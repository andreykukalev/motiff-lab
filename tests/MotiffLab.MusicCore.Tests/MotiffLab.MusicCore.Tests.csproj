<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Import\Midi\Fixtures\*.mid" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Import\Midi\Fixtures\*.hands.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Import\MusicXml\Fixtures\*.musicxml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Import\MusicXml\Fixtures\*.mxl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Import\Scan\Fixtures\*.musicxml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Import\Transcription\Fixtures\*.mid" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Experiments\Fixtures\*.musicxml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Analysis\Fixtures\*.musicxml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Project files of earlier, current and later versions and what today's writer makes of them (Golden/README.md). -->
    <None Include="Golden\*.motiff.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The phrases, form and Piece DNA golden the iPad tests assert under NativeAOT too, and the kit's piece it is made from. -->
    <None Include="..\..\ipad\App\MotiffLabTests\Golden\*.json" Link="Golden\Analysis\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\design\kit\elise.musicxml" Link="Golden\Analysis\elise.musicxml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The example piece of both apps (tools/fur-elise/build.mjs). -->
    <None Include="..\..\src\MotiffLab.Web\Playback\FurElise.musicxml" Link="Import\MusicXml\Fixtures\FurElise.musicxml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MotiffLab.MusicCore\MotiffLab.MusicCore.csproj" />
  </ItemGroup>

</Project>