<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Motiff Lab sends a PDF you choose to read its notes to the scan server you set on your own computer.</string>
	<key>MotiffBuildVersion</key>
	<string>$(MOTIFF_BUILD_VERSION)</string>
	<key>MotiffBuildCommit</key>
	<string>$(MOTIFF_BUILD_COMMIT)</string>
	<key>MotiffBuildDate</key>
	<string>$(MOTIFF_BUILD_DATE)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>msauthv2</string>
		<string>msauthv3</string>
	</array>
</dict>
</plist>
