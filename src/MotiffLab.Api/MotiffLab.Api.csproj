<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The OpenAI SDK marks its Responses API as evaluation (OPENAI001); the assistant's Azure OpenAI adapter is built on it. -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MotiffLab.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="Anthropic.Foundry" Version="1.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.3" />
    <!-- The Cosmos SDK needs Newtonsoft.Json present, though documents are written with System.Text.Json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The assistant's instructions, versioned with the code (0003 section 8). -->
    <EmbeddedResource Include="Assistant\Prompts\*.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotiffLab.MusicCore\MotiffLab.MusicCore.csproj" />
  </ItemGroup>

</Project>
