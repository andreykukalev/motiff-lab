@using MotiffLab.Web.Import
@inject ScanService Scans
@inject MotiffLab.Web.Localization.UiText Text

@* Read the notes from a PDF kept in a piece (0011, 0023): the kept PDF goes to the scan server, as on Scan printed music,
   and the notes it reads go into the same piece (testing item 16, Andrei, 2026-11-06), or become another version of a
   piece that has notes. What leaves the device is one line and one switch, as there; on Motiff Lab's server it needs an
   account and Pro, offered here. *@
<div class="@(Inline ? "recognise-inline" : "popover recognise-popover")" role="@(Inline ? "group" : "dialog")" aria-label="@(Heading ?? Text["pdf.readNotes"])">
    <p class="overline">@(Heading ?? Text["pdf.readNotes"])</p>
    @if (Intro is not null)
    {
        <p class="caption">@Intro</p>
    }
    <ScanReady>
        <p class="caption">@Text.Format(Scans.IsLocal ? "pdf.readLineHere" : "pdf.readLine", Scans.Address!)</p>
        @if (!Scans.IsLocal)
        {
            <label class="consent">
                <input type="checkbox" role="switch" class="switch" @bind="_send" disabled="@_reading" />
                <span>@(Scans.IsHosted ? Text["pdf.sendHosted"] : Text.Format("pdf.sendElsewhere", Scans.Address!.Host))</span>
            </label>
        }

        <button class="btn primary" @onclick="ReadAsync" disabled="@(_reading || !(Scans.IsLocal || _send))">
            @(_reading ? Text["import.scanBusy"] : Text["pdf.readSend"])
        </button>
        <p class="caption">@(Keeps ?? Text["pdf.readKeeps"])</p>
    </ScanReady>

    @if (_problem is not null)
    {
        <p class="caption problem" role="alert">@_problem</p>
    }
</div>

@code {
    private bool _send;
    private bool _reading;
    private string? _problem;

    /// <summary>The PDF, exactly as the player added it.</summary>
    [Parameter, EditorRequired]
    public byte[] Document { get; set; } = [];

    /// <summary>The panel's heading, when it is opened for something that needs the notes first; else Read the notes.</summary>
    [Parameter]
    public string? Heading { get; set; }

    /// <summary>Why the notes are read, said above the rest.</summary>
    [Parameter]
    public string? Intro { get; set; }

    /// <summary>Shown in a sheet's flow, such as Sources, rather than as a popover.</summary>
    [Parameter]
    public bool Inline { get; set; }

    /// <summary>What becomes of the notes read, said under Send; else that they go into this piece.</summary>
    [Parameter]
    public string? Keeps { get; set; }

    /// <summary>The PDF's file name, sent with it.</summary>
    [Parameter, EditorRequired]
    public string FileName { get; set; } = "";

    /// <summary>Takes what the scan server read; returns why the notes cannot be used, or null once they are a piece.</summary>
    [Parameter, EditorRequired]
    public Func<ScanResult, Task<string?>> Read { get; set; } = default!;

    private async Task ReadAsync()
    {
        _reading = true;
        _problem = null;
        try
        {
            ScanResult result = await Scans.RecogniseAsync(FileName, Document);
            _problem = result.MusicXml is null ? result.Problem : await Read(result);
        }
        finally
        {
            _reading = false;
        }
    }
}