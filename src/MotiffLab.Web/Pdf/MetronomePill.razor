@* The metronome of the PDF view (decision record 0023; Andrei, 2026-11-04): a pill at the bottom, as the score's transport
   is (0018 section 2), with start and stop, the tempo (slower, faster, or tapped), the beats to the bar and a dot for each
   beat. It clicks on the device and needs no notes, so it is free. It is the one metronome of the score and the PDF view
   (#521 section 15, PieceMetronome); the tempo and beats are kept per piece on this device. *@
@implements IDisposable
@inject MotiffLab.Web.Playback.PieceMetronome Metronome
@inject MotiffLab.Web.Localization.UiText Text

<div class="pill metronome-pill" role="toolbar" aria-label="@Text["metronome.label"]">
    <button class="play" @onclick="() => Metronome.ToggleAsync()" aria-pressed="@(Metronome.Running ? "true" : "false")" aria-label="@(Metronome.Running ? Text["metronome.stop"] : Text["metronome.start"])">
        <Icon Name="@(Metronome.Running ? "pause" : "playf")" />
    </button>
    <button class="it" @onclick="() => Metronome.ChangeAsync(Metronome.Bpm - Step, Metronome.Beats)" aria-label="@Text["metronome.slower"]" disabled="@(Metronome.Bpm <= MinBpm)">−</button>
    <button class="it bpm" @onclick="() => Metronome.TapAsync()" title="@Text["metronome.tapHint"]" aria-label="@Text.Format("metronome.tempoLabel", Metronome.Bpm)">
        <span class="mono">@Metronome.Bpm</span> <span class="unit">@Text["metronome.bpm"]</span>
    </button>
    <button class="it" @onclick="() => Metronome.ChangeAsync(Metronome.Bpm + Step, Metronome.Beats)" aria-label="@Text["metronome.faster"]" disabled="@(Metronome.Bpm >= MaxBpm)">+</button>
    <span class="div" aria-hidden="true"></span>
    <button class="it" @onclick="NextBeatsAsync" aria-label="@Text.Format("metronome.beatsLabel", Metronome.Beats)" title="@Text["metronome.beatsHint"]">
        <span class="mono">@Metronome.Beats</span>&nbsp;@Text["metronome.beatsShort"]
    </button>
    <span class="beats" aria-hidden="true">
        @for (int beat = 0; beat < Metronome.Beats; beat++)
        {
            <span class="beat @(beat == 0 ? "first" : null) @(beat == Metronome.Beat ? "now" : null)"></span>
        }
    </span>
    <button class="it" @onclick="() => Closed.InvokeAsync()" aria-label="@Text["metronome.close"]" title="@Text["metronome.close"]"><Icon Name="close" /></button>
</div>

@code {
    private const int MinBpm = 30;
    private const int MaxBpm = 240;
    private const int Step = 4;

    /// <summary>The beats to the bar the button goes through.</summary>
    private static readonly int[] s_beats = [2, 3, 4, 6];

    /// <summary>The piece the tempo and beats are kept for.</summary>
    [Parameter, EditorRequired]
    public string PieceId { get; set; } = "";

    /// <summary>The player put the metronome away.</summary>
    [Parameter]
    public EventCallback Closed { get; set; }

    protected override void OnInitialized() => Metronome.Changed += OnChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (Metronome.PieceId != PieceId)
        {
            await Metronome.LoadAsync(PieceId);
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task NextBeatsAsync() => Metronome.ChangeAsync(Metronome.Bpm, s_beats[(Array.IndexOf(s_beats, Metronome.Beats) + 1) % s_beats.Length]);

    public void Dispose() => Metronome.Changed -= OnChanged;
}
