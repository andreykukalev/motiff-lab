@inject MotiffLab.Web.Localization.UiText Text
@inject IJSRuntime JS
@implements IAsyncDisposable
@using MotiffLab.MusicCore.Playback

@* The tempo control (version 0.5.4, #511 section 17; version 0.5.5, #521 section 12): two separate sections. The piece tempo
   (BPM), the one source of truth the score's mark shows, typed by a tap on its number and kept with the piece; and the
   playback pace, a percentage with its own − slider + in 1 % steps, held to repeat (Scripts/layout/hold-repeat.ts), and
   coarse steps, which changes only the speed heard (tempo × pace), never the piece tempo or its mark. It works while
   playing: only the rate changes, the place and the loop stay. It closes with ✕ or a tap on the notes. *@
<div class="tempo-control" @ref="_root">
    <div class="tempo-head">
        <span class="heading">@Text["tempoControl.title"]</span>
        @if (Close.HasDelegate)
        {
            <button class="close" aria-label="@Text["tempoControl.close"]" title="@Text["tempoControl.close"]" @onclick="() => Close.InvokeAsync()"><Icon Name="close" Size="IconSize.Small" /></button>
        }
    </div>
    @if (Reading is { } reading)
    {
        <section class="tempo-section" aria-label="@Text["tempoControl.pieceTempo"]">
            <span class="overline">@Text["tempoControl.pieceTempo"]</span>
            @if (_typing == Typing.Piece && CanSetPiece)
            {
                <form class="tempo-entry" @onsubmit="EnterAsync" @onsubmit:preventDefault>
                    <label class="field">
                        <span class="pre">@reading.Note =</span>
                        <input @ref="_entry" class="mono" inputmode="numeric" autocomplete="off" value="@_typed" @oninput="args => _typed = args.Value?.ToString()" aria-label="@BeatsCaption" />
                    </label>
                    <button class="btn primary compact" type="submit" disabled="@(!PieceValid(reading))">@Text["tempoControl.done"]</button>
                    <button class="btn quiet compact" type="button" @onclick="() => _typing = null">@Text["tempoControl.cancel"]</button>
                </form>
                @if (reading.Own is { } own)
                {
                    <button class="btn quiet compact reset" type="button" @onclick="ClearPieceAsync">@Text.Format("tempoControl.resetTo", reading.Note, own)</button>
                }
            }
            else
            {
                <button class="num" aria-label="@Text["tempoControl.typePiece"]" disabled="@(!CanSetPiece)" @onclick="() => StartTyping(Typing.Piece)">
                    <b class="mono">@reading.PieceText</b>
                    <small>@Text.Format(reading.CaptionKey, reading.Note, reading.PlayedPerMinute)</small>
                </button>
            }
        </section>
    }
    <section class="tempo-section" aria-label="@Text["tempoControl.pace"]">
        <span class="overline">@Text["tempoControl.pace"]</span>
        @if (_typing == Typing.Pace)
        {
            <form class="tempo-entry" @onsubmit="EnterAsync" @onsubmit:preventDefault>
                <label class="field">
                    <input @ref="_entry" class="mono" inputmode="numeric" autocomplete="off" value="@_typed" @oninput="args => _typed = args.Value?.ToString()" aria-label="@Text["tempoControl.percent"]" />
                    <span class="post">%</span>
                </label>
                <button class="btn primary compact" type="submit">@Text["tempoControl.done"]</button>
            </form>
        }
        else
        {
            <button class="num" aria-label="@Text["tempoControl.typePercent"]" disabled="@Disabled" @onclick="() => StartTyping(Typing.Pace)">
                <b class="mono">@Percent<span>%</span></b>
                <small>@(Reading?.HeardText(Percent) is { } heard ? Text.Format("tempoControl.paceHeard", heard) : Text["tempoControl.percentCaption"])</small>
            </button>
        }
        <div class="tempo-fine">
            <button class="step" data-hold-repeat aria-label="@Text["tempoControl.slower"]" title="@Text["tempoControl.slower"]" disabled="@(Disabled || Percent <= Min)"
                    @onclick="() => SetPercentAsync(Percent - 1)">−</button>
            <input type="range" min="@Min" max="@Max" step="1" value="@Percent" disabled="@Disabled" aria-label="@Text["tempoControl.percent"]" @oninput="SlideAsync" />
            <button class="step" data-hold-repeat aria-label="@Text["tempoControl.faster"]" title="@Text["tempoControl.faster"]" disabled="@(Disabled || Percent >= Max)"
                    @onclick="() => SetPercentAsync(Percent + 1)">+</button>
        </div>
        <div class="tempo-steps" role="group" aria-label="@Text["tempoControl.steps"]">
            @foreach (int step in Steps)
            {
                <button class="chip @(Percent == step ? "on" : null)" aria-pressed="@(Percent == step ? "true" : "false")" disabled="@Disabled" @onclick="() => SetPercentAsync(step)">@step</button>
            }
            <span class="unit" aria-hidden="true">%</span>
        </div>
    </section>
</div>

@code {
    /// <summary>The slowest and fastest the playback goes, as a percentage of the piece's tempo.</summary>
    public const int Min = 25;

    public const int Max = 150;

    /// <summary>The coarse steps, 50 % to 110 %.</summary>
    public static readonly IReadOnlyList<int> Steps = [50, 60, 70, 80, 90, 100, 110];

    private enum Typing
    {
        Piece,
        Pace,
    }

    private ElementReference _root;
    private ElementReference _entry;
    private IJSObjectReference? _holdRepeat;
    private Typing? _typing;
    private string? _typed;
    private bool _focusEntry;

    /// <summary>The playback tempo, as a percentage of the piece's.</summary>
    [Parameter]
    public int Percent { get; set; } = 100;

    /// <summary>The piece tempo and where it comes from; null before a piece is loaded.</summary>
    [Parameter]
    public TempoReading? Reading { get; set; }

    /// <summary>The percentage chosen, 25 to 150.</summary>
    [Parameter]
    public EventCallback<int> SetPercent { get; set; }

    /// <summary>The piece tempo the player typed, in quarter notes a minute, or null to clear theirs; without it the piece tempo is shown, not typed.</summary>
    [Parameter]
    public EventCallback<int?> SetPlayerTempo { get; set; }

    /// <summary>Puts the control away (✕).</summary>
    [Parameter]
    public EventCallback Close { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private bool CanSetPiece => Reading is { CanSet: true } && SetPlayerTempo.HasDelegate && !Disabled;

    private string BeatsCaption => Text[Reading?.Beat == TempoBeat.DottedQuarter ? "tempoControl.dottedQuarters" : "tempoControl.quarters"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/layout/hold-repeat.js");
                _holdRepeat = await module.InvokeAsync<IJSObjectReference>("attach", _root);
                await module.DisposeAsync();
            }
            catch (JSException)
            {
                // Without the script − and + still step a tap at a time.
            }
        }

        if (_focusEntry)
        {
            _focusEntry = false;
            try
            {
                await _entry.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // The field went before it could take the focus.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_holdRepeat is { } holdRepeat)
        {
            try
            {
                await holdRepeat.InvokeVoidAsync("dispose");
                await holdRepeat.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going; its listeners go with it.
            }
        }
    }

    private Task SetPercentAsync(int percent) => SetPercent.InvokeAsync(Math.Clamp(percent, Min, Max));

    private Task SlideAsync(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), out int percent) ? SetPercentAsync(percent) : Task.CompletedTask;

    private void StartTyping(Typing typing)
    {
        _typing = typing;
        _typed = typing == Typing.Pace ? Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : Reading?.PlayedPerMinute.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _focusEntry = true;
    }

    private int? Typed => int.TryParse(_typed?.Trim(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int value) && value > 0 ? value : null;

    private bool PieceValid(TempoReading reading) => Typed is { } perMinute && reading.CanSetTo(perMinute);

    /// <summary>
    /// The pace typed, kept within 25 to 150 %; or the piece tempo typed in beats a minute, kept in quarter notes with the
    /// piece and marked on the score; the pace stays, so the speed heard follows it.
    /// </summary>
    private async Task EnterAsync()
    {
        Typing? typing = _typing;
        if (Typed is not { } value)
        {
            return;
        }

        if (typing == Typing.Piece)
        {
            if (Reading is not { } reading || !reading.CanSetTo(value))
            {
                return;
            }

            _typing = null;
            if (value != reading.PlayedPerMinute)
            {
                await SetPlayerTempo.InvokeAsync(reading.Beat.QuarterNotes(value));
            }

            return;
        }

        _typing = null;
        await SetPercentAsync(value);
    }

    private async Task ClearPieceAsync()
    {
        _typing = null;
        await SetPlayerTempo.InvokeAsync(null);
    }
}
