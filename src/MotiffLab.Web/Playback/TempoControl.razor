@inject MotiffLab.Web.Localization.UiText Text
@inject IJSRuntime JS
@implements IAsyncDisposable
@using MotiffLab.MusicCore.Playback

@* The tempo control (version 0.5.4, #511 section 17, the UX prototype's variant A that Andrei approved): the playback tempo
   as a percentage of the piece's with the beats a minute heard beside it, either typed; − slider + in 1 % steps, held to
   repeat (Scripts/layout/hold-repeat.ts); coarse steps; the piece's tempo with where it comes from; and the tempo printed
   in the notes, which changes the piece's tempo and keeps the percentage. It works while playing: only the rate changes,
   the place and the loop stay. It closes with ✕ or a tap on the notes. *@
<div class="tempo-control" @ref="_root">
    <div class="tempo-head">
        <span class="heading">@Text["tempoControl.title"]</span>
        @if (Close.HasDelegate)
        {
            <button class="close" aria-label="@Text["tempoControl.close"]" title="@Text["tempoControl.close"]" @onclick="() => Close.InvokeAsync()"><Icon Name="close" Size="IconSize.Small" /></button>
        }
    </div>
    @if (_typing is { } typing)
    {
        <form class="tempo-entry" @onsubmit="EnterAsync" @onsubmit:preventDefault>
            <label class="field">
                @if (typing == Typing.Beats && Reading is { } beat)
                {
                    <span class="pre">@beat.Note =</span>
                }
                <input @ref="_entry" class="mono" inputmode="numeric" autocomplete="off" value="@_typed" @oninput="args => _typed = args.Value?.ToString()"
                       aria-label="@(typing == Typing.Percent ? Text["tempoControl.percent"] : BeatsCaption)" />
                <span class="post">@(typing == Typing.Percent ? "%" : BeatsCaption)</span>
            </label>
            <button class="btn primary compact" type="submit">@Text["tempoControl.done"]</button>
        </form>
    }
    else
    {
        <div class="tempo-big">
            <button class="num" aria-label="@Text["tempoControl.typePercent"]" disabled="@Disabled" @onclick="() => StartTyping(Typing.Percent)">
                <b class="mono">@Percent<span>%</span></b>
                <small>@Text["tempoControl.percentCaption"]</small>
            </button>
            @if (Reading is { } reading)
            {
                <span class="tempo-split" aria-hidden="true"></span>
                <button class="num" aria-label="@Text["tempoControl.typeBeat"]" disabled="@Disabled" @onclick="() => StartTyping(Typing.Beats)">
                    <b class="mono">@reading.Note @reading.HeardAt(Percent)</b>
                    <small>@(reading.Played.Source == TempoSource.Assumed ? Text.Format("tempoControl.ofTaken", reading.Note, reading.PlayedPerMinute) : BeatsCaption)</small>
                </button>
            }
        </div>
    }
    <div class="tempo-fine">
        <button class="step" data-hold-repeat aria-label="@Text["tempoControl.slower"]" title="@Text["tempoControl.slower"]" disabled="@(Disabled || Percent <= Min)"
                @onclick="() => SetPercentAsync(Percent - 1)">−</button>
        <input type="range" min="@Min" max="@Max" step="1" value="@Percent" disabled="@Disabled" aria-label="@Text["tempoControl.percent"]" @oninput="SlideAsync" />
        <button class="step" data-hold-repeat aria-label="@Text["tempoControl.faster"]" title="@Text["tempoControl.faster"]" disabled="@(Disabled || Percent >= Max)"
                @onclick="() => SetPercentAsync(Percent + 1)">+</button>
    </div>
    <div class="tempo-steps" role="group" aria-label="@Text["tempoControl.steps"]">
        @foreach (int step in Steps)
        {
            <button class="chip @(Percent == step ? "on" : null)" aria-pressed="@(Percent == step ? "true" : "false")" disabled="@Disabled" @onclick="() => SetPercentAsync(step)">@step</button>
        }
        <span class="unit" aria-hidden="true">%</span>
    </div>
    @if (Reading is { } shown)
    {
        @if (_printing && CanPrint)
        {
            <form class="tempo-printed" @onsubmit="SavePrintedAsync" @onsubmit:preventDefault>
                <span class="overline">@Text["tempoControl.printedTitle"]</span>
                <div class="tempo-row">
                    <label class="field">
                        <span class="pre">@shown.Note =</span>
                        <input @ref="_entry" class="mono" inputmode="numeric" autocomplete="off" value="@_printed" placeholder="@shown.PiecePerMinute"
                               aria-label="@BeatsCaption" @oninput="args => _printed = args.Value?.ToString()" />
                    </label>
                    <button class="btn primary compact" type="submit" disabled="@(!PrintedValid(shown))">@Text["tempoControl.save"]</button>
                    <button class="btn quiet compact" type="button" @onclick="() => _printing = false">@Text["tempoControl.cancel"]</button>
                    @if (shown.Player is not null)
                    {
                        <button class="btn quiet compact" type="button" @onclick="ClearPrintedAsync">@Text["tempoControl.clear"]</button>
                    }
                </div>
                <p class="caption">@Text.Format("tempoControl.printedHint", Percent)</p>
            </form>
        }
        else
        {
            <div class="tempo-base">
                <div class="tempo-row">
                    <span class="overline">@Text["tempoControl.pieceTempo"]</span>
                    <span class="tag @SourceClass(shown.Played.Source)">@SourceTag(shown.Played.Source)</span>
                    <span class="mono">@SourceLine(shown)</span>
                </div>
                @if (CanPrint)
                {
                    bool unknown = shown.Played.Source == TempoSource.Assumed;
                    <button class="btn @(unknown ? "secondary" : "quiet") compact" @onclick="StartPrinting">@Text[unknown ? "tempoControl.printedUnknown" : "tempoControl.printed"]</button>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>The slowest and fastest the playback goes, as a percentage of the piece's tempo.</summary>
    public const int Min = 25;

    public const int Max = 150;

    /// <summary>The coarse steps, 50 % to 110 %.</summary>
    public static readonly IReadOnlyList<int> Steps = [50, 60, 70, 80, 90, 100, 110];

    private enum Typing
    {
        Percent,
        Beats,
    }

    private ElementReference _root;
    private ElementReference _entry;
    private IJSObjectReference? _holdRepeat;
    private Typing? _typing;
    private string? _typed;
    private bool _printing;
    private string? _printed;
    private bool _focusEntry;

    /// <summary>The playback tempo, as a percentage of the piece's.</summary>
    [Parameter]
    public int Percent { get; set; } = 100;

    /// <summary>The piece's tempo and where it comes from; null before a piece is loaded.</summary>
    [Parameter]
    public TempoReading? Reading { get; set; }

    /// <summary>The percentage chosen, 25 to 150.</summary>
    [Parameter]
    public EventCallback<int> SetPercent { get; set; }

    /// <summary>The piece's tempo the player read in the printed notes, in quarter notes a minute, or null to clear it; without it the control does not offer it.</summary>
    [Parameter]
    public EventCallback<int?> SetPlayerTempo { get; set; }

    /// <summary>Puts the control away (✕).</summary>
    [Parameter]
    public EventCallback Close { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private bool CanPrint => Reading is { CanSet: true } && SetPlayerTempo.HasDelegate && !Disabled;

    private string BeatsCaption => Text[Reading?.Beat == TempoBeat.DottedQuarter ? "tempoControl.dottedQuarters" : "tempoControl.quarters"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/layout/hold-repeat.js");
                _holdRepeat = await module.InvokeAsync<IJSObjectReference>("attach", _root);
                await module.DisposeAsync();
            }
            catch (JSException)
            {
                // Without the script − and + still step a tap at a time.
            }
        }

        if (_focusEntry)
        {
            _focusEntry = false;
            try
            {
                await _entry.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // The field went before it could take the focus.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_holdRepeat is { } holdRepeat)
        {
            try
            {
                await holdRepeat.InvokeVoidAsync("dispose");
                await holdRepeat.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going; its listeners go with it.
            }
        }
    }

    private Task SetPercentAsync(int percent) => SetPercent.InvokeAsync(Math.Clamp(percent, Min, Max));

    private Task SlideAsync(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), out int percent) ? SetPercentAsync(percent) : Task.CompletedTask;

    private void StartTyping(Typing typing)
    {
        _typing = typing;
        _printing = false;
        _typed = typing == Typing.Percent ? Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : Reading?.HeardAt(Percent).ToString(System.Globalization.CultureInfo.InvariantCulture);
        _focusEntry = true;
    }

    /// <summary>The percentage typed, or the beats a minute as the percentage that plays them, kept within 25 to 150.</summary>
    private async Task EnterAsync()
    {
        Typing? typing = _typing;
        _typing = null;
        if (!int.TryParse(_typed?.Trim(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int value) || value <= 0)
        {
            return;
        }

        await SetPercentAsync(typing == Typing.Beats && Reading is { } reading ? reading.PercentFor(value) : value);
    }

    private void StartPrinting()
    {
        _printing = true;
        _typing = null;
        _printed = Reading?.Player?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _focusEntry = true;
    }

    private bool PrintedValid(TempoReading reading) =>
        int.TryParse(_printed?.Trim(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int perMinute)
        && reading.CanSetTo(perMinute) && perMinute != reading.Player;

    /// <summary>The printed tempo, kept in quarter notes a minute; the percentage stays, so the playback speed follows it.</summary>
    private async Task SavePrintedAsync()
    {
        if (Reading is { } reading && PrintedValid(reading))
        {
            _printing = false;
            await SetPlayerTempo.InvokeAsync(reading.Beat.QuarterNotes(int.Parse(_printed!.Trim(), System.Globalization.CultureInfo.InvariantCulture)));
        }
    }

    private async Task ClearPrintedAsync()
    {
        _printing = false;
        await SetPlayerTempo.InvokeAsync(null);
    }

    private static string SourceClass(TempoSource source) => source switch
    {
        TempoSource.Inferred => "detected",
        TempoSource.Assumed => "assumed",
        TempoSource.Player => "player",
        _ => "notated",
    };

    private string SourceTag(TempoSource source) => Text[source switch
    {
        TempoSource.Inferred => "tempoControl.tagInferred",
        TempoSource.Assumed => "tempoControl.tagAssumed",
        TempoSource.Player => "tempoControl.tagPlayer",
        _ => "tempoControl.tagNotated",
    }];

    /// <summary>The piece's tempo as its source has it, so the printed tempo, an estimate and the player's are never mixed up.</summary>
    private string SourceLine(TempoReading reading) => reading.Played.Source switch
    {
        TempoSource.Inferred => Text.Format("tempoControl.lineInferred", reading.Note, reading.PlayedPerMinute),
        TempoSource.Assumed => Text.Format("tempoControl.lineAssumed", reading.Note, reading.PlayedPerMinute),
        TempoSource.Player when reading.Piece.Source == TempoSource.Notated => Text.Format("tempoControl.linePlayerOver", reading.Note, reading.PlayedPerMinute, reading.PiecePerMinute),
        TempoSource.Player => Text.Format("tempoControl.linePlayer", reading.Note, reading.PlayedPerMinute),
        _ => Text.Format("tempoControl.lineNotated", reading.Note, reading.PlayedPerMinute),
    };
}
