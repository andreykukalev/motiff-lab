    private Task CorrectAsync(Note note, int pitch = 0, long onset = 0, long length = 0, int velocity = 0)
    {
        NoteValues values = NoteValues.Of(note);
        NoteValues after = new(
            new Pitch(Math.Clamp(note.Pitch.MidiNumber + pitch, 0, Pitch.MaxMidiNumber)),
            new TickSpan(new Tick(Math.Max(0, note.Span.Onset.Value + onset)), Math.Max(1, note.Span.Duration + length)),
            Math.Clamp(note.Velocity + velocity, Note.MinVelocity, Note.MaxVelocity));
        return after == values ? Task.CompletedTask : ApplyEditsAsync(_edits.Change(_imported, note.Id, after));
    }

    /// <summary>The accepted hand edits in the chain.</summary>
