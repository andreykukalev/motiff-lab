        _edits = NoteEditLog.Empty;
        _meter = piece.Meter;
        _title = title;
        _tracks = piece.Notes.Select(note => note.Track).Distinct().Order().ToArray();
        _lastBar = MotifSelector.LastBar(_meter, _score.End);
        _levels = null;
        _level = DefaultLevel;
        SuggestPhrases(LevelEdits.None);
        _filters = Filters(piece.Notes, _tracks);
        _filter = SelectionFilter.All;
        _keptIds = null;
        _selection = null;
        _focus = false;
        _focusSpan = null;
        _highlight = null;
        _analysis = null;
        _structure = null;
        _character = [];
        _harmony = HarmonyAnalysis.None;
        _circle = null;
        _sentenceFacts = [];
        _selectionNote = null;
        _looping = false;
        _alternating = false;
        _answerLoop = null;
        _hear = [Player.OriginalSource];
        _chain = null;
        _variation = null;
        _offers = [];
        _invitationContext = null;
        _trial = null;
        // A new piece has its own project, or none (#78): nothing kept about another piece shows or saves here.
        _project = null;
