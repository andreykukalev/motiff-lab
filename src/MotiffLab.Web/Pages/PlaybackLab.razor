            new NoteValues(note.Pitch, new TickSpan(note.Span.End, note.Span.Duration), note.Velocity)))
        : Task.CompletedTask;

    /// <summary>Adds one hand edit to the variation as a step (S1-E7), starting a chain when there is none.</summary>
    private async Task HandEditAsync(HandEditParameters edit)
    {
