            new TickSpan(new Tick(Math.Max(0, note.Span.Onset.Value + onset)), Math.Max(1, note.Span.Duration + length)),
            Math.Clamp(note.Velocity + velocity, Note.MinVelocity, Note.MaxVelocity))));

