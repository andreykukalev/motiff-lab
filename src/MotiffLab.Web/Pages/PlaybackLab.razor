    private Task ReplayAsync() =>
        _chain is not null && _selection is { } selection
            && _chain.Replay(VariationFacts.MotifNotes(_notes!, selection), VariationContext.For(selection, _keep.ToHashSet(), key: Key, meter: _meter, words: Words)) is { } replayed
            ? ShowAsync(replayed, play: false)
