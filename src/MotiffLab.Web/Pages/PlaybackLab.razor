            }

            yield return (ScoreChoice.Generated, "score.generated");
            if (_variationScore is not null)
            {
                yield return (ScoreChoice.Variation, "score.withVariation");
            }
        }
    }

    /// <summary>
    /// The choice in effect, or while the original and the variation loop one after the other, the score of the one sounding.
    /// One that is not available falls back to the file as written, else the generated score.
    /// </summary>
    private ScoreChoice ShownChoice => (SoundingScore ?? _scoreChoice) switch
    {
        ScoreChoice.Variation when _variationScore is not null => ScoreChoice.Variation,
        ScoreChoice.AsWritten or ScoreChoice.Variation when _asWritten is not null => ScoreChoice.AsWritten,
        _ => ScoreChoice.Generated,
    };

    /// <summary>The score shown: while a merge draft is open, the version or the result when «Показать» is on them; never over a variation.</summary>
    private ScoreSource? ShownScore => ShownChoice switch
    {
        ScoreChoice.Variation => _variationScore,
        _ when MergeScore is { } merged => merged,
        ScoreChoice.AsWritten => _asWritten,
        _ => _generated,
    };

    /// <summary>The piece's pencil marks (0015), on its own score as written or generated; a score with a variation in it shows none.</summary>
    private string? ShownPencilKey => ShownChoice == ScoreChoice.Variation ? null : PencilMarks.KeyFor(_project?.Id, _title);

    private IReadOnlyList<InkStroke>? _inkWritten;
    private string _ink = "";

    /// <summary>The strokes the project keeps (v12), for the score to show and write on; null without a project, when the device keeps them.</summary>
    private string? ShownInk
    {
        get
        {
            if (_project is null)
            {
                return null;
            }

            if (!ReferenceEquals(_project.Marks.Ink, _inkWritten))
            {
                _inkWritten = _project.Marks.Ink;
                _ink = _inkWritten.Count == 0 ? "" : ProjectFile.WriteInk(_inkWritten);
            }

            return _ink;
        }
    }

    /// <summary>The player wrote or erased on the score: the strokes go into the project and are saved with it.</summary>
    private async Task OnPencilMarksChangedAsync(string ink)
    {
        if (_project is null)
        {
            return;
        }

        IReadOnlyList<InkStroke> strokes;
        try
        {
            strokes = ProjectFile.ReadInk(ink);
        }
        catch (ProjectFileException)
        {
            return;
        }

        _project = _project with { Marks = _project.Marks.WithInk(strokes) };
        // The score already shows these strokes: the text it sent stands for the list the project now keeps.
        _inkWritten = _project.Marks.Ink;
        _ink = ink;
        await SaveProjectAsync();
    }

