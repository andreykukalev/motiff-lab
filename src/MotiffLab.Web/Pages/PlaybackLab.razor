    protected override void OnInitialized()
    {
        Player.Changed += OnPlayerChanged;
        Text.Changed += OnLanguageChanged;
        SettingsStore.Changed += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FocusDraftAsync();
        await FocusNoteAsync();
        await PlaceMenuBesideContentsAsync();
        await SaveCoverAsync();
        if (firstRender)
        {
            await ReadLayoutPreferencesAsync();
            await Player.InitializeAsync();
        }

        // Try Für Elise on Projects opens it as soon as the player is ready, rather than a piece still in memory.
        if (Start == "fur-elise" && !_started && Player.IsReady)
        {
            _started = true;
            _pieceVersion = CurrentPiece.Version;
            await LoadFurEliseAsync();
            StateHasChanged();
        }

        // A reload or a link: the open piece lives only in memory, so open the project the address names from the device.
        if (CurrentPiece.Piece is null && ProjectId is { Length: > 0 } id && !_reopened)
        {
            _reopened = true;
            try
            {
                if (!await CurrentPiece.OpenSavedAsync(id))
                {
                    (_message, _tip) = (Text["workspace.projectGone"], Text["workspace.projectGoneTip"]);
                }
                else if (CurrentPiece.Project is { HasNotes: false } pdf)
                {
                    // A PDF with no notes is read in its own view (0023).
                    Navigation.NavigateTo(CurrentPiece.WorkspaceUrl(pdf), replace: true);
                    return;
                }
            }
            catch (ProjectFileException exception)
            {
                (_message, _tip) = (exception.Message, null);
            }

            StateHasChanged();
        }

        // A piece opened from the import screen (N2), with the track or hand the player chose to start with.
        if (CurrentPiece.Piece is { } piece && CurrentPiece.Version != _pieceVersion && Player.IsReady)
        {
            _pieceVersion = CurrentPiece.Version;
            await LoadPieceAsync(piece);
            if (_filters.Contains(CurrentPiece.StartWith))
            {
                _filter = CurrentPiece.StartWith;
            }

            _project = CurrentPiece.Project;
            StartScanCheck(piece);
            _level = ProjectLevel;
            if (_project is { PhraseLevels.IsEmpty: false } phrased)
            {
                SuggestPhrases(phrased.PhraseLevels);
            }

            if (_project is { ChangesNotes: true } corrected)
            {
                _restoring = true;
                try
                {
                    await ApplyEditsAsync(corrected.Edits);
                }
                finally
                {
                    _restoring = false;
                }
            }

            if (CurrentPiece.Opened is { Motifs.Count: > 0 } opened)
            {
                await RestoreAsync(opened);
            }

            await ArriveAtResumePointAsync();
            StateHasChanged();
        }

        await SyncLayoutAsync();
    }

    public void Dispose()
    {
        Player.Changed -= OnPlayerChanged;
        Text.Changed -= OnLanguageChanged;
        SettingsStore.Changed -= OnSettingsChanged;
    }

    private void OnPlayerChanged() => _ = InvokeAsync(async () =>
    {
        await FollowScaleAsync();
        await FollowPlayingInFocusAsync();
        StateHasChanged();
    });

    /// <summary>The facts and the variation's explanation are written in the chosen language, so a new language reads the selection again (#134).</summary>
    private void OnLanguageChanged() => _ = InvokeAsync(async () =>
    {
        if (_selection is { } selection)
        {
            Analyze(selection);
            _highlight = null;
            // A trial runs over its own passage, so it keeps the words it was offered in.
            if (_chain is not null && ActiveTrial is null)
            {
                await ReplayAsync();
            }
        }

        StateHasChanged();
    });

