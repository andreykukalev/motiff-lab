@page "/playback"
@using MotiffLab.MusicCore
@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Analytics
@using MotiffLab.MusicCore.Events
@using MotiffLab.MusicCore.Experiments
@using MotiffLab.MusicCore.Export
@using MotiffLab.MusicCore.Import
@using MotiffLab.MusicCore.Import.MusicXml
@using MotiffLab.MusicCore.Import.Transcription
@using MotiffLab.MusicCore.Motifs
@using MotiffLab.MusicCore.Notation
@using MotiffLab.MusicCore.Performance
@using MotiffLab.MusicCore.Invitations
@using MotiffLab.MusicCore.Playback
@using MotiffLab.MusicCore.Projects
@using MotiffLab.MusicCore.Time
@using MotiffLab.MusicCore.Variations
@using MotiffLab.Web.Compare
@using MotiffLab.Web.Explore
@using MotiffLab.Web.Import
@using MotiffLab.Web.Insights
@using MotiffLab.Web.Localization
@using MotiffLab.Web.Observations
@using MotiffLab.Web.Playback
@using MotiffLab.Web.Projects
@using MotiffLab.Web.Roll
@using MotiffLab.Web.Score
@using MotiffLab.Web.Understand
@implements IDisposable
@inject IJSRuntime JS
@inject Player Player
@inject Preferences Preferences
@inject DeviceSettings SettingsStore
@inject CurrentPiece CurrentPiece
@inject ProjectStore Projects
@inject NavigationManager Navigation
@inject MotiffLab.Web.Analytics.UsageAnalytics Analytics
@inject UiText Text
@inject MotiffLab.Web.Import.ScanService Scans

<PageTitle>@(_title ?? Text["workspace.title"]) · Motiff Lab</PageTitle>

@* The score page (decision record 0018, sections 1 and 2): the score is the whole screen, one continuously scrolling document of
   A4 pages, with nothing docked. A floating bar carries the title, the page under the top of the view and five actions (Phrases,
   Pen, Piano roll, Insights, Play) and fades while the player reads; the transport pill appears with a selection or playback;
   the piano roll is a drawer and the Insights sheet slides over the right. The phrases are brackets on the score at the level
   the player chose. It also covers S1-W2 to S1-W7, S1-M1, S1-M2, S1-M5, S1-A1 and S1-A2. Files stay on the device. *@
@* The shared workspace state (decision record 0013): one snapshot per render, which the sheet reads; the page is its only writer. *@
<CascadingValue Value="State">
    <main class="lab app workspace @WorkspaceClass" @ref="_main">
        @if ((_score is null || _meter is null) && Opening)
        {
            @* A piece on its way (a reload, a link, the import screen): only a quiet line, never the start's choices, which
               flashed for a second before the score (testing, 2026-11-06). *@
            <p class="workspace-opening meta" role="status">@Text["workspace.opening"]</p>
        }
        else if (_score is null || _meter is null)
        {
            @* No piece yet: what to open. The library (0018 section 8) replaces this in a later step. *@
            <div class="workspace-start">
                <a class="btn quiet back" href="@BackUrl"><Icon Name="back" /> @BackLabel</a>
                <h1>@Text["workspace.title"]</h1>
                @if (Player.Error is not null)
                {
                    <p class="error">@Player.Error</p>
                }
                else if (!Player.IsReady)
                {
                    <p class="meta">@Text["workspace.loadingPiano"]</p>
                }
                @if (_message is not null)
                {
                    <p class="error">@_message</p>
                    <p class="meta">@_tip</p>
                }
                else if (Player.IsReady)
                {
                    <p class="meta empty-hint">@Text["workspace.emptyHint"]</p>
                }
                <div class="row">
                    <button class="btn primary" @onclick="LoadFurEliseAsync" disabled="@(!Player.IsReady)" title="@Text["workspace.furEliseHint"]">Für Elise</button>
                    <label class="file btn secondary">
                        @Text["workspace.openFile"]
                        <InputFile OnChange="OpenFileAsync" accept="@PieceImporter.AcceptedExtensions" disabled="@(!Player.IsReady)" />
                    </label>
                    <a class="btn secondary" href="import">@Text["workspace.importWithReport"]</a>
                </div>
            </div>
        }
        else
        {
            @if (ShownScore is { } shown)
            {
                @* Clicks on the page outside the score and the overlays clear the selection, except inside panels marked data-keeps-selection (docs/ui-conventions.md). *@
                <ScoreView @ref="_scoreView" Source="shown" Range="ShownRange" Phrases="ScorePhrases" Highlight="_highlight?.Places" HoldHeight="false" PencilKey="ShownPencilKey" Ink="@ShownInk"
                           MarksChanged="OnPencilMarksChangedAsync" Title="@ScoreTitle.Of(_title)" BarPicked="OnScoreBarPickedAsync" PaperTapped="OnPaperTappedAsync" PagesShown="OnPagesShown"
                           BracketPicked="OnBracketPickedAsync" PencilChanged="OnPenChanged" TitleRead="OnTitleRead"
                           Selection="_selection?.Span" BarsChosen="OnScoreBarsChosenAsync" Menu="@(MenuShown ? SelectionMenu : null)"
                           Bookmarks="ScoreBookmarks" BookmarkPicked="OnBookmarkPickedAsync" Notes="ScoreNotes" MarkHighlights="ScoreHighlights" HiddenLayers="HiddenLayers"
                           NoteMarkerPicked="OpenNoteAsync" LayersRequested="OpenLayers" Checks="ScoreChecks" CheckPicked="OnCheckPickedAsync"
                           PerformanceMarkers="ScorePerformanceMarkers" Unheard="ScoreUnheard" VersionAdded="MergeScoreVersion" OwnNotes="MergeScoreOwn" TakenBars="ScoreTakenBars" PerformancePicked="OnPerformancePickedAsync"
                           Pointed="_pointed" NotePicked="OnScoreNotePicked" Follow="@SettingsStore.IsOn(FollowSetting)" EvenBars="@SettingsStore.IsOn(EvenBarsSetting)" PlayheadAway="OnPlayheadAway" />
            }
            else
            {
                <p class="workspace-notice meta">@Text["score.none"]</p>
            }

            @* The bar (0018 section 2, design/kit/ds.css .bar): back, the title, the page under the top of the view, the five actions and the overflow. *@
            <header class="bar @(Focused ? "focus-bar" : null)" data-keeps-selection @ref="_bar">
                @if (Focused)
                {
                    @FocusBar
                }
                else
                {
                    <a class="act" href="@BackUrl" aria-label="@BackLabel" title="@BackLabel"><Icon Name="back" Size="IconSize.Large" /></a>
                    @* The Contents at the left, by the way back, as in a reader (testing item 21); the piece's title opens them too (0018 section 5). *@
                    <button class="act @(_contentsOpen ? "on" : null)" aria-label="@Text["bar.contents"]" title="@Text["bar.contents"]" aria-expanded="@(_contentsOpen ? "true" : "false")"
                            @onclick="ToggleContentsAsync"><Icon Name="pages" Size="IconSize.Large" /></button>
                    <button class="ttl @(_contentsOpen ? "on" : null)" title="@SessionLine" aria-label="@Text.Format("contents.open", BarTitle)" aria-expanded="@(_contentsOpen ? "true" : "false")"
                            @onclick="ToggleContentsAsync">@BarTitle</button>
                    @if (PageText is { } pages)
                    {
                        <span class="pg" aria-live="off">@pages</span>
                    }
                    @if (_project is { Document: not null } or { ReadFrom: not null })
                    {
                        <MotiffLab.Web.Pdf.ViewSwitch OnPdf="false" Switch="_ => ShowPdfAsync()" />
                    }
                    <span class="sp"></span>
                    <button class="act @(_popover == Popover.Phrases ? "on" : null)" aria-expanded="@(_popover == Popover.Phrases ? "true" : "false")" aria-label="@Text["bar.phrases"]" title="@Text["bar.phrases"]"
                            data-long-press="phrases" @onclick="() => TogglePopover(Popover.Phrases)"><Icon Name="phrases" Size="IconSize.Large" /></button>
                    @if (_scoreView?.CanDraw == true)
                    {
                        <button class="act @(_penOn ? "on" : null)" aria-pressed="@(_penOn ? "true" : "false")" aria-label="@Text["bar.pen"]" title="@Text["pencil.hint"]"
                                @onclick="TogglePenAsync"><Icon Name="pen" Size="IconSize.Large" /></button>
                    }
                    <button class="act @(_rollOpen ? "on" : null)" aria-pressed="@(_rollOpen ? "true" : "false")" aria-label="@Text["bar.roll"]" title="@Text["bar.roll"]"
                            data-long-press="roll" @onclick="ToggleRoll"><Icon Name="roll" Size="IconSize.Large" /></button>
                    <button class="act @(_insightsOpen ? "on" : null)" aria-pressed="@(_insightsOpen ? "true" : "false")" aria-label="@Text["bar.insights"]" title="@Text["bar.insights"]"
                            @onclick="ToggleInsights"><Icon Name="insight" Size="IconSize.Large" /></button>
                    @* Extra information (testing item 33): one press shows or hides what the app adds over the notes; the chevron lists each kind. *@
                    <span class="act-split @(LayerShown("extra") ? "on" : null)">
                        <button class="act" aria-pressed="@(LayerShown("extra") ? "true" : "false")" aria-label="@Text["extra.toggle"]" title="@Text["extra.hint"]"
                                @onclick="ToggleExtraAsync"><Icon Name="info" Size="IconSize.Large" /></button>
                        <button class="act chev @(_popover == Popover.Layers ? "on" : null)" aria-expanded="@(_popover == Popover.Layers ? "true" : "false")" aria-label="@Text["extra.list"]"
                                title="@Text["extra.list"]" @onclick="() => TogglePopover(Popover.Layers)"><Icon Name="chevd" /></button>
                    </span>
                    <button class="act" @onclick="TogglePlayAsync" aria-label="@(Player.State == PlaybackState.Stopped ? Text["transport.play"] : Text["transport.pause"])">
                        <Icon Name="@(Player.State != PlaybackState.Stopped ? "pause" : "play")" Size="IconSize.Large" />
                    </button>
                    <button class="act @(_popover == Popover.More ? "on" : null)" aria-expanded="@(_popover == Popover.More ? "true" : "false")" aria-label="@Text["bar.more"]" title="@Text["bar.more"]"
                            @onclick="() => TogglePopover(Popover.More)"><Icon Name="more" Size="IconSize.Large" /></button>
                }
            </header>

            @if (_popover != Popover.None || _pillMenu != PillMenu.None)
            {
                @* A tap anywhere else puts the popover away, the pill's tempo and hands popovers too. *@
                <button class="scrim" aria-label="@Text["bar.close"]" tabindex="-1" @onclick="ClosePopover" data-keeps-selection></button>
            }
            @switch (_popover)
            {
                case Popover.Phrases:
                    @* The Phrases popover (0018 section 3): the level, the brackets on or off, and Reset to detected. It never lists the phrases. *@
                    <div class="popover phrases-popover" role="dialog" aria-label="@Text["bar.phrases"]" data-keeps-selection>
                        <p class="overline">@Text["phrases.levelTitle"]</p>
                        <div class="seg" role="radiogroup" aria-label="@Text["phrases.levelTitle"]">
                            @foreach (PhraseLevel level in PhraseLevels.All)
                            {
                                <button role="radio" class="@(_level == level ? "on" : null)" aria-checked="@(_level == level ? "true" : "false")"
                                        @onclick="() => SetLevelAsync(level)">@LevelName(level)</button>
                            }
                        </div>
                        <p class="caption">@LevelCount</p>
                        <label class="switch-row">
                            <span>@Text["phrases.showBrackets"]</span>
                            <input type="checkbox" role="switch" class="switch" checked="@_showBrackets" @onchange="ToggleBracketsAsync" />
                        </label>
                        <button class="btn quiet" @onclick="ResetLevelAsync" disabled="@(_levels is null || _levels.Edits[_level].IsEmpty)">@Text["phrases.resetLevel"]</button>
                        @PopoverScope([GranularitySetting], "score")
                    </div>
                    break;
                case Popover.Layers:
                    @* Extra information (testing item 33): everything the app adds over the notes, off by default, each kind on its own;
                       below, the player's own marks and the phrases, shown as before. *@
                    <div class="popover layers-popover" role="dialog" aria-label="@Text["extra.title"]" data-keeps-selection>
                        @BackChip(Place.Layers)
                        <p class="overline">@Text["extra.title"]</p>
                        <label class="switch-row">
                            <span>@Text["extra.show"]</span>
                            <input type="checkbox" role="switch" class="switch" checked="@LayerShown("extra")" @onchange="ToggleExtraAsync" />
                        </label>
                        @foreach (string item in PieceExtra)
                        {
                            <label class="check-row @(LayerShown("extra") ? null : "muted")">
                                <input type="checkbox" checked="@LayerShown(item)" @onchange="() => ToggleLayerAsync(item)" />
                                <span>@Text[$"extra.{item}"]</span>
                            </label>
                        }
                        @if (!PieceExtra.Any())
                        {
                            <p class="caption">@Text["extra.none"]</p>
                        }
                        <hr />
                        <p class="overline">@Text["extra.yours"]</p>
                        @foreach (string layer in PieceLayers)
                        {
                            <label class="switch-row">
                                <span>@LayerName(layer)</span>
                                <input type="checkbox" role="switch" class="switch" checked="@LayerShown(layer)" @onchange="() => ToggleLayerAsync(layer)" />
                            </label>
                        }
                        <button class="btn quiet" @onclick="ToggleAllMarksAsync">@(AllMarksHidden ? Text["layers.showAll"] : Text["layers.hideAll"])</button>
                        @PopoverScope(LayerIds, "layers")
                    </div>
                    break;
                case Popover.Roll:
                    @* The piano roll's own settings (0018 section 10), from a long press on its action or its handle. *@
                    <div class="popover roll-popover" role="dialog" aria-label="@Text["settings.rollSettings"]" data-keeps-selection>
                        <p class="overline">@Text["bar.roll"]</p>
                        <SettingSwitch Id="roll.noteNames" Label="@Text["roll.noteNames"]" Prefix="pop" />
                        <SettingChoice Id="roll.colour" Label="@Text["roll.colourBy"]" Name="@(choice => Text[$"settings.rollColour.{choice}"])" Prefix="pop" />
                        @PopoverScope([], "roll")
                    </div>
                    break;
                case Popover.More:
                    @* The overflow: the piece's places and tools, the PDF, which notation is shown, Settings and the credits. *@
                    <div class="popover more-popover" role="dialog" aria-label="@Text["bar.more"]" data-keeps-selection>
                        <button class="btn quiet" aria-expanded="@(_contentsOpen ? "true" : "false")" @onclick="() => FromMoreAsync(Place.Contents, ToggleContentsAsync)"><Icon Name="bookmark" /> @Text["bar.contents"]</button>
                        <button class="btn quiet" @onclick="() => FromMore(Place.Layers, OpenLayers)"><Icon Name="info" /> @Text["extra.title"]</button>
                        <button class="btn quiet" aria-haspopup="dialog" @onclick="() => FromMore(Place.Dna, OpenDna)"><Icon Name="phrases" /> @Text["dna.title"]</button>
                        <button class="btn quiet" @onclick="AskAboutPiece"><Icon Name="insight" /> @Text["ask.aboutPiece"]</button>
                        @if (HasCheck)
                        {
                            <button class="btn quiet" aria-expanded="@(_checkOpen ? "true" : "false")" @onclick="() => FromMore(Place.Check, ToggleCheck)">
                                <Icon Name="check" /> @(OpenCheckBars.Count > 0 ? Text.Count("check.toReview", OpenCheckBars.Count) : Text["check.title"])
                            </button>
                        }
                        @if (_project is not null)
                        {
                            @* A performance compared with the piece (decision record 0022): added and worked with in its drawer. *@
                            <button class="btn quiet" aria-expanded="@(_performanceOpen ? "true" : "false")" @onclick="() => FromMore(Place.Performance, TogglePerformance)">
                                <Icon Name="mic" /> @Text["sources.title"]
                            </button>
                        }
                        @if (_scoreView is not null)
                        {
                            <button class="btn quiet" @onclick="ExportPdfAsync" disabled="@_scoreView.Exporting" title="@Text["score.pdfHint"]">
                                <Icon Name="export" /> @(_scoreView.Exporting ? Text["score.pdfMaking"] : Text["score.pdf"])
                            </button>
                        }
                        @* Notation (0018 "Where every current feature goes"): which notes the page shows, when there is a choice, and one line about them on request. *@
                        @{
                            var choices = ScoreChoices.ToList();
                            bool heardChoice = _heard && ShownScore?.Generated is not null;
                        }
                        @if (choices.Count > 1 || heardChoice)
                        {
                            <hr />
                            <p class="overline" id="more-notation">@Text["score.notation"]</p>
                        }
                        @if (choices.Count > 1)
                        {
                            <div class="seg" role="radiogroup" aria-label="@Text["workspace.scoreLabel"]">
                                @foreach ((ScoreChoice choice, string key) in choices)
                                {
                                    bool on = ShownChoice == choice;
                                    <button role="radio" class="@(on ? "on" : null)" aria-checked="@(on ? "true" : "false")" @onclick="() => _scoreChoice = choice">@Text[key]</button>
                                }
                            </div>
                        }
                        @if (heardChoice)
                        {
                            @* Notes heard in a recording (0016): written for reading, or as close to the playing as notation goes. *@
                            <div class="seg" role="radiogroup" aria-label="@Text["score.heardMode"]">
                                <button role="radio" class="@(_readable ? "on" : null)" aria-checked="@(_readable ? "true" : "false")" @onclick="() => SetReadable(true)">@Text["score.readable"]</button>
                                <button role="radio" class="@(_readable ? null : "on")" aria-checked="@(_readable ? "false" : "true")" @onclick="() => SetReadable(false)">@Text["score.asPlayed"]</button>
                            </div>
                        }
                        @if (ShownScore is { } shownScore)
                        {
                            <details class="about-notation">
                                <summary>@Text["score.aboutNotation"]</summary>
                                <p class="caption score-note">@ScoreNote(shownScore)</p>
                            </details>
                        }
                        <hr />
                        <button class="btn quiet" aria-haspopup="dialog" @onclick="() => FromMore(Place.Settings, () => OpenSettings())">@Text["settings.title"]</button>
                        <p class="caption"><a href="privacy">@Text["footer.privacy"]</a> · <a href="terms">@Text["footer.terms"]</a></p>
                        <p class="credit caption">
                            @Text["credit.piano"] <a href="https://archive.org/details/SalamanderGrandPianoV3">Salamander Grand Piano V3</a> @Text["credit.by"] Alexander Holm,
                            <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>, @Text["credit.shortened"]
                            @Text["credit.engraving"] <a href="https://www.verovio.org">Verovio</a> 6.3.0,
                            <a href="lib/verovio/COPYING.LESSER.txt">LGPL 3.0</a>, <a href="https://github.com/rism-digital/verovio/tree/version-6.3.0">@Text["credit.source"]</a>.
                        </p>
                    </div>
                    break;
            }

            @if (Player.Error is not null || _message is not null)
            {
                <div class="workspace-notice" role="alert">
                    <p class="error">@(Player.Error ?? _message)</p>
                    @if (Player.Error is null && _tip is not null)
                    {
                        <p class="meta">@_tip</p>
                    }
                </div>
            }

            @if (Focused && FocusCard is { } card)
            {
                @* Phrase focus (0018 section 4): the page dimmed behind the phrase lifted into a card; a tap on the page goes back to it. *@
                <div class="focus-layer" data-keeps-selection>
                    <button class="veil" aria-label="@Text["focus.back"]" tabindex="-1" @onclick="LeaveFocusAsync"></button>
                    <div class="focus-stage">
                        <section class="focus-card @(FocusVariations is { Count: > 0 } ? "has-chips" : null)" aria-label="@Text.Format("focus.cardLabel", FocusPosition)">
                            @if (FocusVariations is { Count: > 0 } variations)
                            {
                                @* The variations kept for the phrase, in a row in the card over the ossia: a chip picks the one heard and shown. *@
                                <div class="var-chips" role="group" aria-label="@Text["focus.variations"]">
                                    @foreach (Observation kept in variations)
                                    {
                                        bool heard = kept.Id == HeardKeptId;
                                        <button class="var-chip @(heard ? "on" : null)" aria-pressed="@(heard ? "true" : "false")" @onclick="() => ShowKeptVariationAsync(kept)">@kept.Name</button>
                                    }
                                </div>
                            }
                            <button class="step prev" aria-label="@Text["focus.previous"]" title="@Text["focus.previous"]" disabled="@(!CanStepBack)" @onclick="() => StepUnitAsync(-1)"><Icon Name="back" Size="IconSize.Large" /></button>
                            @if (_focusRoll)
                            {
                                @* The phrase as a roll laid across the card whole (testing item 12); the zoom and Fit float over it. *@
                                <div class="focus-roll" data-fill="true">
                                    <PianoRoll Notes="@(OwnEditNotes ?? _notes)" Score="_score" Meter="_meter" Motif="_selection" MotifPlaysAlone="_looping" Phrases="_phrases" FitsSelection="true"
                                               Kept="_keptIds" Variation="_variation" PlayRange="ShownRange" OriginalAudible="OriginalAudible" VariationAudible="VariationAudible" Highlight="_highlight?.Places"
                                               RangePicked="OnRangePickedAsync" Cleared="ClearSelectionAsync" PlayPausePressed="PlayPauseAsync"
                                               SelectionChanged="OnRollNotesChosen" Keys="RollKeys" Checks="ScoreChecks" CheckPicked="OnCheckPickedAsync" Point="_rollPoint" Editor="@(OwnEditor ?? RollEditor)" Ghosts="OwnEditGhosts" />
                                </div>
                            }
                            else
                            {
                                <PhraseCard Source="card" Sounding="@FocusSounding" />
                            }
                            <button class="step next" aria-label="@Text["focus.next"]" title="@Text["focus.next"]" disabled="@(!CanStepOn)" @onclick="() => StepUnitAsync(1)"><Icon Name="fwd" Size="IconSize.Large" /></button>
                        </section>
                    </div>
                </div>
            }

            @if (_rollOpen && !FocusShowsRoll)
            {
                @* The piano roll as a drawer (0018 section 4): it slides up over the score and leaves the selection as it is. *@
                <section class="drawer roll-drawer" aria-label="@Text["bar.roll"]" data-fill="true" data-keeps-selection data-menu-clear="auto">
                    <button class="grab" aria-label="@Text["drawer.resize"]" title="@Text["drawer.resize"]" data-long-press="roll" @onclick="ToggleRoll"></button>
                    <PianoRoll Heading="@RollHeading" Notes="@(OwnEditNotes ?? _notes)" Score="_score" Meter="_meter" Motif="_selection" MotifPlaysAlone="_looping" Phrases="_phrases"
                               Kept="_keptIds" Variation="_variation" PlayRange="ShownRange" OriginalAudible="OriginalAudible" VariationAudible="VariationAudible" Highlight="_highlight?.Places"
                               RangePicked="OnRangePickedAsync" Cleared="ClearSelectionAsync" PlayPausePressed="PlayPauseAsync"
                               SelectionChanged="OnRollNotesChosen" Keys="RollKeys" Checks="ScoreChecks" CheckPicked="OnCheckPickedAsync" Point="_rollPoint" Editor="@(OwnEditor ?? RollEditor)" Ghosts="OwnEditGhosts"
                               Expanded="ExpandRollAsync" />
                </section>
            }

            @if (_contentsOpen)
            {
                @ContentsDrawer
            }

            @if (_checkOpen && HasCheck)
            {
                @CheckDrawer
            }

            @if (_performanceOpen)
            {
                @PerformanceDrawer
            }

            @if (_draft is not null && !_compareOpen && !Focused)
            {
                @* While a draft is open, what the score shows (testing item 34): the player's notes, the version or the result. *@
                <div class="merge-show" role="group" aria-label="@Text["merge.show"]" data-keeps-selection>
                    <span class="caption">@Text["merge.show"]</span>
                    <div class="seg">
                        @foreach (string view in new[] { "mine", "version", "result" })
                        {
                            <button class="@view @(_mergeShow == view ? "on" : null)" aria-pressed="@(_mergeShow == view ? "true" : "false")" @onclick="() => ShowMergeView(view)">
                                <span class="dot @view"></span> @Text[$"merge.view.{view}"]
                            </button>
                        }
                    </div>
                    <button class="btn icon" aria-label="@Text.Format("merge.hearView", Text[$"merge.view.{_mergeShow}"])" title="@Text.Format("merge.hearView", Text[$"merge.view.{_mergeShow}"])"
                            @onclick="() => HearMergeAsync(_mergeShow)"><Icon Name="@(_mergeHearing == _mergeShow && Player.State != PlaybackState.Stopped ? "pause" : "play")" /></button>
                </div>
            }

            @if (_compareOpen && _draft is not null)
            {
                @CompareWindow
            }

            @if (_markerPick is { } pick && MarkerBar is { } marked && ShownPerformance is { } markedVersion)
            {
                @* A marker tapped (testing item 33): how the version differs, heard as it plays it, and the way into the draft; nothing is taken here. *@
                <div class="ask-pop-backdrop" @onclick="CloseMarker"></div>
                <div class="ask-pop marker-pop" role="dialog" aria-label="@Text.Format("merge.markerTitle", pick.Bar, markedVersion.Name)" style="@MarkerPlace" data-keeps-selection>
                    <p class="overline">@Text.Format("merge.markerTitle", pick.Bar, markedVersion.Name)</p>
                    <p>@marked.Marker(Words) · @PerformanceCounts(marked)</p>
                    <div class="row">
                        <button class="btn secondary compact" @onclick="HearMarkerVersionAsync"><Icon Name="play" /> @Text["merge.asInVersion"]</button>
                        <button class="btn primary compact" @onclick="OpenDraftAtMarkerAsync">@Text["merge.openDraft"]</button>
                    </div>
                </div>
            }

            @if (_mergeToast is { } toast)
            {
                <div class="merge-toast" role="status">
                    <span>@toast.Text</span>
                    @if (toast.Undo is not null)
                    {
                        <button class="btn quiet compact" @onclick="UndoToastAsync">@Text["merge.toastUndo"]</button>
                    }
                    <button class="btn icon" aria-label="@Text["bar.close"]" @onclick="CloseToast"><Icon Name="close" /></button>
                </div>
            }

            @if (_dna is { } dna && !_dnaAside)
            {
                <MotiffLab.Web.Dna.PieceDnaMap Dna="dna" Meter="_meter!" Title="@BarTitle" Words="Words" PlayingAt="@(_dnaPlaying && Player.State != PlaybackState.Stopped ? Player.Position : null)"
                                               BackLabel="@BackTo(Place.Dna)" Closed="LeaveDnaAsync" Hear="HearDnaAsync" ShowInScore="ShowDnaInScoreAsync" PlayMap="PlayDnaMapAsync" Ask="AskFromDna"
                                               ShowInInsights="ShowDnaInInsightsAsync" AddBookmarks="AddFormBookmarksAsync" Status="@_dnaStatus" />
            }

            @if (_askAt is not null)
            {
                @* Ask where it was pressed (testing item 23): a popover over the place, which stays as it was under it. *@
                <div class="ask-pop-backdrop" @onclick="CloseAskPopover"></div>
                <div class="ask-pop" role="dialog" aria-modal="false" aria-labelledby="ask-pop-title" style="@AskPlace" data-keeps-selection
                     @onkeydown="AskPopoverKey">
                    <AssistantPanel Popover="true" SelectionLabel="@AskSelectionLabel" WholePiece="@(_askWholePiece || _selection is null)" WholePieceChanged="SetAskWholePiece"
                                    Knows="AskKnows" Conversation="_conversation" Suggestions="AskSuggestions" Asked="Asked"
                                    OpenInInsights="AskInInsightsAsync" Closed="CloseAskPopover" />
                </div>
            }

            @if (_settingsOpen)
            {
                <SettingsSheet Section="@_settingsSection" PieceOverrides="_project?.SettingOverrides" ClearPieceOverrides="ClearPieceSettingsAsync" BackLabel="@BackTo(Place.Settings)" Back="GoBackAsync" Closed="() => CloseFromAsync(Place.Settings)" LayoutChosen="SetPagedAsync" />
            }

            @if (_insightsOpen)
            {
                @* The Insights sheet (0018 section 6) over the right of the score: one stream of facts, Try chips and ideas for the selection. *@
                <aside class="sheet inspector insights" aria-label="@Text["bar.insights"]" data-keeps-selection data-menu-clear="auto">
                @if (_asking)
                {
                    <AssistantPanel SelectionLabel="@AskSelectionLabel" WholePiece="@(_askWholePiece || _selection is null)" WholePieceChanged="SetAskWholePiece"
                                    Knows="AskKnows" Conversation="_conversation" Suggestions="AskSuggestions" Asked="Asked"
                                    BackLabel="@BackTo(Place.Ask)" Back="AskBackAsync" Closed="() => CloseFromAsync(Place.Ask)" />
                }
                else
                {
                    <div class="inspector-head">
                        @* Which one sounds while the two loop one after the other is shown, not announced at every pass. *@
                        @* One line: what the stream is about (the selection is announced in full by the status line below). A tap on the page clears it. *@
                        <p class="selection-text">@InsightsHeading<span aria-hidden="true">@SoundingText</span></p>
                        <button class="btn quiet icon" aria-label="@Text["drawer.close"]" title="@Text["drawer.close"]" @onclick="ToggleInsights"><Icon Name="close" /></button>
                        @if (_variation is not null && _selection is { NoteIds.Count: > 0 })
                        {
                            <CompareSwitch Choose="CompareAsync" OneAfterTheOther="ToggleOneAfterTheOtherAsync" />
                        }
                    </div>

                <InsightsStream Choose="ChooseFactAsync" HearScale="HearScaleAsync" ScaleHeard="_scaleHeard" Try="TryExperimentAsync" Keep="KeepExperimentAsync" Ask="MenuAsk" OpenIdea="ShowKeptVariationAsync"
                                Adjusting="_showOperations" AdjustingChanged="SetAdjusting" TrialCard="TrialCard" AdjustTools="ShapeTools" Ideas="IdeasList" />
                @if (_variation is not null && _selection is { NoteIds.Count: > 0 })
                {
                    <ComparePanel />
                }

                @* Until the roll takes them over (0018 section 4): the hands, corrections and a second file. The scan's check is in the Check drawer. *@
                <section class="more-tools" aria-label="@MoreToolsLabel">
                    <button class="section-toggle" aria-expanded="@(_showMoreTools ? "true" : "false")" @onclick="() => _showMoreTools = !_showMoreTools">
                        <span class="caret" aria-hidden="true">@(_showMoreTools ? "▾" : "▸")</span>
                        @MoreToolsLabel
                    </button>
                    @if (_showMoreTools)
                    {
                        @if (_selection is { NoteIds.Count: > 0 } chosen)
                            {
                                @* S1-E7, S1-E9: edit single notes of the variation; each edit is a step, and the Keep chips are checked again after it. *@
                                <div class="corrections" aria-label="@Text["edit.label"]">
                                    <button class="section-toggle" aria-expanded="@(_showHandEdits ? "true" : "false")" @onclick="() => _showHandEdits = !_showHandEdits">
                                        <span class="caret" aria-hidden="true">@(_showHandEdits ? "▾" : "▸")</span>
                                        @Text.Format("edit.toggle", Text.Count("edit.edits", HandEditCount))
                                    </button>
                                    @if (_showHandEdits)
                                    {
                                        <p class="meta">@Text["edit.hint"]</p>
                                        <table class="notes-table">
                                            <thead>
                                                <tr><th scope="col">@Text["notes.note"]</th><th scope="col">@Text["notes.where"]</th><th scope="col">@Text["notes.length"]</th><th scope="col">@Text["notes.velocity"]</th><th scope="col"></th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (Note note in HeardNotes(chosen))
                                                {
                                                    bool edited = note.Attribution.Provenance == Provenance.UserEdited;
                                                    <tr class="@(edited ? "edited" : null)">
                                                        <td>
                                                            <button title="@Text["notes.lower"]" @onclick="() => EditNoteAsync(note, pitch: -1)">▼</button>
                                                            @note.Pitch
                                                            <button title="@Text["notes.higher"]" @onclick="() => EditNoteAsync(note, pitch: 1)">▲</button>
                                                        </td>
                                                        <td>
                                                            <button title="@Text["notes.earlier"]" disabled="@(note.Span.Onset.Value - SixteenthTicks < chosen.Span.Onset.Value)" @onclick="() => EditNoteAsync(note, onset: -SixteenthTicks)">◀</button>
                                                            @NotePosition(note)
                                                            <button title="@Text["notes.later"]" @onclick="() => EditNoteAsync(note, onset: SixteenthTicks)">▶</button>
                                                        </td>
                                                        <td>
                                                            <button title="@Text["notes.shorter"]" disabled="@(note.Span.Duration <= SixteenthTicks)" @onclick="() => EditNoteAsync(note, length: -SixteenthTicks)">−</button>
                                                            @VariationFacts.Length(note.Span.Duration, Words)
                                                            <button title="@Text["notes.longer"]" @onclick="() => EditNoteAsync(note, length: SixteenthTicks)">+</button>
                                                        </td>
                                                        <td>
                                                            <button title="@Text["notes.softer"]" disabled="@(note.Velocity <= Note.MinVelocity)" @onclick="() => EditNoteAsync(note, velocity: -10)">−</button>
                                                            @note.Velocity
                                                            <button title="@Text["notes.louder"]" disabled="@(note.Velocity >= Note.MaxVelocity)" @onclick="() => EditNoteAsync(note, velocity: 10)">+</button>
                                                        </td>
                                                        <td>
                                                            <button title="@Text["notes.addAfterHint"]" @onclick="() => AddNoteAfterAsync(note)">@Text["notes.addAfter"]</button>
                                                            <button title="@Text["notes.removeFromVariationHint"]" @onclick="() => RemoveVariationNoteAsync(note)">@Text["notes.remove"]</button>
                                                            @if (edited)
                                                            {
                                                                <span class="kind">@Text["notes.editedByYou"]</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @if (_handEditNote is not null)
                                        {
                                            <p class="meta" aria-live="polite">@_handEditNote</p>
                                        }
                                    }
                                </div>
                            }

                            @* S1-I7: correct or remove imported notes. Every correction goes to the project's edit log; the imported notes stay as they were. *@
                            <div class="corrections" aria-label="@Text["correct.label"]">
                                <button class="section-toggle" aria-expanded="@(_showCorrections ? "true" : "false")" @onclick="() => _showCorrections = !_showCorrections">
                                    <span class="caret" aria-hidden="true">@(_showCorrections ? "▾" : "▸")</span>
                                    @Text.Format("correct.toggle", Text.Count("correct.corrected", _edits.EditedIds.Count()))
                                </button>
                                @if (_showCorrections)
                                {
                                    @NoteCorrections
                                }
                            </div>

                            @* Mute and solo the tracks of a piece with more than one (S1-W5). Another version of the piece is added in Sources (testing item 16). *@
                            @if (_tracks.Length > 1)
                            {
                                <div class="corrections" aria-label="@Text["tracks.label"]">
                                    <section class="row tracks">
                                        @foreach (int track in _tracks)
                                        {
                                            <span class="track">@Text.Format("second.track", track + 1)</span>
                                            <button class="@(Player.Muted.Contains(track) ? "on" : null)" @onclick="() => ToggleTrackAsync(track, solo: false)">@Text["second.mute"]</button>
                                            <button class="@(Player.Soloed.Contains(track) ? "on" : null)" @onclick="() => ToggleTrackAsync(track, solo: true)">@Text["second.solo"]</button>
                                        }
                                    </section>
                                </div>
                            }
                    }
                </section>
                }
                </aside>
            }

            @if (_playheadAway is { } awayAt && Player.State != PlaybackState.Stopped && _meter is not null)
            {
                @* The playhead out of sight while playing (testing item 4): one tap scrolls back to it and the score follows again. *@
                <button class="chip back-to-play @(PillShown ? "over-pill" : null)" data-keeps-selection @onclick="ReturnToPlayheadAsync">
                    <Icon Name="play" Size="IconSize.Small" /> @Text.Format("transport.backToPlay", _meter.BarAt(awayAt).Number)
                </button>
            }

            @if (PillShown)
            {
                @* The transport pill (0018 section 2, design/kit/ds.css .pill): with a selection or while playing. *@
                <div class="pill @(_pillMenu != PillMenu.None ? "settings-open" : null)" role="toolbar" aria-label="@Text["transport.label"]" data-keeps-selection data-long-press="pill">
                    <button class="play" @onclick="TogglePlayAsync" aria-label="@(Player.State == PlaybackState.Stopped ? Text["transport.play"] : Text["transport.pause"])">
                        <Icon Name="@(Player.State != PlaybackState.Stopped ? "pause" : "playf")" />
                    </button>
                    @if (_selection is { NoteIds.Count: > 0 })
                    {
                        <button class="it @(Looping ? "on" : null)" aria-pressed="@(Looping ? "true" : "false")" @onclick="ToggleLoopSelectionAsync"><Icon Name="loop" /> @Text["focus.loop"]</button>
                    }
                    @if (Focused)
                    {
                        <button class="it @(_leadIn ? "on" : null)" aria-pressed="@(_leadIn ? "true" : "false")" title="@Text["focus.leadInHint"]" @onclick="ToggleLeadInAsync"><Icon Name="leadin" /> @Text["focus.leadIn"]</button>
                    }
                    @* Tempo and Hands open their popovers over themselves, with the pointer at them (design/kit/ds.css .popover). *@
                    <span class="anchor">
                        <button class="it @(_pillMenu == PillMenu.Tempo ? "on" : null)" aria-expanded="@(_pillMenu == PillMenu.Tempo ? "true" : "false")" aria-label="@Text.Format("pill.tempoLabel", TempoPercent)"
                                @onclick="() => TogglePillMenu(PillMenu.Tempo)"><Icon Name="dial" /> <span class="mono">@TempoPercent%</span></button>
                        @if (_pillMenu == PillMenu.Tempo)
                        {
                            <div class="popover pill-popover" role="dialog" aria-label="@Text["transport.tempo"]">
                                <div class="seg" role="group" aria-label="@Text["transport.tempo"]">
                                    @foreach (int percent in s_tempoSteps)
                                    {
                                        <button class="@(TempoPercent == percent ? "on" : null)" aria-pressed="@(TempoPercent == percent ? "true" : "false")" @onclick="() => SetTempoPercentAsync(percent)">@percent%</button>
                                    }
                                </div>
                                <label class="tempo">
                                    <span class="visually-hidden">@Text["transport.tempo"]</span>
                                    <input type="range" min="@MinTempo" max="@MaxTempo" step="5" value="@TempoPercent" @oninput="SetTempoAsync" />
                                </label>
                            </div>
                        }
                    </span>
                    @if (_filters.Length > 1)
                    {
                        <span class="anchor">
                            <button class="it @(_filter != SelectionFilter.All ? "on" : null)" aria-expanded="@(_pillMenu == PillMenu.Hands ? "true" : "false")" aria-label="@Text["workspace.notesLabel"]"
                                    @onclick="() => TogglePillMenu(PillMenu.Hands)"><Icon Name="hands" /> @FilterLabel(_filter)</button>
                            @if (_pillMenu == PillMenu.Hands)
                            {
                                <div class="popover pill-popover" role="dialog" aria-label="@Text["workspace.notesLabel"]">
                                    @for (int i = 0; i < _filters.Length; i++)
                                    {
                                        int index = i;
                                        bool chosen = _filters[i] == _filter;
                                        <button class="btn quiet @(chosen ? "on" : null)" aria-pressed="@(chosen ? "true" : "false")" @onclick="() => ChooseFilterAsync(index)">@FilterLabel(_filters[i])</button>
                                    }
                                </div>
                            }
                        </span>
                    }
                    <span class="div" aria-hidden="true"></span>
                    @* Where playback is, for a screen reader: the score shows it with the notes being heard. *@
                    <span class="visually-hidden state" role="status">@StateText</span>
                    <span class="visually-hidden position" aria-live="off">@PositionText</span>
                    <button class="it @(Player.Metronome ? "on" : null)" aria-pressed="@(Player.Metronome ? "true" : "false")" @onclick="ToggleMetronomeAsync"><Icon Name="metronome" /> @Text["transport.metronome"]</button>
                    <button class="it @(Player.CountIn ? "on" : null)" aria-pressed="@(Player.CountIn ? "true" : "false")" title="@Text["transport.countInHint"]" @onclick="ToggleCountInAsync"><Icon Name="count" /> @Text["transport.countIn"]</button>
                    @if (_pillMenu == PillMenu.Settings)
                    {
                        @* The pill's own settings (0018 section 10), from a long press on it: over the pill's middle. *@
                        <div class="popover pill-popover" role="dialog" aria-label="@Text["settings.pillSettings"]">
                            <SettingSwitch Id="guidance.transportPill" Label="@Text["settings.pillWithSelection"]" On="selection" Off="playing" Hint="@Text["settings.pillWithSelectionHint"]" Prefix="pop" />
                            @PopoverScope([], "guidance")
                        </div>
                    }
                </div>
            }

            @* The selection in words for screen readers, wherever the sheet is (WCAG 4.1.3), and what the last change to the marks or bookmarks did. *@
            <p class="visually-hidden selection-status" aria-live="polite">@SelectionText</p>
            <p class="visually-hidden marks-status" aria-live="polite">@_marksStatus</p>
        }
    </main>
</CascadingValue>

@code {
    /// <summary>
    /// The contextual menu's items (0018 section 3; design/kit/ds.css .menu): Loop, Focus and Bookmark (section 5), then the piano
    /// roll and Insights, then the overflow with Ask and the phrase edits that apply. Note and Highlight join it with annotations. While a
    /// new bookmark is being made, the menu holds its card instead.
    /// </summary>
    /// <summary>
    /// The foot of an element's popover (0018 section 10): This piece · Everywhere where its settings can be the
    /// piece's own, and the way to the same rows in the Settings sheet.
    /// </summary>
    private RenderFragment PopoverScope(IReadOnlyList<string> ids, string section) => @<div class="scope">
        @if (ids.Count > 0 && _project is not null)
        {
            bool piece = PieceScoped(ids);
            <div class="seg" role="radiogroup" aria-label="@Text["settings.scope"]">
                <button role="radio" class="@(piece ? "on" : null)" aria-checked="@(piece ? "true" : "false")" @onclick="() => SetScopeAsync(ids, true)">@Text["settings.scopePiece"]</button>
                <button role="radio" class="@(piece ? null : "on")" aria-checked="@(piece ? "false" : "true")" @onclick="() => SetScopeAsync(ids, false)">@Text["settings.scopeEverywhere"]</button>
            </div>
        }
        <button class="btn quiet all-settings" aria-haspopup="dialog" @onclick="() => OpenSettings(section)">@Text["settings.all"]</button>
    </div>;

    private RenderFragment SelectionMenu => @<div class="menu">
        @if (_noteDraft is { } note)
        {
            @NoteCard(note)
        }
        else if (_bookmarkDraft is { Id: null } draft)
        {
            @BookmarkCard(draft)
        }
        else
        {
            @* Each item names itself in aria-label, so its word can give way to the icon alone in a narrow window (portrait, Split View). *@
            <button class="it @(Looping ? "on" : null)" aria-pressed="@(Looping ? "true" : "false")" aria-label="@Text["focus.loop"]" @onclick="ToggleLoopSelectionAsync"><Icon Name="loop" /><span class="lbl">@Text["focus.loop"]</span></button>
            <button class="it" aria-label="@Text["focus.enter"]" title="@Text["focus.enterHint"]" @onclick="MenuFocus"><Icon Name="search" /><span class="lbl">@Text["focus.enter"]</span></button>
            <button class="it" aria-label="@Text["menu.note"]" @onclick="StartNote"><Icon Name="note" /><span class="lbl">@Text["menu.note"]</span></button>
            <button class="it" aria-label="@Text["menu.bookmark"]" title="B" @onclick="StartBookmark"><Icon Name="bookmark" /><span class="lbl">@Text["menu.bookmark"]</span></button>
            <span class="div" aria-hidden="true"></span>
            <button class="it @(_rollOpen ? "on" : null)" aria-pressed="@(_rollOpen ? "true" : "false")" aria-label="@Text["bar.roll"]" @onclick="MenuRoll"><Icon Name="roll" /><span class="lbl">@Text["menu.roll"]</span></button>
            <button class="it @(_insightsOpen && !_asking ? "on" : null)" aria-pressed="@(_insightsOpen && !_asking ? "true" : "false")" aria-label="@Text["bar.insights"]" @onclick="MenuInsights"><Icon Name="insight" /><span class="lbl">@Text["bar.insights"]</span></button>
            @* The overflow: Ask (it opens the same sheet as Insights), Highlight always, and the phrase edits that apply. *@
            @if (_selection is not null)
            {
                <span class="div" aria-hidden="true"></span>
                <button class="it icon @(MenuMoreOpen ? "on" : null)" aria-expanded="@(MenuMoreOpen ? "true" : "false")" aria-label="@Text["menu.more"]" title="@Text["menu.more"]"
                        @onclick="ToggleMenuMore"><Icon Name="more" /></button>
                @if (MenuMoreOpen)
                {
                    <div class="menu-more" role="group" aria-label="@Text["menu.more"]">
                        <button class="it ask @(AskOpen ? "on" : null)" aria-pressed="@(AskOpen ? "true" : "false")" title="?" @onclick="AskHere">@Text["ask.menu"]</button>
                        <div class="highlight-row" role="group" aria-label="@Text["menu.highlight"]">
                            <span class="caption"><Icon Name="highlight" Size="IconSize.Small" /> @Text["menu.highlight"]</span>
                            @foreach (InkColour colour in s_highlightInks)
                            {
                                bool on = SelectedHighlight?.Colour == colour;
                                <button class="swatch ink-@colour.ToString().ToLowerInvariant() @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")"
                                        aria-label="@Text.Format("menu.highlightIn", InkName(colour))" title="@InkName(colour)" @onclick="() => HighlightAsync(colour)"><span aria-hidden="true"></span></button>
                            }
                        </div>
                        @if (SelectedHighlight is { } highlighted)
                        {
                            <button class="it" @onclick="() => RemoveHighlightAsync(highlighted.Id)">@Text["menu.removeHighlight"]</button>
                        }
                        @if (CanMakeUnit)
                        {
                            <button class="it" @onclick="MakeUnitAsync">@MakeLabel</button>
                        }
                        @if (CanMerge)
                        {
                            <button class="it" @onclick="MergeWithNextAsync">@MergeLabel</button>
                        }
                        @if (SplitPoint is not null)
                        {
                            <button class="it" title="@Text.Format("menu.splitHint", SplitBar)" @onclick="SplitHereAsync">@Text["menu.split"]</button>
                        }
                    </div>
                }
            }
        }
    </div>;

    /// <summary>
    /// The bookmark card (0018 section 5): the title, pre-filled with the bars, the category chips in their inks, and
    /// Done; over the selection for a new bookmark, in the drawer for one being changed.
    /// </summary>
    private RenderFragment BookmarkCard(BookmarkDraft draft) => @<div class="bookmark-card" role="group" aria-label="@(draft.Id is null ? Text["bookmark.new"] : Text["bookmark.edit"])">
        <label class="field">
            <span class="overline">@Text["bookmark.title"]</span>
            <input type="text" value="@draft.Title" @oninput="SetDraftTitle" @onkeydown="OnDraftKeyAsync" @ref="_draftTitle" />
        </label>
        <div class="cats" role="radiogroup" aria-label="@Text["bookmark.category"]">
            @foreach (BookmarkCategory category in Categories)
            {
                bool chosen = category.Id == draft.CategoryId;
                <button role="radio" class="chip cat-chip @InkClass(category.Ink) @(chosen ? "on" : null)" aria-checked="@(chosen ? "true" : "false")"
                        @onclick="() => SetDraftCategory(category.Id)"><span class="d" aria-hidden="true"></span>@CategoryName(category)</button>
            }
        </div>
        <div class="row">
            @if (draft.Id is { } id)
            {
                <button class="btn quiet danger" @onclick="() => DeleteBookmarkAsync(id)"><Icon Name="trash" /> @Text["bookmark.delete"]</button>
            }
            <span class="sp"></span>
            <button class="btn quiet" @onclick="CancelBookmark">@Text["bookmark.cancel"]</button>
            <button class="btn primary" @onclick="SaveBookmarkAsync">@Text["bookmark.done"]</button>
        </div>
    </div>;

    /// <summary>The note card over the selection: the player's words about the bars, Done, and Delete for a note already written.</summary>
    private RenderFragment NoteCard(NoteDraft draft) => @<div class="bookmark-card note-card" role="group" aria-label="@(draft.Id is null ? Text["margin.new"] : Text.Format("margin.about", BarsOf(draft.Span)))">
        <label class="field">
            <span class="overline">@Text.Format("margin.about", BarsOf(draft.Span))</span>
            <textarea rows="3" value="@draft.Text" placeholder="@Text["margin.placeholder"]" @oninput="SetNoteText" @onkeydown="OnNoteKey" @ref="_noteText"></textarea>
        </label>
        <div class="row">
            @if (draft.Id is { } id)
            {
                <button class="btn quiet" @onclick="() => DeleteNoteAsync(id)"><Icon Name="trash" /> @Text["bookmark.delete"]</button>
            }
            <span class="sp"></span>
            <button class="btn quiet" @onclick="CancelNote">@Text["bookmark.cancel"]</button>
            <button class="btn primary" @onclick="SaveNoteAsync">@Text["bookmark.done"]</button>
        </div>
    </div>;

    /// <summary>
    /// The Contents drawer (0018 section 5) over the left of the page, a bottom sheet in portrait: the player's bookmarks
    /// by category, to search, sort, fold, go to, change or delete, and the pages with their phrases and bookmark ticks.
    /// </summary>
    /// <summary>"‹ More" at the top left of a place opened from another (testing item 20); nothing when it came from the bar.</summary>
    private RenderFragment BackChip(Place place) => __builder =>
    {
        if (BackTo(place) is { } label)
        {
            <button class="btn quiet back-to" aria-label="@Text.Format("nav.backTo", label)" @onclick="GoBackAsync"><Icon Name="back" Size="IconSize.Small" /> @label</button>
        }
    };

    /// <summary>
    /// The Contents (0018 section 5, testing item 21): one sheet read top to bottom, the pages, the detected structure, the
    /// bookmarks by category and the notes and marks; the chips at the top scroll to a section rather than replace the sheet.
    /// </summary>
    private RenderFragment ContentsDrawer => @<aside class="sheet left contents" aria-label="@Text["bar.contents"]" data-keeps-selection data-menu-clear="left">
        <div class="contents-head">
            @BackChip(Place.Contents)
            <p class="overline">@Text["bar.contents"]</p>
            <span class="sp"></span>
            <button class="btn quiet icon" aria-label="@Text["drawer.close"]" title="@Text["drawer.close"]" @onclick="() => CloseFromAsync(Place.Contents)"><Icon Name="close" /></button>
        </div>
        <nav class="contents-anchors" aria-label="@Text["contents.sections"]">
            <button class="chip" @onclick='() => ScrollContentsToAsync("contents-pages")'>@Text["contents.tabPages"]</button>
            @if (_sentences is { Sentences.Count: > 0 })
            {
                <button class="chip" @onclick='() => ScrollContentsToAsync("contents-structure")'>@Text["contents.structure"]</button>
            }
            <button class="chip" @onclick='() => ScrollContentsToAsync("contents-bookmarks")'>@Text["contents.bookmarks"]</button>
            <button class="chip" @onclick='() => ScrollContentsToAsync("contents-notes")'>@Text["contents.tabNotes"]</button>
        </nav>
        <div class="contents-scroll">
            <section id="contents-pages" class="contents-section" aria-labelledby="contents-pages-title">
                <h3 id="contents-pages-title" class="overline">@(_pageOutline.Count > 0 ? Text.Format("contents.category", Text["contents.tabPages"], _pageOutline.Count) : Text["contents.tabPages"])</h3>
                @if (_pageOutline.Count == 0)
                {
                    <p class="meta">@Text["contents.pagesStrip"]</p>
                }
                else
                {
                    <ol class="pages-strip">
                        @foreach (PageOutline sheet in _pageOutline)
                        {
                            <li>
                                <button class="page-thumb @(PageInView(sheet) ? "on" : null)" aria-label="@Text.Format("contents.pageLabel", sheet.Page)" aria-current="@(PageInView(sheet) ? "page" : null)"
                                        @onclick="() => ShowPageAsync(sheet.Page)">
                                    <span class="th"><img src="@sheet.Url" alt="" />
                                        <span class="ticks" aria-hidden="true">
                                            @foreach (Bookmark bookmark in BookmarksOn(sheet))
                                            {
                                                <span class="tick @InkClass(CategoryOf(bookmark).Ink)" title="@bookmark.Title"></span>
                                            }
                                        </span>
                                    </span>
                                    <span class="caption">@Text.Format("contents.page", sheet.Page)@(PhrasesOn(sheet) is { } phrases ? $" · {phrases}" : null)</span>
                                </button>
                            </li>
                        }
                    </ol>
                }
            </section>

            @if (_sentences is { Sentences.Count: > 0 } sentences)
            {
                @* The form as music-core detects it: a chip per sentence selects its bars; grey until added as Structure bookmarks. *@
                <section id="contents-structure" class="contents-section" aria-labelledby="contents-structure-title">
                    <h3 id="contents-structure-title" class="overline">@Text["contents.structureFound"]</h3>
                    <div class="sentences @(CanAddStructure ? "found" : null)">
                        @foreach (Sentence sentence in sentences.Sentences)
                        {
                            <button class="sent" title="@BarsOf(sentence.Span)" @onclick="() => SelectAsync(sentence.Span, null)">
                                @Text.Format("contents.sentence", sentence.Letter, sentence.FirstBar == sentence.LastBar ? $"{sentence.FirstBar}" : $"{sentence.FirstBar}–{sentence.LastBar}")
                            </button>
                        }
                    </div>
                    @if (CanAddStructure)
                    {
                        <button class="btn quiet" title="@Text["contents.addStructureHint"]" @onclick="AddStructureBookmarksAsync">@Text["contents.addStructure"]</button>
                    }
                </section>
            }

            <section id="contents-bookmarks" class="contents-section" aria-labelledby="contents-bookmarks-title">
                <h3 id="contents-bookmarks-title" class="overline">@(Bookmarks.Count > 0 ? Text.Format("contents.category", Text["contents.bookmarks"], Bookmarks.Count) : Text["contents.bookmarks"])</h3>
                @if (Bookmarks.Count > ContentsToolsFrom)
                {
                    @* Search and order once there are enough bookmarks to need them. *@
                    <div class="contents-tools">
                        <input type="search" class="search" placeholder="@Text["contents.search"]" aria-label="@Text["contents.search"]" value="@_contentsSearch" @oninput="SetContentsSearch" />
                        <div class="seg" role="radiogroup" aria-label="@Text["contents.order"]">
                            <button role="radio" class="@(_contentsMyOrder ? null : "on")" aria-checked="@(_contentsMyOrder ? "false" : "true")" @onclick="() => _contentsMyOrder = false">@Text["contents.scoreOrder"]</button>
                            <button role="radio" class="@(_contentsMyOrder ? "on" : null)" aria-checked="@(_contentsMyOrder ? "true" : "false")" @onclick="() => _contentsMyOrder = true">@Text["contents.myOrder"]</button>
                        </div>
                    </div>
                }
                @if (Bookmarks.Count == 0)
                {
                    <p class="meta">@Text["contents.empty"]</p>
                }
                else if (ContentsGroups is { Count: 0 })
                {
                    <p class="meta">@Text["contents.noMatch"]</p>
                }
                else
                {
                    @foreach ((BookmarkCategory category, IReadOnlyList<Bookmark> entries) in ContentsGroups)
                    {
                        bool folded = _foldedCategories.Contains(category.Id);
                        <section class="contents-group" aria-label="@CategoryName(category)">
                            <button class="cat @InkClass(category.Ink)" aria-expanded="@(folded ? "false" : "true")" title="@Text.Format("contents.fold", CategoryName(category))"
                                    @onclick="() => ToggleFold(category.Id)">
                                <span class="d" aria-hidden="true"></span>@Text.Format("contents.category", CategoryName(category), entries.Count)
                            </button>
                            @if (!folded)
                            {
                                <ul class="entries">
                                    @foreach (Bookmark bookmark in entries)
                                    {
                                        <li>
                                            @if (_bookmarkDraft is { Id: { } editing } draft && editing == bookmark.Id)
                                            {
                                                @BookmarkCard(draft)
                                            }
                                            else
                                            {
                                                bool on = IsShown(bookmark);
                                                <div class="entry @(on ? "on" : null)">
                                                    <button class="go" aria-current="@(on ? "true" : null)" title="@Text["contents.entryHint"]" @onclick="() => GoToBookmarkAsync(bookmark)">
                                                        <span class="t">@bookmark.Title</span>
                                                        <span class="c">@BarsOf(bookmark.Span)@(IdeasIn(bookmark) is { } ideas ? $" · {ideas}" : null)</span>
                                                    </button>
                                                    <button class="btn quiet icon" aria-label="@Text.Format("bookmark.editOne", bookmark.Title)" title="@Text["bookmark.edit"]" @onclick="() => EditBookmark(bookmark)"><Icon Name="pen" /></button>
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                }
            </section>

            <section id="contents-notes" class="contents-section" aria-labelledby="contents-notes-title">
                <h3 id="contents-notes-title" class="overline">@Text["contents.notesHead"]</h3>
                @NotesTab
            </section>
        </div>
    </aside>;

    /// <summary>The Contents drawer's Notes tab: the margin notes, the highlights by colour and the bars with ink; a tap goes there.</summary>
    private RenderFragment NotesTab => @<div class="notes-tab">
        @if (!HasMarks)
        {
            <p class="meta contents-empty">@Text["contents.notesEmpty"]</p>
        }
        @if (CurrentMarks.Notes.Count > 0)
        {
            <p class="cat ink-amber"><span class="d" aria-hidden="true"></span>@Text.Format("contents.category", Text["contents.marginNotes"], CurrentMarks.Notes.Count)</p>
            <ul class="entries">
                @foreach (MarginNote note in NotesInOrder)
                {
                    <li class="entry">
                        <button class="go" @onclick="() => OpenNoteAsync(note.Id)">
                            <span class="t"><span class="num" aria-hidden="true">@NumberOf(note)</span> @FirstWords(note.Text, 80)</span>
                            <span class="c">@BarsOf(note.Span)</span>
                        </button>
                    </li>
                }
            </ul>
        }
        @if (CurrentMarks.Highlights.Count > 0)
        {
            <p class="cat"><span class="d ink-amber" aria-hidden="true"></span>@Text.Format("contents.category", Text["contents.highlights"], CurrentMarks.Highlights.Count)</p>
            <div class="swatches" role="group" aria-label="@Text["contents.highlightFilter"]">
                @foreach (InkColour colour in s_highlightInks.Where(colour => CurrentMarks.Highlights.Any(highlight => highlight.Colour == colour)))
                {
                    bool on = _highlightFilter == colour;
                    <button class="swatch ink-@colour.ToString().ToLowerInvariant() @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" aria-label="@InkName(colour)" title="@InkName(colour)"
                            @onclick="() => FilterHighlights(colour)"><span aria-hidden="true"></span></button>
                }
            </div>
            <ul class="entries">
                @foreach (Highlight highlight in HighlightsListed)
                {
                    <li class="entry">
                        <button class="go" @onclick="() => GoToMarkAsync(highlight.Span)">
                            <span class="t"><span class="d ink-@highlight.Colour.ToString().ToLowerInvariant()" aria-hidden="true"></span> @Text.Format("contents.highlightEntry", InkName(highlight.Colour))</span>
                            <span class="c">@BarsOf(highlight.Span)</span>
                        </button>
                    </li>
                }
            </ul>
        }
        @if (InkRuns is { Count: > 0 } runs)
        {
            <p class="cat ink-graphite"><span class="d" aria-hidden="true"></span>@Text.Format("contents.category", Text["contents.ink"], CurrentMarks.Ink.Count)</p>
            <ul class="entries">
                @foreach (TickSpan run in runs)
                {
                    <li class="entry">
                        <button class="go" @onclick="() => GoToMarkAsync(run)">
                            <span class="t">@Text.Format("contents.inkEntry", BarsOf(run))</span>
                        </button>
                    </li>
                }
            </ul>
        }
    </div>;

    /// <summary>The card of the experiment being tried, which the Insights stream shows under its Try chip.</summary>
    /// <summary>
    /// Correct the imported notes (S1-I7): the selected notes, each one a step in the project's edit log, and the notes taken
    /// out, to put back. In the Insights sheet's More tools for any piece, and under Fix notes in the Check drawer.
    /// </summary>
    private RenderFragment NoteCorrections => @<text>
    <p class="meta">@Text["correct.hint"]</p>
    <div class="row">
        <button @onclick="UndoCorrectionAsync" disabled="@_edits.IsEmpty" title="@Text["correct.undoHint"]">@Text["correct.undo"]</button>
        <span class="meta">@Text.Count("correct.inLog", _edits.Edits.Count)</span>
    </div>
    @if (_selection is { NoteIds.Count: > 0 } picked)
    {
        <table class="notes-table">
            <thead>
                <tr><th scope="col">@Text["notes.note"]</th><th scope="col">@Text["notes.where"]</th><th scope="col">@Text["notes.length"]</th><th scope="col">@Text["notes.velocity"]</th><th scope="col"></th></tr>
            </thead>
            <tbody>
                @foreach (Note note in CorrectableNotes(picked))
                {
                    bool edited = note.Attribution.Provenance == Provenance.UserEdited;
                    <tr class="@(edited ? "edited" : null)">
                        <td>
                            <button title="@Text["notes.lower"]" @onclick="() => CorrectAsync(note, pitch: -1)">▼</button>
                            @note.Pitch
                            <button title="@Text["notes.higher"]" @onclick="() => CorrectAsync(note, pitch: 1)">▲</button>
                        </td>
                        <td>
                            <button title="@Text["notes.earlier"]" disabled="@(note.Span.Onset.Value < SixteenthTicks)" @onclick="() => CorrectAsync(note, onset: -SixteenthTicks)">◀</button>
                            @NotePosition(note)
                            <button title="@Text["notes.later"]" @onclick="() => CorrectAsync(note, onset: SixteenthTicks)">▶</button>
                        </td>
                        <td>
                            <button title="@Text["notes.shorter"]" disabled="@(note.Span.Duration <= SixteenthTicks)" @onclick="() => CorrectAsync(note, length: -SixteenthTicks)">−</button>
                            @VariationFacts.Length(note.Span.Duration, Words)
                            <button title="@Text["notes.longer"]" @onclick="() => CorrectAsync(note, length: SixteenthTicks)">+</button>
                        </td>
                        <td>
                            <button title="@Text["notes.softer"]" disabled="@(note.Velocity <= Note.MinVelocity)" @onclick="() => CorrectAsync(note, velocity: -10)">−</button>
                            @note.Velocity
                            <button title="@Text["notes.louder"]" disabled="@(note.Velocity >= Note.MaxVelocity)" @onclick="() => CorrectAsync(note, velocity: 10)">+</button>
                        </td>
                        <td>
                            <button title="@Text["notes.removeFromPieceHint"]" @onclick="() => RemoveNoteAsync(note)">@Text["notes.remove"]</button>
                            @if (edited)
                            {
                                <button title="@Text["notes.revertHint"]" @onclick="() => RevertNoteAsync(note)">@Text["notes.revert"]</button>
                                <span class="kind">@Text["notes.editedByYou"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="meta">@Text["correct.selectFirst"]</p>
    }
    @if (RemovedNotes.Count > 0)
    {
        <p class="meta">@Text.Format("correct.removed", string.Join(", ", RemovedNotes.Select(note => Text.Format("correct.noteAt", note.Pitch, NotePosition(note)))))</p>
        <div class="row">
            @foreach (Note note in RemovedNotes)
            {
                <button @onclick="() => RevertNoteAsync(note)">@Text.Format("correct.revertAt", note.Pitch, NotePosition(note))</button>
            }
        </div>
    }
</text>;

    /// <summary>
    /// The Check drawer (0018 section 9): where the doubts come from, the bars still to check with their reasons and Show,
    /// Fix notes and Looks right, then the bars resolved, to check again. Over the right of the page, as Insights.
    /// </summary>
    private RenderFragment CheckDrawer => @<aside class="sheet inspector check-sheet" aria-labelledby="check-title" data-keeps-selection data-menu-clear="auto">
    <header class="check-head">
        <div>
            @BackChip(Place.Check)
            <p class="overline">@Text["check.title"]</p>
            <h2 id="check-title">@(OpenCheckBars.Count > 0 ? Text.Count("check.toReview", OpenCheckBars.Count) : HasCheckFlags ? Text["check.allDone"] : Text["transcribe.barsHeading"])</h2>
        </div>
        <button class="btn icon" aria-label="@Text["check.close"]" title="@Text["check.close"]" @onclick="() => CloseFromAsync(Place.Check)"><Icon Name="close" /></button>
    </header>
    <p class="caption">@CheckSourceLine @Text[_project?.Scan is not null ? "check.howScan" : "check.howRecording"]</p>
    @if (_project is { Transcription: { } heard } project)
    {
        @* The bars and tempo worked out from the notes (0016), in the drawer's head for a transcription (0018 section 9). *@
        bool canChange = project.CanChangeBars;
        <section class="check-bars" aria-labelledby="check-bars-title">
            <h3 id="check-bars-title" class="overline">@Text["transcribe.barsHeading"]</h3>
            <label class="switch-line">
                <input type="checkbox" role="switch" class="switch" checked="@(heard.Bars is not null)" disabled="@(!canChange)" @onchange="ToggleBarsAsync" />
                <span>@Text["transcribe.barsOn"]</span>
            </label>
            @if (heard.Bars is { } bars)
            {
                <p class="check-bar">@Text.Format("check.barsLine", bars.Signature, bars.QuarterNotesPerMinute)</p>
                @if (bars.FollowsPlaying)
                {
                    <p class="caption">@Text["transcribe.barsFollow"]</p>
                }
                @if (bars.HasPickup)
                {
                    <p class="caption">@Text["transcribe.barsPickup"]</p>
                }
                <div class="row">
                    <label class="field">
                        <span class="caption">@Text["transcribe.signature"]</span>
                        <select value="@bars.Signature.ToString()" disabled="@(!canChange)" @onchange="ChangeSignatureAsync">
                            @foreach (TimeSignature signature in BarGrid.Signatures)
                            {
                                <option value="@signature.ToString()">@signature</option>
                            }
                        </select>
                    </label>
                </div>
                <div class="row">
                    <button class="btn secondary compact" disabled="@(!canChange || !CanChangeTempo(bars, faster: true))" @onclick="() => ChangeTempoAsync(faster: true)">@Text["transcribe.faster"]</button>
                    <button class="btn secondary compact" disabled="@(!canChange || !CanChangeTempo(bars, faster: false))" @onclick="() => ChangeTempoAsync(faster: false)">@Text["transcribe.slower"]</button>
                </div>
                <div class="row">
                    <button class="btn secondary compact" disabled="@(!canChange)" @onclick="() => ShiftBarsAsync(-1)">@Text["transcribe.earlier"]</button>
                    <button class="btn secondary compact" disabled="@(!canChange)" @onclick="() => ShiftBarsAsync(1)">@Text["transcribe.later"]</button>
                </div>
            }
            else
            {
                <p class="caption">@Text["transcribe.barsOff"]</p>
            }
            <p class="caption">@Text[canChange ? "check.barsHow" : "check.barsKept"]</p>
        </section>
    }
    @if (OpenCheckBars.Count == 0 && HasCheckFlags)
    {
        <p class="caption">@Text["check.allDoneHint"]</p>
    }
    <ul class="check-list">
        @foreach (IGrouping<int, CheckFlag> bar in OpenCheckBars)
        {
            bool fixing = _checkFixing == bar.Key;
            bool selected = SelectedCheckBar == bar.Key;
            <li class="check-entry @(selected ? "on" : null)">
                <p class="check-bar"><span class="flag-square" aria-hidden="true">?</span> <strong>@Text.Format("check.bar", bar.Key)</strong> <span class="tag warn">@ReasonNames(bar)</span></p>
                @foreach (CheckReason reason in bar.Select(flag => flag.Reason).Distinct())
                {
                    <p class="caption">@CheckFlag.Explain(reason, Words)</p>
                }
                <div class="row">
                    <button class="btn secondary compact" @onclick="() => ShowCheckBarAsync(bar.Key)">@Text["scanCheck.show"]</button>
                    <button class="btn quiet compact @(fixing ? "on" : null)" aria-expanded="@(fixing ? "true" : "false")" @onclick="() => FixCheckBarAsync(bar.Key)">@Text["check.fix"]</button>
                    <button class="btn primary compact" @onclick="() => ResolveCheckAsync(bar.Key, true)">@Text["scanCheck.looksRight"]</button>
                </div>
                @if (fixing)
                {
                    <div class="check-fix corrections" aria-label="@Text["correct.label"]">
                        @NoteCorrections
                    </div>
                }
            </li>
        }
    </ul>
    @if (UncheckedSelectedBars is { Count: > 0 } others)
    {
        @* A scan's other bars: confirmed once the player compared them with the page (0011). *@
        <button class="btn quiet" @onclick="() => ConfirmScanBarsAsync(others)">@(others.Count == 1 ? Text.Format("scanCheck.barRight", others[0]) : Text.Format("scanCheck.barsRight", others[0], others[^1]))</button>
    }
    @if (ResolvedCheckBars.Count > 0)
    {
        <p class="overline">@Text["check.resolvedHeading"]</p>
        <ul class="check-list resolved">
            @foreach (IGrouping<int, CheckFlag> bar in ResolvedCheckBars)
            {
                <li class="check-entry">
                    <p class="check-bar"><Icon Name="check" /> <strong>@Text.Format("check.bar", bar.Key)</strong> <span class="caption">@ReasonNames(bar)</span></p>
                    <div class="row">
                        <button class="btn quiet compact" @onclick="() => ShowCheckBarAsync(bar.Key)">@Text["scanCheck.show"]</button>
                        <button class="btn quiet compact" title="@Text["scanCheck.againHint"]" @onclick="() => ResolveCheckAsync(bar.Key, false)">@Text["scanCheck.again"]</button>
                    </div>
                </li>
            }
        </ul>
    }
</aside>;

    /// <summary>
    /// The Sources sheet (decision record 0022, sections 1, 4 and 5; testing item 16): the piece's base, the PDF kept inside
    /// it and the other versions, a row for each, what the player's version holds beyond the base, one Add a source, and
    /// after a version is added its four next steps. For the version shown: how well it lines up, the bars it has otherwise
    /// with Show, Take into the score and Not a difference, the bars taken with Restore the print, and the bars dismissed to
    /// show again. Over the right of the page.
    /// </summary>
    private RenderFragment PerformanceDrawer => @<aside class="sheet inspector check-sheet perf-sheet" aria-labelledby="perf-title" data-keeps-selection data-menu-clear="auto">
    @if (PageVersion is { } page && ShownPerformance?.Id == page.Id)
    {
        @VersionPage(page)
    }
    else
    {
        <header class="check-head">
            <div>
                @BackChip(Place.Performance)
                <p class="overline">@Text["sources.title"]</p>
                <h2 id="perf-title">@Text["sources.mine"]</h2>
            </div>
            <button class="btn icon" aria-label="@Text["performance.close"]" title="@Text["performance.close"]" @onclick="() => CloseFromAsync(Place.Performance)"><Icon Name="close" /></button>
        </header>
        @if (_project is { } piece && Sources is { } sources)
        {
            <p class="caption sources-summary">@sources.Summary(Words)</p>
            <ul class="source-list" aria-label="@Text["sources.list"]">
                <li class="source-row">
                    <Icon Name="@BaseIcon" />
                    <span class="source-text"><strong>@Text["sources.base"]</strong><span class="caption">@sources.BaseName(Words)</span></span>
                </li>
                @if (piece.Document is not null)
                {
                    <li class="source-row">
                        <Icon Name="pages" />
                        <span class="source-text"><strong>@piece.DocumentFileName</strong><span class="caption">@Text["sources.pdfInside"]</span></span>
                        <span class="source-actions">
                            <button class="btn quiet compact" @onclick="ShowPdfAsync">@Text["sources.openPdf"]</button>
                            <button class="btn quiet compact" aria-expanded="@(_readingDocument ? "true" : "false")" @onclick="ToggleReadDocument">
                                @Text["sources.readPdf"] @if (Scans.IsHosted) { <span class="tag pro">Pro</span> }
                            </button>
                        </span>
                    </li>
                }
                @foreach (SavedPerformance kept in piece.Performances)
                {
                    <li>
                        @* A version's row opens its page (testing item 32): the overview, the draft and what was merged. *@
                        <button class="source-row version" @onclick="() => OpenVersionPage(kept.Id)">
                            <Icon Name="@VersionIcon(kept)" />
                            <span class="source-text">
                                <strong>@kept.Name</strong>
                                <span class="caption">@VersionRole(kept)@if (kept.Merge is { AppliedAt: not null }) { @(" · " + Text.Count("merge.takenShort", kept.Taken.Count)) }</span>
                            </span>
                            <Icon Name="fwd" />
                        </button>
                    </li>
                }
            </ul>
            @if (_readingDocument && piece.Document is { } pdf)
            {
                <MotiffLab.Web.Pdf.RecognisePanel Inline Document="pdf" FileName="@piece.DocumentFileName" Heading="@Text["sources.readPdf"]" Intro="@Text["sources.readPdfIntro"]"
                                                  Keeps="@Text["sources.readPdfKeeps"]" Read="ReadDocumentVersionAsync" />
            }
        }
        @if (_performanceStatus is { } status)
        {
            <p class="caption" role="status">@status</p>
        }
        <button class="btn primary source-add" aria-expanded="@(_addingSource ? "true" : "false")" @onclick="ToggleAddSource"><Icon Name="plus" /> @Text["sources.add"]</button>
        @if (_addingSource)
        {
            <section class="source-choices" aria-label="@Text["sources.add"]">
                <p class="caption">@Text["performance.how"]</p>
                <label class="file btn secondary">
                    <Icon Name="file" /> @Text["performance.addMidi"]
                    <InputFile OnChange="AddPerformanceAsync" accept="@VersionFile.AcceptedExtensions" />
                </label>
                <label class="file btn secondary">
                    <Icon Name="pages" /> @Text[_project?.Document is null ? "sources.addPdf" : "sources.replacePdf"]
                    <InputFile OnChange="AddDocumentAsync" accept="@MotiffLab.MusicCore.Import.PdfDocument.Extension" />
                </label>
                <p class="caption">@Text["sources.pdfHow"]</p>
                <MotiffLab.Web.Import.RecordingVersion Heard="AddRecordingVersionAsync" />
            </section>
        }
    }
</aside>;

    /// <summary>
    /// A version's page in Sources (testing items 32 and 34): ‹ Sources back to the list; the overview with its verdict, its
    /// strip of bars and three choices that open the draft; the draft itself; what was merged, to open again or undo; and,
    /// under a divider, its name and Remove, which the toast can undo.
    /// </summary>
    private RenderFragment VersionPage(SavedPerformance version) => @<text>
    <header class="check-head">
        <div>
            <button class="btn quiet back-to" aria-label="@Text.Format("nav.backTo", Text["sources.title"])" @onclick="CloseVersionPage"><Icon Name="back" Size="IconSize.Small" /> @Text["sources.title"]</button>
            <p class="overline">@VersionRole(version)</p>
            <h2 id="perf-title">@version.Name</h2>
        </div>
        <button class="btn icon" aria-label="@Text["performance.close"]" title="@Text["performance.close"]" @onclick="() => CloseFromAsync(Place.Performance)"><Icon Name="close" /></button>
    </header>
    @if (ShownComparison is { } comparison)
    {
        @if (_draft is null)
        {
            @if (MergedLine(version) is { } merged)
            {
                <section class="merge-applied" aria-label="@merged">
                    <p><Icon Name="check" /> @merged</p>
                    <div class="row">
                        <button class="btn secondary compact" @onclick="ReopenDraftAsync">@Text["merge.reopen"]</button>
                        <button class="btn quiet compact" @onclick="UndoMergeAsync"><Icon Name="undo" /> @Text["merge.undoMerge"]</button>
                    </div>
                </section>
            }
            else if (version.Merge is { AppliedAt: null, Decisions.Count: > 0 })
            {
                <section class="merge-applied undone" aria-label="@Text["merge.keptChoices"]">
                    <p>@Text["merge.keptChoices"]</p>
                    <div class="row">
                        <button class="btn secondary compact" @onclick="ReopenDraftAsync">@Text["merge.reopen"]</button>
                    </div>
                </section>
            }
            <section class="merge-overview" aria-label="@Text["merge.overview"]">
                <p class="overline">@Text["merge.overview"]</p>
                <p class="merge-verdict">@PageVerdict(version)</p>
                @BarStrip(comparison)
                @if (PageDifferingCount > 0)
                {
                    <div class="merge-choices">
                        <button class="btn secondary" @onclick="() => StartDraftAsync(MergeStart.Mine)"><span class="swatch mine"></span> @Text["merge.keepMine"]</button>
                        <button class="btn secondary" @onclick="() => StartDraftAsync(MergeStart.Sure)" disabled="@(PageSureCount == 0)"><span class="swatch version"></span> @Text.Format("merge.takeSure", PageSureCount)</button>
                        <button class="btn secondary" @onclick="() => StartDraftAsync(MergeStart.All)"><span class="swatch version"></span> @Text.Format("merge.takeAll", PageDifferingCount)</button>
                    </div>
                    <label class="check-row">
                        <input type="checkbox" checked="@MergeDirect" @onchange="ToggleMergeDirectAsync" />
                        <span>@Text["merge.direct"]</span>
                    </label>
                }
            </section>
        }
        else
        {
            @DraftBlock
        }
        @if (PageDifferingCount > 0 || _draft is not null)
        {
            <button class="btn quiet merge-window" @onclick="OpenCompareWindowAsync"><Icon Name="layers" /> @Text["merge.window"] ⤢</button>
        }
    }
    @if (_performanceStatus is { } status)
    {
        <p class="caption" role="status">@status</p>
    }
    <hr />
    <label class="field">
        <span class="caption">@Text["performance.name"]</span>
        <input type="text" value="@version.Name" @onchange="RenamePerformanceAsync" />
    </label>
    <button class="btn quiet compact danger-text" @onclick="RemoveVersionAsync"><Icon Name="trash" /> @Text["merge.remove"]</button>
    <p class="caption">@Text["merge.removeHow"]</p>
</text>;

    /// <summary>The bars of the piece in a strip: grey where the version agrees, plum where it differs, the sure ones darker; a tap goes to the bar.</summary>
    private RenderFragment BarStrip(PerformanceComparison comparison) => @<div class="merge-strip" role="list" aria-label="@Text["merge.strip"]">
        @foreach (BarComparison bar in comparison.Bars)
        {
            string kind = !bar.Aligned ? "off" : bar.Difference == BarDifference.None ? "same" : bar.Confidence >= PerformanceTake.AutomaticConfidence ? "sure" : "doubt";
            string state = _draft?.DecisionFor(bar.Bar) is not null ? ChoiceClass(bar.Bar) : "";
            <button role="listitem" class="cell @kind @state @(_draftAt == bar.Bar ? "at" : null)" title="@Text.Format("check.bar", bar.Bar)"
                    aria-label="@($"{Text.Format("check.bar", bar.Bar)}: {(bar.Difference == BarDifference.None ? Text["merge.same"] : bar.Marker(Words))}")"
                    @onclick="() => StripBarAsync(bar.Bar)"></button>
        }
    </div>;

    /// <summary>
    /// The draft in the drawer (dashed plum): what changes, ‹ › through the changes, Bar or Phrase, Take mine, Take from the
    /// version and Edit in the roll for the change shown, the list of changes, the three views to hear, and Undo, Redo,
    /// Reset, Cancel and Apply.
    /// </summary>
    private RenderFragment DraftBlock => @<section class="merge-draft" aria-label="@Text["merge.draft"]">
    @if (_draft is { } draft)
    {
        <div class="merge-draft-head">
            <p class="overline">@Text["merge.draft"]</p>
            <span class="caption">@Text.Format("merge.decided", draft.Decided, draft.Bars.Count)</span>
        </div>
        <p class="caption">@Text.Count("merge.changes", DraftOutcome?.Taken.Count ?? 0)</p>
        @if (_draftAt is { } at && DraftRows.FirstOrDefault(bar => bar.Bar == at) is { } current)
        {
            <div class="merge-step">
                <button class="btn icon" aria-label="@Text["merge.previous"]" title="@Text["merge.previous"]" @onclick="() => StepChangeAsync(-1)"><Icon Name="back" /></button>
                <p><strong>@Text.Format("check.bar", at)</strong> <span class="tag plum">@current.Marker(Words)</span> <span class="caption">@Text.Format("merge.confidence", current.Confidence)</span></p>
                <button class="btn icon" aria-label="@Text["merge.next"]" title="@Text["merge.next"]" @onclick="() => StepChangeAsync(1)"><Icon Name="fwd" /></button>
            </div>
            <div class="seg merge-scope" role="radiogroup" aria-label="@Text["merge.scope"]">
                <button role="radio" class="@(_draftPhrase ? null : "on")" aria-checked="@(_draftPhrase ? "false" : "true")" @onclick="() => _draftPhrase = false">@Text["merge.scopeBar"]</button>
                <button role="radio" class="@(_draftPhrase ? "on" : null)" aria-checked="@(_draftPhrase ? "true" : "false")" @onclick="() => _draftPhrase = true">@Text["merge.scopePhrase"]</button>
            </div>
            <div class="merge-take">
                <button class="btn secondary @(draft.DecisionFor(at)?.Choice == MergeChoice.Mine ? "on" : null)" @onclick="() => ChooseAsync(at, MergeChoice.Mine)"><span class="swatch mine"></span> @Text["merge.takeMine"]</button>
                <button class="btn secondary @(draft.DecisionFor(at)?.Choice == MergeChoice.Version ? "on" : null)" @onclick="() => ChooseAsync(at, MergeChoice.Version)"><span class="swatch version"></span> @Text["merge.takeVersion"]</button>
                <button class="btn quiet @(draft.DecisionFor(at)?.Choice == MergeChoice.Own ? "on" : null)" @onclick="() => BeginOwnEdit(at)"><Icon Name="pen" /> @Text["merge.editInRoll"]</button>
            </div>
            <p class="caption merge-state">@Text.Format("merge.stateLine", ChoiceName(at))</p>
            <button class="btn quiet compact" @onclick='() => HearMergeAsync("result")'><Icon Name="play" /> @Text["merge.hearResult"]</button>
        }
        <ul class="merge-rows">
            @foreach (BarComparison bar in DraftRows)
            {
                <li>
                    <button class="merge-row @(_draftAt == bar.Bar ? "on" : null)" @onclick="() => GoToBarAsync(bar.Bar)">
                        <span>@Text.Format("check.bar", bar.Bar)</span>
                        <span class="caption">@bar.Marker(Words)</span>
                        <span class="state @ChoiceClass(bar.Bar)">@ChoiceName(bar.Bar)</span>
                    </button>
                </li>
            }
        </ul>
        @MergeListen
        <div class="row merge-history">
            <button class="btn quiet compact" @onclick="UndoDraftAsync" disabled="@(!draft.CanUndo)"><Icon Name="undo" /> @Text["merge.undo"]</button>
            <button class="btn quiet compact redo" @onclick="RedoDraftAsync" disabled="@(!draft.CanRedo)"><Icon Name="undo" /> @Text["merge.redo"]</button>
            <button class="btn quiet compact" @onclick="ResetDraftAsync" disabled="@(!draft.Changed)">@Text["merge.reset"]</button>
        </div>
        <div class="row merge-apply">
            <button class="btn quiet" @onclick="CancelDraftAsync">@Text["merge.cancel"]</button>
            <button class="btn primary" @onclick="ApplyDraftAsync"><Icon Name="check" /> @Text[DraftVersion?.Merge is { AppliedAt: not null } ? "merge.applyAgain" : "merge.apply"]</button>
        </div>
        <label class="check-row">
            <input type="checkbox" checked="@MergeDirect" @onchange="ToggleMergeDirectAsync" />
            <span>@Text["merge.direct"]</span>
        </label>
    }
</section>;

    /// <summary>
    /// «Сравнение версий» (testing item 34): the full-screen window over the same draft. At the left the changes grouped by
    /// kind with Take the group, filtered; at the right the change shown in three views stacked, with how much they show,
    /// the size of the notes, the choices and the keys M, V, E and ← →.
    /// </summary>
    private RenderFragment CompareWindow => @<section class="dna compare" role="dialog" aria-modal="true" aria-labelledby="compare-title" tabindex="0" @onkeydown="CompareKeyAsync" data-keeps-selection>
    @if (_draft is { } draft)
    {
        <header class="dna-bar compare-bar">
            <button class="act back-to" @onclick="CloseCompare"><Icon Name="back" Size="IconSize.Large" /> @Text["merge.toNotes"]</button>
            <h2 id="compare-title" class="ttl">@Text["merge.window"]</h2>
            <span class="sub">@DraftVersion?.Name</span>
            <span class="sp"></span>
            <span class="counts">@Text.Format("merge.decided", draft.Decided, draft.Bars.Count)</span>
            <button class="btn quiet compact" @onclick="UndoDraftAsync" disabled="@(!draft.CanUndo)" title="⌘Z / Ctrl+Z"><Icon Name="undo" /> @Text["merge.undo"]</button>
            <button class="btn quiet compact redo" @onclick="RedoDraftAsync" disabled="@(!draft.CanRedo)" title="⇧⌘Z / Ctrl+Y"><Icon Name="undo" /> @Text["merge.redo"]</button>
            <button class="btn quiet compact" @onclick="ResetDraftAsync" disabled="@(!draft.Changed)">@Text["merge.resetShort"]</button>
            <button class="btn quiet compact" @onclick="CancelDraftAsync">@Text["merge.cancel"]</button>
            <button class="btn primary compact" @onclick="ApplyDraftAsync"><Icon Name="check" /> @Text["merge.apply"]</button>
        </header>
        <div class="compare-body">
            <aside class="compare-list" aria-label="@Text["merge.changesList"]">
                <div class="seg" role="radiogroup" aria-label="@Text["merge.filter"]">
                    @foreach (string filter in new[] { "all", "sure", "doubtful", "decided" })
                    {
                        <button role="radio" class="@(_compareFilter == filter ? "on" : null)" aria-checked="@(_compareFilter == filter ? "true" : "false")"
                                @onclick="() => _compareFilter = filter">@Text[$"merge.filter.{filter}"]</button>
                    }
                </div>
                @foreach (IGrouping<MergeGroup, BarComparison> group in CompareRows.GroupBy(bar => PerformanceMerge.GroupOf(bar.Difference)).OrderBy(group => group.Key))
                {
                    <div class="compare-group">
                        <p class="overline">@Text[GroupKey(group.Key)] · @group.Count()</p>
                        <span class="sp"></span>
                        <span class="caption">@Text["merge.takeGroup"]:</span>
                        <button class="btn quiet compact" title="@Text["merge.groupMine"]" aria-label="@Text["merge.groupMine"]" @onclick="() => ChooseGroupAsync(group.Key, MergeChoice.Mine)"><span class="swatch mine"></span> @Text["merge.view.mine"]</button>
                        <button class="btn quiet compact" title="@Text["merge.groupVersion"]" aria-label="@Text["merge.groupVersion"]" @onclick="() => ChooseGroupAsync(group.Key, MergeChoice.Version)"><span class="swatch version"></span> @Text["merge.view.version"]</button>
                    </div>
                    <ul class="merge-rows">
                        @foreach (BarComparison bar in group)
                        {
                            <li>
                                <button class="merge-row @(_draftAt == bar.Bar ? "on" : null)" @onclick="() => GoToBarAsync(bar.Bar)">
                                    <span>@Text.Format("check.bar", bar.Bar)</span>
                                    <span class="caption">@bar.Marker(Words) · @bar.Confidence %</span>
                                    <span class="state @ChoiceClass(bar.Bar)">@ChoiceName(bar.Bar)</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </aside>
            <div class="compare-main" style="@($"--zoom: {_compareZoom / 100.0:0.00}".Replace(',', '.'))">
                @if (_draftAt is { } at && DraftRows.FirstOrDefault(bar => bar.Bar == at) is { } current)
                {
                    <div class="merge-step">
                        <button class="btn icon" aria-label="@Text["merge.previous"]" title="@Text["merge.previous"] (←)" @onclick="() => StepChangeAsync(-1)"><Icon Name="back" /></button>
                        <p><strong>@Text.Format("check.bar", at)</strong> <span class="tag plum">@current.Marker(Words)</span> <span class="caption">@PerformanceCounts(current) · @Text.Format("merge.confidence", current.Confidence)</span></p>
                        <button class="btn icon" aria-label="@Text["merge.next"]" title="@Text["merge.next"] (→)" @onclick="() => StepChangeAsync(1)"><Icon Name="fwd" /></button>
                    </div>
                    <div class="compare-actions">
                        <div class="seg merge-scope" role="radiogroup" aria-label="@Text["merge.scope"]">
                            <button role="radio" class="@(_draftPhrase ? null : "on")" aria-checked="@(_draftPhrase ? "false" : "true")" @onclick="() => _draftPhrase = false">@Text["merge.scopeBar"]</button>
                            <button role="radio" class="@(_draftPhrase ? "on" : null)" aria-checked="@(_draftPhrase ? "true" : "false")" @onclick="() => _draftPhrase = true">@Text["merge.scopePhrase"]</button>
                        </div>
                        <button class="btn secondary @(draft.DecisionFor(at)?.Choice == MergeChoice.Mine ? "on" : null)" title="M" @onclick="() => ChooseAsync(at, MergeChoice.Mine)"><span class="swatch mine"></span> @Text["merge.takeMine"] <kbd>M</kbd></button>
                        <button class="btn secondary @(draft.DecisionFor(at)?.Choice == MergeChoice.Version ? "on" : null)" title="V" @onclick="() => ChooseAsync(at, MergeChoice.Version)"><span class="swatch version"></span> @Text["merge.takeVersion"] <kbd>V</kbd></button>
                        <button class="btn quiet @(draft.DecisionFor(at)?.Choice == MergeChoice.Own ? "on" : null)" title="E" @onclick="() => BeginOwnEdit(at)"><Icon Name="pen" /> @Text["merge.editInRoll"] <kbd>E</kbd></button>
                        <button class="btn quiet @(draft.DecisionFor(at)?.Choice == MergeChoice.NotADifference ? "on" : null)" @onclick="() => ChooseAsync(at, MergeChoice.NotADifference)">@Text["merge.notDifference"]</button>
                        @if (draft.DecisionFor(at) is not null)
                        {
                            <button class="btn quiet compact" @onclick="() => UndecideAsync(at)">@Text["merge.resetBar"]</button>
                        }
                        <span class="caption merge-state">@Text.Format("merge.stateLine", ChoiceName(at))</span>
                    </div>
                    <div class="compare-see">
                        <span class="caption">@Text["merge.see"]</span>
                        <div class="seg" role="radiogroup" aria-label="@Text["merge.see"]">
                            @foreach (string see in new[] { "bar", "phrase", "sentence" })
                            {
                                <button role="radio" class="@(_compareSee == see ? "on" : null)" aria-checked="@(_compareSee == see ? "true" : "false")" @onclick="() => _compareSee = see">@Text[$"merge.see.{see}"]</button>
                            }
                        </div>
                        <span class="sp"></span>
                        <div class="zoom" role="group" aria-label="@Text["merge.zoom"]">
                            <button class="btn icon" aria-label="@Text["merge.zoomOut"]" @onclick="() => ZoomCompare(-10)">−</button>
                            <span class="caption">@_compareZoom %</span>
                            <button class="btn icon" aria-label="@Text["merge.zoomIn"]" @onclick="() => ZoomCompare(10)">+</button>
                        </div>
                    </div>
                    @foreach (string view in new[] { "mine", "version", "result" })
                    {
                        <div class="merge-view @view">
                            <div class="lab">
                                <span class="dot @view"></span> <strong>@Text[$"merge.view.{view}"]</strong>
                                @if (view == "version") { <span class="caption">· @DraftVersion?.Name</span> }
                                @if (view == "result") { <span class="caption">· @Text["merge.resultHint"]</span> }
                                <span class="sp"></span>
                                <button class="btn icon @view" aria-label="@Text.Format("merge.hearView", Text[$"merge.view.{view}"])" @onclick="() => HearMergeAsync(view)">
                                    <Icon Name="@(_mergeHearing == view && Player.State != PlaybackState.Stopped ? "pause" : "play")" />
                                </button>
                            </div>
                            @if (MergeCard(view) is { } card)
                            {
                                <PhraseCard Source="card" />
                            }
                        </div>
                    }
                    @MergeListen
                }
                else
                {
                    <p class="caption">@Text["merge.nothing"]</p>
                }
            </div>
        </div>
    }
</section>;

    /// <summary>Listen: Mine · Version · Result · In turn, each in its view's colour.</summary>
    private RenderFragment MergeListen => @<div class="seg merge-listen" role="group" aria-label="@Text["merge.listen"]">
        @foreach (string view in new[] { "mine", "version", "result", "alternate" })
        {
            bool on = _mergeHearing == view && Player.State != PlaybackState.Stopped;
            <button class="@view @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @onclick="() => HearMergeAsync(view)">
                @if (view != "alternate") { <span class="dot @view"></span> } @Text[$"merge.view.{view}"]
            </button>
        }
    </div>;

    private RenderFragment TrialCard => @<ExploreCard Try="TryExperimentAsync" Leave="LeaveExperimentAsync" HearInContext="HearAnswerAsync"
                                                    ListenToChanged="SetListenToAsync" FactChosen="ShowFactAsync" NoteSaved="SaveKeptNoteAsync" />;

    /// <summary>What the player kept for the passage, listed whole (#78): to open, rename, note, export or delete.</summary>
    private RenderFragment IdeasList => @<text>
        @if (_selection is not null)
        {
            <ObservationList Heading="@ListedHeading" Rows="KeptRows" SessionOnly="KeptForSessionOnly" CanKeepHeard="CanKeepHeard" CanWrite="true"
                             Status="@ObservationStatus" Open="OpenObservationAsync" Rename="RenameObservationAsync" Note="NoteObservationAsync"
                             Export="ExportObservationAsync" Delete="DeleteObservationAsync" KeepHeard="KeepHeardAsync" Write="WriteNoteAsync" />
        }
    </text>;

    /// <summary>
    /// Adjust (0018 section 6): Keep, the catalogue's operations and the steps behind the experiments (S1-E1 to S1-E5), inline in the
    /// Insights stream under the experiment being tried, pre-filled with its steps, or at the end of the stream to shape a variation by hand.
    /// </summary>
    private RenderFragment ShapeTools => @<div class="adjust" role="group" aria-label="@Text["tools.shape"]">
        @if (_selection is { NoteIds.Count: > 0 })
        {
            <p class="meta">@Text["tools.shapeHint"]</p>
            <div class="group">
                <h3>@Text["tools.keep"]</h3>
                <select class="preset" @onchange="ApplyPresetChosenAsync" aria-label="@Text["tools.keepPreset"]" title="@(CurrentPreset is { } current ? PresetHint(current) : Text["tools.ownChoiceHint"])">
                    @if (CurrentPreset is null)
                    {
                        <option selected>@Text["tools.ownChoice"]</option>
                    }
                    @foreach (KeepPreset preset in KeepTable.Presets)
                    {
                        <option value="@preset.Id" selected="@(_keep.SetEquals(preset.Keep))">@preset.LabelIn(Words)</option>
                    }
                </select>
                <div class="keep" role="group" aria-label="@Text["tools.whatToKeep"]" title="@Text["tools.whatToKeepHint"]">
                    @foreach (KeepProperty property in Enum.GetValues<KeepProperty>())
                    {
                        <button class="@KeepClass(property)" aria-pressed="@(_keep.Contains(property) ? "true" : "false")" title="@KeepStatusText(property)" @onclick="() => ToggleKeepAsync(property)">
                            @KeepLabel(property)
                        </button>
                    }
                </div>
            </div>

            <div class="group">
                <label class="pick scope" title="@Text["tools.scopeHint"]">
                    <span>@Text["tools.change"]</span>
                    <select @onchange="SetScope" aria-label="@Text["tools.scopeLabel"]">
                        @foreach ((OperationScope scope, string key) in s_scopes)
                        {
                            <option value="@scope" selected="@(_scope == scope)">@Text[key]</option>
                        }
                    </select>
                </label>
            </div>

            @foreach (OperationGroup group in s_operations)
            {
                string id = group.Operation.Id;
                bool open = _openGroups.Contains(id);
                <div class="group variation" role="group" aria-label="@OperationTitle(group.Operation)">
                    <button class="section-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleGroup(id)">
                        <span class="caret" aria-hidden="true">@(open ? "▾" : "▸")</span>
                        @id @OperationTitle(group.Operation)
                        @if (_chain?.Pending?.Operation.Id == id)
                        {
                            <span class="kind">@Text["tools.trying"]</span>
                        }
                    </button>
                    @if (open)
                    {
                        @if (group.Operation.DisabledReason(_keep, Words) is { } disabled)
                        {
                            <p class="meta">@disabled</p>
                        }
                        else if (_scope != OperationScope.All && !group.Operation.Supports(_scope))
                        {
                            <p class="meta">@Text["tools.wholeSelection"]</p>
                        }
                        <div class="choices" role="group" aria-label="@Text[$"op.{group.Operation.Id}.question"]">
                            @foreach (OperationChoice choice in group.Choices)
                            {
                                OperationParameters parameters = Scoped(group, choice);
                                string? reason = OperationUnavailable(group, parameters);
                                bool trying = _chain?.Pending?.Parameters == parameters;
                                <button class="@(trying ? "on" : null)" aria-pressed="@(trying ? "true" : "false")"
                                        disabled="@(reason is not null)" title="@(reason ?? Text[$"op.{choice.Key}.hint"])" @onclick="() => ProposeAsync(group, parameters)">
                                    @ChoiceLabel(choice)
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="group">
                @if (StepsText is { } steps)
                {
                    <p class="steps" aria-live="polite">@steps</p>
                }
                <div class="step-buttons" role="group" aria-label="@Text["tools.steps"]">
                    <button class="primary" @onclick="AcceptStepAsync" disabled="@(_chain?.AcceptDisabledReason is not null)" title="@(_chain?.AcceptDisabledReason ?? Text["tools.acceptHint"])">@Text["tools.accept"]</button>
                    <button @onclick="RejectStepAsync" disabled="@(_chain?.Pending is null)" title="@Text["tools.rejectHint"]">@Text["tools.reject"]</button>
                    <button @onclick="UndoStepAsync" disabled="@(_chain?.CanUndo != true)" title="@Text["tools.undoHint"]">@Text["tools.undo"]</button>
                    <button @onclick="RedoStepAsync" disabled="@(_chain?.CanRedo != true)" title="@Text["tools.redoHint"]">@Text["tools.redo"]</button>
                </div>
            </div>

            <div class="changed" aria-live="polite">
                <h3>@Text["tools.whatChanged"]</h3>
                <p>@(ExplanationText ?? Text["tools.pickChange"])</p>
                @foreach (string flag in _variation?.Flags ?? [])
                {
                    <p class="meta">@Text.Format("tools.check", flag)</p>
                }
            </div>
            @if (_variation is not null)
            {
                <ComparePanel ShowFlags="false" />
            }

            <div class="group">
                <div class="row">
                    <button @onclick="() => AuditionAsync(variation: false)">@Text["tools.hearOriginal"]</button>
                    <button @onclick="() => AuditionAsync(variation: true)" disabled="@(_variation is null)">@Text["tools.hearVariation"]</button>
                    <button @onclick="RemoveVariationAsync" disabled="@(_variation is null)">@Text["tools.removeVariation"]</button>
                </div>
                <div class="row">
                    <button @onclick="() => ExportMidiAsync(variation: false)" title="@Text["tools.exportMotifHint"]">@Text["tools.exportMotif"]</button>
                    <button @onclick="() => ExportMidiAsync(variation: true)" disabled="@(_variation is null)" title="@Text["tools.exportVariationHint"]">@Text["tools.exportVariation"]</button>
                </div>
            </div>
        }
        else
        {
            <p class="meta">@Text["tools.selectFirst"]</p>
        }
    </div>;

    /// <summary>
    /// The focus bar (0018 section 4): Back to the page, where the phrase is, Reading / As played for a transcription,
    /// Original / Variation / Alternate when the phrase has a variation, then the piano roll, Insights and Play.
    /// </summary>
    private RenderFragment FocusBar => @<text>
        <button class="back-to-page" title="@Text["focus.backHint"]" @onclick="LeaveFocusAsync"><Icon Name="back" Size="IconSize.Large" /> <span>@Text["focus.back"]</span></button>
        <span class="crumb">@FocusPosition</span>
        @* The phrase as notes or as a roll (testing item 12). *@
        <div class="seg" role="radiogroup" aria-label="@Text["focus.showAs"]">
            <button role="radio" class="@(_focusRoll ? null : "on")" aria-checked="@(_focusRoll ? "false" : "true")" @onclick="() => ShowFocusAs(false)">@Text["focus.asNotes"]</button>
            <button role="radio" class="@(_focusRoll ? "on" : null)" aria-checked="@(_focusRoll ? "true" : "false")" @onclick="() => ShowFocusAs(true)">@Text["focus.asRoll"]</button>
        </div>
        <span class="sp"></span>
        @if (_heard)
        {
            <div class="seg" role="radiogroup" aria-label="@Text["focus.notation"]">
                <button role="radio" class="@(_readable ? "on" : null)" aria-checked="@(_readable ? "true" : "false")" @onclick="() => SetReadable(true)">@Text["focus.reading"]</button>
                <button role="radio" class="@(_readable ? null : "on")" aria-checked="@(_readable ? "false" : "true")" @onclick="() => SetReadable(false)">@Text["score.asPlayed"]</button>
            </div>
        }
        @if (FocusHasVariation)
        {
            bool alternate = _alternating;
            bool variation = !alternate && VariationChosen;
            <div class="seg" role="radiogroup" aria-label="@Text["focus.listen"]">
                <button role="radio" class="@(!alternate && !variation ? "on" : null)" aria-checked="@(!alternate && !variation ? "true" : "false")" title="@Text["compare.originalHint"]" @onclick="() => CompareAsync(false)">@Text["focus.original"]</button>
                <button role="radio" class="@(variation ? "on" : null)" aria-checked="@(variation ? "true" : "false")" title="@Text["compare.variationHint"]" @onclick="() => CompareAsync(true)">@Text["focus.variation"]</button>
                <button role="radio" class="@(alternate ? "on" : null)" aria-checked="@(alternate ? "true" : "false")" title="@Text["compare.alternateHint"]" @onclick="StartOneAfterTheOtherAsync">@Text["focus.alternate"]</button>
            </div>
        }
        @if (FocusHasVersion)
        {
            bool alternate = _alternating;
            bool version = !alternate && VersionChosen;
            string name = ShownPerformance!.Name;
            <div class="seg" role="radiogroup" aria-label="@Text["focus.listen"]">
                <button role="radio" class="@(!alternate && !version ? "on" : null)" aria-checked="@(!alternate && !version ? "true" : "false")" title="@Text["compare.notesHint"]" @onclick="() => HearVersionAsync(false)">@Text["focus.notes"]</button>
                <button role="radio" class="@(version ? "on" : null)" aria-checked="@(version ? "true" : "false")" title="@Text.Format("compare.versionHint", name)" @onclick="() => HearVersionAsync(true)">@Text["focus.versionHear"]</button>
                <button role="radio" class="@(alternate ? "on" : null)" aria-checked="@(alternate ? "true" : "false")" title="@Text.Format("compare.alternateVersionHint", name)" @onclick="StartOneAfterTheOtherAsync">@Text["focus.alternate"]</button>
            </div>
        }
        @if (!FocusHasVariation && ShownPerformance is not null)
        {
