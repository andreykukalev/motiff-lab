@page "/playback"
@using MotiffLab.MusicCore
@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Analytics
@using MotiffLab.MusicCore.Events
@using MotiffLab.MusicCore.Experiments
@using MotiffLab.MusicCore.Export
@using MotiffLab.MusicCore.Import
@using MotiffLab.MusicCore.Import.MusicXml
@using MotiffLab.MusicCore.Import.Transcription
@using MotiffLab.MusicCore.Motifs
@using MotiffLab.MusicCore.Notation
@using MotiffLab.MusicCore.Invitations
@using MotiffLab.MusicCore.Playback
@using MotiffLab.MusicCore.Projects
@using MotiffLab.MusicCore.Time
@using MotiffLab.MusicCore.Variations
@using MotiffLab.Web.Compare
@using MotiffLab.Web.Explore
@using MotiffLab.Web.Import
@using MotiffLab.Web.Localization
@using MotiffLab.Web.Observations
@using MotiffLab.Web.Phrases
@using MotiffLab.Web.Playback
@using MotiffLab.Web.Practise
@using MotiffLab.Web.Projects
@using MotiffLab.Web.Roll
@using MotiffLab.Web.Score
@using MotiffLab.Web.Structure
@using MotiffLab.Web.Understand
@implements IDisposable
@inject IJSRuntime JS
@inject Player Player
@inject Preferences Preferences
@inject CurrentPiece CurrentPiece
@inject ProjectStore Projects
@inject NavigationManager Navigation
@inject MotiffLab.Web.Analytics.UsageAnalytics Analytics
@inject UiText Text

<PageTitle>@(_title ?? Text["workspace.title"]) · Motiff Lab</PageTitle>

@* The workspace (0012, docs/ui-conventions.md): the piece is the context, the session is the task, and the selected passage is the
   unit of work. A header with the piece and the session, the score as the primary view with the piano roll under it, an inspector
   for the passage on the right (Practise, Understand and Explore share the selection; Tools holds the mechanisms), and the
   transport along the bottom. It also covers S1-W2 to S1-W7, S1-M1, S1-M2, S1-M5, S1-A1 and S1-A2. Files stay on the device. *@
@* The shared workspace state (decision record 0013): one snapshot per render, which the tabs read; the page is its only writer. *@
<CascadingValue Value="State">
    <main class="lab app @(_focus ? "focus" : null)" @ref="_main">
        <header class="app-header">
            <a class="back" href="@BackUrl">‹ @BackLabel</a>
            <div class="app-title">
                <strong>@(_title ?? Text["workspace.title"])</strong>
                <span class="meta">@SessionLine</span>
            </div>
            <div class="app-actions">
                @if (_score is null)
                {
                    <button @onclick="LoadFurEliseAsync" disabled="@(!Player.IsReady)" title="@Text["workspace.furEliseHint"]">Für Elise</button>
                    <label class="file">
                        @Text["workspace.openFile"]
                        <InputFile OnChange="OpenFileAsync" accept="@PieceImporter.AcceptedExtensions" disabled="@(!Player.IsReady)" />
                    </label>
                    <a class="button" href="import">@Text["workspace.importWithReport"]</a>
                }
                else
                {
                    <details class="open-another">
                        <summary>@Text["workspace.openAnother"]</summary>
                        <div class="row">
                            <button @onclick="LoadFurEliseAsync" disabled="@(!Player.IsReady)" title="@Text["workspace.furEliseHint"]">Für Elise</button>
                            <label class="file">
                                @Text["workspace.openFile"]
                                <InputFile OnChange="OpenFileAsync" accept="@PieceImporter.AcceptedExtensions" disabled="@(!Player.IsReady)" />
                            </label>
                            <a class="button" href="import">@Text["workspace.importWithReport"]</a>
                        </div>
                    </details>
                }
            </div>
            @if (_score is not null && _meter is not null)
            {
                @* Which notes play and light up (S1-M2), what is heard, and which score shows. *@
                <div class="app-view" role="group" aria-label="@Text["workspace.view"]">
                    @ViewSwitch
                    <button class="focus-button" @onclick="EnterFocusAsync" title="@Text["focus.hint"]">@Text["focus.enter"]</button>
                    <label class="pick">
                        <span>@Text["workspace.notes"]</span>
                        <select @onchange="SetFilterAsync" aria-label="@Text["workspace.notesLabel"]">
                            @for (int i = 0; i < _filters.Length; i++)
                            {
                                <option value="@i" selected="@(_filters[i] == _filter)">@FilterLabel(_filters[i])</option>
                            }
                            @foreach (string category in s_coreCategories)
                            {
                                <option disabled>@Text.Format("workspace.needsAnalysis", Text[category])</option>
                            }
                        </select>
                    </label>
                    <label class="pick">
                        <span>@Text["workspace.hear"]</span>
                        <select @onchange="HearChosenAsync" aria-label="@Text["workspace.hearLabel"]">
                            @for (int i = 0; i < Sources.Length; i++)
                            {
                                <option value="@i" selected="@HearShown(Sources[i].Ids)">@Text[Sources[i].Key]</option>
                            }
                        </select>
                    </label>
                    <label class="pick">
                        <span>@Text["workspace.score"]</span>
                        @* The select's value, not each option's selected attribute: Firefox can fall back to the first option when the options and their selected attributes change in one render. *@
                        <select @onchange="SetScoreChoice" aria-label="@Text["workspace.scoreLabel"]" value="@ShownChoice.ToString()" disabled="@(!ShowScore)">
                            @foreach ((ScoreChoice choice, string key) in ScoreChoices)
                            {
                                <option value="@choice">@Text[key]</option>
                            }
                        </select>
                    </label>
                </div>
            }
        </header>

        @if (Player.Error is not null)
        {
            <p class="error">@Player.Error</p>
        }
        else if (!Player.IsReady)
        {
            <p class="meta">@Text["workspace.loadingPiano"]</p>
        }
        @if (_message is not null)
        {
            <p class="error">@_message</p>
            <p class="meta">@_tip</p>
        }
        @if (_score is null && Player.IsReady && _message is null)
        {
            <p class="meta empty-hint">@Text["workspace.emptyHint"]</p>
        }

        @if (_focus && _score is not null && _meter is not null)
        {
            @* Focus mode (0012): what playing at the instrument needs, and a way back; the header and the inspector are hidden by CSS. *@
            <div class="focus-bar" role="toolbar" aria-label="@Text["focus.label"]" data-keeps-selection>
                <button class="exit" @onclick="LeaveFocusAsync">‹ @Text["focus.exit"]</button>
                <span class="phrase" aria-live="polite">@SelectionText</span>
                <div class="steps" role="group" aria-label="@Text["workspace.phrases"]">
                    <button @onclick="() => StepPhraseAsync(-1)" disabled="@(!CanStep(-1))" aria-label="@StepLabel(-1)" title="@StepLabel(-1)">‹</button>
                    <button @onclick="() => StepPhraseAsync(1)" disabled="@(!CanStep(1))" aria-label="@StepLabel(1)" title="@StepLabel(1)">›</button>
                </div>
                <button class="@(Looping ? "on" : null)" aria-pressed="@(Looping ? "true" : "false")" @onclick="ToggleLoopSelectionAsync" disabled="@(_selection is not { NoteIds.Count: > 0 })">
                    @(Looping ? Text["focus.looping"] : Text["focus.loop"])
                </button>
                @if (_variation is not null && _selection is { NoteIds.Count: > 0 })
                {
                    <CompareSwitch Choose="CompareAsync" OneAfterTheOther="ToggleOneAfterTheOtherAsync" />
                }
                @ViewSwitch
            </div>
        }

        @if (_score is not null && _meter is not null)
        {
            <div class="app-body">
                @* The score first, as the primary view (0012); the roll under it, scrolling within its own panel. *@
                <section class="canvas" aria-label="@Text["workspace.canvas"]" @ref="_canvas">
                    @if (_phrases is not null)
                    {
                        <HierarchyLine Picked="PickSpanAsync" />
                        <PhraseStrip Picked="PickPhraseAsync" SentencePicked="PickSentenceAsync" Make="MakePhraseAsync" Join="JoinPhraseAsync" Reset="ResetPhrasesAsync"
                                     CanExtendBack="@(Extension(-1) is not null)" CanExtendOn="@(Extension(1) is not null)"
                                     Extend="ExtendSelectionAsync" KeptCount="KeptCount" />
                    }
                    @if (ShowScore && ShownScore is { } shown)
                    {
                        @* Clicks on the page outside the roll clear the selection, except inside panels marked data-keeps-selection (docs/ui-conventions.md). *@
                        <div class="score-panel" data-keeps-selection>
                            @if (_heard && shown.Generated is not null)
                            {
                                @* Notes heard in a recording (0016): written for reading, or as close to the playing as notation goes. *@
                                <div class="row" role="radiogroup" aria-label="@Text["score.heardMode"]">
                                    <label><input type="radio" name="heard-mode" checked="@_readable" @onchange="() => SetReadable(true)" /> @Text["score.readable"]</label>
                                    <label><input type="radio" name="heard-mode" checked="@(!_readable)" @onchange="() => SetReadable(false)" /> @Text["score.asPlayed"]</label>
                                </div>
                            }
                            <ScoreView Source="shown" Range="ShownRange" Phrases="ScorePhrases" Highlight="_highlight?.Places" HoldHeight="_alternating" PencilKey="ShownPencilKey" Title="@ScoreTitle.Of(_title)" BarPicked="OnScoreBarPickedAsync" />
                            <p class="meta">@ScoreNote(shown)</p>
                        </div>
                        @if (ShowRoll)
                        {
                            @* The divider between the two views: dragged, or moved with the arrow keys, Home and End (WCAG 2.1.1). *@
                            <div class="divider" role="separator" aria-orientation="horizontal" aria-label="@Text["divider.label"]" title="@Text["divider.hint"]"
                                 tabindex="0" aria-valuemin="20" aria-valuemax="80" aria-valuenow="@((int)Math.Round(_split * 100))" @ref="_handle" data-keeps-selection></div>
                        }
                    }
                    @if (ShowRoll)
                    {
                        <div class="roll-panel">
                            <PianoRoll Notes="_notes" Score="_score" Meter="_meter" Motif="_selection" MotifPlaysAlone="_looping" Phrases="_phrases"
                                       Kept="_keptIds" Variation="_variation" PlayRange="ShownRange" OriginalAudible="OriginalAudible" VariationAudible="VariationAudible" Highlight="_highlight?.Places"
                                       RangePicked="OnRangePickedAsync" Cleared="ClearSelectionAsync" PlayPausePressed="PlayPauseAsync" />
                        </div>
                    }
                </section>

                <aside class="inspector" aria-label="@Text["workspace.inspector"]" data-keeps-selection>
                    <div class="inspector-head">
                        @* Which one sounds while the two loop one after the other is shown, not announced at every pass. *@
                        <p class="selection-text" aria-live="polite">@SelectionText<span aria-hidden="true">@SoundingText</span></p>
                        <div class="inspector-actions">
                            <button class="@(Looping ? "on" : "primary")" @onclick="ToggleLoopSelectionAsync" disabled="@(_selection is not { NoteIds.Count: > 0 })">
                                @(Looping ? Text["focus.looping"] : Text["focus.loop"])
                            </button>
                            <button @onclick="ClearSelectionAsync" disabled="@(_selection is null)">@Text["workspace.clear"]</button>
                        </div>
                        @if (_variation is not null && _selection is { NoteIds.Count: > 0 })
                        {
                            <CompareSwitch Choose="CompareAsync" OneAfterTheOther="ToggleOneAfterTheOtherAsync" />
                        }
                    </div>

                    @* Three ways of working on the same passage, then the mechanisms (0012): switching keeps the selection, the tempo and the loop. *@
                    <div class="tabs" role="tablist" aria-label="@Text["workspace.inspector"]">
                        @foreach ((InspectorTab tab, string label) in InspectorTabs)
                        {
                            <button role="tab" class="tab" aria-selected="@(_tab == tab ? "true" : "false")" @onclick="() => _tab = tab">@label</button>
                        }
                    </div>

                    <div class="tab-panel" role="tabpanel" aria-label="@_tab">
                        @switch (_tab)
                        {
                            case InspectorTab.Practise:
                                <PractisePanel PlayPressed="PractisePlayAsync" LoopPressed="ToggleLoopSelectionAsync" Step="StepPhraseAsync"
                                               TempoChanged="SetTempoPercentAsync" ListenToChanged="PractiseListenToAsync"
                                               PlayOn="PlayOnAsync" Back="BackToPhraseAsync" />
                                break;
                            case InspectorTab.Understand:
                                @if (Facts.Count == 0)
                                {
                                    <p class="meta">@Text["understand.nothingYet"]</p>
                                }
                                <UnderstandPanel Choose="ChooseFactAsync" Try="TryFromFactAsync" />
                                @if (Facts.Count > 0)
                                {
                                    @* Understanding leads to experimenting on the same passage (0012). *@
                                    <div class="row handoff">
                                        <button @onclick="() => _tab = InspectorTab.Explore" title="@Text["workspace.toExploreHint"]">@Text["workspace.toExplore"] ›</button>
                                    </div>
                                }
                                break;
                            case InspectorTab.Explore:
                                <ExploreCard Try="TryExperimentAsync" Hear="CompareAsync" Keep="KeepExperimentAsync" Leave="LeaveExperimentAsync"
                                             Surprise="SurpriseAsync" HearInContext="HearAnswerAsync" ListenToChanged="SetListenToAsync" FactChosen="ShowFactAsync"
                                             NoteSaved="SaveKeptNoteAsync" />
                                @if (_variation is not null && _selection is { NoteIds.Count: > 0 })
                                {
                                    <ComparePanel />
                                }
                                @if (_selection is not null)
                                {
                                    @* Kept for this phrase (#78): what the player kept about the phrase, to open, rename, export or delete. *@
                                    <ObservationList Heading="@ListedHeading" Rows="KeptRows" SessionOnly="KeptForSessionOnly" CanKeepHeard="CanKeepHeard" CanWrite="true"
                                                     Status="@ObservationStatus" Open="OpenObservationAsync" Rename="RenameObservationAsync" Note="NoteObservationAsync"
                                                     Export="ExportObservationAsync" Delete="DeleteObservationAsync" KeepHeard="KeepHeardAsync" Write="WriteNoteAsync" />
                                }
                                break;
                            default:
                                @if (_scanCheck is not null && _project?.Scan is { } scan)
                                {
                                    <ScanCheckPanel Check="_scanCheck" Scan="scan" SelectedBars="SelectedScanBars" Show="ShowScanBarAsync" Correct="CorrectScanBarAsync"
                                                    Confirm="ConfirmScanBarsAsync" Unconfirm="UnconfirmScanBarAsync" />
                                }

                                @* The mechanisms behind the experiments (S1-E1 to S1-E5): Keep, the catalogue's operations and the steps, for shaping a variation by hand. *@
                                <div class="corrections shape" aria-label="@Text["tools.shape"]">
                                    <button class="section-toggle" aria-expanded="@(_showOperations ? "true" : "false")" @onclick="() => _showOperations = !_showOperations">
                                        <span class="caret" aria-hidden="true">@(_showOperations ? "▾" : "▸")</span>
                                        @Text["tools.shape"]
                                    </button>
                                    @if (_showOperations && _selection is { NoteIds.Count: > 0 })
                                    {
                                        <p class="meta">@Text["tools.shapeHint"]</p>
                                        <div class="group">
                                            <h3>@Text["tools.keep"]</h3>
                                            <select class="preset" @onchange="ApplyPresetChosenAsync" aria-label="@Text["tools.keepPreset"]" title="@(CurrentPreset is { } current ? PresetHint(current) : Text["tools.ownChoiceHint"])">
                                                @if (CurrentPreset is null)
                                                {
                                                    <option selected>@Text["tools.ownChoice"]</option>
                                                }
                                                @foreach (KeepPreset preset in KeepTable.Presets)
                                                {
                                                    <option value="@preset.Id" selected="@(_keep.SetEquals(preset.Keep))">@preset.LabelIn(Words)</option>
                                                }
                                            </select>
                                            <div class="keep" role="group" aria-label="@Text["tools.whatToKeep"]" title="@Text["tools.whatToKeepHint"]">
                                                @foreach (KeepProperty property in Enum.GetValues<KeepProperty>())
                                                {
                                                    <button class="@KeepClass(property)" aria-pressed="@(_keep.Contains(property) ? "true" : "false")" title="@KeepStatusText(property)" @onclick="() => ToggleKeepAsync(property)">
                                                        @KeepLabel(property)
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <div class="group">
                                            <label class="pick scope" title="@Text["tools.scopeHint"]">
                                                <span>@Text["tools.change"]</span>
                                                <select @onchange="SetScope" aria-label="@Text["tools.scopeLabel"]">
                                                    @foreach ((OperationScope scope, string key) in s_scopes)
                                                    {
                                                        <option value="@scope" selected="@(_scope == scope)">@Text[key]</option>
                                                    }
                                                </select>
                                            </label>
                                        </div>

                                        @foreach (OperationGroup group in s_operations)
                                        {
                                            string id = group.Operation.Id;
                                            bool open = _openGroups.Contains(id);
                                            <div class="group variation" role="group" aria-label="@OperationTitle(group.Operation)">
                                                <button class="section-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleGroup(id)">
                                                    <span class="caret" aria-hidden="true">@(open ? "▾" : "▸")</span>
                                                    @id @OperationTitle(group.Operation)
                                                    @if (_chain?.Pending?.Operation.Id == id)
                                                    {
                                                        <span class="kind">@Text["tools.trying"]</span>
                                                    }
                                                </button>
                                                @if (open)
                                                {
                                                    @if (group.Operation.DisabledReason(_keep, Words) is { } disabled)
                                                    {
                                                        <p class="meta">@disabled</p>
                                                    }
                                                    else if (_scope != OperationScope.All && !group.Operation.Supports(_scope))
                                                    {
                                                        <p class="meta">@Text["tools.wholeSelection"]</p>
                                                    }
                                                    <div class="choices" role="group" aria-label="@Text[$"op.{group.Operation.Id}.question"]">
                                                        @foreach (OperationChoice choice in group.Choices)
                                                        {
                                                            OperationParameters parameters = Scoped(group, choice);
                                                            string? reason = OperationUnavailable(group, parameters);
                                                            bool trying = _chain?.Pending?.Parameters == parameters;
                                                            <button class="@(trying ? "on" : null)" aria-pressed="@(trying ? "true" : "false")"
                                                                    disabled="@(reason is not null)" title="@(reason ?? Text[$"op.{choice.Key}.hint"])" @onclick="() => ProposeAsync(group, parameters)">
                                                                @ChoiceLabel(choice)
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="group">
                                            @if (StepsText is { } steps)
                                            {
                                                <p class="steps" aria-live="polite">@steps</p>
                                            }
                                            <div class="step-buttons" role="group" aria-label="@Text["tools.steps"]">
                                                <button class="primary" @onclick="AcceptStepAsync" disabled="@(_chain?.AcceptDisabledReason is not null)" title="@(_chain?.AcceptDisabledReason ?? Text["tools.acceptHint"])">@Text["tools.accept"]</button>
                                                <button @onclick="RejectStepAsync" disabled="@(_chain?.Pending is null)" title="@Text["tools.rejectHint"]">@Text["tools.reject"]</button>
                                                <button @onclick="UndoStepAsync" disabled="@(_chain?.CanUndo != true)" title="@Text["tools.undoHint"]">@Text["tools.undo"]</button>
                                                <button @onclick="RedoStepAsync" disabled="@(_chain?.CanRedo != true)" title="@Text["tools.redoHint"]">@Text["tools.redo"]</button>
                                            </div>
                                        </div>

                                        <div class="changed" aria-live="polite">
                                            <h3>@Text["tools.whatChanged"]</h3>
                                            <p>@(ExplanationText ?? Text["tools.pickChange"])</p>
                                            @foreach (string flag in _variation?.Flags ?? [])
                                            {
                                                <p class="meta">@Text.Format("tools.check", flag)</p>
                                            }
                                        </div>
                                        @if (_variation is not null)
                                        {
                                            <ComparePanel ShowFlags="false" />
                                        }

                                        <div class="group">
                                            <div class="row">
                                                <button @onclick="() => AuditionAsync(variation: false)">@Text["tools.hearOriginal"]</button>
                                                <button @onclick="() => AuditionAsync(variation: true)" disabled="@(_variation is null)">@Text["tools.hearVariation"]</button>
                                                <button @onclick="RemoveVariationAsync" disabled="@(_variation is null)">@Text["tools.removeVariation"]</button>
                                            </div>
                                            <div class="row">
                                                <button @onclick="() => ExportMidiAsync(variation: false)" title="@Text["tools.exportMotifHint"]">@Text["tools.exportMotif"]</button>
                                                <button @onclick="() => ExportMidiAsync(variation: true)" disabled="@(_variation is null)" title="@Text["tools.exportVariationHint"]">@Text["tools.exportVariation"]</button>
                                            </div>
                                        </div>
                                    }
                                    else if (_showOperations)
                                    {
                                        <p class="meta">@Text["tools.selectFirst"]</p>
                                    }
                                </div>

                                @if (_selection is { NoteIds.Count: > 0 } chosen)
                                {
                                    @* S1-E7, S1-E9: edit single notes of the variation; each edit is a step, and the Keep chips are checked again after it. *@
                                    <div class="corrections" aria-label="@Text["edit.label"]">
                                        <button class="section-toggle" aria-expanded="@(_showHandEdits ? "true" : "false")" @onclick="() => _showHandEdits = !_showHandEdits">
                                            <span class="caret" aria-hidden="true">@(_showHandEdits ? "▾" : "▸")</span>
                                            @Text.Format("edit.toggle", Text.Count("edit.edits", HandEditCount))
                                        </button>
                                        @if (_showHandEdits)
                                        {
                                            <p class="meta">@Text["edit.hint"]</p>
                                            <table class="notes-table">
                                                <thead>
                                                    <tr><th scope="col">@Text["notes.note"]</th><th scope="col">@Text["notes.where"]</th><th scope="col">@Text["notes.length"]</th><th scope="col">@Text["notes.velocity"]</th><th scope="col"></th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (Note note in HeardNotes(chosen))
                                                    {
                                                        bool edited = note.Attribution.Provenance == Provenance.UserEdited;
                                                        <tr class="@(edited ? "edited" : null)">
                                                            <td>
                                                                <button title="@Text["notes.lower"]" @onclick="() => EditNoteAsync(note, pitch: -1)">▼</button>
                                                                @note.Pitch
                                                                <button title="@Text["notes.higher"]" @onclick="() => EditNoteAsync(note, pitch: 1)">▲</button>
                                                            </td>
                                                            <td>
                                                                <button title="@Text["notes.earlier"]" disabled="@(note.Span.Onset.Value - SixteenthTicks < chosen.Span.Onset.Value)" @onclick="() => EditNoteAsync(note, onset: -SixteenthTicks)">◀</button>
                                                                @NotePosition(note)
                                                                <button title="@Text["notes.later"]" @onclick="() => EditNoteAsync(note, onset: SixteenthTicks)">▶</button>
                                                            </td>
                                                            <td>
                                                                <button title="@Text["notes.shorter"]" disabled="@(note.Span.Duration <= SixteenthTicks)" @onclick="() => EditNoteAsync(note, length: -SixteenthTicks)">−</button>
                                                                @VariationFacts.Length(note.Span.Duration, Words)
                                                                <button title="@Text["notes.longer"]" @onclick="() => EditNoteAsync(note, length: SixteenthTicks)">+</button>
                                                            </td>
                                                            <td>
                                                                <button title="@Text["notes.softer"]" disabled="@(note.Velocity <= Note.MinVelocity)" @onclick="() => EditNoteAsync(note, velocity: -10)">−</button>
                                                                @note.Velocity
                                                                <button title="@Text["notes.louder"]" disabled="@(note.Velocity >= Note.MaxVelocity)" @onclick="() => EditNoteAsync(note, velocity: 10)">+</button>
                                                            </td>
                                                            <td>
                                                                <button title="@Text["notes.addAfterHint"]" @onclick="() => AddNoteAfterAsync(note)">@Text["notes.addAfter"]</button>
                                                                <button title="@Text["notes.removeFromVariationHint"]" @onclick="() => RemoveVariationNoteAsync(note)">@Text["notes.remove"]</button>
                                                                @if (edited)
                                                                {
                                                                    <span class="kind">@Text["notes.editedByYou"]</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            @if (_handEditNote is not null)
                                            {
                                                <p class="meta" aria-live="polite">@_handEditNote</p>
                                            }
                                        }
                                    </div>
                                }

                                @* S1-I7: correct or remove imported notes. Every correction goes to the project's edit log; the imported notes stay as they were. *@
                                <div class="corrections" aria-label="@Text["correct.label"]">
                                    <button class="section-toggle" aria-expanded="@(_showCorrections ? "true" : "false")" @onclick="() => _showCorrections = !_showCorrections">
                                        <span class="caret" aria-hidden="true">@(_showCorrections ? "▾" : "▸")</span>
                                        @Text.Format("correct.toggle", Text.Count("correct.corrected", _edits.EditedIds.Count()))
                                    </button>
                                    @if (_showCorrections)
                                    {
                                        <p class="meta">@Text["correct.hint"]</p>
                                        <div class="row">
                                            <button @onclick="UndoCorrectionAsync" disabled="@_edits.IsEmpty" title="@Text["correct.undoHint"]">@Text["correct.undo"]</button>
                                            <span class="meta">@Text.Count("correct.inLog", _edits.Edits.Count)</span>
                                        </div>
                                        @if (_selection is { NoteIds.Count: > 0 } picked)
                                        {
                                            <table class="notes-table">
                                                <thead>
                                                    <tr><th scope="col">@Text["notes.note"]</th><th scope="col">@Text["notes.where"]</th><th scope="col">@Text["notes.length"]</th><th scope="col">@Text["notes.velocity"]</th><th scope="col"></th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (Note note in CorrectableNotes(picked))
                                                    {
                                                        bool edited = note.Attribution.Provenance == Provenance.UserEdited;
                                                        <tr class="@(edited ? "edited" : null)">
                                                            <td>
                                                                <button title="@Text["notes.lower"]" @onclick="() => CorrectAsync(note, pitch: -1)">▼</button>
                                                                @note.Pitch
                                                                <button title="@Text["notes.higher"]" @onclick="() => CorrectAsync(note, pitch: 1)">▲</button>
                                                            </td>
                                                            <td>
                                                                <button title="@Text["notes.earlier"]" disabled="@(note.Span.Onset.Value < SixteenthTicks)" @onclick="() => CorrectAsync(note, onset: -SixteenthTicks)">◀</button>
                                                                @NotePosition(note)
                                                                <button title="@Text["notes.later"]" @onclick="() => CorrectAsync(note, onset: SixteenthTicks)">▶</button>
                                                            </td>
                                                            <td>
                                                                <button title="@Text["notes.shorter"]" disabled="@(note.Span.Duration <= SixteenthTicks)" @onclick="() => CorrectAsync(note, length: -SixteenthTicks)">−</button>
                                                                @VariationFacts.Length(note.Span.Duration, Words)
                                                                <button title="@Text["notes.longer"]" @onclick="() => CorrectAsync(note, length: SixteenthTicks)">+</button>
                                                            </td>
                                                            <td>
                                                                <button title="@Text["notes.softer"]" disabled="@(note.Velocity <= Note.MinVelocity)" @onclick="() => CorrectAsync(note, velocity: -10)">−</button>
                                                                @note.Velocity
                                                                <button title="@Text["notes.louder"]" disabled="@(note.Velocity >= Note.MaxVelocity)" @onclick="() => CorrectAsync(note, velocity: 10)">+</button>
                                                            </td>
                                                            <td>
                                                                <button title="@Text["notes.removeFromPieceHint"]" @onclick="() => RemoveNoteAsync(note)">@Text["notes.remove"]</button>
                                                                @if (edited)
                                                                {
                                                                    <button title="@Text["notes.revertHint"]" @onclick="() => RevertNoteAsync(note)">@Text["notes.revert"]</button>
                                                                    <span class="kind">@Text["notes.editedByYou"]</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <p class="meta">@Text["correct.selectFirst"]</p>
                                        }
                                        @if (RemovedNotes.Count > 0)
                                        {
                                            <p class="meta">@Text.Format("correct.removed", string.Join(", ", RemovedNotes.Select(note => Text.Format("correct.noteAt", note.Pitch, NotePosition(note)))))</p>
                                            <div class="row">
                                                @foreach (Note note in RemovedNotes)
                                                {
                                                    <button @onclick="() => RevertNoteAsync(note)">@Text.Format("correct.revertAt", note.Pitch, NotePosition(note))</button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>

                                @* A second file as the variation (S1-W5): it plays on this piece's timeline, so A/B keeps the position. *@
                                <div class="corrections" aria-label="@Text["second.label"]">
                                    <button class="section-toggle" aria-expanded="@(_showSecondFile ? "true" : "false")" @onclick="() => _showSecondFile = !_showSecondFile">
                                        <span class="caret" aria-hidden="true">@(_showSecondFile ? "▾" : "▸")</span>
                                        @Text["second.toggle"]
                                    </button>
                                    @if (_showSecondFile)
                                    {
                                        <section class="row">
                                            <label class="file">
                                                @Text["second.open"]
                                                <InputFile OnChange="OpenSecondFileAsync" accept="@PieceImporter.AcceptedExtensions" />
                                            </label>
                                            @if (_secondTitle is not null)
                                            {
                                                <span class="meta">@_secondTitle</span>
                                                <button @onclick="RemoveSecondFileAsync">@Text["notes.remove"]</button>
                                            }
                                            else
                                            {
                                                <span class="meta">@Text["second.hint"]</span>
                                            }
                                        </section>
                                        @if (_secondMessage is not null)
                                        {
                                            <p class="error">@_secondMessage</p>
                                            <p class="meta">@_secondTip</p>
                                        }
                                        @foreach (string difference in _secondDifferences)
                                        {
                                            <p class="meta">@Text.Format("second.difference", difference)</p>
                                        }

                                        <section class="row tracks">
                                            @foreach (int track in _tracks)
                                            {
                                                <span class="track">@Text.Format("second.track", track + 1)</span>
                                                <button class="@(Player.Muted.Contains(track) ? "on" : null)" @onclick="() => ToggleTrackAsync(track, solo: false)">@Text["second.mute"]</button>
                                                <button class="@(Player.Soloed.Contains(track) ? "on" : null)" @onclick="() => ToggleTrackAsync(track, solo: true)">@Text["second.solo"]</button>
                                            }
                                        </section>
                                    }
                                </div>
                                break;
                        }
                    </div>
                </aside>
            </div>

            <footer class="transport-bar" aria-label="@Text["transport.label"]">
                <button class="play" @onclick="TogglePlayAsync" aria-label="@(Player.State == PlaybackState.Stopped ? Text["transport.play"] : Text["transport.pause"])">
                    @if (Player.State != PlaybackState.Stopped)
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z" /></svg>
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
                    }
                </button>
                <button @onclick="StopAsync">@Text["transport.stop"]</button>
                <input class="seek" type="range" min="0" max="@_score.End.Value" step="1" value="@Player.Position.Value"
                       @onchange="SeekAsync" aria-label="@Text["transport.position"]" />
                <span class="position" aria-live="off">@PositionText</span>
                <span class="meta state">@StateText</span>
                <label class="tempo">@Text["transport.tempo"] <input type="range" min="25" max="150" step="5" value="@TempoPercent" @oninput="SetTempoAsync" /> <span class="mono">@TempoPercent%</span></label>
                <label><input type="checkbox" checked="@Player.Metronome" @onchange="ToggleMetronomeAsync" /> @Text["transport.metronome"]</label>
                <label><input type="checkbox" checked="@Player.CountIn" @onchange="ToggleCountInAsync" /> @Text["transport.countIn"]</label>
            </footer>
        }

        <p class="credit">
            @Text["credit.piano"] <a href="https://archive.org/details/SalamanderGrandPianoV3">Salamander Grand Piano V3</a> @Text["credit.by"] Alexander Holm,
            <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>, @Text["credit.shortened"]
            @Text["credit.engraving"] <a href="https://www.verovio.org">Verovio</a> 6.3.0,
            <a href="lib/verovio/COPYING.LESSER.txt">LGPL 3.0</a>, <a href="https://github.com/rism-digital/verovio/tree/version-6.3.0">@Text["credit.source"]</a>.
        </p>
    </main>
