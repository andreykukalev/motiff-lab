    /// <summary>What the shown score is, and what was inferred to write it (decision record 0008).</summary>
    /// <summary>The key signatures the score is written with: the piece's, or for notes heard in a recording, the key worked out from them.</summary>
    private IEnumerable<KeyChange> NotationKeys() => _heardKey is { } heardKey
        ? [new KeyChange(Tick.Zero, heardKey.Fifths)]
        : _keys.Select(key => new KeyChange(key.At, Math.Clamp(key.Fifths, -7, 7)));

    /// <summary>The piece's notes engraved, in the mode the player chose for notes heard in a recording.</summary>
    private GeneratedNotation Notation(IEnumerable<Note> notes, Tick end) =>
        _heard ? HeardNotation(notes, _meter!, NotationKeys(), end, ScoreTitle.Of(_title), _score!) : NotationGenerator.Generate(notes, _meter!, NotationKeys(), end, ScoreTitle.Of(_title));

    private GeneratedNotation HeardNotation(IEnumerable<Note> notes, MeterMap meter, IEnumerable<KeyChange> keys, Tick end, string? title, PlaybackScore played) =>
        _readable
            ? NotationGenerator.Generate(notes, meter, keys, end, title, asHeard: true)
            : NotationGenerator.Generate(notes, meter, keys, end, title, playedTempos: played.Tempos, pedal: played.Pedal.Select(held => held.Span));

    /// <summary>Notes heard in a recording, written for reading or as played.</summary>
    private void SetReadable(bool readable)
    {
        if (_readable == readable || _score is null || _notes is null)
        {
            return;
        }

        _readable = readable;
        _generated = ScoreSource.FromNotes(Notation(_notes, _score.End));
        if (_variationScore is not null && _variation is { } variation)
        {
            _variationScore = VariationScore(variation);
        }
    }

    private string ScoreNote(ScoreSource source)
    {
        if (source.Generated is not { } notation)
        {
            return Text["score.asWrittenNote"];
        }

        var parts = new List<string> { Text["score.generatedNote"] };
        if (notation.WrittenAsHeard)
        {
            parts.Add(Text["score.readableNote"]);
            if (notation.GraceNoteCount > 0)
            {
                parts.Add(Text.Count("score.graceNotes", notation.GraceNoteCount));
            }
        }
        else if (_heard)
        {
            parts.Add(Text["score.asPlayedNote"]);
            if (notation.DynamicCount + notation.AccentCount + notation.TempoWordCount + notation.HairpinCount > 0)
            {
                parts.Add(Text["score.playingMarks"]);
            }

            if (notation.SlurCount > 0)
            {
                parts.Add(Text["score.slurs"]);
            }

            if (notation.PedalCount > 0)
            {
                parts.Add(Text["score.pedal"]);
            }
        }
        else if (notation.ApproximatedNoteCount > 0)
        {
            parts.Add(Text.Format("score.approximated", notation.ApproximatedNoteCount, Text.Count("score.ofNotes", notation.NoteCount)));
        }

        if (notation.TripletCount > 0)
        {
            parts.Add($"{notation.TripletCount} beats are written as triplets: their notes fall on thirds or sixths of the beat rather than on 16ths.");
        }

        if (_heard && _heardKey is { } key)
        {
            parts.Add(Text.Format("score.heardKey", key.NameIn(Words)));
        }

        if (notation.ShortenedNoteCount > 0)
        {
            parts.Add(Text.Count("score.shortened", notation.ShortenedNoteCount));
        }

        if (notation.Staves.Any(staff => staff.IsSplitInferred))
        {
            parts.Add(Text["score.split"]);
        }

        parts.Add(Text["score.clickNote"]);
        return string.Join(" ", parts);
    }

    /// <summary>
    /// Space (S1-W4, S1-M5): with notes selected it starts looping them and playing, or pauses and
