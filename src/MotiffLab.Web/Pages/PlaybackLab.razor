    /// <summary>
    /// What the player can hear alone while the phrase loops: a hand when the selection has notes in both,
    /// and the melody or the accompaniment when it has a melody over an accompaniment.
    /// </summary>
    private IReadOnlyList<(ListenTo Choice, string Label)> ListenChoices
    {
        get
        {
            Note[] notes = SelectedNotes;
            bool hands = notes.Any(note => note.Hand?.Value == Hand.Right) && notes.Any(note => note.Hand?.Value == Hand.Left);
            var choices = new List<(ListenTo, string)> { (ListenTo.Everything, Text[hands && !_layered ? "listen.bothHands" : "explore.everything"]) };
            if (hands)
            {
                choices.Add((ListenTo.RightHand, Text["filter.rightHand"]));
                choices.Add((ListenTo.LeftHand, Text["filter.leftHand"]));
            }

            if (_layered)
            {
                choices.Add((ListenTo.Melody, Text["explore.melodyAlone"]));
                choices.Add((ListenTo.Accompaniment, Text["explore.accompanimentAlone"]));
            }

            return choices;
        }
    }

    /// <summary>Says when the hands are a reading of the notes rather than marked in the file.</summary>
    private string? HandsNote =>
        ListenChoices.Any(choice => choice.Choice == ListenTo.RightHand) && SelectedNotes.Any(note => note.Hand?.Attribution.Provenance == Provenance.Inferred)
            ? Text["listen.handsInferred"]
            : _layered ? Text["explore.listenHintShort"] : null;

    private Note[] SelectedNotes
    {
        get
        {
            if (_selection is not { NoteIds.Count: > 0 } selection)
            {
                return [];
            }

            var ids = selection.NoteIds.ToHashSet(StringComparer.Ordinal);
