    private async Task LoadFurEliseAsync()
    {
        await LoadPieceAsync(FurElise.Import(), FurElise.Title);
        // Für Elise has no project, so the address no longer names one.
        if (ProjectId is not null)
        {
            Navigation.NavigateTo("playback", replace: true);
        }

        await Analytics.TrackAsync(AnalyticsEvent.StarterOpened("fur_elise"));
    }

    private async Task OpenFileAsync(InputFileChangeEventArgs args)
    {
        (_message, _tip) = (null, null);
        (PieceImportResult result, byte[] data) = await ReadAsync(args.File);
        if (result.Piece is { } piece)
        {
            // Saved as a project, as the import screen does (S1-P1), so it is still there after a reload.
            // The workspace opens it as it opens an imported piece.
            var project = Project.Create($"p_{Guid.NewGuid():N}", piece.FileName, data, DateTimeOffset.Now);
            ResumePoint point = ResumePoint.Start(project.NextResumePointId(), DateTimeOffset.Now);
            project = project.AddResumePoint(point);
            await Projects.SaveAsync(project);
            CurrentPiece.Open(piece, SelectionFilter.All, project);
            Navigation.NavigateTo(CurrentPiece.WorkspaceUrl(project, point.Id), replace: true);
            return;
        }

        (_message, _tip) = (result.Rejection?.Text(Words), result.Rejection?.TipIn(Words));
    }

    /// <summary>Reads a picked file on the device and imports it; the file never leaves the browser.</summary>
    private static async Task<(PieceImportResult Result, byte[] Data)> ReadAsync(IBrowserFile file)
    {
        if (PieceImporter.CheckSize(file.Size) is { } rejection)
        {
            return (new(null, rejection), []);
        }

        await using Stream stream = file.OpenReadStream(PieceImporter.MaxFileBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        byte[] data = memory.ToArray();
        return (PieceImporter.Import(file.Name, data), data);
    }

    /// <param name="title">The piece's name, when it is not its file's (Für Elise).</param>
    private async Task LoadPieceAsync(ImportedPiece piece, string? title = null)
    {
        string? scoreTitle = title ?? ScoreTitle.Of(piece.FileName);
        // MIDI cannot mark accents, so a MIDI piece has no accent fact rather than "no accents".
        _accents = piece.MusicXml?.AccentMarks;
        _characterContext = CharacterContext.FromPiece(piece);
        // MIDI has no slurs or repeat signs; rests still mark phrase boundaries.
        _phraseMarks = piece.MusicXml?.PhraseMarks ?? PhraseMarks.None;
        _heard = Transcribed.IsHeard(piece);
        _heardKey = _heard && piece.Keys.Count == 0 ? Transcribed.KeyOf(piece.Notes) : null;
        if (piece.Midi is { } midi)
        {
            var score = PlaybackScore.FromMidi(midi);
            GeneratedNotation notation = _heard
                ? HeardNotation(midi.Notes, midi.Meter, _heardKey is { } heardKey ? [new KeyChange(Tick.Zero, heardKey.Fifths)] : [], midi.End, scoreTitle, score)
                : NotationGenerator.FromMidi(midi, scoreTitle);
            await LoadAsync((score, piece.Meter, piece.Notes), title ?? piece.FileName, notation, musicXml: null, piece.Keys);
            return;
        }

        MusicXmlImport import = piece.MusicXml!;
        using var text = new StreamReader(new MemoryStream(piece.ScoreXml!), detectEncodingFromByteOrderMarks: true);
        await LoadAsync((PlaybackScore.FromMusicXml(import), piece.Meter, piece.Notes), title ?? piece.FileName, NotationGenerator.FromMusicXml(import, scoreTitle), await text.ReadToEndAsync(), piece.Keys);
    }

    private async Task LoadAsync((PlaybackScore Score, MeterMap Meter, IReadOnlyList<Note> Notes) piece, string title, GeneratedNotation notation, string? musicXml, IReadOnlyList<KeySignature> keys)
    {
        _keys = keys;
        _generated = ScoreSource.FromNotes(notation);
        _asWritten = musicXml is null ? null : ScoreSource.AsWritten(musicXml);
        _variationScore = null;
