    /// <summary>The choice's parameters, limited to the chosen layer when the operation can be.</summary>
    private OperationParameters Scoped(OperationGroup group, OperationChoice choice) =>
        group.Operation.Supports(_scope) ? choice.Parameters with { Scope = _scope } : choice.Parameters;

    /// <summary>Why a parameter cannot run on the current notes with these Keep choices, or null.</summary>
    private string? OperationUnavailable(OperationGroup group, OperationParameters parameters) => _selection is { } selection
        ? (_chain ?? StartChain(selection)).UnavailableReason(group.Operation, parameters)
        : Text["tools.selectNotesFirst"];

    private void ToggleGroup(string id)
