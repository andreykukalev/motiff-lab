    private Task ApplyPresetChosenAsync(ChangeEventArgs args) =>
        KeepTable.Presets.FirstOrDefault(preset => preset.Id == args.Value?.ToString()) is { } preset ? ApplyPresetAsync(preset) : Task.CompletedTask;

    /// <summary>"Suggests Rhythm reshape, Density and rests and Accent shift.", read from the Keep table.</summary>
    private string PresetHint(KeepPreset preset)
