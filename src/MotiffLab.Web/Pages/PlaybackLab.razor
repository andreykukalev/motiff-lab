        _phrases is { } map ? ChangePhrasesAsync(map.JoinWithNext(phrase), phrase.Span) : Task.CompletedTask;

    /// <summary>Drops the player's boundaries; the selection stays as it is.</summary>
    private Task ResetPhrasesAsync() =>
        _phrases is not null ? ChangePhrasesAsync(PhraseEdits.None, around: null) : Task.CompletedTask;

    /// <summary>
