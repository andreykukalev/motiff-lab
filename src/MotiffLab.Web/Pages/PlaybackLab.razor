@page "/playback"
@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Events
@using MotiffLab.MusicCore.Import
@using MotiffLab.MusicCore.Import.MusicXml
@using MotiffLab.MusicCore.Motifs
@using MotiffLab.MusicCore.Notation
@using MotiffLab.MusicCore.Playback
@using MotiffLab.MusicCore.Projects
@using MotiffLab.MusicCore.Time
@using MotiffLab.MusicCore.Variations
@using MotiffLab.Web.Facts
@using MotiffLab.Web.Import
@using MotiffLab.Web.Playback
@using MotiffLab.Web.Projects
@using MotiffLab.Web.Roll
@using MotiffLab.Web.Score
@implements IDisposable
@inject Player Player
@inject CurrentPiece CurrentPiece
@inject ProjectStore Projects

<PageTitle>Playback · Motiff Lab</PageTitle>

@* A test bench for the playback engine (S1-W4, S1-W5), the piano roll and keyboard (S1-W2, S1-W3), motif selection, its loop and its facts (S1-M1, S1-M2, S1-M5, S1-A1, S1-A2) and the score view (S1-W7) and a second file as the variation (S1-W5) until the workspace exists. Files stay on the device. *@
<main class="lab">
    <h1>Playback</h1>
    <p class="meta">A test bench for playback until the workspace lands. Open a MIDI or MusicXML file or use the demo; nothing leaves this device.</p>

    @if (Player.Error is not null)
    {
        <p class="error">@Player.Error</p>
    }
    else if (!Player.IsReady)
    {
        <p class="meta">Loading the piano…</p>
    }

    <section class="row">
        <button @onclick="LoadDemoAsync" disabled="@(!Player.IsReady)">Demo piece</button>
        <label class="file">
            Open file
            <InputFile OnChange="OpenFileAsync" accept="@PieceImporter.AcceptedExtensions" disabled="@(!Player.IsReady)" />
        </label>
        <a href="import">Import with the report</a>
        @if (_title is not null)
        {
            <span class="meta">@_title</span>
        }
    </section>
    @if (_message is not null)
    {
        <p class="error">@_message</p>
        <p class="meta">@_tip</p>
    }

    @if (_score is not null && _meter is not null)
    {
        <section class="row transport">
            <button class="primary" @onclick="TogglePlayAsync">@(Player.State == PlaybackState.Stopped ? "Play" : "Pause")</button>
            <button @onclick="StopAsync">Stop</button>
            <span class="position" aria-live="off">@PositionText</span>
            <span class="meta">@StateText</span>
            <input class="seek" type="range" min="0" max="@_score.End.Value" step="1" value="@Player.Position.Value"
                   @onchange="SeekAsync" aria-label="Position" />
            <label>Tempo <input type="range" min="25" max="150" step="5" value="@TempoPercent" @oninput="SetTempoAsync" /> @TempoPercent%</label>
            <label><input type="checkbox" checked="@Player.Metronome" @onchange="ToggleMetronomeAsync" /> Metronome</label>
            <label><input type="checkbox" checked="@Player.CountIn" @onchange="ToggleCountInAsync" /> Count-in</label>
        </section>

        @* Which notes play and light up (S1-M2), what is heard, and whether the score shows. *@
        <section class="row toolbar">
            <label>
                Notes
                <select @onchange="SetFilterAsync" aria-label="Which notes play, light up and can be selected">
                    @for (int i = 0; i < _filters.Length; i++)
                    {
                        <option value="@i" selected="@(_filters[i].Filter == _filter)">@_filters[i].Label</option>
                    }
                    @foreach (string category in s_coreCategories)
                    {
                        <option disabled>@category (needs voice and chord analysis)</option>
                    }
                </select>
            </label>
            <span class="divider" aria-hidden="true"></span>
            <span>Hear</span>
            @foreach ((string label, string[] ids) in Sources)
            {
                <label><input type="radio" name="source" checked="@_hear.SequenceEqual(ids)" @onchange="() => HearAsync(ids)" /> @label</label>
            }
            <span class="divider" aria-hidden="true"></span>
            <label><input type="checkbox" checked="@_showScore" @onchange="() => _showScore = !_showScore" /> Score</label>
            @if (_showScore)
            {
                @foreach ((ScoreChoice choice, string label) in ScoreChoices)
                {
                    <label><input type="radio" name="score" checked="@(ShownChoice == choice)" @onchange="() => _scoreChoice = choice" /> @label</label>
                }
            }
        </section>

        @* The roll on the left and the score on the right; without the score the roll takes the width. *@
        <div class="workspace @(_showScore && ShownScore is not null ? "with-score" : null)">
            <section class="roll-panel">
                <PianoRoll Notes="_notes" Score="_score" Meter="_meter" Motif="_selection" MotifPlaysAlone="_looping"
                           Kept="_keptIds" Variation="_variation" PlayRange="ShownRange" OriginalAudible="OriginalAudible" VariationAudible="VariationAudible"
                           RangePicked="OnRangePickedAsync" Cleared="ClearSelectionAsync" PlayPausePressed="PlayPauseAsync" />
            </section>
            @if (_showScore && ShownScore is { } shown)
            {
                @* Clicks on the page outside the roll clear the selection, except inside panels marked data-keeps-selection (docs/ui-conventions.md). *@
                <section class="score-panel" data-keeps-selection>
                    <ScoreView Source="shown" Range="ShownRange" />
                    <p class="meta">@ScoreNote(shown)</p>
                </section>
            }
        </div>

        <div class="below">
            <section class="selection" aria-label="Selection" data-keeps-selection>
                <div class="row">
                    <button class="@(_looping ? "on" : "primary")" @onclick="ToggleLoopSelectionAsync" disabled="@(_selection is not { NoteIds.Count: > 0 })">
                        @(_looping ? "Stop looping" : "Loop selection")
                    </button>
                    <button @onclick="ClearSelectionAsync" disabled="@(_selection is null)">Clear</button>
                    <span class="meta" aria-live="polite">@SelectionText</span>
                </div>

                <div class="variation" aria-label="Rhythm reshape">
                    <h2>V1 Rhythm reshape</h2>
                    <p class="meta">Moves when the selected notes start and how long they last; the pitches stay. Pick a reshape to hear it at once, then accept it to build the next step on it, or reject it. In the roll each reshaped note is outlined where it lands, with a line from where it was.</p>
                    @if (_selection is { NoteIds.Count: > 0 })
                    {
                        <div class="segmented" role="group" aria-label="How to reshape the rhythm">
                            @for (int i = 0; i < s_reshapes.Length; i++)
                            {
                                int index = i;
                                string? reason = ReshapeUnavailable(index);
                                bool trying = _chain?.Pending?.Parameters == s_reshapes[index].Parameters;
                                <button class="@(trying ? "on" : null)" aria-pressed="@(trying ? "true" : "false")"
                                        disabled="@(reason is not null)" title="@(reason ?? s_reshapes[index].Hint)" @onclick="() => ReshapeAsync(index)">
                                    @s_reshapes[index].Label
                                </button>
                            }
                        </div>
                        <div class="row" role="group" aria-label="Steps">
                            <button class="primary" @onclick="AcceptStepAsync" disabled="@(_chain?.AcceptDisabledReason is not null)" title="@(_chain?.AcceptDisabledReason ?? "Keep this step; the next reshape builds on it.")">Accept step</button>
                            <button @onclick="RejectStepAsync" disabled="@(_chain?.Pending is null)" title="Drop this step and go back to the accepted ones.">Reject step</button>
                            <button @onclick="UndoStepAsync" disabled="@(_chain?.CanUndo != true)" title="Take back the last accepted step.">Undo</button>
                            <button @onclick="RedoStepAsync" disabled="@(_chain?.CanRedo != true)" title="Bring back the last step you undid.">Redo</button>
                            <span class="meta" aria-live="polite">@StepsText</span>
                        </div>
                        <div class="row">
                            <button @onclick="() => AuditionAsync(variation: false)">Hear original</button>
                            <button @onclick="() => AuditionAsync(variation: true)" disabled="@(_variation is null)">Hear variation</button>
                            <button @onclick="RemoveVariationAsync" disabled="@(_variation is null)">Remove variation</button>
                        </div>
                        <div class="row" role="group" aria-label="Keep presets">
                            @foreach (KeepPreset preset in KeepTable.Presets)
                            {
                                bool on = _keep.SetEquals(preset.Keep);
                                <button class="@(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" title="@PresetHint(preset)" @onclick="() => ApplyPresetAsync(preset)">
                                    @preset.Label
                                </button>
                            }
                        </div>
                        <div class="row keep" role="group" aria-label="What to keep">
                            <span title="Properties the variation should leave as they are. A chip turns dashed when the step changes it.">Keep</span>
                            @foreach (KeepProperty property in Enum.GetValues<KeepProperty>())
                            {
                                <button class="@KeepClass(property)" aria-pressed="@(_keep.Contains(property) ? "true" : "false")" title="@KeepStatusText(property)" @onclick="() => ToggleKeepAsync(property)">
                                    @KeepLabel(property)
                                </button>
                            }
                        </div>
                        <p class="meta" aria-live="polite">@(DisabledReason ?? ExplanationText ?? "Keep marks what should stay the same; rhythm reshape needs Keep rhythm off. The original notes are never changed.")</p>
                        @foreach (string flag in _variation?.Flags ?? [])
                        {
                            <p class="meta">Check: @flag</p>
                        }
                    }
                    else
                    {
                        <p class="meta">Select some bars on the roll first: drag across it, or click a bar number.</p>
                    }
                </div>
            </section>

            <section class="facts-panel" aria-label="Facts" data-keeps-selection>
                <h2>Facts about the selection</h2>
                @if (Facts.Count == 0)
                {
                    <p class="meta">Select some bars to see what music-core finds in them.</p>
                }
                <FactsPanel Facts="Facts" />
            </section>
        </div>

        @* A second file as the variation (S1-W5): it plays on this piece's timeline, so A/B keeps the position. *@
        <section class="row">
            <label class="file">
                Open a second file
                <InputFile OnChange="OpenSecondFileAsync" accept="@PieceImporter.AcceptedExtensions" />
            </label>
            @if (_secondTitle is not null)
            {
                <span class="meta">@_secondTitle</span>
                <button @onclick="RemoveSecondFileAsync">Remove</button>
            }
            else
            {
                <span class="meta">Compare the piece with another file, such as your own variation of it.</span>
            }
        </section>
        @if (_secondMessage is not null)
        {
            <p class="error">@_secondMessage</p>
            <p class="meta">@_secondTip</p>
        }
        @foreach (string difference in _secondDifferences)
        {
            <p class="meta">Second file: @difference</p>
        }

        <section class="row tracks">
            @foreach (int track in _tracks)
            {
                <span class="track">Track @(track + 1)</span>
                <button class="@(Player.Muted.Contains(track) ? "on" : null)" @onclick="() => ToggleTrackAsync(track, solo: false)">Mute</button>
                <button class="@(Player.Soloed.Contains(track) ? "on" : null)" @onclick="() => ToggleTrackAsync(track, solo: true)">Solo</button>
            }
        </section>
    }

    <p class="credit">
        Piano: <a href="https://archive.org/details/SalamanderGrandPianoV3">Salamander Grand Piano V3</a> by Alexander Holm,
        <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>, shortened and re-encoded for Motiff Lab.
        Score engraving: <a href="https://www.verovio.org">Verovio</a> 6.3.0,
        <a href="lib/verovio/COPYING.LESSER.txt">LGPL 3.0</a>, <a href="https://github.com/rism-digital/verovio/tree/version-6.3.0">source</a>.
    </p>
</main>

@code {
    private const string VariationSource = "variation";

    /// <summary>The selected notes alone, played while the selection loops.</summary>
    private const string SelectionSource = "selection";

    private static readonly (string Label, RhythmReshapeParameters Parameters, string Hint)[] s_reshapes =
    [
        ("Syncopate", new(RhythmReshapeKind.Syncopate), "Notes on a beat start half a beat early and are held into the beat."),
        ("Dotted", new(RhythmReshapeKind.Dotted), "Pairs of equal quarters or eighths become long–short."),
        ("Half-time", new(RhythmReshapeKind.HalfTime), "Every note twice as long, and twice as far from the start of the selection."),
        ("Double-time", new(RhythmReshapeKind.DoubleTime), "Every note half as long, and half as far from the start of the selection."),
        ("Later by 1 eighth", new(RhythmReshapeKind.Displace, 1), "Every note starts an eighth later; lengths stay."),
        ("Later by 2 eighths", new(RhythmReshapeKind.Displace, 2), "Every note starts a quarter later; lengths stay."),
        ("Later by 3 eighths", new(RhythmReshapeKind.Displace, 3), "Every note starts three eighths later; lengths stay."),
    ];

    /// <summary>Note categories the player expects but music-core cannot pick out yet; shown, not offered (S1-A3).</summary>
    private static readonly string[] s_coreCategories = ["Melody", "Bass", "Harmony"];

    /// <summary>A second file opened as the variation (S1-W5).</summary>
    private const string SecondFileId = "second-file";

    private static readonly (string Label, string[] Ids)[] s_sources =
    [
        ("Original", [Player.OriginalSource]),
        ("Variation", [VariationSource]),
        ("Both", [Player.OriginalSource, VariationSource]),
    ];

    private static readonly (string Label, string[] Ids)[] s_secondFileSources =
    [
        ("Second file", [SecondFileId]),
        ("Original and second file", [Player.OriginalSource, SecondFileId]),
    ];

    private (string Label, string[] Ids)[] Sources => _secondTitle is null ? s_sources : [.. s_sources, .. s_secondFileSources];

    private PlaybackScore? _score;
    private IReadOnlyList<Note>? _notes;
    private MeterMap? _meter;
    private int[] _tracks = [];
    private int _lastBar;
    private MotifSelection? _selection;
    private MotifAnalysis? _analysis;
    private StructureAnalysis? _structure;
    private IReadOnlyList<MotifFact> _character = [];
    private CharacterContext? _characterContext;
    private PhraseMarks _phraseMarks = PhraseMarks.None;
    private IReadOnlyList<KeySignature> _keys = [];
    private IReadOnlyList<AccentMark>? _accents;
    private SelectionFilter _filter = SelectionFilter.All;
    private (string Label, SelectionFilter Filter)[] _filters = [("All notes", SelectionFilter.All)];

    /// <summary>The ids of the notes the filter keeps, for the roll; null when it keeps them all.</summary>
    private IReadOnlyCollection<string>? _keptIds;
    private string? _selectionNote;

    /// <summary>Everything music-core found about the selection, for the facts panel to group by lens.</summary>
    private IReadOnlyList<MotifFact> Facts => [.. _analysis?.Facts ?? [], .. _structure?.Facts ?? [], .. _character];
    private readonly HashSet<KeepProperty> _keep = [KeepProperty.Pitches, KeepProperty.PitchOrder];
    /// <summary>The steps made from the selection (S1-E5, S1-E8); null when none were tried.</summary>
    private VariationChain? _chain;
    /// <summary>The chain's result, as heard and drawn: the original against every accepted step and the pending one.</summary>
    private Variation? _variation;
    private bool _looping;
    /// <summary>What the player chose to hear. While the selection loops, the original stands for the selection's notes alone.</summary>
    private string[] _hear = [Player.OriginalSource];
    private string? _title;
    private string? _message;
    private string? _tip;
    private string? _secondTitle;
    private string? _secondMessage;
    private string? _secondTip;
    private IReadOnlyList<string> _secondDifferences = [];
    private int _pieceVersion;

    /// <summary>The project the piece autosaves to (S1-P1); null for files opened here or the demo.</summary>
    private Project? _project;

    /// <summary>The motif the lab's selection is saved as. The lab works on one motif; a project can hold more.</summary>
    private string _motifId = "m_0001";

    /// <summary>True while a saved project is put back, so the steps of restoring do not autosave over it.</summary>
    private bool _restoring;
    private ScoreSource? _asWritten;
    private ScoreSource? _generated;

    /// <summary>The piece with the variation in place of the motif, engraved from the notes; null without a variation.</summary>
    private ScoreSource? _variationScore;
    private bool _showScore = true;
    private ScoreChoice _scoreChoice = ScoreChoice.AsWritten;

    private enum ScoreChoice
    {
        AsWritten,
        Generated,
        Variation,
    }

    private IEnumerable<(ScoreChoice Choice, string Label)> ScoreChoices
    {
        get
        {
            if (_asWritten is not null)
            {
                yield return (ScoreChoice.AsWritten, "As written");
            }

            yield return (ScoreChoice.Generated, "Generated from the notes");
            if (_variationScore is not null)
            {
                yield return (ScoreChoice.Variation, "With the variation");
            }
        }
    }

    /// <summary>The choice in effect: one that is not available falls back to the file as written, else the generated score.</summary>
    private ScoreChoice ShownChoice => _scoreChoice switch
    {
        ScoreChoice.Variation when _variationScore is not null => ScoreChoice.Variation,
        ScoreChoice.AsWritten or ScoreChoice.Variation when _asWritten is not null => ScoreChoice.AsWritten,
        _ => ScoreChoice.Generated,
    };

    private ScoreSource? ShownScore => ShownChoice switch
    {
        ScoreChoice.Variation => _variationScore,
        ScoreChoice.AsWritten => _asWritten,
        _ => _generated,
    };

    /// <summary>The piece's notes are heard: the original, or the selection on its own.</summary>
    private bool OriginalAudible => Player.ActiveSources.Contains(Player.OriginalSource) || Player.ActiveSources.Contains(SelectionSource);

    private bool VariationAudible => Player.ActiveSources.Contains(VariationSource);

    private int TempoPercent => (int)Math.Round(Player.Tempo * 100);

    private string PositionText
    {
        get
        {
            MetricPosition position = _meter!.ToPosition(Player.Position);
            return $"Bar {position.Bar}, beat {position.Beat}";
        }
    }

    private string StateText => Player.State switch
    {
        PlaybackState.CountingIn => "Count-in",
        PlaybackState.Playing => "Playing",
        _ => "Stopped",
    };

    protected override void OnInitialized()
    {
        Player.Changed += OnPlayerChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Player.InitializeAsync();
        }

        // A piece opened from the import screen (N2), with the track or hand the player chose to start with.
        if (CurrentPiece.Piece is { } piece && CurrentPiece.Version != _pieceVersion && Player.IsReady)
        {
            _pieceVersion = CurrentPiece.Version;
            await LoadPieceAsync(piece);
            if (_filters.Any(filter => filter.Filter == CurrentPiece.StartWith))
            {
                _filter = CurrentPiece.StartWith;
            }

            _project = CurrentPiece.Project;
            if (CurrentPiece.Opened is { Motifs.Count: > 0 } opened)
            {
                await RestoreAsync(opened);
            }

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Player.Changed -= OnPlayerChanged;
    }

    private void OnPlayerChanged() => _ = InvokeAsync(StateHasChanged);

    private Task LoadDemoAsync()
    {
        (PlaybackScore score, MeterMap meter, IReadOnlyList<Note> notes) = DemoPiece.Create();
        GeneratedNotation notation = NotationGenerator.Generate(notes, meter, [], score.End, "Demo piece");
        _accents = null;
        _phraseMarks = PhraseMarks.None;
        _characterContext = new CharacterContext(score.Tempos, TempoAssumed: false, FromNotation: false);
        return LoadAsync((score, meter, notes), "Demo piece (two hands, 3/4 with a pickup)", notation, musicXml: null, keys: []);
    }

    private async Task OpenFileAsync(InputFileChangeEventArgs args)
    {
        (_message, _tip) = (null, null);
        PieceImportResult result = await ReadAsync(args.File);
        if (result.Piece is { } piece)
        {
            await LoadPieceAsync(piece);
            return;
        }

        (_message, _tip) = (result.Rejection?.Message, result.Rejection?.Tip);
    }

    /// <summary>Reads a picked file on the device and imports it; the file never leaves the browser.</summary>
    private static async Task<PieceImportResult> ReadAsync(IBrowserFile file)
    {
        if (PieceImporter.CheckSize(file.Size) is { } rejection)
        {
            return new(null, rejection);
        }

        await using Stream stream = file.OpenReadStream(PieceImporter.MaxFileBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        return PieceImporter.Import(file.Name, memory.ToArray());
    }

    /// <summary>Opens a second file as the variation source and switches to it at the same position (S1-W5).</summary>
    private async Task OpenSecondFileAsync(InputFileChangeEventArgs args)
    {
        (_secondMessage, _secondTip) = (null, null);
        PieceImportResult result = await ReadAsync(args.File);
        if (result.Piece is not { } piece || _score is null)
        {
            (_secondMessage, _secondTip) = (result.Rejection?.Message, result.Rejection?.Tip);
            return;
        }

        if (_looping)
        {
            await StopLoopingAsync();
        }

        SecondFileSource second = SecondFileSource.Align(_score, piece);
        if (second.Timeline != _score)
        {
            // The second file runs longer: reload the timeline, which stops playback, and come back to the same place.
            Tick position = Player.Position;
            _score = second.Timeline;
            _lastBar = MotifSelector.LastBar(_meter!, _score.End);
            await Player.LoadAsync(_score);
            await ApplyFilterAsync();
            await Player.SetSourceAsync(VariationSource, _score.WithNotes(_variation?.Notes ?? []));
            await Player.SeekAsync(position);
        }

        _secondTitle = piece.FileName;
        _secondDifferences = second.Differences;
        await Player.SetSourceAsync(SecondFileId, second.Notes);
        await HearAsync([SecondFileId]);
    }

    private async Task RemoveSecondFileAsync()
    {
        if (_hear.Contains(SecondFileId))
        {
            await HearAsync([Player.OriginalSource]);
        }

        await Player.SetSourceAsync(SecondFileId, _score!.WithNotes([]));
        _secondTitle = null;
        _secondDifferences = [];
        _motifId = "m_0001";
        _project = null;
    }

    private async Task LoadPieceAsync(ImportedPiece piece)
    {
        // MIDI cannot mark accents, so a MIDI piece has no accent fact rather than "no accents".
        _accents = piece.MusicXml?.AccentMarks;
        _characterContext = CharacterContext.FromPiece(piece);
        // MIDI has no slurs or repeat signs; rests still mark phrase boundaries.
        _phraseMarks = piece.MusicXml?.PhraseMarks ?? PhraseMarks.None;
        if (piece.Midi is { } midi)
        {
            await LoadAsync((PlaybackScore.FromMidi(midi), piece.Meter, piece.Notes), piece.FileName, NotationGenerator.FromMidi(midi, piece.FileName), musicXml: null, piece.Keys);
            return;
        }

        MusicXmlImport import = piece.MusicXml!;
        using var text = new StreamReader(new MemoryStream(piece.ScoreXml!), detectEncodingFromByteOrderMarks: true);
        await LoadAsync((PlaybackScore.FromMusicXml(import), piece.Meter, piece.Notes), piece.FileName, NotationGenerator.FromMusicXml(import, piece.FileName), await text.ReadToEndAsync(), piece.Keys);
    }

    private async Task LoadAsync((PlaybackScore Score, MeterMap Meter, IReadOnlyList<Note> Notes) piece, string title, GeneratedNotation notation, string? musicXml, IReadOnlyList<KeySignature> keys)
    {
        _keys = keys;
        _generated = ScoreSource.FromNotes(notation);
        _asWritten = musicXml is null ? null : ScoreSource.AsWritten(musicXml);
        _variationScore = null;
        _scoreChoice = ScoreChoice.AsWritten;
        _score = piece.Score;
        _notes = piece.Notes;
        _meter = piece.Meter;
        _title = title;
        _tracks = piece.Notes.Select(note => note.Track).Distinct().Order().ToArray();
        _lastBar = MotifSelector.LastBar(_meter, _score.End);
        _filters = Filters(piece.Notes, _tracks);
        _filter = SelectionFilter.All;
        _keptIds = null;
        _selection = null;
        _analysis = null;
        _structure = null;
        _character = [];
        _selectionNote = null;
        _looping = false;
        _hear = [Player.OriginalSource];
        _chain = null;
        _variation = null;
        _secondTitle = null;
        _secondDifferences = [];
        (_secondMessage, _secondTip) = (null, null);

        await Player.LoadAsync(_score);
        await Player.SetSourceAsync(VariationSource, _score.WithNotes([]));
        await Player.SetSourceAsync(SecondFileId, _score.WithNotes([]));
        await Player.SetTracksAsync([], []);
    }

    /// <summary>What the shown score is, and what was inferred to write it (decision record 0008).</summary>
    private static string ScoreNote(ScoreSource source)
    {
        if (source.Generated is not { } notation)
        {
            return "As written in the MusicXML file. Click a note to play from there.";
        }

        var parts = new List<string> { "Generated from the notes: note values, voices and spelling are inferred." };
        if (notation.ApproximatedNoteCount > 0)
        {
            parts.Add($"{notation.ApproximatedNoteCount} of {notation.NoteCount} notes are shown at the nearest 32nd.");
        }

        if (notation.ShortenedNoteCount > 0)
        {
            parts.Add($"{notation.ShortenedNoteCount} notes are shown shorter to fit four voices per staff.");
        }

        if (notation.Staves.Any(staff => staff.IsSplitInferred))
        {
            parts.Add("The staves are split at middle C.");
        }

        parts.Add("Click a note to play from there.");
        return string.Join(" ", parts);
    }

    /// <summary>
    /// Space (S1-W4, S1-M5): with notes selected it starts looping them and playing, or pauses and
    /// resumes the loop; with nothing selected it plays or pauses the piece.
    /// </summary>
    private async Task PlayPauseAsync()
    {
        if (!_looping && _selection is { NoteIds.Count: > 0 })
        {
            await ToggleLoopSelectionAsync();
            if (Player.State == PlaybackState.Stopped)
            {
                await Player.PlayAsync();
            }

            return;
        }

        await TogglePlayAsync();
    }

    private Task TogglePlayAsync() => Player.State == PlaybackState.Stopped ? Player.PlayAsync() : Player.PauseAsync();

    private async Task StopAsync()
    {
        await Player.PauseAsync();
        await Player.SeekAsync(Player.Loop?.Onset ?? Tick.Zero);
    }

    private Task SeekAsync(ChangeEventArgs args) =>
        long.TryParse(args.Value?.ToString(), out long tick) ? Player.SeekAsync(new Tick(tick)) : Task.CompletedTask;

    private Task SetTempoAsync(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), out int percent) ? Player.SetTempoAsync(Math.Clamp(percent, 25, 150) / 100.0) : Task.CompletedTask;

    private Task ToggleMetronomeAsync() => Player.SetMetronomeAsync(!Player.Metronome);

    private Task ToggleCountInAsync() => Player.SetCountInAsync(!Player.CountIn);

    /// <summary>
    /// What playback, the roll and a selection can be limited to (S1-M2): a hand when the piece has
    /// hands, a track when it has several, and a notated voice when a track has several.
    /// </summary>
    private static (string Label, SelectionFilter Filter)[] Filters(IReadOnlyList<Note> notes, int[] tracks)
    {
        var filters = new List<(string, SelectionFilter)> { ("All notes", SelectionFilter.All) };
        foreach ((Hand hand, string label) in new[] { (Hand.Right, "Right hand"), (Hand.Left, "Left hand") })
        {
            if (notes.Any(note => note.Hand?.Value == hand))
            {
                filters.Add((label, SelectionFilter.ForHand(hand)));
            }
        }

        if (tracks.Length > 1)
        {
            filters.AddRange(tracks.Select(track => ($"Track {track + 1}", SelectionFilter.ForTrack(track))));
        }

        foreach (int track in tracks)
        {
            int[] voices = [.. notes.Where(note => note.Track == track && note.Voice is not null).Select(note => note.Voice!.Value).Distinct().Order()];
            if (voices.Length > 1)
            {
                filters.AddRange(voices.Select(voice => (tracks.Length > 1 ? $"Track {track + 1}, voice {voice}" : $"Voice {voice}", SelectionFilter.ForVoice(track, voice))));
            }
        }

        return [.. filters];
    }

    /// <summary>Selects whole bars, keeping to the piece and to 8 bars (S1-M1).</summary>
    private Task SelectBarRangeAsync(int fromBar, int toBar)
    {
        int from = Math.Clamp(Math.Min(fromBar, toBar), _meter!.FirstBarNumber, _lastBar);
        int to = Math.Clamp(Math.Max(fromBar, toBar), from, _lastBar);
        string? note = null;
        if (to - from + 1 > MotifSelection.MaxBars)
        {
            to = from + MotifSelection.MaxBars - 1;
            note = $"A selection spans at most {MotifSelection.MaxBars} bars, so it ends at bar {to}.";
        }

        return SelectAsync(MotifSelector.Bars(_meter, from, to, _score!.End), note);
    }

    /// <summary>
    /// A click on a bar number selects that bar, a Shift-click extends the selection to it in whole
    /// bars, and a drag selects the beats it covers (S1-M1).
    /// </summary>
    private Task OnRangePickedAsync(RollRange range)
    {
        Tick last = new(_score!.End.Value - 1);
        if (range.Extend && _selection is { } selection)
        {
            int clicked = _meter!.BarAt(range.Anchor > last ? last : range.Anchor).Number;
            return clicked < selection.FirstBar
                ? SelectBarRangeAsync(clicked, selection.LastBar)
                : SelectBarRangeAsync(selection.FirstBar, clicked);
        }

        if (range.IsClick || range.Extend)
        {
            int bar = _meter!.BarAt(range.Anchor > last ? last : range.Anchor).Number;
            return SelectAsync(MotifSelector.Bars(_meter, bar, bar, _score.End), note: null);
        }

        TickSpan span = MotifSelector.Drag(_meter!, range.Anchor, range.Current, _score.End);
        Tick low = range.Anchor < range.Current ? range.Anchor : range.Current;
        Tick high = new(Math.Max(low.Value, Math.Max(range.Anchor.Value, range.Current.Value) - 1));
        bool capped = _meter!.BarAt(high > last ? last : high).Number - _meter.BarAt(low > last ? last : low).Number + 1 > MotifSelection.MaxBars;
        return SelectAsync(span, capped ? $"A selection spans at most {MotifSelection.MaxBars} bars, so the drag stopped there." : null);
    }

    /// <summary>
    /// Limits what plays and lights up on the roll to the chosen notes (S1-M2). The selection keeps
    /// its range and the variation is made again on the kept notes.
    /// </summary>
    private async Task SetFilterAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out int index) || index < 0 || index >= _filters.Length)
        {
            return;
        }

        _filter = _filters[index].Filter;
        await ApplyFilterAsync();
        if (_selection is { } selection)
        {
            await SelectAsync(selection.Span, note: null);
        }
    }

    /// <summary>Plays only the notes the filter keeps as the original, and tells the roll which to draw at full strength.</summary>
    private async Task ApplyFilterAsync()
    {
        _keptIds = _filter == SelectionFilter.All ? null : _notes!.Where(_filter.Matches).Select(note => note.Id).ToHashSet(StringComparer.Ordinal);
        await Player.SetSourceAsync(Player.OriginalSource, _filter == SelectionFilter.All ? _score! : _score!.WithNotes(_notes!.Where(_filter.Matches)));
    }

    private async Task SelectAsync(TickSpan span, string? note)
    {
        _selection = MotifSelector.Select(_notes!, _meter!, span, _filter);
        IReadOnlyList<PhraseBoundary> phrases = PhraseBoundaryFinder.Find(_notes!.Where(_filter.Matches), _meter!, _phraseMarks);
        _analysis = MotifAnalyzer.Analyze(_notes!, _meter!, _selection, KeySignature.InForce(_keys, span.Onset), _accents, phrases);
        _structure = StructureAnalyzer.Analyze(_notes!, _meter!, _selection, phrases);
        _character = MotifAnalyzer.AnalyzeCharacter(_notes!, _meter!, _selection, KeySignature.InForce(_keys, span.Onset), _characterContext!);
        _selectionNote = note;
        // The steps follow the selection as it changes, so the player keeps hearing and seeing them.
        await ReplayAsync();

        if (_looping)
        {
            if (_selection.NoteIds.Count == 0)
            {
                await StopLoopingAsync();
            }
            else
            {
                await LoopSelectionAsync(_selection);
            }
        }

        await SaveProjectAsync();
    }

    private async Task ClearSelectionAsync()
    {
        if (_looping)
        {
            await StopLoopingAsync();
        }

        _selection = null;
        _analysis = null;
        _structure = null;
        _character = [];
        _selectionNote = null;
        await ClearVariationAsync();
        await SaveProjectAsync();
    }

    /// <summary>Why the Keep choices rule V1 out (S1-E2), or null.</summary>
    private string? DisabledReason => RhythmReshape.Instance.DisabledReason(_keep);

    /// <summary>The breadcrumbs of the chain, for example "Original › Half-time › trying Later by 1 eighth".</summary>
    private string? StepsText => _chain is null
        ? null
        : string.Join(" › ", ["Original", .. _chain.Steps.Select(StepLabel), .. _chain.Pending is { } pending ? [$"trying {StepLabel(pending)}"] : Array.Empty<string>()]);

    /// <summary>What the pending step changed, then what all the steps changed from the original; both read from the diff (S1-E4).</summary>
    private string? ExplanationText => _chain switch
    {
        { Pending: { } pending, Steps.Count: > 0, Result: { } result } => $"This step: {pending.Result.Explanation} From the original: {result.Explanation}",
        { Result: { } result } => result.Explanation,
        _ => null,
    };

    private static string StepLabel(VariationStep step) =>
        s_reshapes.FirstOrDefault(reshape => reshape.Parameters == step.Parameters).Label ?? step.Operation.Name;

    private static string KeepLabel(KeepProperty property) => property switch
    {
        KeepProperty.PitchOrder => "Pitch order",
        _ => property.ToString(),
    };

    private KeepStatus? KeepStatusOf(KeepProperty property) =>
        _variation?.Checks.FirstOrDefault(check => check.Property == property)?.Status;

    private string KeepClass(KeepProperty property) => KeepStatusOf(property) switch
    {
        KeepStatus.Kept => "chip kept",
        KeepStatus.NoLongerKept => "chip broken",
        _ => "chip",
    };

    private string? KeepStatusText(KeepProperty property) => KeepStatusOf(property) switch
    {
        KeepStatus.Kept => "Kept in the variation.",
        KeepStatus.NoLongerKept => "No longer kept in the variation.",
        KeepStatus.NotChecked => "Not checked yet: this needs chord analysis.",
        _ => null,
    };

    private Task ToggleKeepAsync(KeepProperty property)
    {
        if (!_keep.Remove(property))
        {
            _keep.Add(property);
        }

        return KeepChangedAsync();
    }

    /// <summary>A preset replaces the Keep choices with its own (S1-E2).</summary>
    private Task ApplyPresetAsync(KeepPreset preset)
    {
        _keep.Clear();
        _keep.UnionWith(preset.Keep);
        return KeepChangedAsync();
    }

    /// <summary>"Suggests Rhythm reshape, Density and rests and Accent shift.", read from the Keep table.</summary>
    private static string PresetHint(KeepPreset preset)
    {
        string[] names = [.. preset.Operations.Select(id => KeepTable.Find(id)?.Name ?? id)];
        return names.Length == 1 ? $"Suggests {names[0]}." : $"Suggests {string.Join(", ", names[..^1])} and {names[^1]}.";
    }

    private async Task KeepChangedAsync()
    {
        if (_chain is not null)
        {
            await ReplayAsync();
            await SaveProjectAsync();
        }
    }

    /// <summary>A new parameter re-runs the operation and plays the result at once (S1-E3).</summary>
    private Task ReshapeAsync(int index)
    {
        if (_selection is not { } selection)
        {
            return Task.CompletedTask;
        }

        // Show the reshape in the score as well, the first time one is made.
        if (_variation is null)
        {
            _scoreChoice = ScoreChoice.Variation;
        }

        VariationChain chain = _chain ?? StartChain(selection);
        return ShowAsync(chain.Propose(RhythmReshape.Instance, s_reshapes[index].Parameters), play: true);
    }

    /// <summary>Why one reshape cannot run on the current notes with these Keep choices, or null.</summary>
    private string? ReshapeUnavailable(int index) => _selection is { } selection
        ? (_chain ?? StartChain(selection)).UnavailableReason(RhythmReshape.Instance, s_reshapes[index].Parameters)
        : "Select some notes first.";

    private Task AcceptStepAsync() => _chain is { AcceptDisabledReason: null } chain ? ShowAsync(chain.Accept(), play: false) : Task.CompletedTask;

    private Task RejectStepAsync() => _chain is { Pending: not null } chain ? ShowAsync(chain.Reject(), play: false) : Task.CompletedTask;

    private Task UndoStepAsync() => _chain is { CanUndo: true } chain ? ShowAsync(chain.Undo(), play: false) : Task.CompletedTask;

    private Task RedoStepAsync() => _chain is { CanRedo: true } chain ? ShowAsync(chain.Redo(), play: false) : Task.CompletedTask;

    /// <summary>A chain with no steps over the selected notes, with a copy of the Keep choices.</summary>
    private VariationChain StartChain(MotifSelection selection) =>
        VariationChain.Start(VariationFacts.MotifNotes(_notes!, selection), VariationContext.For(selection, _keep.ToHashSet(), meter: _meter));

    /// <summary>Runs the chain's steps again on the selection and Keep choices as they are now; clears it when a step no longer runs.</summary>
    private Task ReplayAsync() =>
        _chain is not null && _selection is { } selection
            && _chain.Replay(VariationFacts.MotifNotes(_notes!, selection), VariationContext.For(selection, _keep.ToHashSet(), meter: _meter)) is { } replayed
            ? ShowAsync(replayed, play: false)
            : ClearVariationAsync();

    private async Task RemoveVariationAsync()
    {
        await ClearVariationAsync();
        await SaveProjectAsync();
    }

    /// <summary>The piece with the variation's notes in place of the motif's, engraved from the notes; what it writes is inferred (decision record 0008).</summary>
    private ScoreSource VariationScore(Variation variation)
    {
        var changed = variation.Changes.Select(change => change.Before.Id).Concat(variation.Removed.Select(note => note.Id)).ToHashSet(StringComparer.Ordinal);
        Note[] notes = [.. _notes!.Where(note => !changed.Contains(note.Id)), .. variation.Notes];
        Tick end = notes.Length == 0 ? _score!.End : notes.Max(note => note.Span.End);
        IEnumerable<KeyChange> keys = _keys.Select(key => new KeyChange(key.At, Math.Clamp(key.Fifths, -7, 7)));
        return ScoreSource.FromNotes(NotationGenerator.Generate(notes, _meter!, keys, end > _score!.End ? end : _score.End, _title));
    }

    /// <summary>
    /// Shows the chain's result in place of the motif, keeping the original notes as they are
    /// (S1-E1, S1-E4, S1-E5, S1-E9). A chain with nothing to show (every step undone) is kept for redo.
    /// </summary>
    private async Task ShowAsync(VariationChain chain, bool play)
    {
        if (_selection is not { } selection || chain.Result is null)
        {
            await ClearVariationAsync(_selection is null ? null : chain);
            await SaveProjectAsync();
            return;
        }

        _chain = chain;
        _variation = chain.Result;
        _variationScore = VariationScore(_variation);
        await Player.SetSourceAsync(VariationSource, _score!.WithNotes(_variation.Notes));
        if (play)
        {
            await AuditionAsync(variation: true);
        }
        else if (_looping)
        {
            // The loop follows the variation's new length.
            await LoopSelectionAsync(selection);
        }

        await SaveProjectAsync();
    }

    /// <summary>
    /// Autosaves the selection as the project's working motif, with its variation and Keep choices
    /// (S1-P1). Other motifs and variations in the project are kept as they are.
    /// </summary>
    private async Task SaveProjectAsync()
    {
        if (_project is null || _restoring)
        {
            return;
        }

        var motifs = _project.Motifs.Where(motif => motif.Id != _motifId).ToList();
        var variations = _project.Variations.Where(variation => variation.MotifId != _motifId).ToList();
        if (_selection is { NoteIds.Count: > 0 } selection)
        {
            motifs.Insert(0, SavedMotif.From(Motif.Create(_motifId, 1, selection, MotifSelectionKind.Range, MotifMode.Discovery, _notes!)));
            if (_chain is { Result: not null } chain)
            {
                variations.Insert(0, SavedVariation.Create(_motifId.Replace("m_", "v_", StringComparison.Ordinal), _motifId, chain));
            }
        }

        _project = _project with { Motifs = motifs, Variations = variations };
        CurrentPiece.Saved(_project);
        await Projects.SaveAsync(_project);
    }

    /// <summary>Puts a saved project's first motif back as the selection, with its variation and Keep choices.</summary>
    private async Task RestoreAsync(OpenedProject opened)
    {
        Motif motif = opened.Motifs[0];
        _motifId = motif.Id;
        _restoring = true;
        try
        {
            _filter = _filters.Any(filter => filter.Filter == motif.Filter) ? motif.Filter : SelectionFilter.All;
            await SelectAsync(motif.Span, note: $"Restored \"{motif.Name}\" from the project.");
            if (opened.Variations.FirstOrDefault(variation => variation.Saved.MotifId == motif.Id).Chain is { } chain)
            {
                _keep.Clear();
                _keep.UnionWith(chain.Context.Keep);
                _chain = chain;
                await ReplayAsync();
            }
        }
        finally
        {
            _restoring = false;
        }
    }

    /// <summary>Stops showing a variation. The chain goes too, unless <paramref name="chain"/> is kept for redo.</summary>
    private async Task ClearVariationAsync(VariationChain? chain = null)
    {
        _chain = chain;
        if (_variation is null)
        {
            return;
        }

        _variation = null;
        _variationScore = null;
        await Player.SetSourceAsync(VariationSource, _score!.WithNotes([]));
        // Nothing is left to hear as the variation: go back to the original, keeping the loop.
        if (_hear.Contains(VariationSource))
        {
            await HearAsync([Player.OriginalSource]);
        }
    }

    /// <summary>Chooses what to hear. While the selection loops, the loop carries on with the new choice and its range.</summary>
    private async Task HearAsync(string[] ids)
    {
        _hear = ids;
        if (_looping && _selection is { NoteIds.Count: > 0 } selection)
        {
            await LoopSelectionAsync(selection);
        }
        else
        {
            await Player.SelectSourcesAsync(ids);
        }
    }

    /// <summary>Loops the selection as it is, or its variation, from the start of the selection.</summary>
    private async Task AuditionAsync(bool variation)
    {
        if (_selection is not { NoteIds.Count: > 0 } selection)
        {
            return;
        }

        _hear = variation && _variation is not null ? [VariationSource] : [Player.OriginalSource];
        _looping = true;
        TickSpan range = await LoopSelectionAsync(selection);
        await Player.SeekAsync(range.Onset);
        if (Player.State == PlaybackState.Stopped)
        {
            await Player.PlayAsync();
        }
    }

    private async Task ToggleLoopSelectionAsync()
    {
        if (_looping)
        {
            await StopLoopingAsync();
        }
        else if (_selection is { NoteIds.Count: > 0 } selection)
        {
            _looping = true;
            await LoopSelectionAsync(selection);
        }
    }

    /// <summary>
    /// Loops what the player chose to hear, kept to the selection (S1-W4, S1-M5): the original as the
    /// selection's notes alone, the variation as its notes. Returns the range that loops.
    /// </summary>
    private async Task<TickSpan> LoopSelectionAsync(MotifSelection selection)
    {
        var ids = selection.NoteIds.ToHashSet(StringComparer.Ordinal);
        await Player.SetSourceAsync(SelectionSource, _score!.WithNotes(_notes!.Where(note => ids.Contains(note.Id))));
        await Player.SelectSourcesAsync([.. _hear.Select(id => id == Player.OriginalSource ? SelectionSource : id)]);
        TickSpan range = PlayRange(selection);
        await Player.SetLoopAsync(range);
        if (!range.Contains(Player.Position))
        {
            await Player.SeekAsync(range.Onset);
        }

        return range;
    }

    /// <summary>
    /// What plays for the selection: its own range, or, when the variation is heard, the range the
    /// variation's notes take, rounded out to whole beats. A variation that runs longer extends it,
    /// one that runs shorter shortens it; heard together with the original it never ends before the
    /// selection. Never past the end of the piece.
    /// </summary>
    private TickSpan PlayRange(MotifSelection selection)
    {
        TickSpan span = selection.Span;
        if (!_hear.Contains(VariationSource) || _variation is not { Notes.Count: > 0 } variation)
        {
            return span;
        }

        Tick end = BeatEnd(variation.Notes.Max(note => note.Span.End));
        if (_hear.Contains(Player.OriginalSource) && span.End > end)
        {
            end = span.End;
        }

        Tick pieceEnd = _score!.End;
        end = end > pieceEnd ? pieceEnd : end;
        return end > span.Onset ? TickSpan.FromBounds(span.Onset, end) : span;
    }

    /// <summary>The first beat line at or after an end, in the bar it falls in.</summary>
    private Tick BeatEnd(Tick end)
    {
        Bar bar = _meter!.BarAt(new Tick(Math.Max(0, end.Value - 1)));
        long beat = bar.Signature.BeatTicks;
        // A pickup's beats count back from its bar line.
        long barStart = bar.IsPickup ? bar.Span.End.Value - bar.Signature.BarTicks : bar.Span.Onset.Value;
        long past = (end.Value - barStart) % beat;
        long snapped = past == 0 ? end.Value : end.Value + beat - past;
        return new Tick(Math.Min(snapped, bar.Span.End.Value));
    }

    /// <summary>The range that plays for the selection as things stand, for the roll and the score to show; null without a selection.</summary>
    private TickSpan? ShownRange => _selection is { } selection ? (_selection.NoteIds.Count > 0 ? PlayRange(selection) : selection.Span) : null;

    private async Task StopLoopingAsync()
    {
        _looping = false;
        await Player.SetLoopAsync(null);
        await Player.SelectSourcesAsync(_hear);
    }

    /// <summary>The selection in words: where it is, which notes it keeps and whether a hand is inferred.</summary>
    private string SelectionText
    {
        get
        {
            if (_selection is not { } selection)
            {
                return "Nothing selected. Drag across the piano roll or click a bar number.";
            }

            var parts = new List<string> { $"Selected {Where(selection)}" };
            if (selection.Filter != SelectionFilter.All)
            {
                string label = _filters.FirstOrDefault(filter => filter.Filter == selection.Filter).Label ?? "filtered";
                parts.Add(selection.HandInferred ? $"{label.ToLowerInvariant()} (inferred for some notes)" : label.ToLowerInvariant());
            }

            string text = string.Join(", ", parts) + selection.NoteIds.Count switch
            {
                0 => ": no notes start here, so there is nothing to loop.",
                1 => ": 1 note.",
                int count => $": {count} notes.",
            };
            if (_looping)
            {
                text += " Looping; only these notes play.";
            }

            return _selectionNote is null ? text : $"{text} {_selectionNote}";
        }
    }

    /// <summary>"bars 5–6", or with beats when an edge is inside a bar: "bar 5, beat 2, through bar 6, beat 1".</summary>
    private string Where(MotifSelection selection)
    {
        Bar first = _meter!.GetBar(selection.FirstBar);
        Bar last = _meter.GetBar(selection.LastBar);
        if (selection.Span.Onset == first.Span.Onset && selection.Span.End == last.Span.End)
        {
            return selection.FirstBar == selection.LastBar ? $"bar {selection.FirstBar}" : $"bars {selection.FirstBar}–{selection.LastBar}";
        }

        MetricPosition from = _meter.ToPosition(selection.Span.Onset);
        MetricPosition through = _meter.ToPosition(new Tick(selection.Span.End.Value - 1));
        return from.Bar == through.Bar && from.Beat == through.Beat
            ? $"bar {from.Bar}, beat {from.Beat}"
            : $"bar {from.Bar}, beat {from.Beat}, through bar {through.Bar}, beat {through.Beat}";
    }

    private Task ToggleTrackAsync(int track, bool solo)
    {
        var muted = Player.Muted.ToHashSet();
        var soloed = Player.Soloed.ToHashSet();
        HashSet<int> target = solo ? soloed : muted;
        if (!target.Remove(track))
        {
            target.Add(track);
        }

        return Player.SetTracksAsync(muted, soloed);
    }
}
