    /// <summary>The selected notes, then any note the player moved or edited out of the range, so a correction never hides it.</summary>
    private IEnumerable<Note> CorrectableNotes(MotifSelection selection)
    {
        var ids = selection.NoteIds.ToHashSet(StringComparer.Ordinal);
        return _notes!.Where(note => ids.Contains(note.Id) || (_edits.EditedIds.Contains(note.Id) && note.Span.Overlaps(selection.Span)));
    }

