    /// <summary>
    /// Plays, draws, engraves and analyses the imported notes with <paramref name="edits"/> applied
    /// (S1-I7), keeping the position and the selection's range; the steps are made again on the
    /// corrected notes, and the project saves the edit log.
    /// </summary>
    private async Task ApplyEditsAsync(NoteEditLog edits)
    {
        _edits = edits;
        _notes = edits.Apply(_imported);
        if (_selection is { } current)
        {
            // Renders between the awaits below must not see a selection that names a removed note.
            _selection = MotifSelector.Select(_notes, _meter!, current.Span, _filter, SelectionCap(current.Span));
        }

        _score = PlaybackScore.Create(_notes, _score!.Tempos, _meter!, _score.End, _score.Pedal);
        _lastBar = MotifSelector.LastBar(_meter!, _score.End);
        _phrases = PhraseMap.Suggest(_notes, _meter!, _phraseMarks, _score.End, _phrases?.Edits);
        SuggestSentences();
        _generated = ScoreSource.FromNotes(Notation(_notes, _score.End));
        if (!edits.IsEmpty && _scoreChoice == ScoreChoice.AsWritten)
        {
            // The file as written does not know the corrections.
            _scoreChoice = ScoreChoice.Generated;
        }

        Tick position = Player.Position;
        await Player.LoadAsync(_score);
        await ApplyFilterAsync();
        await SetVariationSourcesAsync();
        await Player.SeekAsync(position);
        if (_selection is { } selection)
        {
            await SelectAsync(selection.Span, note: null);
        }
        else
        {
            await SaveProjectAsync();
        }
    }

    /// <summary>The experiment the page shows: the last one tried, while the variation is still the one it made.</summary>
    private ExploreTrial? ActiveTrial => _trial is { } trial && ReferenceEquals(trial.Chain, _chain) ? trial : null;

    /// <summary>What the Explore card offers: what fits the selection, or while an experiment runs, what fitted where it was offered.</summary>
    private IReadOnlyList<Experiment> CardOffers => ActiveTrial?.Offers ?? _offers;

    /// <summary>
    /// Tries one alternative of an experiment (decision record 0010): its steps become the variation,
    /// heard at once, with the experiment's Keep choices. An experiment that changes another passage
    /// (the motif's return) moves the selection there. Nothing is saved until the player keeps it.
    /// </summary>
    private async Task TryExperimentAsync(ExploreRequest request)
    {
        if (_selection is not { NoteIds.Count: > 0 } selection || _invitationContext is null)
        {
            return;
        }

        ExploreTrial? active = ActiveTrial;
        bool tryingOne = active is { Kept: false };
        InvitationContext offeredIn = active?.OfferedIn ?? _invitationContext;
        Experiment experiment = request.Experiment;
        VariationChain chain = ExperimentCatalogue.Start(experiment, request.Alternative, offeredIn);
        var trial = new ExploreTrial(
            experiment,
            request.Alternative,
            offeredIn,
            active?.Offers ?? _offers,
            chain,
            tryingOne ? active!.Before : _chain,
            tryingOne ? active!.KeepBefore : _keep.ToHashSet(),
            Kept: false);

        if (selection.Span != experiment.Passage.Span || _filter != experiment.Filter)
        {
            await MoveSelectionAsync(experiment.Passage.Span, experiment.Filter, trial.Elsewhere ? Text["selection.elsewhere"] : null);
        }

        _keep.Clear();
        _keep.UnionWith(chain.Context.Keep);
        if (_variation is null)
        {
            _scoreChoice = ScoreChoice.Variation;
        }

        _trial = trial;
        _tried.Add(experiment.Id);
        await ShowAsync(chain, play: true);
        await Analytics.TrackAsync(AnalyticsEvent.ExperimentTried(experiment.Id, request.Alternative, request.Entry));
    }

    /// <summary>Selects another range for an experiment without saving or replaying the steps: the experiment's own come next.</summary>
    private async Task MoveSelectionAsync(TickSpan span, SelectionFilter filter, string? note)
    {
        await ClearVariationAsync();
        if (_filter != filter)
        {
            _filter = filter;
            await ApplyFilterAsync();
        }

        _restoring = true;
        try
        {
            await SelectAsync(span, note);
        }
        finally
        {
            _restoring = false;
        }
    }

    /// <summary>Keeps the experiment's variation: it is saved with the project and the Selection tab builds on it.</summary>
    private async Task KeepExperimentAsync()
    {
        if (ActiveTrial is not { Kept: false } trial)
        {
            return;
        }

        _trial = trial with { Kept = true };
        KeepObservation(_trial);
        await SaveProjectAsync();
        await Analytics.TrackAsync(AnalyticsEvent.ExperimentKept(trial.Experiment.Id, trial.Alternative));
    }

    /// <summary>Leaves the experiment: the selection, Keep choices and steps the player had come back.</summary>
    private async Task LeaveExperimentAsync()
    {
        if (ActiveTrial is not { Kept: false } trial)
        {
            return;
        }

        _trial = null;
        MotifSelection origin = trial.OfferedIn.Selection;
        await ClearVariationAsync();
        _chain = trial.Before;
        _keep.Clear();
        _keep.UnionWith(trial.KeepBefore);
        if (_selection is { } selection && (selection.Span != origin.Span || _filter != origin.Filter))
        {
            if (_filter != origin.Filter)
            {
                _filter = origin.Filter;
                await ApplyFilterAsync();
            }

            await SelectAsync(origin.Span, note: null);
        }
        else
        {
            await ReplayAsync();
        }
    }

