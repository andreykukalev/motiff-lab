    /// <summary>What the shown score is, and what was inferred to write it (decision record 0008).</summary>
    /// <summary>The key signatures the score is written with: the piece's, or for notes heard in a recording, the key worked out from them.</summary>
    private IEnumerable<KeyChange> NotationKeys() => _heardKey is { } heardKey
        ? [new KeyChange(Tick.Zero, heardKey.Fifths)]
        : _keys.Select(key => new KeyChange(key.At, Math.Clamp(key.Fifths, -7, 7)));

    /// <summary>The piece's notes engraved, in the mode the player chose for notes heard in a recording.</summary>
    private GeneratedNotation Notation(IEnumerable<Note> notes, Tick end, IReadOnlyList<NotationOssia>? ossias = null) =>
        _heard ? HeardNotation(notes, _meter!, NotationKeys(), end, ScoreTitle.Of(_title), _score!, ossias) : NotationGenerator.Generate(notes, _meter!, NotationKeys(), end, ScoreTitle.Of(_title), ossias: ossias);

    private GeneratedNotation HeardNotation(IEnumerable<Note> notes, MeterMap meter, IEnumerable<KeyChange> keys, Tick end, string? title, PlaybackScore played, IReadOnlyList<NotationOssia>? ossias = null) =>
        _readable
            ? NotationGenerator.Generate(notes, meter, keys, end, title, asHeard: true, ossias: ossias)
            : NotationGenerator.Generate(notes, meter, keys, end, title, playedTempos: played.Tempos, pedal: played.Pedal.Select(held => held.Span), ossias: ossias);

    /// <summary>Notes heard in a recording, written for reading or as played.</summary>
    private void SetReadable(bool readable)
    {
        if (_readable == readable || _score is null || _notes is null)
        {
            return;
        }

        _readable = readable;
        _generated = ScoreSource.FromNotes(Notation(_notes, _score.End));
        if (_variationScore is not null && _variation is { } variation)
        {
            _variationScore = VariationScore(variation);
        }
    }

    private string ScoreNote(ScoreSource source)
    {
        if (source.Generated is not { } notation)
        {
            return Text["score.asWrittenNote"];
        }

        var parts = new List<string> { Text["score.generatedNote"] };
        if (notation.WrittenAsHeard)
        {
            parts.Add(Text["score.readableNote"]);
            if (notation.GraceNoteCount > 0)
            {
                parts.Add(Text.Count("score.graceNotes", notation.GraceNoteCount));
            }
        }
        else if (_heard)
        {
            parts.Add(Text["score.asPlayedNote"]);
            if (notation.DynamicCount + notation.AccentCount + notation.TempoWordCount + notation.HairpinCount > 0)
            {
                parts.Add(Text["score.playingMarks"]);
            }

            if (notation.SlurCount > 0)
            {
                parts.Add(Text["score.slurs"]);
            }

            if (notation.PedalCount > 0)
            {
                parts.Add(Text["score.pedal"]);
            }
        }
        else if (notation.ApproximatedNoteCount > 0)
        {
            parts.Add(Text.Format("score.approximated", notation.ApproximatedNoteCount, Text.Count("score.ofNotes", notation.NoteCount)));
        }

        if (notation.TripletCount > 0)
        {
            parts.Add(Text.Count("score.triplets", notation.TripletCount));
        }

        if (_heard && _heardKey is { } key)
        {
            parts.Add(Text.Format("score.heardKey", key.NameIn(Words)));
        }

        if (notation.ShortenedNoteCount > 0)
        {
            parts.Add(Text.Count("score.shortened", notation.ShortenedNoteCount));
        }

        if (notation.Staves.Any(staff => staff.IsSplitInferred))
        {
            parts.Add(Text["score.split"]);
        }

        parts.Add(Text["score.clickNote"]);
        return string.Join(" ", parts);
    }

    /// <summary>
    /// Space (S1-W4, S1-M5): with notes selected it starts looping them and playing, or pauses and
    /// resumes the loop; with nothing selected it plays or pauses the piece.
    /// </summary>
    private async Task PlayPauseAsync()
    {
        if (!_looping && _selection is { NoteIds.Count: > 0 })
        {
            await ToggleLoopSelectionAsync();
            if (Player.State == PlaybackState.Stopped)
            {
                await PlayAsync();
            }

            return;
        }

        await TogglePlayAsync();
    }

    private Task TogglePlayAsync() => Player.State == PlaybackState.Stopped ? PlayAsync() : Player.PauseAsync();

    /// <summary>Starts playback, and counts it for analytics when the player has turned them on (#64).</summary>
    private async Task PlayAsync()
    {
        _pillKept = true;
        await Player.PlayAsync();
        string hear = !VariationChosen ? "original" : _hear.Length > 1 ? "both" : "variation";
        await Analytics.TrackAsync(AnalyticsEvent.PlaybackStarted(hear, TempoPercent, _looping));
    }

    private async Task StopAsync()
    {
        await Player.PauseAsync();
        await Player.SeekAsync(Player.Loop?.Onset ?? Tick.Zero);
    }

    private Task SeekAsync(ChangeEventArgs args) =>
        long.TryParse(args.Value?.ToString(), out long tick) ? Player.SeekAsync(new Tick(tick)) : Task.CompletedTask;

    private Task SetTempoAsync(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), out int percent) ? SetTempoPercentAsync(percent) : Task.CompletedTask;

    /// <summary>The slowest and fastest the tempo goes, as a percentage of the piece's; the pill's slider has the same range.</summary>
    private const int MinTempo = 25;
    private const int MaxTempo = 150;

    private Task SetTempoPercentAsync(int percent) =>
        Player.SetTempoAsync(Math.Clamp(percent, MinTempo, MaxTempo) / 100.0);

    /// <summary>The phrase the selection stands for or lies mostly in, which Previous and Next phrase step from.</summary>
    private Phrase? StepFrom => _phrases is { } map && _selection is { } selection ? CurrentPhrase ?? map.Covering(selection.Span) : null;

    /// <summary>The phrase before (-1) or after (1) the one the selection is in, or null at either end; with nothing selected, the next is the first phrase.</summary>
    private Phrase? StepTarget(int direction) => StepFrom switch
    {
        null => direction > 0 && _selection is null ? _phrases?.Phrases[0] : null,
        { } from => from.Number + direction is int number && number >= 1 && number <= _phrases!.Phrases.Count ? _phrases.Phrases[number - 1] : null,
    };



    /// <summary>
    /// What the player can hear alone while the phrase loops: a hand when the selection has notes in both,
    /// and the melody or the accompaniment when it has a melody over an accompaniment.
    /// </summary>
    private IReadOnlyList<(ListenTo Choice, string Label)> ListenChoices
    {
        get
        {
            Note[] notes = SelectedNotes;
            bool hands = notes.Any(note => note.Hand?.Value == Hand.Right) && notes.Any(note => note.Hand?.Value == Hand.Left);
            var choices = new List<(ListenTo, string)> { (ListenTo.Everything, Text[hands && !_layered ? "listen.bothHands" : "explore.everything"]) };
            if (hands)
            {
                choices.Add((ListenTo.RightHand, Text["filter.rightHand"]));
                choices.Add((ListenTo.LeftHand, Text["filter.leftHand"]));
            }

            if (_layered)
            {
                choices.Add((ListenTo.Melody, Text["explore.melodyAlone"]));
                choices.Add((ListenTo.Accompaniment, Text["explore.accompanimentAlone"]));
            }

            return choices;
        }
    }

    /// <summary>Says when the hands are a reading of the notes rather than marked in the file.</summary>
    private string? HandsNote =>
        ListenChoices.Any(choice => choice.Choice == ListenTo.RightHand) && SelectedNotes.Any(note => note.Hand?.Attribution.Provenance == Provenance.Inferred)
            ? Text["listen.handsInferred"]
            : _layered ? Text["explore.listenHintShort"] : null;

    private Note[] SelectedNotes
    {
        get
        {
            if (_selection is not { NoteIds.Count: > 0 } selection)
            {
                return [];
            }

            var ids = selection.NoteIds.ToHashSet(StringComparer.Ordinal);
            return [.. _notes!.Where(note => ids.Contains(note.Id))];
        }
    }

    private Task ToggleMetronomeAsync() => Player.SetMetronomeAsync(!Player.Metronome);

    private Task ToggleCountInAsync() => Player.SetCountInAsync(!Player.CountIn);

    /// <summary>
    /// What playback, the roll and a selection can be limited to (S1-M2): a hand when the piece has
    /// hands, a track when it has several, and a notated voice when a track has several.
    /// </summary>
    private static SelectionFilter[] Filters(IReadOnlyList<Note> notes, int[] tracks)
    {
        var filters = new List<SelectionFilter> { SelectionFilter.All };
        foreach (Hand hand in new[] { Hand.Right, Hand.Left })
        {
            if (notes.Any(note => note.Hand?.Value == hand))
            {
                filters.Add(SelectionFilter.ForHand(hand));
            }
        }

        if (tracks.Length > 1)
        {
            filters.AddRange(tracks.Select(SelectionFilter.ForTrack));
        }

        foreach (int track in tracks)
        {
            int[] voices = [.. notes.Where(note => note.Track == track && note.Voice is not null).Select(note => note.Voice!.Value).Distinct().Order()];
            if (voices.Length > 1)
            {
                filters.AddRange(voices.Select(voice => SelectionFilter.ForVoice(track, voice)));
            }
        }

        return [.. filters];
    }

    /// <summary>"All notes", "Right hand", "Track 2", "Track 2, voice 1" or "Voice 1", as the Notes list names a filter.</summary>
    private string FilterLabel(SelectionFilter filter) => filter switch
    {
        { Hand: Hand.Right } => Text["filter.rightHand"],
        { Hand: Hand.Left } => Text["filter.leftHand"],
        { Track: int track, Voice: int voice } => _tracks.Length > 1 ? Text.Format("filter.trackVoice", track + 1, voice) : Text.Format("filter.voice", voice),
        { Track: int track } => Text.Format("second.track", track + 1),
        _ => Text["filter.all"],
    };

    /// <summary>Selects whole bars, keeping to the piece and to 8 bars (S1-M1).</summary>
    private Task SelectBarRangeAsync(int fromBar, int toBar)
    {
        int from = Math.Clamp(Math.Min(fromBar, toBar), _meter!.FirstBarNumber, _lastBar);
        int to = Math.Clamp(Math.Max(fromBar, toBar), from, _lastBar);
        string? note = null;
        if (to - from + 1 > MotifSelection.MaxBars)
        {
            to = from + MotifSelection.MaxBars - 1;
            note = Text.Format("selection.capped", MotifSelection.MaxBars, to);
        }

        return SelectAsync(MotifSelector.Bars(_meter, from, to, _score!.End), note);
    }

    /// <summary>
    /// A click on a bar number selects that bar, a Shift-click extends the selection to it in whole
    /// bars, and a drag selects the beats it covers (S1-M1).
    /// </summary>
    private Task OnRangePickedAsync(RollRange range)
    {
        Tick last = new(_score!.End.Value - 1);
        if (range.Extend && _selection is { } selection)
        {
            int clicked = _meter!.BarAt(range.Anchor > last ? last : range.Anchor).Number;
            return clicked < selection.FirstBar
                ? SelectBarRangeAsync(clicked, selection.LastBar)
                : SelectBarRangeAsync(selection.FirstBar, clicked);
        }

        if (range.IsClick || range.Extend)
        {
            int bar = _meter!.BarAt(range.Anchor > last ? last : range.Anchor).Number;
            return SelectAsync(MotifSelector.Bars(_meter, bar, bar, _score.End), note: null);
        }

        TickSpan span = MotifSelector.Drag(_meter!, range.Anchor, range.Current, _score.End);
        Tick low = range.Anchor < range.Current ? range.Anchor : range.Current;
        Tick high = new(Math.Max(low.Value, Math.Max(range.Anchor.Value, range.Current.Value) - 1));
        bool capped = _meter!.BarAt(high > last ? last : high).Number - _meter.BarAt(low > last ? last : low).Number + 1 > MotifSelection.MaxBars;
        return SelectAsync(span, capped ? Text.Format("selection.dragCapped", MotifSelection.MaxBars) : null);
    }

    /// <summary>
    /// Limits what plays and lights up on the roll to the chosen notes (S1-M2). The selection keeps
    /// its range and the variation is made again on the kept notes.
    /// </summary>
    private async Task SetFilterAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out int index) || index < 0 || index >= _filters.Length)
        {
            return;
        }

        _filter = _filters[index];
        await ApplyFilterAsync();
        if (_selection is { } selection)
        {
            await SelectAsync(selection.Span, note: null);
        }
    }

    /// <summary>Plays only the notes the filter keeps as the original, and tells the roll which to draw at full strength.</summary>
    private async Task ApplyFilterAsync()
    {
        _keptIds = _filter == SelectionFilter.All ? null : _notes!.Where(_filter.Matches).Select(note => note.Id).ToHashSet(StringComparer.Ordinal);
        await Player.SetSourceAsync(Player.OriginalSource, _filter == SelectionFilter.All ? _score! : _score!.WithNotes(_notes!.Where(_filter.Matches)));
    }

    /// <summary>The facts about a selection and the experiments offered for them.</summary>
    private void Analyze(MotifSelection selection)
    {
        IReadOnlyList<PhraseBoundary> phrases = _phrases!.Boundaries;
        KeySignature? key = KeySignature.InForce(_keys, selection.Span.Onset);
        _analysis = MotifAnalyzer.Analyze(_notes!, _meter!, selection, key, _accents, phrases, Words);
        _structure = StructureAnalyzer.Analyze(_notes!, _meter!, selection, phrases, Words);
        _character = MotifAnalyzer.AnalyzeCharacter(_notes!, _meter!, selection, key, _characterContext!, Words);
        _harmony = HarmonyAnalyzer.Analyze(_notes!, _meter!, selection, _analysis.Key?.Key, Words);
        _circle = KeyCircle.For(selection, _notes!, _meter!, _analysis.Key, _harmony, Words);
        _sentenceFacts = SentenceFactsFor(selection);
        _invitationContext = new InvitationContext(_notes!, _meter!, selection, _analysis, _structure, _character, Words) { Harmony = _harmony };
        _offers = TryChips.Buttons(Facts, _invitationContext);
    }

    private async Task SelectAsync(TickSpan span, string? note)
    {
        // A new bookmark's card, or a note's, belongs to the selection it was opened over.
        if (_bookmarkDraft is { Id: null })
        {
            _bookmarkDraft = null;
        }

        if (_noteDraft is { } noteDraft && noteDraft.Span != span)
        {
            _noteDraft = null;
        }

        _selection = MotifSelector.Select(_notes!, _meter!, Selectable(span), _filter, SelectionCap(span));
        Analyze(_selection);
        _highlight = null;
        MotifTexture? texture = _selection.NoteIds.Count == 0 ? null : MotifTexture.Read(VariationFacts.MotifNotes(_notes!, _selection));
        _layered = texture is { IsSingleLine: false } && texture.Melody.Count < texture.Notes.Count;
        // A hand or a layer the new selection does not have goes back to everything.
        if (!ListenChoices.Any(choice => choice.Choice == _listenTo))
        {
            _listenTo = ListenTo.Everything;
        }

        _selectionNote = note;
        if (!_restoring && _selection.NoteIds.Count > 0)
        {
            await Analytics.TrackAsync(AnalyticsEvent.MotifSelected(_selection.BarCount));
        }

        if (_answerLoop is not null)
        {
            await StopLoopingAsync();
        }

        // An experiment only being tried does not follow the selection: the player's own steps come back.
        if (ActiveTrial is { Kept: false } trial)
        {
            _chain = trial.Before;
            _keep.Clear();
            _keep.UnionWith(trial.KeepBefore);
        }

        // The steps follow the selection as it changes, so the player keeps hearing and seeing them.
        await ReplayAsync();

        if (_looping)
        {
            if (_selection.NoteIds.Count == 0)
            {
                await StopLoopingAsync();
            }
            else
            {
                await LoopSelectionAsync(_selection);
            }
        }

        await SaveProjectAsync();
    }

    /// <summary>The phrase the selection stands for, or null when the selection is another range (#18).</summary>
    private Phrase? CurrentPhrase => _selection is { } selection ? _phrases?.Matching(selection.Span) : null;

    /// <summary>Selects a phrase as the working context (#18): Explore and the facts read it. A phrase longer than a selection is selected up to 8 bars.</summary>
    private Task PickPhraseAsync(Phrase phrase)
    {
        if (_phrases is null)
        {
            return Task.CompletedTask;
        }

        TickSpan span = _phrases.Selectable(phrase);
        string? note = phrase.BarCount <= MotifSelection.MaxStructureBars ? null : Text.Format("selection.phraseCapped", phrase.Number, phrase.BarCount, MotifSelection.MaxStructureBars, _meter!.BarAt(new Tick(span.End.Value - 1)).Number);
        return SelectAsync(span, note);
    }

    /// <summary>
    /// Puts the player's edits at every level in effect and saves them with the project. With <paramref name="around"/>,
    /// the unit of the level shown that now holds its start is selected; otherwise the selection stays and its facts are read again.
    /// </summary>
    private async Task ChangePhrasesAsync(LevelEdits edits, TickSpan? around)
    {
        SuggestPhrases(edits);
        // A bookmark made from a phrase follows it through the merge or the split (0018 section 5).
        if ((_project ?? _session) is { Bookmarks.Count: > 0 })
        {
            Change(project => project.FollowPhrases(_phrases!.Phrases.Select(phrase => phrase.Span)));
        }

        if (around is { } span)
        {
            await SelectAsync(_levels!.Selectable(_levels.Map(span, _level)), note: null);
        }
        else if (_selection is { } selection)
        {
            await SelectAsync(selection.Span, note: null);
        }
        else
        {
            await SaveProjectAsync();
        }
    }

    private async Task ClearSelectionAsync()
    {
        if (_looping)
        {
            await StopLoopingAsync();
        }

        _selection = null;
        _bookmarkDraft = _bookmarkDraft is { Id: null } ? null : _bookmarkDraft;
        _noteDraft = null;
        // Nothing to lift: focus goes with the selection.
        _focus = false;
        _focusSpan = null;
        _highlight = null;
        _analysis = null;
        _structure = null;
        _character = [];
        _harmony = HarmonyAnalysis.None;
        _circle = null;
        _sentenceFacts = [];
        _invitationContext = null;
        _offers = [];
        _trial = null;
        _layered = false;
        _listenTo = ListenTo.Everything;
        _selectionNote = null;
        await ClearVariationAsync();
        await SaveProjectAsync();
    }

    /// <summary>The breadcrumbs of the chain, for example "Original › Half-time › trying Later by 1 eighth".</summary>
    private string? StepsText => _chain is null
        ? null
        : string.Join(" › ", [Text["term.original"], .. _chain.Steps.Select(StepLabel), .. _chain.Pending is { } pending ? [Text.Format("variation.trying", StepLabel(pending))] : Array.Empty<string>()]);

    /// <summary>What the pending step changed, then what all the steps changed from the original; both read from the diff (S1-E4).</summary>
    private string? ExplanationText => _chain switch
    {
        { Pending: { } pending, Steps.Count: > 0, Result: { } result } => Text.Format("variation.thisStep", pending.Result.Explanation, result.Explanation),
        { Pending: null, Steps.Count: > 1, Result: { } result } when _chain.Steps[^1].Operation is HandEdit => Text.Format("variation.thisEdit", _chain.Steps[^1].Result.Explanation, result.Explanation),
        { Result: { } result } => result.Explanation,
        _ => null,
    };

    /// <summary>The selected notes, then any note the player moved or edited out of the range, so a correction never hides it.</summary>
    private IEnumerable<Note> CorrectableNotes(MotifSelection selection)
    {
        var ids = selection.NoteIds.ToHashSet(StringComparer.Ordinal);
        return _notes!.Where(note => ids.Contains(note.Id) || (_edits.EditedIds.Contains(note.Id) && note.Span.Overlaps(selection.Span)));
    }

    /// <summary>Imported notes the edit log removes.</summary>
    private IReadOnlyList<Note> RemovedNotes
    {
        get
        {
            if (_edits.IsEmpty)
            {
                return [];
            }

            var kept = _edits.Apply(_imported).Select(note => note.Id).ToHashSet(StringComparer.Ordinal);
            return [.. _imported.Where(note => !kept.Contains(note.Id))];
        }
    }

    private string NotePosition(Note note)
    {
        MetricPosition position = _meter!.ToPosition(note.Span.Onset);
        return position.BeatOffset == 0
            ? Text.Format("notes.at", position.Bar, position.Beat)
            : Text.Format("notes.atOffset", position.Bar, position.Beat, VariationFacts.Length(position.BeatOffset, Words));
    }

    private Task CorrectAsync(Note note, int pitch = 0, long onset = 0, long length = 0, int velocity = 0)
    {
        if (RefuseTakenNote(note))
        {
            return Task.CompletedTask;
        }

        NoteValues values = NoteValues.Of(note);
        NoteValues after = new(
            new Pitch(Math.Clamp(note.Pitch.MidiNumber + pitch, 0, Pitch.MaxMidiNumber)),
            new TickSpan(new Tick(Math.Max(0, note.Span.Onset.Value + onset)), Math.Max(1, note.Span.Duration + length)),
            Math.Clamp(note.Velocity + velocity, Note.MinVelocity, Note.MaxVelocity));
        return after == values ? Task.CompletedTask : ApplyEditsAsync(_edits.Change(_imported, note.Id, after));
    }

    /// <summary>The accepted hand edits in the chain.</summary>
    private int HandEditCount => _chain?.Steps.Count(step => step.Operation is HandEdit) ?? 0;

    /// <summary>The variation's notes as heard, or the selected notes when there are no steps yet.</summary>
    private IReadOnlyList<Note> HeardNotes(MotifSelection selection) => _chain?.Heard ?? VariationFacts.MotifNotes(_notes!, selection);

    private Task EditNoteAsync(Note note, int pitch = 0, long onset = 0, long length = 0, int velocity = 0) =>
        HandEditAsync(HandEditParameters.Change(note.Id, new NoteValues(
            new Pitch(Math.Clamp(note.Pitch.MidiNumber + pitch, 0, Pitch.MaxMidiNumber)),
            new TickSpan(new Tick(Math.Max(0, note.Span.Onset.Value + onset)), Math.Max(1, note.Span.Duration + length)),
            Math.Clamp(note.Velocity + velocity, Note.MinVelocity, Note.MaxVelocity))));

    private Task RemoveVariationNoteAsync(Note note) => HandEditAsync(HandEditParameters.Remove(note.Id));

    private Task AddNoteAfterAsync(Note note) => _selection is { } selection
        ? HandEditAsync(HandEditParameters.Add(
            HandEdit.NewId([.. _notes!, .. HeardNotes(selection)]),
            new NoteValues(note.Pitch, new TickSpan(note.Span.End, note.Span.Duration), note.Velocity)))
        : Task.CompletedTask;

    /// <summary>Adds one hand edit to the variation as a step (S1-E7), starting a chain when there is none.</summary>
    private async Task HandEditAsync(HandEditParameters edit)
    {
        if (_selection is not { } selection)
        {
            return;
        }

        VariationChain chain = _chain ?? StartChain(selection);
        _handEditNote = chain.EditUnavailableReason(edit);
        if (_handEditNote is not null)
        {
            return;
        }

        if (_variation is null)
        {
            _scoreChoice = ScoreChoice.Variation;
        }

        await ShowAsync(chain.Edit(edit), play: false);
        await Analytics.TrackAsync(AnalyticsEvent.NoteEdited(edit.Kind));
    }

    private Task RemoveNoteAsync(Note note) => RefuseTakenNote(note) ? Task.CompletedTask : ApplyEditsAsync(_edits.Remove(_imported, note.Id));

    private Task RevertNoteAsync(Note note) => ApplyEditsAsync(_edits.Revert(note.Id));

    private Task UndoCorrectionAsync() => _edits.IsEmpty ? Task.CompletedTask : ApplyEditsAsync(_edits.Undo());

    /// <summary>
    /// Plays, draws, engraves and analyses the imported notes with <paramref name="edits"/> applied
    /// (S1-I7), keeping the position and the selection's range; the steps are made again on the
    /// corrected notes, and the project saves the edit log.
    /// </summary>
    private async Task ApplyEditsAsync(NoteEditLog edits)
    {
        _edits = edits;
        // Bars taken from a performance (decision record 0022, section 5) come after the corrections.
        _notes = PerformanceTake.Apply(edits.Apply(_imported), _project?.TakenBars ?? []);
        if (_selection is { } current)
        {
            // Renders between the awaits below must not see a selection that names a removed note.
            _selection = MotifSelector.Select(_notes, _meter!, current.Span, _filter, SelectionCap(current.Span));
        }

        _score = PlaybackScore.Create(_notes, _score!.Tempos, _meter!, _score.End, _score.Pedal);
        _lastBar = MotifSelector.LastBar(_meter!, _score.End);
        SuggestPhrases();
        _generated = ScoreSource.FromNotes(Notation(_notes, _score.End));
        if ((!edits.IsEmpty || _project is { ChangesNotes: true }) && _scoreChoice == ScoreChoice.AsWritten)
        {
            // The file as written does not know the corrections.
            _scoreChoice = ScoreChoice.Generated;
        }

        Tick position = Player.Position;
        await Player.LoadAsync(_score);
        await ApplyFilterAsync();
        await SetVariationSourcesAsync();
        await Player.SeekAsync(position);
        if (_selection is { } selection)
        {
            await SelectAsync(selection.Span, note: null);
        }
        else
        {
            await SaveProjectAsync();
        }
    }

    /// <summary>The experiment the page shows: the last one tried, while the variation is still the one it made.</summary>
    private ExploreTrial? ActiveTrial => _trial is { } trial && ReferenceEquals(trial.Chain, _chain) ? trial : null;

    /// <summary>What the Explore card offers: what fits the selection, or while an experiment runs, what fitted where it was offered.</summary>
    private IReadOnlyList<Experiment> CardOffers => ActiveTrial?.Offers ?? _offers;

    /// <summary>
    /// Tries one alternative of an experiment (decision record 0010): its steps become the variation,
    /// heard at once, with the experiment's Keep choices. An experiment that changes another passage
    /// (the motif's return) moves the selection there. Nothing is saved until the player keeps it.
    /// </summary>
    private async Task TryExperimentAsync(ExploreRequest request)
    {
        if (_selection is not { NoteIds.Count: > 0 } selection || _invitationContext is null)
        {
            return;
        }

        ExploreTrial? active = ActiveTrial;
        bool tryingOne = active is { Kept: false };
        InvitationContext offeredIn = active?.OfferedIn ?? _invitationContext;
        Experiment experiment = request.Experiment;
        VariationChain chain = ExperimentCatalogue.Start(experiment, request.Alternative, offeredIn);
        var trial = new ExploreTrial(
            experiment,
            request.Alternative,
            offeredIn,
            active?.Offers ?? _offers,
            chain,
            tryingOne ? active!.Before : _chain,
            tryingOne ? active!.KeepBefore : _keep.ToHashSet(),
            Kept: false);

        if (selection.Span != experiment.Passage.Span || _filter != experiment.Filter)
        {
            await MoveSelectionAsync(experiment.Passage.Span, experiment.Filter, trial.Elsewhere ? Text["selection.elsewhere"] : null);
        }

        _keep.Clear();
        _keep.UnionWith(chain.Context.Keep);
        if (_variation is null)
        {
            _scoreChoice = ScoreChoice.Variation;
        }

        _trial = trial;
        await ShowAsync(chain, play: true);
        await Analytics.TrackAsync(AnalyticsEvent.ExperimentTried(experiment.Id, request.Alternative, request.Entry));
    }

    /// <summary>Selects another range for an experiment without saving or replaying the steps: the experiment's own come next.</summary>
    private async Task MoveSelectionAsync(TickSpan span, SelectionFilter filter, string? note)
    {
        await ClearVariationAsync();
        if (_filter != filter)
        {
            _filter = filter;
            await ApplyFilterAsync();
        }

        _restoring = true;
        try
        {
            await SelectAsync(span, note);
        }
        finally
        {
            _restoring = false;
        }
    }

    /// <summary>Keeps the experiment's variation: it is saved with the project and the Selection tab builds on it.</summary>
    private async Task KeepExperimentAsync()
    {
        if (ActiveTrial is not { Kept: false } trial)
        {
            return;
        }

        _trial = trial with { Kept = true };
        KeepObservation(_trial);
        await SaveProjectAsync();
        await Analytics.TrackAsync(AnalyticsEvent.ExperimentKept(trial.Experiment.Id, trial.Alternative));
    }

    /// <summary>Leaves the experiment: the selection, Keep choices and steps the player had come back.</summary>
    private async Task LeaveExperimentAsync()
    {
        if (ActiveTrial is not { Kept: false } trial)
        {
            return;
        }

        _trial = null;
        MotifSelection origin = trial.OfferedIn.Selection;
        await ClearVariationAsync();
        _chain = trial.Before;
        _keep.Clear();
        _keep.UnionWith(trial.KeepBefore);
        if (_selection is { } selection && (selection.Span != origin.Span || _filter != origin.Filter))
        {
            if (_filter != origin.Filter)
            {
                _filter = origin.Filter;
                await ApplyFilterAsync();
            }

            await SelectAsync(origin.Span, note: null);
        }
        else
        {
            await ReplayAsync();
        }
    }

    /// <summary>The fact chosen on the Understand tab and what the score and the roll highlight for it (#25); null for none. A new selection clears it.</summary>
    private FactHighlight? _highlight;

    /// <summary>
    /// The experiments the Understand tab links its facts to: those offered for the same selection as the facts.
    /// None while an experiment offered for another selection runs (the motif's return), as its offers rest on other facts.
    /// </summary>
    private IReadOnlyList<Experiment> UnderstandOffers => ActiveTrial is { } trial && !ReferenceEquals(trial.OfferedIn, _invitationContext) ? [] : CardOffers;

    /// <summary>Highlights the places of a fact, or one of them and moves playback to its start; null clears the highlight.</summary>
    private async Task ChooseFactAsync(FactChoice? choice)
    {
        _highlight = choice is null || _notes is null ? null : FactHighlight.Create(choice, _notes);
        if (choice?.Place is { } place)
        {
            await Player.SeekAsync(place.Span.Onset);
        }
    }

    /// <summary>A fact the experiment being tried rests on: its places are ringed on the score.</summary>
    private Task ShowFactAsync(MotifFact fact) => ChooseFactAsync(new FactChoice(fact));

    /// <summary>Loops from the motif to the end of its return, with the new answer in place; pressed again, it stops.</summary>
    private async Task HearAnswerAsync()
    {
        if (_answerLoop is not null)
        {
            await StopLoopingAsync();
            return;
        }

        if (ActiveTrial is not { Elsewhere: true } trial || _variation is not { Notes.Count: > 0 } variation)
        {
            return;
        }

        TickSpan origin = trial.OfferedIn.Selection.Span;
        TickSpan passage = trial.Experiment.Passage.Span;
        Tick start = origin.Onset < passage.Onset ? origin.Onset : passage.Onset;
        Tick end = BeatEnd(variation.Notes.Max(note => note.Span.End));
        end = end < passage.End ? passage.End : end;
        end = end > _score!.End ? _score.End : end;
        TickSpan range = TickSpan.FromBounds(start, end);

        _looping = false;
        _alternating = false;
        _hear = [InPlaceSource];
        await Player.SelectSourcesAsync(_hear);
        await Player.SetLoopAsync(range);
        _answerLoop = range;
        await Player.SeekAsync(range.Onset);
        if (Player.State == PlaybackState.Stopped)
        {
            await PlayAsync();
        }
    }

    /// <summary>Listens to one layer of the selection, or to all of it, and loops it at once.</summary>
    private async Task SetListenToAsync(ListenTo choice)
    {
        _listenTo = choice;
        await SetVariationSourcesAsync();
        if (_looping && _selection is { NoteIds.Count: > 0 } selection)
        {
            await LoopSelectionAsync(selection);
        }
        else
        {
            await AuditionAsync(variation: _variation is not null && VariationChosen);
        }
    }

    /// <summary>Hands the player the motif or the variation as a MIDI file (S1-X1), named after the project, the bars and the steps.</summary>
    private async Task ExportMidiAsync(bool variation)
    {
        if (_selection is not { } selection || _notes is null || _score is null || _meter is null || (variation && _variation is null))
        {
            return;
        }

        IReadOnlyList<Note> notes = variation ? _variation!.Notes : VariationFacts.MotifNotes(_notes, selection);
        string project = Path.GetFileNameWithoutExtension(_project?.FileName ?? CurrentPiece.Piece?.FileName ?? "");
        string bars = selection.BarCount == 1 ? $"bar {selection.FirstBar}" : $"bars {selection.FirstBar}–{selection.LastBar}";
        string? steps = variation && _chain is { } chain
            ? string.Join(" › ", [.. chain.Steps.Select(StepLabel), .. chain.Pending is { } pending ? [StepLabel(pending)] : Array.Empty<string>()])
            : null;
        byte[] file = MidiExporter.Export(notes, _score.Tempos, _meter, project, selection.Span.Onset);
        await Projects.DownloadAsync(MidiExporter.FileName(project, bars, steps), file, "audio/midi");
        await Analytics.TrackAsync(AnalyticsEvent.MidiExported(variation, variation ? _chain?.Steps.Count ?? 0 : 0));
    }

    /// <summary>The button label of a step, with the layer it was limited to: "Detached (the melody)".</summary>
    private string StepLabel(VariationStep step)
    {
        OperationParameters whole = step.Parameters with { Scope = OperationScope.All };
        string label = s_operations.Where(group => group.Operation.Id == step.Operation.Id).SelectMany(group => group.Choices)
            .FirstOrDefault(choice => choice.Parameters == whole) is { } choice ? ChoiceLabel(choice) : step.Operation.NameIn(Words);
        return step.Parameters.Scope == OperationScope.All ? label : $"{label} ({OperationScopes.Describe(step.Parameters.Scope, Words)})";
    }

    /// <summary>A parameter button's label: "Syncopate"; in Russian "Синкопирование (Syncopate)".</summary>
    private string ChoiceLabel(OperationChoice choice) => Text[$"op.{choice.Key}"];

    /// <summary>An operation's name: "Rhythm reshape"; in Russian with the English after it, "Изменение ритма (Rhythm reshape)".</summary>
    private string OperationTitle(IVariationOperation operation) =>
        Words.IsRussian ? $"{operation.NameIn(Words)} ({operation.Name})" : operation.Name;

    private string KeepLabel(KeepProperty property) => Text[$"term.keep.{property}"];

