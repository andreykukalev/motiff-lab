@page "/"
@using MotiffLab.MusicCore.Projects
@using MotiffLab.Web.Import
@using MotiffLab.Web.Localization
@using MotiffLab.Web.Projects
@implements IDisposable
@inject ProjectStore Projects
@inject NavigationManager Navigation
@inject UiText Text
@inject MotiffLab.Web.Account.OnlineProjects Online
@inject MotiffLab.Web.Account.CloudAccount Account
@inject ScanService Scans

<PageTitle>Motiff Lab</PageTitle>

@* N1 · Projects (S1-P1, 0012): a project is a piece and everything the player made around it. Opening one goes to its page,
   with its sessions and ideas; export and re-import as one file for backup (AC-S1-20). The screen also starts a new piece
   by each route in (a file, a scan, a recording, Für Elise). *@
<main class="lab projects home-screen">
    <header class="page-header">
        <div class="brand">
            <h1>Motiff Lab</h1>
            <p class="tagline">@Text["home.tagline"]</p>
        </div>
        <MotiffLab.Web.Account.AccountButton />
    </header>

    @if (_summaries is { Count: 0 })
    {
        <p class="lead">@Text["home.emptyWhat"]</p>
    }

    @if (_message is not null)
    {
        <p class="error" role="alert">@_message</p>
    }

    @if (_nearlyFull)
    {
        <p class="warning" role="status">@Text["home.nearlyFull"]</p>
    }

    @* The routes in, as large tiles a finger finds on an iPad at the piano. Scanning and transcription say here when they
       need a server or a sign-in first; the import screen has the details. *@
    <section class="start-new" aria-labelledby="start-heading">
        <h2 id="start-heading">@Text["home.startHeading"]</h2>
        <ul class="start-tiles">
            <li>
                <a class="start-tile" href="import">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v14H6z M14 3v4h4 M10 17V11l5-1v6 M10 17a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z M15 16a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z" /></svg>
                    <strong>@Text["home.fromFile"]</strong>
                    <span class="hint">@Text["home.fromFileHint"]</span>
                </a>
            </li>
            <li>
                <a class="start-tile" href="import#scan-heading">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8V4h4 M16 4h4v4 M20 16v4h-4 M8 20H4v-4 M7 9h10 M7 12h10 M7 15h10" /></svg>
                    <strong>@Text["home.fromScan"]</strong>
                    <span class="hint">@Text["home.fromScanHint"]</span>
                    @if (_serverNote is not null)
                    {
                        <span class="needs">@_serverNote</span>
                    }
                </a>
            </li>
            <li>
                <a class="start-tile" href="import#transcribe-heading">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h2 M7 8v8 M11 5v14 M15 9v6 M19 11v2 M21 12h0" /></svg>
                    <strong>@Text["home.fromRecording"]</strong>
                    <span class="hint">@Text["home.fromRecordingHint"]</span>
                    @if (_serverNote is not null)
                    {
                        <span class="needs">@_serverNote</span>
                    }
                </a>
            </li>
            <li>
                <a class="start-tile demo" href="playback?start=fur-elise">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" /></svg>
                    <strong>@Text["home.tryFurElise"]</strong>
                    <span class="hint">@Text["home.furEliseHint"]</span>
                </a>
            </li>
        </ul>
        <p class="restore">
            <label class="file">
                @Text["home.importProject"]
                <InputFile OnChange="ImportProjectAsync" accept=".json" />
            </label>
            <span class="meta">@Text["home.importProjectHint"]</span>
        </p>
    </section>

    @if (_summaries is null)
    {
        <p class="meta">@Text["home.loading"]</p>
    }
    else if (_summaries.Count == 0)
    {
        <section class="how" aria-labelledby="how-heading">
            <h2 id="how-heading">@Text["home.howHeading"]</h2>
            <ol class="steps">
                <li>@Text["home.step1"]</li>
                <li>@Text["home.step2"]</li>
                <li>@Text["home.step3"]</li>
            </ol>
        </section>
    }
    else
    {
        <section aria-labelledby="projects-heading">
            <h2 id="projects-heading">@Text["home.projects"]</h2>
            <ul class="project-list">
                @foreach (ProjectSummary summary in _summaries)
                {
                    <li class="project-card">
                        <a class="project-name" href="@ProjectPage.Url(summary.Id)">@summary.FileName</a>
                        <p class="meta">
                            @Text.Format("home.counts", summary.SessionCount, summary.IdeaCount)
                            · @Text.Format("home.lastOpened", summary.LastOpened.ToLocalTime().ToString("g", Text.Culture))
                        </p>
                        <div class="actions">
                            <a class="button primary" href="@ProjectPage.Url(summary.Id)">@Text["home.open"]</a>
                            <button @onclick="() => ExportAsync(summary.Id)">@Text["home.export"]</button>
                            @if (_confirmDelete == summary.Id)
                            {
                                <button class="on" @onclick="() => DeleteAsync(summary.Id)">@Text["home.deleteForGood"]</button>
                                <button @onclick="() => _confirmDelete = null">@Text["home.keep"]</button>
                            }
                            else
                            {
                                <button @onclick="() => _confirmDelete = summary.Id">@Text["home.delete"]</button>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    }

    @if (_onlineOnly is { Count: > 0 })
    {
        @* Saved online from another device (0014): fetched only when the player asks for it. *@
        <section aria-labelledby="online-only-heading">
            <h2 id="online-only-heading">@Text["home.onlineOnly"]</h2>
            <ul class="project-list">
                @foreach (ProjectSummary summary in _onlineOnly)
                {
                    <li class="project-card">
                        <span class="project-name">@summary.FileName</span>
                        <p class="meta">
                            @Text.Format("home.counts", summary.SessionCount, summary.IdeaCount)
                            · @Text.Format("home.lastOpened", summary.LastOpened.ToLocalTime().ToString("g", Text.Culture))
                        </p>
                        <div class="actions">
                            <button class="primary" @onclick="() => GetHereAsync(summary.Id)">@Text["home.getHere"]</button>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }

</main>

@code {
    private IReadOnlyList<ProjectSummary>? _summaries;
    private bool _nearlyFull;
    private string? _message;
    private string? _confirmDelete;
    private IReadOnlyList<ProjectSummary>? _onlineOnly;
    private string? _player;

    /// <summary>What scanning and transcription need before they work here, or null when they are ready.</summary>
    private string? _serverNote;

    protected override void OnInitialized() => Text.Changed += OnChanged;

    public void Dispose() => Text.Changed -= OnChanged;

    private void OnChanged()
    {
        _serverNote = ServerNote();
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await Scans.LoadAsync();
        _player = await Account.PlayerAsync();
        _serverNote = ServerNote();
    }

    /// <summary>The same states the import screen explains: no server set, Motiff Lab's server turned off, or not signed in for it.</summary>
    private string? ServerNote() => Scans.Address is null
        ? Text[Scans.HostedAddress is null ? "home.needsServer" : "home.scanTurnedOff"]
        : Scans.IsHosted && _player is null ? Text["home.needsSignIn"] : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        _summaries = await Projects.ListAsync();
        _nearlyFull = await Projects.IsNearlyFullAsync();
        _onlineOnly = null;
        if (await Online.IsOnAsync())
        {
            // Offline or signed out, the list is just left out: this screen is about the projects here.
            (IReadOnlyList<ProjectSummary>? online, _) = await Online.ListAsync();
            HashSet<string> here = [.. _summaries.Select(summary => summary.Id)];
            _onlineOnly = online?.Where(summary => !here.Contains(summary.Id)).ToList();
        }
    }

    private async Task GetHereAsync(string id)
    {
        _message = null;
        (Project? project, string? problem) = await Online.DownloadAsync(id);
        if (project is null)
        {
            _message = problem;
            return;
        }

        await Projects.SaveHereAsync(project);
        await RefreshAsync();
    }

    private async Task ExportAsync(string id)
    {
        _message = null;
        try
        {
            if (await Projects.LoadAsync(id) is { } project)
            {
                await Projects.ExportAsync(project);
            }
        }
        catch (ProjectFileException exception)
        {
            _message = exception.Message;
        }
    }

    private async Task DeleteAsync(string id)
    {
        _confirmDelete = null;
        await Projects.DeleteAsync(id);
        await RefreshAsync();
    }

    /// <summary>Re-imports an exported project (AC-S1-20). It replaces a saved project with the same id.</summary>
    private async Task ImportProjectAsync(InputFileChangeEventArgs args)
    {
        _message = null;
        try
        {
            // A project holds a source of at most 5 MB, which base64 and the JSON around it grow by about a third.
            await using Stream stream = args.File.OpenReadStream(8 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            Project project = ProjectFile.Read(memory.ToArray());
            OpenedProject.Open(project);
            await Projects.SaveAsync(project);
            await RefreshAsync();
        }
        catch (ProjectFileException exception)
        {
            _message = $"{args.File.Name}: {exception.Message}";
        }
        catch (IOException)
        {
            _message = Text.Format("home.tooLarge", args.File.Name);
        }
    }
}
