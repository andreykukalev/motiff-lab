@page "/"
@using MotiffLab.MusicCore.Projects
@using MotiffLab.Web.Import
@using MotiffLab.Web.Projects
@using MotiffLab.Web.Score
@implements IAsyncDisposable

<PageTitle>Motiff Lab</PageTitle>

@* The library (0018 section 9; version 0.2, ux-prototype/v2/screens/lib-1-list.png and lib-3-sessions.png): the screen outside
   the piece. Its search, Add piece, the overflow that imports a project file, and the account head it; the tabs list every
   piece with its columns, the composers, the pieces opened last, the playlists, and the sessions of current work as cards,
   each resumed where it was left with one tap. Long-press on a card (or its •••) lists its resume points to resume, name or
   remove. On the very first run, before the library, one screen asks for a preset (0018 section 10), once. *@
@if (_firstRun is true)
{
    <FirstRun Done="() => _firstRun = false" />
}
else if (_firstRun is false)
{
    <main class="lab library">
        <header class="lib-head">
            <h1 class="display">@Text["library.title"]</h1>
            <div class="lib-actions">
                @if (Shelf.Entries.Count > 0)
                {
                    <label class="search">
                        <Icon Name="search" />
                        <input type="search" value="@Shelf.Query.Search" placeholder="@Text["library.searchHint"]" aria-label="@Text["library.search"]"
                               @oninput="change => Narrow(Shelf.Query with { Search = change.Value as string })" />
                    </label>
                }
                <button class="btn primary add-piece" @onclick="OpenAddPiece" aria-haspopup="dialog"><Icon Name="plus" /> @Text["library.addPiece"]</button>
                <div class="lib-more-wrap">
                    <button class="btn icon" aria-label="@Text["library.more"]" title="@Text["library.more"]" aria-expanded="@(_menu == LibraryMenu ? "true" : "false")"
                            @onclick="() => ToggleMenu(LibraryMenu)"><Icon Name="more" /></button>
                    @if (_menu == LibraryMenu)
                    {
                        <div class="lib-menu" role="group" aria-label="@Text["library.more"]">
                            <label class="btn quiet file">
                                <Icon Name="file" /> @Text["home.importProject"]
                                <InputFile OnChange="ImportProjectAsync" accept=".json" />
                            </label>
                            <p class="caption">@Text["home.importProjectHint"]</p>
                        </div>
                    }
                </div>
                @* The Reference (an experiment, Settings · Experimental): the circle of fifths in one tap. *@
                <MotiffLab.Web.Reference.ReferenceButton />
                <button class="btn quiet" aria-haspopup="dialog" @onclick="() => _settingsOpen = true">@Text["settings.title"]</button>
                <MotiffLab.Web.Account.AccountButton Opened="OpenAccount" />
            </div>
        </header>

        @if (_message is not null)
        {
            <p class="lib-note error" role="alert">@_message</p>
        }

        @if (_nearlyFull)
        {
            <p class="lib-note warning" role="status">@Text["home.nearlyFull"]</p>
        }

        @* The folder import's line (an experiment, Settings · Experimental, version 0.5); nothing while it is off. *@
        <MotiffLab.Web.Library.ImportBanner Listed="RefreshAsync" />

        @* Sync with the player's other devices (version 0.2): a pass when the library opens and comes back into view. *@
        <MotiffLab.Web.Account.LibrarySync Synced="RefreshAsync" />

        @if (_summaries is null)
        {
            <p class="meta">@Text["home.loading"]</p>
        }
        else if (Shelf.Entries.Count == 0)
        {
            <p class="lead">@Text["home.emptyWhat"]</p>
            <ul class="lib-grid">
                <li class="card add">
                    <button class="add-round" @onclick="OpenAddPiece" aria-haspopup="dialog" aria-labelledby="add-card-title"><Icon Name="plus" Size="IconSize.Large" /></button>
                    <h3 class="ttl" id="add-card-title">@Text["library.addAPiece"]</h3>
                    <ul class="routes">
                        <li>@Text["library.routeFile"]</li>
                        <li>@Text["library.routeScan"]</li>
                        <li>@Text["library.routeRecording"]</li>
                    </ul>
                    <a class="demo" href="playback?start=fur-elise">@Text["library.tryDemo"]</a>
                </li>
            </ul>
        }
        else
        {
            <LibraryTools State="Shelf" Changed="OnShelfChanged" />
            LibraryPage page = Shelf.Page;
            <div class="lib-panel @(page.Indexed && !page.IsEmpty ? "indexed" : null)">
                @if (page.Groups is { } groups)
                {
                    <LibraryGroups Groups="groups" Picked="group => Shelf.Pick(group)" />
                    @if (groups.Count == 0 && !Shelf.Query.Narrows && Shelf.Tab == LibraryTab.Playlists)
                    {
                        <p class="lead">@Text["library.noPlaylists"]</p>
                    }
                }
                else if (Shelf.Tab == LibraryTab.Sessions)
                {
                    @* The sessions of current work as cards (lib-3-sessions.png): each resumed where it was left with one tap. *@
                    <ul class="lib-grid">
                        @foreach (LibraryEntry entry in Shelf.Page.Pieces)
                        {
                            ProjectSummary summary = entry.Summary;
                            PieceCover? cover = _covers.GetValueOrDefault(summary.Id);
                            string title = entry.Title;
                            string headingId = $"piece-{summary.Id}";
                            <li class="card piece @(_menu == summary.Id ? "menu-open" : null)" @key="summary.Id" aria-labelledby="@headingId"
                                @onclick="() => CardClickedAsync(summary)" @oncontextmenu="() => OpenResumesAsync(summary)" @oncontextmenu:preventDefault="true"
                                @onpointerdown="() => PressStart(summary)" @onpointerup="PressEnd" @onpointerleave="PressEnd" @onpointercancel="PressEnd">
                                <div class="top">
                                    <button class="thumb" aria-label="@Text.Format("library.openPage1", title)" @onclick="() => OpenFreshAsync(summary.Id, null)" @onclick:stopPropagation="true" disabled="@_opening">
                                        @if (cover is not null)
                                        {
                                            <img src="@cover.Url" alt="" loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <span class="blank" aria-hidden="true"></span>
                                        }
                                    </button>
                                    <div class="what">
                                        <h3 class="ttl" id="@headingId">@title</h3>
                                        <p class="meta">@MetaLine(summary, cover, entry.Composer)</p>
                                        <PieceTags Entry="entry" Shelf="Shelf" />
                                    </div>
                                    @CardMenu(entry)
                                </div>
                                <div class="rule"></div>
                                <p class="overline">@Text["library.recentWork"]</p>
                                @if (summary.Origin == PieceOrigin.Pdf)
                                {
                                    @* A PDF read as it is has no resume points: it opens at the page it was left on (0023). *@
                                    <p class="resume-name">@Text["library.pdfAsIs"]</p>
                                    <p class="meta">@Text.Format("home.lastOpened", Day(summary.LastOpened))</p>
                                }
                                else if (summary.Latest is { } latest)
                                {
                                    <p class="resume-name">@ResumeName(latest, cover)</p>
                                    <p class="meta">@ResumeLine(latest, cover)</p>
                                }
                                <div class="row">
                                    <button class="btn secondary resume" @onclick="() => ResumeAsync(summary.Id, null)" @onclick:stopPropagation="true" disabled="@_opening"
                                            aria-label="@Text.Format("library.resumeLabel", title)"><Icon Name="play" /> @Text["library.resume"]</button>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else if (!page.IsEmpty)
                {
                    <LibraryList Entries="page.Pieces" Query="Shelf.Query" Sorted="column => Narrow(Shelf.Query.SortedBy(column))" Opened="entry => CardClickedAsync(entry.Summary)"
                                 Menu="CardMenu" When="Day" MenuOpen="@_menu" Busy="_opening" Shelf="Shelf" />
                }
                @if (page.Indexed && !page.IsEmpty)
                {
                    <LibraryIndex Initials="page.Initials" />
                }
            </div>
        }

        @if (_onlineOnly is { Count: > 0 })
        {
            @* Saved online from another device (0014) and not fetched by the sync, as when it could not be read here. *@
            <h2 class="overline">@Text["home.onlineOnly"]</h2>
            <ul class="lib-grid online">
                @foreach (ProjectSummary summary in _onlineOnly)
                {
                    <li class="card piece">
                        <h3 class="ttl">@ScoreTitle.Of(summary.FileName)</h3>
                        <p class="meta">@Text.Format("home.lastOpened", summary.LastOpened.ToLocalTime().ToString("g", Text.Culture))</p>
                        <div class="row">
                            <button class="btn secondary" @onclick="() => GetHereAsync(summary.Id)">@Text["home.getHere"]</button>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (_menu is not null)
        {
            <div class="lib-scrim clear" @onclick="() => ToggleMenu(null)"></div>
        }

        @if (_sheet != Sheet.None)
        {
            <div class="lib-scrim" @onclick="CloseSheet"></div>
        }

        @if (_sheet == Sheet.AddPiece)
        {
            <AddPieceSheet ServerNote="@_serverNote" UsesOurServer="UsesOurServer" Closed="CloseSheet" />
        }
        else if (_sheet == Sheet.Edit && _editing is { } editing)
        {
            <PiecePropertiesSheet Project="editing" LibraryComposers="Shelf.Composers" LibraryTags="Shelf.Tags" LibraryPlaylists="Shelf.Playlists" Saved="SaveDetailsAsync" Closed="CloseSheet" />
        }
        else if (_sheet == Sheet.Account)
        {
            @* The account sheet behind the avatar (0018 section 9, "Account"): signing in, the plan, saving online, privacy and terms. *@
            <section class="lib-sheet account-sheet" role="dialog" aria-modal="true" aria-labelledby="account-title" tabindex="-1" @ref="_sheetElement" @onkeydown="OnSheetKey">
                <header class="hd">
                    <h2 class="ttl" id="account-title">@Text["account.title"]</h2>
                    <button class="btn icon" aria-label="@Text["library.close"]" title="@Text["library.close"]" @onclick="CloseSheet"><Icon Name="close" /></button>
                </header>
                <MotiffLab.Web.Account.AccountPanel Level="3" />
                <p class="caption"><a href="privacy">@Text["footer.privacy"]</a> · <a href="terms">@Text["footer.terms"]</a></p>
            </section>
        }
        else if (_sheet == Sheet.Resumes && _resumeProject is { } project)
        {
            @* The resume points of one piece (0018 section 9): resume any, name it, or remove it; or start a new one from page 1, named
               by the player's words when they give any. *@
            <section class="lib-sheet resume-sheet" role="dialog" aria-modal="true" aria-labelledby="resume-title" tabindex="-1" @ref="_sheetElement" @onkeydown="OnSheetKey">
                <header class="hd">
                    <div>
                        <p class="overline">@Text["library.resumePoints"]</p>
                        <h2 class="ttl" id="resume-title">@_resumeTitle</h2>
                    </div>
                    <button class="btn icon" aria-label="@Text["library.close"]" title="@Text["library.close"]" @onclick="CloseSheet"><Icon Name="close" /></button>
                </header>
                @if (project.ResumePoints.Count == 0)
                {
                    <p class="meta">@Text["project.noSessions"]</p>
                }
                else
                {
                    <ul class="resume-list">
                        @foreach (ResumePoint point in project.RecentResumePoints)
                        {
                            <li class="resume-item">
                                <label class="name">
                                    <span class="visually-hidden">@Text["library.nameLabel"]</span>
                                    <input type="text" maxlength="120" value="@point.Name" placeholder="@PointFallbackName(point)"
                                           @onchange="change => RenameAsync(point, change.Value as string)" />
                                </label>
                                <p class="meta">@PointLine(point)</p>
                                <div class="row">
                                    <button class="btn secondary" @onclick="() => ResumeAsync(project.Id, point.Id)" disabled="@_opening"><Icon Name="play" /> @Text["library.resume"]</button>
                                    @if (_confirmRemove == point.Id)
                                    {
                                        <button class="btn quiet danger" @onclick="() => RemoveAsync(point)">@Text["project.endForGood"]</button>
                                        <button class="btn quiet" @onclick="() => _confirmRemove = null">@Text["home.keep"]</button>
                                    }
                                    else
                                    {
                                        <button class="btn quiet" @onclick="() => _confirmRemove = point.Id" title="@Text["project.endHint"]">@Text["project.end"]</button>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                <div class="start-new">
                    <label class="name">
                        <span class="caption">@Text["project.taskLabel"]</span>
                        <input type="text" maxlength="120" @bind="_newName" @bind:event="oninput" placeholder="@Text["project.taskPlaceholder"]" />
                    </label>
                    <button class="btn primary" @onclick="() => OpenFreshAsync(project.Id, _newName)" disabled="@_opening">@Text["library.startNew"]</button>
                </div>
            </section>
        }
        @if (_settingsOpen)
        {
            <SettingsSheet Closed="() => _settingsOpen = false" />
        }
    </main>
}

@code {
    /// <summary>A piece's ••• and its menu, the same on a card and on a row of the list.</summary>
    private RenderFragment CardMenu(LibraryEntry entry) => @<div class="card-more">
        <button class="btn icon" aria-label="@Text.Format("library.moreFor", entry.Title)" title="@Text["library.more"]" aria-expanded="@(_menu == entry.Summary.Id ? "true" : "false")"
                @onclick="() => ToggleMenu(entry.Summary.Id)" @onclick:stopPropagation="true"><Icon Name="more" /></button>
        @if (_menu == entry.Summary.Id)
        {
            ProjectSummary summary = entry.Summary;
            <div class="lib-menu" role="group" aria-label="@Text.Format("library.moreFor", entry.Title)" @onclick:stopPropagation="true">
                @if (summary.Origin != PieceOrigin.Pdf)
                {
                    <button class="btn quiet" @onclick="() => OpenFreshAsync(summary.Id, null)" disabled="@_opening"><Icon Name="file" /> @Text["library.page1"]</button>
                    <button class="btn quiet" @onclick="() => OpenResumesAsync(summary)"><Icon Name="pages" /> @Text["library.resumePoints"]</button>
                    <button class="btn quiet" @onclick="() => ResumeAsync(summary.Id, null, dna: true)" disabled="@_opening"><Icon Name="phrases" /> @Text["dna.title"]</button>
                }
                <button class="btn quiet" @onclick="() => OpenEditAsync(entry)"><Icon Name="pen" /> @Text["library.properties"]</button>
                <button class="btn quiet" @onclick="() => ExportAsync(summary.Id)"><Icon Name="export" /> @Text["library.export"]</button>
                @if (_confirmDelete == summary.Id)
                {
                    <button class="btn quiet danger" @onclick="() => DeleteAsync(summary.Id)"><Icon Name="trash" /> @Text["home.deleteForGood"]</button>
                    <button class="btn quiet" @onclick="() => _confirmDelete = null">@Text["home.keep"]</button>
                }
                else
                {
                    <button class="btn quiet" @onclick="() => _confirmDelete = summary.Id"><Icon Name="trash" /> @Text["home.delete"]</button>
                }
            </div>
        }
    </div>;
}