@page "/"
@using MotiffLab.MusicCore.Projects
@using MotiffLab.Web.Import
@using MotiffLab.Web.Localization
@using MotiffLab.Web.Projects
@implements IDisposable
@inject ProjectStore Projects
@inject NavigationManager Navigation
@inject UiText Text
@inject MotiffLab.Web.Account.OnlineProjects Online

<PageTitle>Motiff Lab</PageTitle>

@* N1 · Projects (S1-P1, 0012): a project is a piece and everything the player made around it. Opening one goes to its page,
   with its sessions and ideas; export and re-import as one file for backup (AC-S1-20). *@
<main class="lab projects">
    <header class="page-header">
        <h1>Motiff Lab</h1>
        <MotiffLab.Web.Account.AccountButton />
    </header>
    <p class="tagline">@Text["home.tagline"]</p>

    <section class="row">
        <a class="button primary" href="import">@Text["home.import"]</a>
        <label class="file">
            @Text["home.importProject"]
            <InputFile OnChange="ImportProjectAsync" accept=".json" />
        </label>
        <a href="playback">@Text["home.tryFurElise"]</a>
    </section>

    @if (_message is not null)
    {
        <p class="error" role="alert">@_message</p>
    }

    @if (_nearlyFull)
    {
        <p class="warning" role="status">@Text["home.nearlyFull"]</p>
    }

    @if (_summaries is null)
    {
        <p class="meta">@Text["home.loading"]</p>
    }
    else if (_summaries.Count == 0)
    {
        <section class="empty">
            <p>@Text["home.emptyWhat"]</p>
            <p class="meta">@Text["home.emptyHow"]</p>
        </section>
    }
    else
    {
        <h2>@Text["home.projects"]</h2>
        <ul class="project-list">
            @foreach (ProjectSummary summary in _summaries)
            {
                <li class="project-card">
                    <a class="project-name" href="@ProjectPage.Url(summary.Id)">@summary.FileName</a>
                    <p class="meta">
                        @Text.Format("home.counts", summary.SessionCount, summary.IdeaCount)
                        · @Text.Format("home.lastOpened", summary.LastOpened.ToLocalTime().ToString("g", Text.Culture))
                    </p>
                    <div class="actions">
                        <a class="button primary" href="@ProjectPage.Url(summary.Id)">@Text["home.open"]</a>
                        <button @onclick="() => ExportAsync(summary.Id)">@Text["home.export"]</button>
                        @if (_confirmDelete == summary.Id)
                        {
                            <button class="on" @onclick="() => DeleteAsync(summary.Id)">@Text["home.deleteForGood"]</button>
                            <button @onclick="() => _confirmDelete = null">@Text["home.keep"]</button>
                        }
                        else
                        {
                            <button @onclick="() => _confirmDelete = summary.Id">@Text["home.delete"]</button>
                        }
                    </div>
                </li>
            }
        </ul>
        <p class="meta">@Text[_onlineOn ? "home.savedOnlineToo" : "home.savedHere"]</p>
    }

    @if (_onlineOnly is { Count: > 0 })
    {
        @* Saved online from another device (0014): fetched only when the player asks for it. *@
        <h2>@Text["home.onlineOnly"]</h2>
        <ul class="project-list">
            @foreach (ProjectSummary summary in _onlineOnly)
            {
                <li class="project-card">
                    <span class="project-name">@summary.FileName</span>
                    <p class="meta">
                        @Text.Format("home.counts", summary.SessionCount, summary.IdeaCount)
                        · @Text.Format("home.lastOpened", summary.LastOpened.ToLocalTime().ToString("g", Text.Culture))
                    </p>
                    <div class="actions">
                        <button class="primary" @onclick="() => GetHereAsync(summary.Id)">@Text["home.getHere"]</button>
                    </div>
                </li>
            }
        </ul>
    }
</main>

@code {
    private IReadOnlyList<ProjectSummary>? _summaries;
    private bool _nearlyFull;
    private string? _message;
    private string? _confirmDelete;
    private IReadOnlyList<ProjectSummary>? _onlineOnly;
    private bool _onlineOn;

    protected override void OnInitialized() => Text.Changed += OnTextChanged;

    public void Dispose() => Text.Changed -= OnTextChanged;

    private void OnTextChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        _summaries = await Projects.ListAsync();
        _nearlyFull = await Projects.IsNearlyFullAsync();
        _onlineOnly = null;
        _onlineOn = await Online.IsOnAsync();
        if (_onlineOn)
        {
            // Offline or signed out, the list is just left out: this screen is about the projects here.
            (IReadOnlyList<ProjectSummary>? online, _) = await Online.ListAsync();
            HashSet<string> here = [.. _summaries.Select(summary => summary.Id)];
            _onlineOnly = online?.Where(summary => !here.Contains(summary.Id)).ToList();
        }
    }

    private async Task GetHereAsync(string id)
    {
        _message = null;
        (Project? project, string? problem) = await Online.DownloadAsync(id);
        if (project is null)
        {
            _message = problem;
            return;
        }

        await Projects.SaveHereAsync(project);
        await RefreshAsync();
    }

    private async Task ExportAsync(string id)
    {
        _message = null;
        try
        {
            if (await Projects.LoadAsync(id) is { } project)
            {
                await Projects.ExportAsync(project);
            }
        }
        catch (ProjectFileException exception)
        {
            _message = exception.Message;
        }
    }

    private async Task DeleteAsync(string id)
    {
        _confirmDelete = null;
        await Projects.DeleteAsync(id);
        await RefreshAsync();
    }

    /// <summary>Re-imports an exported project (AC-S1-20). It replaces a saved project with the same id.</summary>
    private async Task ImportProjectAsync(InputFileChangeEventArgs args)
    {
        _message = null;
        try
        {
            // A project holds a source of at most 5 MB, which base64 and the JSON around it grow by about a third.
            await using Stream stream = args.File.OpenReadStream(8 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            Project project = ProjectFile.Read(memory.ToArray());
            OpenedProject.Open(project);
            await Projects.SaveAsync(project);
            await RefreshAsync();
        }
        catch (ProjectFileException exception)
        {
            _message = $"{args.File.Name}: {exception.Message}";
        }
        catch (IOException)
        {
            _message = Text.Format("home.tooLarge", args.File.Name);
        }
    }
}
