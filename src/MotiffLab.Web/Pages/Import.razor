@page "/import"
@page "/import/scan"
@page "/import/recording"
@using System.Diagnostics
@using MotiffLab.MusicCore.Analytics
@using MotiffLab.MusicCore.Import
@using MotiffLab.MusicCore.Import.Midi
@using MotiffLab.MusicCore.Import.Scan
@using MotiffLab.MusicCore.Import.Transcription
@using MotiffLab.MusicCore.Projects
@using MotiffLab.MusicCore.Time
@using MotiffLab.Web.Import
@using MotiffLab.Web.Projects
@inject CurrentPiece CurrentPiece
@inject ProjectStore Projects
@inject NavigationManager Navigation
@inject MotiffLab.Web.Analytics.UsageAnalytics Analytics
@inject ScanService Scans
@inject MotiffLab.Web.Pdf.ScoreScan ScoreScan
@inject MotiffLab.Web.Localization.UiText Text
@inject MotiffLab.Web.Account.CloudAccount Account
@inject MotiffLab.Web.Settings.DeviceSettings SettingsStore
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable

<PageTitle>@Text[Heading] · Motiff Lab</PageTitle>

@* N2 · Import (S1-I1, S1-I8): pick a file, read the import report, pick where to start. Each way in has its own screen, so the
   file picker takes only what that way reads. Opening a file (/import) parses it in the browser; the file never leaves the device.
   Scanning (/import/scan, 0011) is one exception: a PDF or photo the player picks for it goes to the scan server they set in Settings,
   and comes back as MusicXML. Transcription (/import/recording, 0014) is the other: the sound of a recording the player picks goes to
   the same server, and comes back as MIDI. *@
<PageSheet Title="@Text[Heading]" Class="import" Wide="@(_route == ImportRoute.Recording || _piece is not null)">

    @if (_route == ImportRoute.File)
    {
        <p class="meta">@Text["import.fileWhat"]</p>
        <label class="dropzone @(_reading ? "busy" : null)">
            <InputFile OnChange="OpenFileAsync" accept="@PieceImporter.AcceptedExtensions" disabled="@_reading" aria-label="@Text["import.fileChoose"]" />
            <span>@(_reading ? Text["import.reading"] : Text["import.fileDrop"])</span>
        </label>
    }
    else if (_route == ImportRoute.Scan)
    {
        <section class="scan" aria-label="@Text["home.fromScan"]">
            @if (Scans.Address is not { } server)
            {
                @if (Scans.HostedAddress is not null)
                {
                    <p class="meta">@Text["scan.turnedOff"] <a href="settings#scan">@Text["scan.turnOn"]</a>.</p>
                }
                else
                {
                    <p class="meta">@Text["import.scanSetUp"] <a href="settings#scan-heading">@Text["import.scanSetUpLink"]</a>.</p>
                }
            }
            else if (Scans.IsHosted && !_signedIn)
            {
                <MotiffLab.Web.Account.SignInPrompt Text="@Text["scan.signInPrompt"]" />
            }
            else if (Scans.IsHosted && !_scanPro)
            {
                <p class="meta">@Text["scan.proPrompt"]</p>
            }
            else
            {
                @* What leaves the device, as one short line above the file field (0018 section 9): picking the file sends it, with
                   no switch to turn on each time (v0.5, issue #479 item 17). *@
                <p class="meta">@Text.Format(Scans.IsLocal ? "import.scanLineHere" : "import.scanLine", server)</p>
                <label class="dropzone @(_scanning ? "busy" : null)">
                    <InputFile OnChange="ScanFileAsync" accept="@ScanService.AcceptedExtensions" multiple="@PhotosOn" disabled="@(_reading || _scanning)" aria-label="@Text[PhotosOn ? "import.scanChoosePhotos" : "import.scanChoose"]" />
                    <span>@(_scanning ? ScanBusy : Text[PhotosOn ? "import.scanDropPhotos" : "import.scanDrop"])</span>
                </label>
                @if (_scanning && _scanProgress is { } progress)
                {
                    <MotiffLab.Web.Pdf.ScanProgressBar Progress="progress" />
                }
            }
        </section>
    }
    else
    {
        <section class="scan" aria-label="@Text["home.fromRecording"]">
            @if (Scans.Address is not { } listener)
            {
                @if (Scans.HostedAddress is not null)
                {
                    <p class="meta">@Text["scan.turnedOff"] <a href="settings#scan">@Text["scan.turnOn"]</a>.</p>
                }
                else
                {
                    <p class="meta">@Text["transcribe.setUp"] <a href="settings#scan-heading">@Text["transcribe.setUpLink"]</a>.</p>
                }
            }
            else if (Scans.IsHosted && !_signedIn)
            {
                <MotiffLab.Web.Account.SignInPrompt Text="@Text["transcribe.signInPrompt"]" />
            }
            else if (Scans.IsHosted && !_transcribePro)
            {
                <p class="meta">@Text["transcribe.proPrompt"]</p>
            }
            else
            {
                <p class="meta">@Text.Format("transcribe.line", listener)</p>
                @if (!Scans.IsLocal)
                {
                    <label class="consent">
                        <input type="checkbox" role="switch" class="switch" @bind="_sendSound" />
                        <span>@(Scans.IsHosted ? Text["transcribe.sendHosted"] : Text.Format("transcribe.sendElsewhere", listener.Host))</span>
                    </label>
                }

                <label class="dropzone @(_transcribing || _decoding ? "busy" : null)">
                    <InputFile @ref="_recordingInput" OnChange="PickRecordingAsync" accept="@ScanService.AcceptedRecordings" disabled="@(_reading || _scanning || _transcribing || _decoding || !(Scans.IsLocal || _sendSound))" aria-label="@Text["transcribe.choose"]" />
                    <span>@(_decoding ? Text["transcribe.decoding"] : _loaded is not null && !_transcribing ? Text["transcribe.dropAnother"] : !_transcribing ? Text["transcribe.drop"] : HearingText(_hearing))</span>
                </label>

                @* The stretch to hear (0014), chosen as in an audio trimmer: a selection window on the recording's shape whose
                   edges, or the whole window, the player drags; a tap elsewhere moves the play position. Playing the selection
                   from its start, or its last seconds, and arrow keys 5 s either way find the exact edges by ear; before
                   sending, the estimate tells how many parts, and so requests to the server, the stretch takes. *@
                @if (_loaded is { } loaded && _range is { } range)
                {
                    <section class="recording-range" aria-labelledby="range-heading">
                        <h2 id="range-heading">@Text["transcribe.rangeHeading"]</h2>
                        <p class="meta">@Text.Format("transcribe.length", _recordingName, Clock(loaded.Milliseconds))</p>
                        <div class="wave-editor @(_transcribing ? "busy" : null)" @ref="_editor" data-from="@range.FromMilliseconds" data-to="@range.ToMilliseconds" data-length="@loaded.Milliseconds">
                            <div class="scrub" role="slider" tabindex="0" aria-label="@Text["transcribe.position"]" aria-valuemin="0" aria-valuemax="@loaded.Milliseconds" aria-valuenow="0" aria-valuetext="@Clock(0, tenths: true)">
                                <div class="knob"></div>
                            </div>
                            <div class="wave">
                                <svg class="waveform" viewBox="0 0 @loaded.Peaks.Length 100" preserveAspectRatio="none" role="img" aria-label="@Text.Format("transcribe.waveform", Clock(range.FromMilliseconds), Clock(range.ToMilliseconds), Clock(loaded.Milliseconds))">
                                    <path d="@_wave" />
                                </svg>
                                <div class="outside" style="left: 0; width: @Percent(range.FromMilliseconds)"></div>
                                <div class="outside" style="left: @Percent(range.ToMilliseconds); right: 0"></div>
                                <div class="selection" style="left: @Percent(range.FromMilliseconds); width: @Percent(range.Milliseconds)">
                                    <div class="handle start" role="slider" tabindex="0" aria-label="@Text["transcribe.from"]" aria-valuemin="0" aria-valuemax="@loaded.Milliseconds" aria-valuenow="@range.FromMilliseconds" aria-valuetext="@Clock(range.FromMilliseconds, tenths: true)"></div>
                                    <div class="handle end" role="slider" tabindex="0" aria-label="@Text["transcribe.to"]" aria-valuemin="0" aria-valuemax="@loaded.Milliseconds" aria-valuenow="@range.ToMilliseconds" aria-valuetext="@Clock(range.ToMilliseconds, tenths: true)"></div>
                                </div>
                            </div>
                            <div class="playhead" aria-hidden="true"></div>
                        </div>
                        <div class="wave-times">
                            <span>@Text["transcribe.from"] <strong>@Clock(range.FromMilliseconds, tenths: true)</strong></span>
                            <span class="position" aria-live="off">@Text["transcribe.position"] <strong data-position>@Clock(0, tenths: true)</strong></span>
                            <span>@Text["transcribe.to"] <strong>@Clock(range.ToMilliseconds, tenths: true)</strong></span>
                        </div>
                        <audio @ref="_player" preload="auto" src="@loaded.Url"></audio>
                        <div class="transport" role="group" aria-label="@Text["transcribe.player"]">
                            <button class="primary" @onclick="ListenAsync" disabled="@_transcribing">▶ @Text["transcribe.listen"]</button>
                            <button @onclick="ListenToEndAsync" disabled="@_transcribing">@Text["transcribe.listenEnd"]</button>
                            <button @onclick="TogglePlayAsync" disabled="@_transcribing">@(_playing ? "⏸ " + Text["transcribe.pause"] : "▶ " + Text["transcribe.play"])</button>
                            <button @onclick="() => SeekByAsync(-5000)" disabled="@_transcribing" aria-label="@Text["transcribe.back5"]">@Text["transcribe.back5Short"]</button>
                            <button @onclick="() => SeekByAsync(5000)" disabled="@_transcribing" aria-label="@Text["transcribe.forward5"]">@Text["transcribe.forward5Short"]</button>
                        </div>
                        <div class="transport">
                            <button @onclick="() => RangeHereAsync(start: true)" disabled="@_transcribing">@Text["transcribe.startHere"]</button>
                            <button @onclick="() => RangeHereAsync(start: false)" disabled="@_transcribing">@Text["transcribe.endHere"]</button>
                        </div>
                        <p class="meta">@Text["transcribe.rangeHow"]</p>
                        <p class="estimate">@Estimate(range)</p>
                        <div class="actions">
                            <button class="primary" @onclick="TranscribeRangeAsync" disabled="@(_transcribing || !(Scans.IsLocal || _sendSound))">@Text["transcribe.hearRange"]</button>
                        </div>
                    </section>
                }
            }
        </section>
    }

    @if (_rejection is { } rejection)
    {
        <section class="rejection" role="alert">
            <p class="error"><strong>@_fileName</strong>: @rejection.Text(MotiffLab.MusicCore.Words.For(Text.Language))</p>
            @if (TipFor(rejection) is { } tip)
            {
                <p>@tip</p>
            }
            @if (OtherRouteFor(rejection) is { } other)
            {
                <p><a href="@other.Href">@Text[other.Label]</a></p>
            }
        </section>
    }

    @if (_piece is { } piece)
    {
        ImportReport report = piece.Report;
        <section class="report" aria-label="@Text["import.report"]">
            <h2>@piece.FileName</h2>
            <p class="summary">
                @(_scan is not null ? Text.Format("import.scannedBy", _scanEngine) : _transcriptionEngine is { } heardBy ? Text.Format("transcribe.by", heardBy) : FormatName(piece.Format)) · @Text.Count("import.tracks", piece.Tracks.Count) · @Text.Count("import.noteCount", report.NoteCount) · @Text.Count("import.barCount", report.MeasureCount)
            </p>
            @if (_scan is { } scan)
            {
                <p class="meta">@Text.Format("import.scanRead", Text.Count("import.pageCount", _scanPages), _elapsed.TotalSeconds.ToString("0", Text.Culture))</p>
                @if (_leftOut.Count > 0)
                {
                    @* Photos of pages (v0.5): a page the scan server could not read is left out of the notes, and said so. *@
                    <ul class="warnings left-out">
                        @foreach (LeftOutPage page in _leftOut)
                        {
                            <li>@Text.Format("import.scanPageLeftOut", page.Page, page.Name, page.Problem)</li>
                        }
                    </ul>
                }
                @* Check the scan (0011): the bars the rules flag come first; the player checks them in the workspace. *@
                <section class="scan-check" aria-label="@Text["import.scanCheck"]">
                    <h3>@Text["import.scanCheck"]</h3>
                    @if (scan.Flagged.ToList() is { Count: > 0 } flagged)
                    {
                        <p>@Text.Format("import.scanFlagged", Text.Count("import.barCount", flagged.Count), scan.Bars.Count)</p>
                        <ul class="warnings">
                            @foreach (ScanBar bar in flagged)
                            {
                                <li><span class="kind">@Text.Format("import.bar", bar.Bar)</span> @string.Join(" ", bar.ReasonsIn(MotiffLab.MusicCore.Words.For(Text.Language)))</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>@Text["import.scanClean"]</p>
                    }
                    <ScanPagesSummary Pages="scan.Pages" />
                </section>
            }
            else if (_transcriptionEngine is not null)
            {
                <p class="meta">@(_heardRange is { IsWhole: false } heardRange
                    ? Text.Format("transcribe.heardRange", Clock(heardRange.FromMilliseconds), Clock(heardRange.ToMilliseconds), _elapsed.TotalSeconds.ToString("0.#", Text.Culture), Text.Count("transcribe.requests", _requests))
                    : Text.Format("transcribe.heard", _heardSeconds.ToString("0", Text.Culture), _elapsed.TotalSeconds.ToString("0.#", Text.Culture)))</p>
                <section class="scan-check" aria-label="@Text["transcribe.checkHeading"]">
                    <h3>@Text["transcribe.checkHeading"]</h3>
                    <p>@Text["transcribe.draft"]</p>
                    @* Bars and tempo worked out from the notes (0016): changed, or turned off, in the head of the Check drawer (0018 section 9). *@
                    <p>@(_bars is { } bars ? Text.Format("transcribe.barsReport", bars.Signature, bars.QuarterNotesPerMinute) : Text["transcribe.barsNone"])</p>
                    @if (SettingsStore.IsOn(MotiffLab.Web.Workspace.PartPlace.Setting))
                    {
                        @* An experiment (Settings · Experimental, version 0.5): the number of pieces, kept nowhere, opens the review of the pieces with it. *@
                        <div class="several-pieces">
                            <label class="consent">
                                <input type="checkbox" role="switch" class="switch" @bind="_severalPieces" />
                                <span>@Text["import.severalPieces"]</span>
                            </label>
                            @if (_severalPieces)
                            {
                                <label class="field">
                                    <span class="caption">@Text["import.piecesCount"]</span>
                                    <input type="number" inputmode="numeric" min="2" max="99" @bind="_piecesCount" />
                                </label>
                            }
                        </div>
                    }
                    @if (_cut)
                    {
                        <p class="notice">@Text.Format("transcribe.cut", (ScanService.ServerRecordingSeconds / 60.0).ToString("0.#", Text.Culture))</p>
                    }
                </section>
            }
            else
            {
                <p class="meta">@Text.Format("import.readHere", _elapsed.TotalSeconds.ToString("0.00", Text.Culture))</p>
            }

            <table class="tracks-table">
                <thead>
                    <tr><th scope="col">@Text["import.track"]</th><th scope="col">@Text["import.instrument"]</th><th scope="col">@Text["import.notes"]</th><th scope="col">@Text["import.hands"]</th></tr>
                </thead>
                <tbody>
                    @foreach (ImportedTrack track in piece.Tracks)
                    {
                        <tr>
                            <td>@track.Label</td>
                            <td>@(track.InstrumentName ?? "–")</td>
                            <td>@track.NoteCount</td>
                            <td>@(_scan is not null && track.Hands != TrackHands.None ? Text["import.handsScan"] : HandsLabel(track.Hands))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3>@Text["import.timing"]</h3>
            @if (report.OfKind(ImportIssueKind.Rounded).ToList() is { Count: > 0 } rounded)
            {
                <ul>
                    @foreach (ImportIssue issue in rounded)
                    {
                        <li>@issue.Text(MotiffLab.MusicCore.Words.For(Text.Language))</li>
                    }
                </ul>
                <p class="meta">@Text["import.roundedHow"]</p>
            }
            else
            {
                <p class="meta">@Text["import.notRounded"]</p>
            }
            @if (_timing?.Describe(MotiffLab.MusicCore.Words.For(Text.Language)) is { } played)
            {
                <p class="notice" role="status">@played</p>
                @if (_timing.Kind == TimingKind.Performance)
                {
                    <p class="meta">@Text["import.noRestoreYet"]</p>
                }
            }

            <h3>@Text["import.warnings"]</h3>
            @if (report.Issues.Where(issue => issue.Kind != ImportIssueKind.Rounded).ToList() is { Count: > 0 } warnings)
            {
                <ul class="warnings">
                    @foreach (ImportIssue issue in warnings)
                    {
                        <li><span class="kind">@KindLabel(issue.Kind)</span> @issue.Text(MotiffLab.MusicCore.Words.For(Text.Language))</li>
                    }
                </ul>
                <p class="meta">@Text["import.warningKinds"]</p>
            }
            else
            {
                <p class="meta">@Text["import.none"]</p>
            }
        </section>

        <section class="start" aria-label="@Text["import.whereToStart"]">
            <h3>@Text["import.startWith"]</h3>
            <div class="row" role="radiogroup">
                @for (int i = 0; i < piece.StartChoices.Count; i++)
                {
                    int index = i;
                    StartChoice choice = piece.StartChoices[i];
                    <label title="@(choice.IsInferred ? Text["import.handsInferredWhy"] : null)">
                        <input type="radio" name="start" checked="@(index == _start)" @onchange="() => _start = index" /> @choice.Label
                    </label>
                }
            </div>
            <button class="primary" @onclick="OpenAsync">@Text["import.open"]</button>
            <p class="meta">@Text["import.openSaves"]</p>
        </section>
    }

</PageSheet>

@code {
    private string? _fileName;
    private ImportedPiece? _piece;

    /// <summary>How the MIDI file's onsets sit against the grid (S1-I6, S1-R1, S1-R2); null for MusicXML, which is written.</summary>
    private PerformanceTiming? _timing;
    private byte[] _data = [];
    private ImportRejection? _rejection;
    private TimeSpan _elapsed;
    private int _start;
    private bool _reading;

    /// <summary>The checks of a piece read by the scan server (0011); null for a file imported on the device.</summary>
    private ScanCheck? _scan;

    /// <summary>The scan server's report on each page of the notes just read (version 0.4); empty without one.</summary>
    private IReadOnlyList<PageReport> _scanReports = [];
    private string _scanEngine = "";
    private int _scanPages;
    private bool _scanning;

    /// <summary>How far a PDF's notes are read (v0.5, issue #479), while one is.</summary>
    private MotiffLab.Web.Pdf.ScanProgress? _scanProgress;

    /// <summary>Photos of pages (v0.5): the page being read and how many were picked; 0 while one file is read.</summary>
    private (int Page, int Of) _photoPage;

    /// <summary>The photos whose pages could not be read, left out of the notes just read.</summary>
    private IReadOnlyList<LeftOutPage> _leftOut = [];

    /// <summary>Several photos of a piece's pages may be picked at once (the experiment «Фото страниц», v0.5).</summary>
    private bool PhotosOn => SettingsStore.IsOn(PhotoPages.Setting);

    private string ScanBusy => _photoPage.Of > 1 ? Text.Format("import.scanPageBusy", _photoPage.Page, _photoPage.Of) : Text["import.scanBusy"];

    /// <summary>The engine that heard a transcribed recording (0014); null for anything else.</summary>
    private string? _transcriptionEngine;

    /// <summary>Where a recording heard in parts was joined, in milliseconds (0018, preparation item 12): the Check layer flags those bars.</summary>
    private IReadOnlyList<long> _seams = [];
    private double _heardSeconds;
    private bool _cut;

    /// <summary>A recording this browser decoded and holds, for the player to choose the stretch to hear; null before one is picked or when it could not be decoded.</summary>
    private LoadedRecording? _loaded;
    private RecordingRange? _range;
    private string _recordingName = "";
    private bool _decoding;

    /// <summary>The recording's shape as one SVG path, worked out once when it is picked.</summary>
    private string _wave = "";
    private ElementReference _player;
    private ElementReference _editor;
    private bool _playing;

    /// <summary>Whether the selection editor's gestures and keys are wired up for the recording shown.</summary>
    private bool _editorAttached;
    private DotNetObjectReference<Import>? _self;

    /// <summary>How much of the selection's end "Listen to the end" plays.</summary>
    private const long EndCheckMilliseconds = 5_000;

    /// <summary>The stretch the last transcription heard, and how many requests it took; null when the file itself was sent.</summary>
    private RecordingRange? _heardRange;
    private int _requests;

    /// <summary>While a long recording is heard in parts: how many parts are heard of how many; null before the first word.</summary>
    private HearingProgress? _hearing;
    private bool _transcribing;
    private bool _sendSound;

    /// <summary>The transcription as the engine wrote it, marked as heard, before any bars are worked out.</summary>
    private ImportedPiece? _heard;

    /// <summary>The bars and tempo worked out from the notes (0016), as found or as the player changed them; null when none were found.</summary>
    private BarGrid? _bars;

    /// <summary>«В записи несколько пьес» and how many (version 0.5): passed to the workspace once, kept nowhere.</summary>
    private bool _severalPieces;
    private int _piecesCount = 2;
    private InputFile? _recordingInput;

    /// <summary>Whether a player is signed in, which Motiff Lab's scan server needs.</summary>
    private bool _signedIn;
    private bool _scanPro;
    private bool _transcribePro;

    /// <summary>The way in this screen is for, from its address.</summary>
    private enum ImportRoute
    {
        File,
        Scan,
        Recording,
    }

    private ImportRoute _route;

    private string Heading => _route switch
    {
        ImportRoute.Scan => "home.fromScan",
        ImportRoute.Recording => "home.fromRecording",
        _ => "home.fromFile",
    };

    protected override void OnInitialized() => Text.Changed += OnTextChanged;

    public void Dispose()
    {
        Text.Changed -= OnTextChanged;
        _ = Scans.ForgetRecordingAsync();
        _self?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loaded is not null && !_editorAttached)
        {
            _editorAttached = true;
            _self ??= DotNetObjectReference.Create(this);
            await Scans.AttachEditorAsync(_editor, _player, _self);
        }
    }

    private void OnTextChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        await Scans.LoadAsync();
        await SettingsStore.LoadAsync();
        _signedIn = await Account.PlayerAsync() is not null;
        // Scanning and transcription on Motiff Lab's server are one Pro feature each (0018 section 12); the server checks it too.
        _scanPro = _signedIn && await Account.AllowsAsync(MotiffLab.MusicCore.Accounts.ProFeature.Scan);
        _transcribePro = _signedIn && await Account.AllowsAsync(MotiffLab.MusicCore.Accounts.ProFeature.Transcribe);
    }

    protected override void OnParametersSet()
    {
        string path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        ImportRoute route = path switch
        {
            "import/scan" => ImportRoute.Scan,
            "import/recording" => ImportRoute.Recording,
            _ => ImportRoute.File,
        };
        if (route != _route)
        {
            // Another way in starts afresh: what was picked on the last screen is not this one's.
            (_route, _piece, _rejection, _scan, _transcriptionEngine, _timing) = (route, null, null, null, null, null);
            (_loaded, _range, _wave, _editorAttached, _playing) = (null, null, "", false, false);
            _ = Scans.ForgetRecordingAsync();
        }
    }

    private async Task OpenFileAsync(InputFileChangeEventArgs args)
    {
        _fileName = args.File.Name;
        _piece = null;
        _scan = null;
        _transcriptionEngine = null;
        _timing = null;
        _rejection = PieceImporter.CheckSize(args.File.Size);
        _start = 0;
        _elapsed = TimeSpan.Zero;
        if (_rejection is not null)
        {
            await TrackImportAsync();
            return;
        }

        _reading = true;
        try
        {
            var watch = Stopwatch.StartNew();
            await using Stream stream = args.File.OpenReadStream(PieceImporter.MaxFileBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _data = memory.ToArray();
            PieceImportResult result = PieceImporter.Import(args.File.Name, _data);
            _elapsed = watch.Elapsed;
            (_piece, _rejection) = (result.Piece, result.Rejection);
            _timing = _piece is { Format: SourceFormat.Midi } midi ? PerformanceTiming.Measure(midi.Notes, midi.Meter) : null;
        }
        finally
        {
            _reading = false;
        }

        await TrackImportAsync();
    }

    /// <summary>Sends a PDF or photo to the scan server and imports the MusicXML it reads, with the notes marked as detected (0011).</summary>
    private async Task ScanFileAsync(InputFileChangeEventArgs args)
    {
        _piece = null;
        _scan = null;
        _transcriptionEngine = null;
        _timing = null;
        _rejection = null;
        _start = 0;
        _leftOut = [];
        if (args.FileCount > 1)
        {
            await ScanPhotosAsync(args);
            return;
        }

        _fileName = args.File.Name;
        if (args.File.Size == 0 || args.File.Size > ScanService.MaxUploadBytes)
        {
            _rejection = new(
                args.File.Size == 0 ? ImportRejectionReason.Empty : ImportRejectionReason.TooLarge,
                Text[args.File.Size == 0 ? "transcribe.empty" : "import.scanTooLarge"],
                Text["import.scanTooLargeTip"]);
            return;
        }

        _scanning = true;
        try
        {
            var watch = Stopwatch.StartNew();
            await using Stream stream = args.File.OpenReadStream(ScanService.MaxUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            byte[] data = memory.ToArray();
            // A PDF longer than the server reads at once goes in parts, up to 100 pages (v0.5, issue #479); a photo as it is.
            ScanResult result = data.AsSpan().StartsWith("%PDF"u8)
                ? await ScoreScan.ReadAsync(args.File.Name, data, progress =>
                {
                    _scanProgress = progress;
                    StateHasChanged();
                })
                : await Scans.RecogniseAsync(args.File.Name, data);
            _elapsed = watch.Elapsed;
            ShowScan(result, args.File.Name);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _rejection = new(ImportRejectionReason.NotMusic, Text["pdf.unreadable"], Text["import.scanNotReadTip"]);
        }
        finally
        {
            (_scanning, _scanProgress) = (false, null);
        }
    }

    /// <summary>
    /// Photos of pages (v0.5): several photos of one piece's pages, read one request at a time in the order of their names
    /// and joined into one piece by music-core; a page not read is left out and said so. The photos are not kept.
    /// </summary>
    private async Task ScanPhotosAsync(InputFileChangeEventArgs args)
    {
        if (args.FileCount > PhotoPages.MaxPhotos)
        {
            _rejection = new(ImportRejectionReason.TooLarge, Text.Format("import.scanTooManyPhotos", args.FileCount, PhotoPages.MaxPhotos), Text["import.scanPhotosTip"]);
            return;
        }

        IReadOnlyList<IBrowserFile> photos = PhotoPages.InOrder(args.GetMultipleFiles(PhotoPages.MaxPhotos));
        _fileName = photos[0].Name;
        if (photos.FirstOrDefault(photo => !PhotoPages.IsPhoto(photo.Name)) is { } other)
        {
            _fileName = other.Name;
            _rejection = new(ImportRejectionReason.Unsupported, Text["import.scanPhotosOnly"], Text["import.scanPhotosTip"]);
            return;
        }

        _scanning = true;
        try
        {
            var watch = Stopwatch.StartNew();
            PhotoPagesRead read = await PhotoPages.ReadAsync(Scans, photos, Text, page =>
            {
                _photoPage = (page, photos.Count);
                StateHasChanged();
            });
            _elapsed = watch.Elapsed;
            _leftOut = read.LeftOut;
            ShowScan(read.Result, photos[0].Name);
        }
        finally
        {
            (_scanning, _photoPage) = (false, (0, 0));
        }
    }

    /// <summary>The notes the scan server read, as a piece with its bars to check; or why there are none.</summary>
    private void ShowScan(ScanResult result, string fileName)
    {
        if (result.MusicXml is not { } musicXml)
        {
            _rejection = new(ImportRejectionReason.NotMusic, result.Problem!, Text["import.scanNotReadTip"]);
            return;
        }

        string name = Path.ChangeExtension(fileName, ".musicxml");
        PieceImportResult imported = PieceImporter.Import(name, musicXml);
        if (imported.Piece is not { } piece)
        {
            _rejection = imported.Rejection;
            return;
        }

        _scanReports = ReportsFor(result, musicXml);
        _scan = ScanCheck.Of(piece, _scanReports.Count > 0 ? _scanReports : null);
        (_piece, _data, _fileName, _scanEngine, _scanPages) = (_scan.Mark(piece, []), musicXml, name, result.Engine, result.Pages);
    }

    /// <summary>
    /// The server's report on each page as the pages of the notes (version 0.4); none when it sent none, or not one per page
    /// of the notes, so the notes are kept without them.
    /// </summary>
    private static IReadOnlyList<PageReport> ReportsFor(ScanResult result, byte[] musicXml)
    {
        if (result.Reports.Count == 0)
        {
            return [];
        }

        try
        {
            return PageReport.ForScore(result.Reports, musicXml);
        }
        catch (ArgumentException)
        {
            return [];
        }
    }

    /// <summary>
    /// Decodes a picked recording on this device and shows its length and shape, for the player to choose the
    /// stretch to hear; nothing is sent yet. A browser that cannot decode the file sends the file itself,
    /// when it is small enough to pass through the app, and the server hears its first minutes.
    /// </summary>
    private async Task PickRecordingAsync(InputFileChangeEventArgs args)
    {
        _fileName = args.File.Name;
        ClearTranscription();
        await ForgetRecordingAsync();
        if (args.File.Size == 0)
        {
            _rejection = new(ImportRejectionReason.Empty, Text["transcribe.empty"], Text["transcribe.tooLargeTip"]);
            return;
        }

        _decoding = true;
        LoadedRecording? loaded;
        try
        {
            loaded = _recordingInput?.Element is { } input ? await Scans.LoadRecordingAsync(input) : null;
        }
        finally
        {
            _decoding = false;
        }

        if (loaded is { TooLong: true })
        {
            _rejection = new(
                ImportRejectionReason.TooLarge,
                Text.Format("transcribe.tooLongToDecode", Clock(loaded.Milliseconds), loaded.MostMinutes),
                Text["transcribe.tooLongToDecodeTip"]);
            return;
        }

        if (loaded is { Milliseconds: > 0 })
        {
            (_loaded, _range, _recordingName) = (loaded, RecordingRange.Start(loaded.Milliseconds), args.File.Name);
            _wave = WavePath(loaded.Peaks);
            return;
        }

        if (args.File.Size > ScanService.MaxRecordingUploadBytes)
        {
            _rejection = new(ImportRejectionReason.TooLarge, Text["transcribe.tooLarge"], Text["transcribe.tooLargeTip"]);
            return;
        }

        _transcribing = true;
        try
        {
            var watch = Stopwatch.StartNew();
            await using Stream stream = args.File.OpenReadStream(ScanService.MaxRecordingUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            // The server is not told the file's name: it reads the format from the content.
            TranscriptionResult result = await Scans.TranscribeAsync("recording", memory.ToArray());
            if (result.Midi is null)
            {
                _rejection = new(ImportRejectionReason.NotMusic, result.Problem!, Text["transcribe.notHeardTip"]);
                return;
            }

            Show(args.File.Name, result.Midi, result, watch.Elapsed, result.Seconds, result.Cut, null, 1);
        }
        finally
        {
            _transcribing = false;
        }
    }

    /// <summary>
    /// Sends the sound of the chosen stretch to the scan server to be heard, in parts when it is longer than
    /// the server hears at once, and imports the MIDI that comes back with every note marked as detected (0014).
    /// </summary>
    private async Task TranscribeRangeAsync()
    {
        if (_range is not { } range)
        {
            return;
        }

        ClearTranscription();
        _fileName = _recordingName;
        _transcribing = true;
        try
        {
            var watch = Stopwatch.StartNew();
            if (_loaded is not { } loaded)
            {
                return;
            }

            // A stretch longer than the server hears at once goes in overlapping parts, several at once, and the notes
            // are joined; the notes' times start at the stretch's start. Parts heard before are not sent again.
            HeardSound heard = await Scans.HearRangeAsync(loaded, range, progress =>
            {
                _hearing = progress;
                StateHasChanged();
            });
            if (heard.Midi is not { } midi)
            {
                _rejection = new(ImportRejectionReason.NotMusic, heard.Problem!, heard.Result.NothingHeard ? Text["transcribe.notHeardTip"] : "");
                return;
            }

            Show(_recordingName, midi, heard.Result, watch.Elapsed, range.Milliseconds / 1000.0, false, range, heard.Parts.Count, RecordingParts.Seams(heard.Parts));
        }
        finally
        {
            (_transcribing, _hearing) = (false, null);
        }
    }

    /// <summary>What the drop zone says while a stretch is heard: parts heard of how many, and whether the server is asked again.</summary>
    private string HearingText(HearingProgress? hearing) => hearing switch
    {
        { Total: > 1, Retrying: true } => Text.Format("transcribe.retrying", hearing.Done, hearing.Total),
        { Total: > 1 } => Text.Format("transcribe.progress", hearing.Done, hearing.Total),
        _ => Text["transcribe.busy"],
    };

    /// <summary>Imports what the server heard, marked as heard, in the bars worked out from it (0016).</summary>
    private void Show(string recordingName, byte[] midi, TranscriptionResult result, TimeSpan elapsed, double seconds, bool cut, RecordingRange? range, int requests, IReadOnlyList<long>? seams = null)
    {
        _seams = seams ?? [];
        _elapsed = elapsed;
        string name = Path.ChangeExtension(recordingName, ".mid");
        PieceImportResult imported = PieceImporter.Import(name, midi);
        if (imported.Piece is not { } piece)
        {
            _rejection = imported.Rejection;
            return;
        }

        (_heard, _data, _fileName, _transcriptionEngine) = (Transcribed.Mark(piece), midi, name, result.Engine);
        (_heardSeconds, _cut, _heardRange, _requests) = (seconds, cut, range, requests);
        _bars = BarGrid.Find(piece.Midi!, search: SettingsStore.IsOn(MotiffLab.Web.Insights.TempoCard.Setting) ? GridSearch.Live : null);
        ShowBars();
    }

    private void ClearTranscription()
    {
        (_heard, _bars) = (null, null);
        _piece = null;
        _scan = null;
        _transcriptionEngine = null;
        _timing = null;
        _rejection = null;
        _start = 0;
        (_heardRange, _requests) = (null, 0);
    }

    private async Task ForgetRecordingAsync()
    {
        (_loaded, _range, _wave, _editorAttached, _playing) = (null, null, "", false, false);
        await Scans.ForgetRecordingAsync();
    }

    /// <summary>
    /// The player dragged an edge of the selection ("start" or "end"), the whole selection ("move", to where it
    /// now starts), or pressed an arrow key on an edge. The rules of <see cref="RecordingRange"/> decide where it lands.
    /// </summary>
    [JSInvokable]
    public void DragRange(string edge, long milliseconds)
    {
        if (_range is not { } range || _transcribing)
        {
            return;
        }

        _range = edge switch
        {
            "start" => range.WithStart(milliseconds),
            "end" => range.WithEnd(milliseconds),
            _ => range.MovedTo(milliseconds),
        };
        StateHasChanged();
    }

    /// <summary>The recording started or stopped playing, by a button, the space bar or the end of the selection.</summary>
    [JSInvokable]
    public void PlayingChanged(bool playing)
    {
        _playing = playing;
        StateHasChanged();
    }

    /// <summary>Moves one end of the stretch to where the player is in the recording, to the nearest tenth of a second.</summary>
    private async Task RangeHereAsync(bool start)
    {
        if (_range is { } range)
        {
            long at = (long)Math.Round(await Scans.PositionOfAsync(_player) / 100.0) * 100;
            _range = start ? range.WithStart(at) : range.WithEnd(at);
        }
    }

    /// <summary>Plays the selection from its start, pausing at its end.</summary>
    private async Task ListenAsync()
    {
        if (_range is { } range)
        {
            await Scans.PlayBetweenAsync(_player, range.FromMilliseconds, range.ToMilliseconds);
        }
    }

    /// <summary>Plays the selection's last seconds, to check where it ends.</summary>
    private async Task ListenToEndAsync()
    {
        if (_range is { } range)
        {
            await Scans.PlayBetweenAsync(_player, Math.Max(range.FromMilliseconds, range.ToMilliseconds - EndCheckMilliseconds), range.ToMilliseconds);
        }
    }

    private async Task TogglePlayAsync() => await Scans.TogglePlayAsync(_player);

    private async Task SeekByAsync(long milliseconds) => await Scans.SeekByAsync(_player, milliseconds);

    /// <summary>
    /// What hearing the stretch takes, before it is sent: its length, its parts, one request each, and roughly how
    /// long the server listens, from the sound the requests carry.
    /// </summary>
    private string Estimate(RecordingRange range)
    {
        int parts = range.Parts.Count;
        double seconds = Scans.EstimateSeconds(range.Parts);
        string time = seconds < 90
            ? Text.Format("transcribe.aboutSeconds", (Math.Ceiling(seconds / 10) * 10).ToString("0", Text.Culture))
            : Text.Format("transcribe.aboutMinutes", Math.Ceiling(seconds / 60).ToString("0", Text.Culture));
        string estimate = parts == 1 ? "transcribe.estimateOne" : Scans.MostAtOnce > 1 ? "transcribe.estimate" : "transcribe.estimateSerial";
        return Text.Format(
            estimate,
            Clock(range.FromMilliseconds),
            Clock(range.ToMilliseconds),
            Clock(range.Milliseconds),
            Text.Count("transcribe.parts", parts),
            Text.Count("transcribe.requests", parts),
            time,
            Math.Min(parts, Scans.MostAtOnce));
    }

    /// <summary>A time in the recording as m:ss, or h:mm:ss from an hour, with tenths of a second when asked.</summary>
    private static string Clock(long milliseconds, bool tenths = false)
    {
        var time = TimeSpan.FromMilliseconds(Math.Max(0, milliseconds));
        string whole = time.TotalHours >= 1
            ? $"{(int)time.TotalHours}:{time.Minutes:00}:{time.Seconds:00}"
            : $"{(int)time.TotalMinutes}:{time.Seconds:00}";
        return tenths ? $"{whole}.{time.Milliseconds / 100}" : whole;
    }

    /// <summary>A time in the recording as a share of its length, for placing the selection over its shape.</summary>
    private string Percent(long milliseconds) =>
        _loaded is { } loaded ? (milliseconds * 100.0 / loaded.Milliseconds).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%" : "0";

    /// <summary>One vertical line a bar, centred on the middle, as tall as the loudest sample in its stretch.</summary>
    private static string WavePath(double[] peaks)
    {
        var path = new System.Text.StringBuilder();
        var invariant = System.Globalization.CultureInfo.InvariantCulture;
        for (int i = 0; i < peaks.Length; i++)
        {
            double half = Math.Max(0.5, Math.Clamp(peaks[i], 0, 1) * 48);
            path.Append(invariant, $"M{i + 0.5:0.#} {50 - half:0.##}V{50 + half:0.##}");
        }

        return path.ToString();
    }

    /// <summary>The transcription in the bars worked out from it, or as the engine wrote it when none fit.</summary>
    private void ShowBars() => _piece = _bars is { } bars ? bars.Apply(_heard!) : _heard;

    /// <summary>The importer's tip; for a PDF, photo or recording picked as a file, the screen that reads it is linked instead.</summary>
    private string? TipFor(ImportRejection rejection) => OtherRouteFor(rejection) is null ? rejection.TipIn(MotiffLab.MusicCore.Words.For(Text.Language)) : null;

    /// <summary>The screen for what was picked, when this one cannot read it: scanning for a PDF or photo, transcription for a recording.</summary>
    private (string Href, string Label)? OtherRouteFor(ImportRejection rejection) => rejection.Reason switch
    {
        ImportRejectionReason.Pdf or ImportRejectionReason.Image when _route != ImportRoute.Scan => ("import/scan", "import.goScan"),
        ImportRejectionReason.Audio when _route != ImportRoute.Recording => ("import/recording", "import.goRecording"),
        _ => null,
    };

    private Task TrackImportAsync() => Analytics.TrackAsync(AnalyticsEvent.PieceImported(
        AnalyticsEvent.FormatOf(_fileName ?? ""), _piece is not null, _piece?.Report.NoteCount ?? 0, _piece?.Tracks.Count ?? 0,
        _timing?.Kind == TimingKind.Performance, (long)_elapsed.TotalMilliseconds));

    /// <summary>Saves the piece as a new project on the device (S1-P1) and opens it in the workspace.</summary>
    private async Task OpenAsync()
    {
        if (_piece is not { } piece)
        {
            return;
        }

        var project = Project.Create($"p_{Guid.NewGuid():N}", piece.FileName, _data, DateTimeOffset.Now) with
        {
            Scan = _scan is null ? null : ScanOrigin.Read(_scanEngine) with { Pages = _scanReports },
            // Where the stretch heard starts in the recording file (version 0.5), so a piece's sound is found in it on any device; the file sent whole starts at 0.
            Transcription = _transcriptionEngine is null ? null : new TranscriptionOrigin(_transcriptionEngine, _bars) { Seams = _seams, SentFromMilliseconds = _heardRange?.FromMilliseconds ?? 0 },
        };
        // The piece opens at a resume point (0018), so it comes back to where it was left; a scan's Check flags start open.
        if (_scan is { } check)
        {
            project = project with { Check = CheckFlag.FromScan(check, []) };
        }
        else if (project.Transcription is { } heard)
        {
            // A transcription's doubts (0018, preparation item 12): where parts were joined, the tempo fits poorly, notes crowd or the hands were guessed.
            project = project with { Check = CheckFlag.FromTranscription(heard, _data, piece) };
        }

        ResumePoint point = ResumePoint.Start(project.NextResumePointId(), DateTimeOffset.Now);
        project = project.AddResumePoint(point);
        await Projects.SaveAsync(project);
        CurrentPiece.Open(piece, piece.StartChoices[Math.Clamp(_start, 0, piece.StartChoices.Count - 1)].Filter, project);
        string url = CurrentPiece.WorkspaceUrl(project, point.Id);
        bool several = _severalPieces && _transcriptionEngine is not null && SettingsStore.IsOn(MotiffLab.Web.Workspace.PartPlace.Setting);
        if (several)
        {
            await KeepConcertAsync(project.Id);
        }

        Navigation.NavigateTo(several ? $"{url}&pieces={Math.Clamp(_piecesCount, 1, 99)}" : url);
    }

    /// <summary>
    /// A recording of several pieces (version 0.5): the stretch heard is kept on this device, before the page lets the
    /// recording go, so each piece split from it can have its own sound. Never in the project file; a browser that could
    /// not decode the recording keeps nothing.
    /// </summary>
    private async Task KeepConcertAsync(string projectId)
    {
        if (_heardRange is not { } range)
        {
            return;
        }

        try
        {
            await using Microsoft.JSInterop.IJSObjectReference store = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./js/storage/recording-store.js");
            await store.InvokeAsync<bool>("keepHeldStretch", $"{projectId}/{MotiffLab.Web.Workspace.PartPlace.ConcertSound}", range.FromMilliseconds, range.ToMilliseconds);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // The pieces are made all the same; their sound is then picked again from the file.
        }
    }

    private static string FormatName(SourceFormat format) => format == SourceFormat.Midi ? "MIDI" : "MusicXML";

    private string HandsLabel(TrackHands hands) => hands switch
    {
        TrackHands.Imported => Text["import.handsScore"],
        TrackHands.Inferred => Text["import.handsInferred"],
        _ => "–",
    };

    private string KindLabel(ImportIssueKind kind) => Text[kind switch
    {
        ImportIssueKind.Assumed => "import.assumed",
        ImportIssueKind.Repaired => "import.repaired",
        ImportIssueKind.Dropped => "import.leftOut",
        _ => "import.rounded",
    }];
