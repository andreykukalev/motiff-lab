@page "/import"
@using System.Diagnostics
@using MotiffLab.MusicCore.Analytics
@using MotiffLab.MusicCore.Import
@using MotiffLab.MusicCore.Import.Scan
@using MotiffLab.MusicCore.Projects
@using MotiffLab.Web.Import
@using MotiffLab.Web.Projects
@inject CurrentPiece CurrentPiece
@inject ProjectStore Projects
@inject NavigationManager Navigation
@inject MotiffLab.Web.Analytics.UsageAnalytics Analytics
@inject ScanService Scans

<PageTitle>Import · Motiff Lab</PageTitle>

@* N2 · Import (S1-I1, S1-I8): drop or pick a file, read the import report, pick where to start. Parsing runs in the browser; the file never leaves the device.
   Scanning (0011) is the one exception: a PDF or photo the player picks for it goes to the scan server they set in Settings, and comes back as MusicXML. *@
<main class="lab import">
    <h1>Import a piece</h1>
    <p class="meta">Motiff Lab reads MIDI (.mid) and MusicXML (.musicxml, .mxl) files up to 5 MB. The file is read in this browser and never leaves this device.</p>

    <label class="dropzone @(_reading ? "busy" : null)">
        <InputFile OnChange="OpenFileAsync" accept="@PieceImporter.AcceptedExtensions" disabled="@_reading" aria-label="Choose a MIDI or MusicXML file" />
        <span>@(_reading ? "Reading…" : "Drop a file here, or click to choose one")</span>
    </label>

    @if (_rejection is { } rejection)
    {
        <section class="rejection" role="alert">
            <p class="error"><strong>@_fileName</strong>: @rejection.Message</p>
            <p>@TipFor(rejection)</p>
        </section>
    }

    <section class="scan" aria-labelledby="scan-heading">
        <h2 id="scan-heading">Scan printed music</h2>
        @if (Scans.Address is not { } server)
        {
            <p class="meta">Motiff Lab can read a PDF or a photo of printed music with a scan server you run on your computer. <a href="settings#scan-heading">Set it up in Settings</a>.</p>
        }
        else
        {
            <p class="meta">
                A PDF of up to 8 pages, or a photo of one page, is sent to the scan server at @server@(Scans.IsLocal ? " on this computer" : "") to be read,
                and deleted there as soon as it has been. A page takes 20 to 60 seconds. The notes come back marked as detected, for you to check.
            </p>
            @if (!Scans.IsLocal)
            {
                <label>
                    <input type="checkbox" @bind="_sendElsewhere" />
                    Send the page to @server.Host, which is another computer
                </label>
            }

            <label class="dropzone @(_scanning ? "busy" : null)">
                <InputFile OnChange="ScanFileAsync" accept="@ScanService.AcceptedExtensions" disabled="@(_reading || _scanning || !(Scans.IsLocal || _sendElsewhere))" aria-label="Choose a PDF or photo of printed music to scan" />
                <span>@(_scanning ? "Reading the notes… this takes a while for each page" : "Drop a PDF or photo here, or click to choose one")</span>
            </label>
        }
    </section>

    @if (_piece is { } piece)
    {
        ImportReport report = piece.Report;
        <section class="report" aria-label="Import report">
            <h2>@piece.FileName</h2>
            <p class="summary">
                @(_scan is null ? FormatName(piece.Format) : $"Scanned by {_scanEngine}") · @Plural(piece.Tracks.Count, "track") with notes · @Plural(report.NoteCount, "note") · @Plural(report.MeasureCount, "bar")
            </p>
            @if (_scan is { } scan)
            {
                <p class="meta">@Plural(_scanPages, "page") read in @_elapsed.TotalSeconds.ToString("0") s by the scan server.</p>
                @* Check the scan (0011): the bars the rules flag come first; the player checks them in the workspace. *@
                <section class="scan-check" aria-label="Check the scan">
                    <h3>Check the scan</h3>
                    @if (scan.Flagged.ToList() is { Count: > 0 } flagged)
                    {
                        <p>
                            @Plural(flagged.Count, "bar") of @scan.Bars.Count may have been misread. Every note is marked as detected until you
                            check it; after opening, the Scan tab in the workspace takes you to each of these bars.
                        </p>
                        <ul class="warnings">
                            @foreach (ScanBar bar in flagged)
                            {
                                <li><span class="kind">Bar @bar.Bar</span> @string.Join(" ", bar.Reasons)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No bar looks wrong to the checks. The notes are still a reading of the page, marked as detected until you check them.</p>
                    }
                </section>
            }
            else
            {
                <p class="meta">Read in @_elapsed.TotalSeconds.ToString("0.00") s on this device.</p>
            }

            <table class="tracks-table">
                <thead>
                    <tr><th scope="col">Track</th><th scope="col">Instrument</th><th scope="col">Notes</th><th scope="col">Hands</th></tr>
                </thead>
                <tbody>
                    @foreach (ImportedTrack track in piece.Tracks)
                    {
                        <tr>
                            <td>@track.Label</td>
                            <td>@(track.InstrumentName ?? "–")</td>
                            <td>@track.NoteCount</td>
                            <td>@(_scan is not null && track.Hands != TrackHands.None ? "From the scan's staves" : HandsLabel(track.Hands))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3>Timing</h3>
            @if (report.OfKind(ImportIssueKind.Rounded).ToList() is { Count: > 0 } rounded)
            {
                <ul>
                    @foreach (ImportIssue issue in rounded)
                    {
                        <li>@issue.Message</li>
                    }
                </ul>
                <p class="meta">Rounded timing moves a note by at most half a tick, 1/960 of a quarter note.</p>
            }
            else
            {
                <p class="meta">No timing had to be rounded.</p>
            }
            @if (_timing?.Describe() is { } played)
            {
                <p class="notice" role="status">@played</p>
                @if (_timing.Kind == TimingKind.Performance)
                {
                    <p class="meta">Restore rhythm is not in this version yet, so for now the file plays as it was recorded.</p>
                }
            }

            <h3>Warnings</h3>
            @if (report.Issues.Where(issue => issue.Kind != ImportIssueKind.Rounded).ToList() is { Count: > 0 } warnings)
            {
                <ul class="warnings">
                    @foreach (ImportIssue issue in warnings)
                    {
                        <li><span class="kind">@KindLabel(issue.Kind)</span> @issue.Message</li>
                    }
                </ul>
                <p class="meta">Assumed: the file did not say, so Motiff Lab chose a value. Repaired: the file was damaged and Motiff Lab kept what it could read. Left out: not used in this version.</p>
            }
            else
            {
                <p class="meta">None.</p>
            }
        </section>

        <section class="start" aria-label="Where to start">
            <h3>Start with</h3>
            <div class="row" role="radiogroup">
                @for (int i = 0; i < piece.StartChoices.Count; i++)
                {
                    int index = i;
                    StartChoice choice = piece.StartChoices[i];
                    <label title="@(choice.IsInferred ? "Hands were worked out from pitch and movement, not read from the file." : null)">
                        <input type="radio" name="start" checked="@(index == _start)" @onchange="() => _start = index" /> @choice.Label
                    </label>
                }
            </div>
            <button class="primary" @onclick="OpenAsync">Open the piece</button>
            <p class="meta">Opening saves the piece as a project in this browser, so you can come back to it.</p>
        </section>
    }

    <p><a href="">Back to projects</a></p>
</main>

@code {
    private string? _fileName;
    private ImportedPiece? _piece;

    /// <summary>How the MIDI file's onsets sit against the grid (S1-I6, S1-R1, S1-R2); null for MusicXML, which is written.</summary>
    private PerformanceTiming? _timing;
    private byte[] _data = [];
    private ImportRejection? _rejection;
    private TimeSpan _elapsed;
    private int _start;
    private bool _reading;

    /// <summary>The checks of a piece read by the scan server (0011); null for a file imported on the device.</summary>
    private ScanCheck? _scan;
    private string _scanEngine = "";
    private int _scanPages;
    private bool _scanning;
    private bool _sendElsewhere;

    protected override Task OnInitializedAsync() => Scans.LoadAsync();

    private async Task OpenFileAsync(InputFileChangeEventArgs args)
    {
        _fileName = args.File.Name;
        _piece = null;
        _scan = null;
        _timing = null;
        _rejection = PieceImporter.CheckSize(args.File.Size);
        _start = 0;
        _elapsed = TimeSpan.Zero;
        if (_rejection is not null)
        {
            await TrackImportAsync();
            return;
        }

        _reading = true;
        try
        {
            var watch = Stopwatch.StartNew();
            await using Stream stream = args.File.OpenReadStream(PieceImporter.MaxFileBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _data = memory.ToArray();
            PieceImportResult result = PieceImporter.Import(args.File.Name, _data);
            _elapsed = watch.Elapsed;
            (_piece, _rejection) = (result.Piece, result.Rejection);
            _timing = _piece is { Format: SourceFormat.Midi } midi ? PerformanceTiming.Measure(midi.Notes, midi.Meter) : null;
        }
        finally
        {
            _reading = false;
        }

        await TrackImportAsync();
    }

    /// <summary>Sends a PDF or photo to the scan server and imports the MusicXML it reads, with the notes marked as detected (0011).</summary>
    private async Task ScanFileAsync(InputFileChangeEventArgs args)
    {
        _fileName = args.File.Name;
        _piece = null;
        _scan = null;
        _timing = null;
        _rejection = null;
        _start = 0;
        if (args.File.Size == 0 || args.File.Size > ScanService.MaxUploadBytes)
        {
            _rejection = new(
                args.File.Size == 0 ? ImportRejectionReason.Empty : ImportRejectionReason.TooLarge,
                args.File.Size == 0 ? "This file is empty." : "This file is larger than 20 MB, the most the scan server reads.",
                "Scan fewer pages at a time, or save the photo at a lower resolution.");
            return;
        }

        _scanning = true;
        try
        {
            var watch = Stopwatch.StartNew();
            await using Stream stream = args.File.OpenReadStream(ScanService.MaxUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            ScanResult result = await Scans.RecogniseAsync(args.File.Name, memory.ToArray());
            _elapsed = watch.Elapsed;
            if (result.MusicXml is not { } musicXml)
            {
                _rejection = new(ImportRejectionReason.NotMusic, result.Problem!, "Try a sharper photo that shows the whole page, straight on and in good light.");
                return;
            }

            string name = Path.ChangeExtension(args.File.Name, ".musicxml");
            PieceImportResult imported = PieceImporter.Import(name, musicXml);
            if (imported.Piece is not { } piece)
            {
                _rejection = imported.Rejection;
                return;
            }

            _scan = ScanCheck.Of(piece);
            (_piece, _data, _fileName, _scanEngine, _scanPages) = (_scan.Mark(piece, []), musicXml, name, result.Engine, result.Pages);
        }
        finally
        {
            _scanning = false;
        }
    }

    /// <summary>The importer's tip, or a pointer to scanning for a PDF or photo when it is set up.</summary>
    private string TipFor(ImportRejection rejection) =>
        rejection.Reason is ImportRejectionReason.Pdf or ImportRejectionReason.Image && Scans.Address is not null && _scan is null
            ? "To read the notes from it, drop it under Scan printed music below."
            : rejection.Tip;

    private Task TrackImportAsync() => Analytics.TrackAsync(AnalyticsEvent.PieceImported(
        AnalyticsEvent.FormatOf(_fileName ?? ""), _piece is not null, _piece?.Report.NoteCount ?? 0, _piece?.Tracks.Count ?? 0,
        _timing?.Kind == TimingKind.Performance, (long)_elapsed.TotalMilliseconds));

    /// <summary>Saves the piece as a new project on the device (S1-P1) and opens it in the workspace.</summary>
    private async Task OpenAsync()
    {
        if (_piece is not { } piece)
        {
            return;
        }

        var project = Project.Create($"p_{Guid.NewGuid():N}", piece.FileName, _data, DateTimeOffset.Now) with
        {
            Scan = _scan is null ? null : ScanOrigin.Read(_scanEngine),
        };
        // The piece opens in a session (0012), so the work has a context to come back to from the project page.
        Session session = Session.Start(project.NextSessionId(), SessionIntent.Open, null, DateTimeOffset.Now);
        project = project.StartSession(session);
        await Projects.SaveAsync(project);
        CurrentPiece.Open(piece, piece.StartChoices[Math.Clamp(_start, 0, piece.StartChoices.Count - 1)].Filter, project);
        Navigation.NavigateTo(CurrentPiece.WorkspaceUrl(project, session.Id));
    }

    private static string FormatName(SourceFormat format) => format == SourceFormat.Midi ? "MIDI" : "MusicXML";

    private static string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count:N0} {noun}s";

    private static string HandsLabel(TrackHands hands) => hands switch
    {
        TrackHands.Imported => "From the score",
        TrackHands.Inferred => "Inferred",
        _ => "–",
    };

    private static string KindLabel(ImportIssueKind kind) => kind switch
    {
        ImportIssueKind.Assumed => "Assumed",
        ImportIssueKind.Repaired => "Repaired",
        ImportIssueKind.Dropped => "Left out",
        _ => "Rounded",
    };
}
