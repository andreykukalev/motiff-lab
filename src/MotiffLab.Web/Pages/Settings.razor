@page "/settings"
@using MotiffLab.MusicCore.Analytics
@using MotiffLab.Web.Analytics
@implements IDisposable
@inject UsageAnalytics Analytics
@inject MotiffLab.Web.Import.ScanService Scans
@inject MotiffLab.Web.Localization.UiText Text
@inject MotiffLab.Web.Account.CloudAccount Account
@inject MotiffLab.Web.Account.OnlineProjects Online
@inject MotiffLab.Web.Projects.ProjectStore Projects

<PageTitle>@Text["settings.title"] · Motiff Lab</PageTitle>

@* Settings (S1-AI0, #64, #65), grouped in cards as in most apps: the account (0014), scanning and transcription (0011),
   language, anonymous analytics with consent, and the privacy notice and terms of use. AI assistance joins this page when it arrives. *@
<main class="lab settings">
    <nav class="crumbs" aria-label="@Text["nav.label"]"><a href="">‹ @Text["nav.projects"]</a></nav>
    <h1>@Text["settings.title"]</h1>

    @if (Account.IsAvailable)
    {
        @* The account first, as in most apps (0014): sign in or create an account; once signed in, who it is, saving
           online (a choice that stays off until the player turns it on; the device stays the working copy) and erasure. *@
        <section id="account" class="card account" aria-labelledby="account-heading">
            @if (_player is null)
            {
                <h2 id="account-heading">@Text["settings.accountTitle"]</h2>
                <p>@Text["settings.accountWhy"]</p>
                <div class="row">
                    <button class="primary" @onclick="() => Account.SignIn()">@Text["settings.signIn"]</button>
                    <button @onclick="() => Account.SignIn(create: true)">@Text["settings.createAccount"]</button>
                </div>
                <p class="meta">@Text["settings.signInHow"] <a href="privacy#online">@Text["settings.onlineWhatIsKept"]</a></p>
            }
            else
            {
                <h2 id="account-heading" class="visually-hidden">@Text["account.title"]</h2>
                <div class="account-head">
                    <span class="avatar" aria-hidden="true">@MotiffLab.Web.Account.AccountButton.Initial(_player)</span>
                    <p class="who"><strong>@_player</strong><span class="meta">@Text["settings.signedIn"]</span></p>
                    <button @onclick="Account.SignOut">@Text["settings.signOut"]</button>
                </div>
                <div class="switch-row">
                    <label for="save-online">@Text["settings.saveOnline"]</label>
                    <input id="save-online" type="checkbox" class="switch" checked="@_online" @onchange="ToggleOnlineAsync" aria-describedby="online-status" />
                </div>
                <p id="online-status" class="meta" role="status">@(Online.Status ?? (_online ? Text["settings.onlineOn"] : Text["settings.onlineOff"]))</p>
                <p class="meta"><a href="privacy#online">@Text["settings.onlineWhatIsKept"]</a></p>
                <div class="row danger">
                    @if (_confirmDeleteOnline)
                    {
                        <button class="destructive" @onclick="DeleteOnlineAsync">@Text["settings.deleteOnlineForGood"]</button>
                        <button @onclick="() => _confirmDeleteOnline = false">@Text["home.keep"]</button>
                    }
                    else
                    {
                        <button class="link destructive" @onclick="() => _confirmDeleteOnline = true">@Text["settings.deleteOnline"]</button>
                    }
                </div>
                @if (_onlineMessage is not null)
                {
                    <p class="meta" role="status">@_onlineMessage</p>
                }
            }
        </section>
    }

    @* Scanning and transcription (0011, 0014): Motiff Lab's server where the build has one, the player's own server, or off.
       Running one's own server is folded away, since most players never need it. *@
    <section id="scan" class="card" aria-labelledby="scan-heading">
        <h2 id="scan-heading">@Text["settings.scanTitle"]</h2>
        <p class="meta">@Text["settings.scanWhat"]</p>
        @if (Scans.HostedAddress is { } hosted)
        {
            <div class="choices" role="radiogroup" aria-labelledby="scan-heading">
                <label class="choice @(Choice == ScanChoice.Hosted ? "on" : null)">
                    <input type="radio" name="scan-server" checked="@(Choice == ScanChoice.Hosted)" @onchange="() => UseHostedAsync(hosted)" />
                    <span>
                        <strong>@Text["settings.scanHosted"]</strong> <span class="badge">@Text["settings.scanRecommended"]</span>
                        <span class="meta">@Text["settings.scanHostedWhat"]</span>
                    </span>
                </label>
                <label class="choice @(Choice == ScanChoice.Own ? "on" : null)">
                    <input type="radio" name="scan-server" checked="@(Choice == ScanChoice.Own)" @onchange="ChooseOwn" />
                    <span>
                        <strong>@Text["settings.scanOwn"]</strong>
                        <span class="meta">@Text["settings.scanOwnWhat"]</span>
                    </span>
                </label>
                <label class="choice @(Choice == ScanChoice.Off ? "on" : null)">
                    <input type="radio" name="scan-server" checked="@(Choice == ScanChoice.Off)" @onchange="TurnScanningOffAsync" />
                    <span><strong>@Text["settings.scanOff"]</strong></span>
                </label>
            </div>
            @if (Choice == ScanChoice.Hosted && _player is null)
            {
                <div class="notice row">
                    <span>@Text["settings.scanSignIn"]</span>
                    <button class="primary" @onclick="() => Account.SignIn()">@Text["settings.signIn"]</button>
                </div>
            }
        }

        @if (Scans.HostedAddress is null || Choice == ScanChoice.Own)
        {
            <div class="own-server">
                <div class="row">
                    <label>
                        @Text["settings.scanAddress"]
                        <input type="url" @bind="_address" placeholder="@MotiffLab.Web.Import.ScanService.SuggestedAddress" aria-describedby="scan-status" />
                    </label>
                    <button @onclick="SaveAddressAsync">@Text["settings.scanSave"]</button>
                    @if (Scans.HostedAddress is null && Scans.Address is not null)
                    {
                        <button @onclick="TurnScanningOffAsync">@Text["settings.scanTurnOff"]</button>
                    }
                </div>
                <button class="disclosure" aria-expanded="@(_showHowToRun ? "true" : "false")" aria-controls="how-to-run" @onclick="() => _showHowToRun = !_showHowToRun">@Text["settings.scanHowToRun"]</button>
                @if (_showHowToRun)
                {
                    <div id="how-to-run">
                        <pre class="command"><code>docker build -t motiff-omr services/omr
docker run --rm -p 8765:8000 motiff-omr</code></pre>
                        <p class="meta">@Text["settings.scanDocker"] <a href="https://github.com/andreykukalev/motiff-lab/tree/main/services/omr">@Text["settings.scanMore"]</a>.</p>
                    </div>
                }
            </div>
        }
        <p id="scan-status" class="meta" role="status">@(_scanStatus ?? ScanStatus())</p>
        @if (Scans.Address is not null && !Scans.IsLocal && !Scans.IsHosted)
        {
            <p class="notice">@Text["settings.scanElsewhere"]</p>
        }
    </section>

    <section class="card" aria-labelledby="language-heading">
        <h2 id="language-heading">@Text["settings.language"]</h2>
        <p class="meta">@Text["settings.languageHint"]</p>
        <div class="segmented" role="group" aria-label="@Text["settings.language"]">
            @foreach ((string tag, string name) in MotiffLab.Web.Localization.UiText.Languages)
            {
                bool on = Text.Language == tag;
                <button class="@(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" lang="@tag" @onclick="() => Text.SetLanguageAsync(tag)">@name</button>
            }
        </div>
    </section>

    <section class="card" aria-labelledby="analytics-heading">
        <h2 id="analytics-heading">Anonymous usage analytics</h2>
        <p>
            Help us learn how Motiff Lab is used by sending a few anonymous events: that the app was opened, a file was
            imported, a motif selected, playback started, a variation tried or exported. They never contain your music,
            file names or titles. Analytics are off until you turn them on, and you can turn them off at any time.
        </p>
        <label>
            <input type="checkbox" checked="@Analytics.On" @onchange="ToggleAsync" />
            Send anonymous usage analytics
        </label>
        <p class="meta">
            @if (Analytics.On)
            {
                @: This browser's random ID is @Analytics.DeviceId. Turning analytics off deletes it.
            }
            else
            {
                @: Nothing is recorded while analytics are off.
            }
        </p>
        <p class="meta">This version does not send analytics yet: events wait on this device, and the list below shows exactly what would be sent. <a href="privacy#analytics">What each event holds</a>.</p>

        @if (Analytics.On)
        {
            <h3>Waiting to be sent (@Analytics.Pending.Count)</h3>
            @if (Analytics.Pending.Count == 0)
            {
                <p class="meta">Nothing yet.</p>
            }
            else
            {
                <ol class="events" reversed>
                    @foreach (AnalyticsEvent recorded in Analytics.Pending.Reverse())
                    {
                        <li><code>@recorded.Name</code> @string.Join(", ", recorded.Properties.Select(p => $"{p.Key}: {Format(p.Value)}"))</li>
                    }
                </ol>
            }
        }
    </section>

    <section class="card" aria-labelledby="documents-heading">
        <h2 id="documents-heading">Privacy and terms</h2>
        <p><a href="privacy">Privacy notice</a> · <a href="terms">Terms of use</a></p>
    </section>
</main>

@code {
    private enum ScanChoice { Hosted, Own, Off }

    private string? _address;
    private string? _scanStatus;
    private string? _player;
    private bool _online;
    private bool _confirmDeleteOnline;
    private string? _onlineMessage;
    private bool _ownChosen;
    private bool _showHowToRun;

    /// <summary>The scanning choice on show: the hosted server, the player's own (also while its address is being typed), or off.</summary>
    private ScanChoice Choice => Scans.IsHosted ? ScanChoice.Hosted : Scans.Address is not null || _ownChosen ? ScanChoice.Own : ScanChoice.Off;

    protected override async Task OnInitializedAsync()
    {
        Analytics.Changed += OnChanged;
        Text.Changed += OnChanged;
        Online.Changed += OnChanged;
        _player = await Account.PlayerAsync();
        _online = _player is not null && await Online.IsOnAsync();
        await Analytics.LoadAsync();
        await Scans.LoadAsync();
        _address = Scans.Address is { } address && !Scans.IsHosted ? address.ToString() : MotiffLab.Web.Import.ScanService.SuggestedAddress;
    }

    private string ScanStatus() =>
        Scans.IsHosted ? (_player is null ? "" : Text["settings.scanStatusHosted"])
        : Scans.Address is { } address ? Text.Format("settings.scanStatusUses", address)
        : _ownChosen ? ""
        : Text["settings.scanStatusOff"];

    private async Task SaveAddressAsync()
    {
        if (MotiffLab.Web.Import.ScanService.Parse(_address) is not { } address)
        {
            _scanStatus = Text["settings.scanBadAddress"];
            return;
        }

        await Scans.SetAddressAsync(address);
        _scanStatus = Text["settings.scanChecking"];
        StateHasChanged();
        (string? engine, string? problem) = await Scans.CheckAsync();
        _scanStatus = engine is not null ? Text.Format("settings.scanConnected", engine) : Text.Format("settings.scanSavedBut", problem!);
    }

    private async Task UseHostedAsync(Uri hosted)
    {
        _ownChosen = false;
        await Scans.SetAddressAsync(hosted);
        _scanStatus = null;
        if (_player is not null)
        {
            _scanStatus = Text["settings.scanChecking"];
            StateHasChanged();
            (string? engine, string? problem) = await Scans.CheckAsync();
            _scanStatus = engine is not null ? Text.Format("settings.scanConnected", engine) : Text.Format("settings.scanSavedBut", problem!);
        }
    }

    /// <summary>Picking one's own server shows its address and how to run it; scanning changes once the address is saved.</summary>
    private async Task ChooseOwn()
    {
        _ownChosen = true;
        _showHowToRun = true;
        _scanStatus = null;
        if (Scans.IsHosted)
        {
            await Scans.SetAddressAsync(null);
        }
    }

    /// <summary>Turning saving online on sends the projects already on this device, so they are all online.</summary>
    private async Task ToggleOnlineAsync(ChangeEventArgs args)
    {
        _online = args.Value is true;
        _onlineMessage = null;
        await Online.SetOnAsync(_online);
        if (_online)
        {
            foreach (MotiffLab.MusicCore.Projects.ProjectSummary summary in await Projects.ListAsync())
            {
                try
                {
                    if (await Projects.LoadAsync(summary.Id) is { } project)
                    {
                        await Online.QueueAsync(project);
                    }
                }
                catch (MotiffLab.MusicCore.Projects.ProjectFileException)
                {
                    // A damaged project stays on this device; Home says so when it is opened.
                }
            }
        }
    }

    private async Task DeleteOnlineAsync()
    {
        _confirmDeleteOnline = false;
        _onlineMessage = await Online.DeleteEverythingAsync();
        _online = await Online.IsOnAsync();
    }

    private async Task TurnScanningOffAsync()
    {
        _ownChosen = false;
        await Scans.SetAddressAsync(null);
        _scanStatus = null;
    }

    public void Dispose()
    {
        Analytics.Changed -= OnChanged;
        Text.Changed -= OnChanged;
        Online.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task ToggleAsync(ChangeEventArgs args) => Analytics.SetOnAsync(args.Value is true);

    private static string Format(object value) => value switch
    {
        bool flag => flag ? "yes" : "no",
        _ => value.ToString() ?? "",
    };
}
