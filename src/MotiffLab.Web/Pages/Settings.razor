@page "/settings"
@inject MotiffLab.Web.Localization.UiText Text
@inject MotiffLab.Web.Account.CloudAccount Account
@implements IDisposable

<PageTitle>@Text[Title] · Motiff Lab</PageTitle>

@* The account page (0014): the account panel as a sheet over the library, for the links that lead to it (the scan and recording
   screens, the privacy notice, the return from signing in). In the library the same panel opens as a sheet behind the
   avatar, and in Settings it is the Account section. *@
<PageSheet Title="@Text[Title]" Class="settings">
    <MotiffLab.Web.Account.AccountPanel />
</PageSheet>

@code {
    private string Title => Account.IsAvailable ? "account.title" : "settings.title";

    protected override void OnInitialized() => Text.Changed += OnChanged;

    public void Dispose() => Text.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
