@using MotiffLab.Web.Explore
@using MotiffLab.Web.Localization
@inject UiText Text

@* Practise the phrase (#50, docs/08-central-product-model.md sections 3 and 6): play it, loop it, slow it down and hear
   one hand or one layer, with controls large enough to reach with the iPad on the music stand. No tasks and no scores.
   It only shows the workspace state (0013): the page plays, loops and moves between phrases. *@
<section class="practise" aria-label="@Text["practise.title"]">
    <p class="eyebrow">@Text["practise.title"]</p>
    @if (!HasSelection)
    {
        <p class="meta">@Text["practise.selectFirst"]</p>
    }
    else
    {
        <div class="group" role="group" aria-label="@Text["transport.play"]">
            <div class="play-row">
                <button class="@(Playing ? "on" : "primary")" @onclick="() => PlayPressed.InvokeAsync()">
                    @(Playing ? Text["transport.pause"] : Text["practise.playFromStart"])
                </button>
                <button class="@(Looping ? "on" : null)" aria-pressed="@(Looping ? "true" : "false")" @onclick="() => LoopPressed.InvokeAsync()"
                        title="@Text["practise.loopHint"]">
                    @Text["practise.loop"]
                </button>
            </div>
            <div class="row step">
                <button @onclick="() => Step.InvokeAsync(-1)" disabled="@(!CanGoBack)">‹ @Text["focus.previous"]</button>
                <button @onclick="() => Step.InvokeAsync(1)" disabled="@(!CanGoOn)">@Text["focus.next"] ›</button>
            </div>
            @* The wider context (#126): the piece around the phrase, then back to it. *@
            <div class="row step wider">
                @if (PlayingOn)
                {
                    <button class="primary" @onclick="() => Back.InvokeAsync()" title="@Text["practise.backHint"]">@Text["practise.back"]</button>
                }
                else
                {
                    <button @onclick="() => PlayOn.InvokeAsync(false)" title="@Text["practise.playOnHint"]">@Text["practise.playOn"]</button>
                    <button @onclick="() => PlayOn.InvokeAsync(true)" title="@Text["practise.wholeHint"]">@Text["practise.whole"]</button>
                }
            </div>
        </div>

        <div class="group" role="group" aria-label="@Text["transport.tempo"]">
            <h3>@Text["transport.tempo"]</h3>
            <div class="tempo-steps">
                <button aria-label="@Text["practise.slower"]" title="@Text["practise.slowerHint"]" @onclick="() => TempoChanged.InvokeAsync(TempoPercent - TempoStep)" disabled="@(TempoPercent <= MinTempo)">−</button>
                <output aria-live="polite" aria-label="@Text["transport.tempo"]">@TempoPercent%</output>
                <button aria-label="@Text["practise.faster"]" title="@Text["practise.fasterHint"]" @onclick="() => TempoChanged.InvokeAsync(TempoPercent + TempoStep)" disabled="@(TempoPercent >= MaxTempo)">+</button>
            </div>
            <div class="choices">
                @foreach (int preset in s_presets)
                {
                    bool on = TempoPercent == preset;
                    <button class="@(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @onclick="() => TempoChanged.InvokeAsync(preset)">@preset%</button>
                }
            </div>
        </div>

        @if (Choices.Count > 1)
        {
            <div class="group" role="group" aria-label="@Text["explore.hear"]">
                <h3>@Text["explore.hear"]</h3>
                @* The hands on one row, the layers on the next. *@
                @foreach (var row in Choices.GroupBy(choice => IsLayer(choice.Choice)))
                {
                    <div class="choices" title="@Text["practise.whileLooping"]">
                        @foreach ((ListenTo choice, string label) in row)
                        {
                            bool on = ListenTo == choice;
                            <button class="@(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @onclick="() => ListenToChanged.InvokeAsync(choice)">@label</button>
                        }
                    </div>
                }
                @if (HandsNote is not null)
                {
                    <p class="meta">@HandsNote</p>
                }
            </div>
        }

        <p class="meta">@Text["practise.samePhrase"]</p>
    }
</section>

@code {
    private const int TempoStep = 5;

    /// <summary>The tempo range of the transport's slider.</summary>
    internal const int MinTempo = 25;

    internal const int MaxTempo = 150;

    private static readonly int[] s_presets = [50, 75, 100];

    /// <summary>The shared workspace state the page cascades; this panel reads its selection and playback.</summary>
    [CascadingParameter]
    public WorkspaceState State { get; set; } = null!;

    private bool HasSelection => State.Selection.HasNotes;

    private bool Playing => State.Playback.Playing;

    private bool Looping => State.Playback.Looping;

    private int TempoPercent => State.Playback.TempoPercent;

    private IReadOnlyList<(ListenTo Choice, string Label)> Choices => State.Playback.ListenChoices;

    private ListenTo ListenTo => State.Playback.ListenTo;

    private string? HandsNote => State.Playback.HandsNote;

    private bool CanGoBack => State.Selection.Previous is not null;

    private bool CanGoOn => State.Selection.Next is not null;

    private bool PlayingOn => State.Playback.PlayingOn;

    [Parameter]
    public EventCallback PlayPressed { get; set; }

    [Parameter]
    public EventCallback LoopPressed { get; set; }

    /// <summary>-1 for the previous phrase, 1 for the next.</summary>
    [Parameter]
    public EventCallback<int> Step { get; set; }

    [Parameter]
    public EventCallback<int> TempoChanged { get; set; }

    [Parameter]
    public EventCallback<ListenTo> ListenToChanged { get; set; }

    /// <summary>True to play the whole piece from its start, false to play on from the phrase to the end.</summary>
    [Parameter]
    public EventCallback<bool> PlayOn { get; set; }

    [Parameter]
    public EventCallback Back { get; set; }

    private static bool IsLayer(ListenTo choice) => choice is ListenTo.Melody or ListenTo.Accompaniment;
}
