@using MotiffLab.MusicCore.Variations
@using MotiffLab.Web.Localization
@inject UiText Text

@* Compare (#43, step 6 of docs/08-central-product-model.md): what the variation changed and what it kept, read only
   from its diff (Variation.Changes, Added, Removed), its Keep checks (Variation.Checks, Properties) and its rule
   flags. Nothing here is computed again: each line counts or names what music-core already returned. *@
<section class="compare" aria-label="@Text["compare.title"]">
    <h3>@Text["compare.title"]</h3>

    <div class="compare-part">
        <h4>@Text["tools.whatChanged"]</h4>
        <ul>
            @foreach (string line in Changed)
            {
                <li>@line</li>
            }
        </ul>
        @if (Names(Variation.Properties, KeepStatus.NoLongerKept) is { } changed)
        {
            <p><span class="label">@Text["compare.changed"]</span> @changed</p>
        }
    </div>

    <div class="compare-part">
        <h4>@Text["compare.whatKept"]</h4>
        @if (Variation.Checks.Count == 0)
        {
            <p class="meta">@Text["compare.nothingAsked"]</p>
        }
        else
        {
            <ul class="checks">
                @foreach ((KeepStatus status, string key) in s_statuses)
                {
                    KeepCheck[] checks = [.. Variation.Checks.Where(check => check.Status == status)];
                    @if (checks.Length > 0)
                    {
                        <li class="@StatusClass(status)">
                            <span class="label">@Text[key]:</span>
                            @foreach (KeepCheck check in checks)
                            {
                                <span class="property">@Label(check.Property)</span>
                            }
                        </li>
                    }
                }
            </ul>
        }
        @if (Names(Unasked, KeepStatus.Kept) is { } unchanged)
        {
            <p><span class="label">@Text["compare.alsoUnchanged"]</span> @unchanged</p>
        }
    </div>

    @if (ShowFlags)
    {
        @foreach (string flag in Variation.Flags)
        {
            <p class="meta flag">@Text.Format("tools.check", flag)</p>
        }
    }
</section>

@code {
    private static readonly (KeepStatus Status, string Key)[] s_statuses =
    [
        (KeepStatus.Kept, "compare.kept"),
        (KeepStatus.NoLongerKept, "compare.notKept"),
        (KeepStatus.NotChecked, "compare.notChecked"),
    ];

    /// <summary>The shared workspace state the page cascades; the panel reads its variation.</summary>
    [CascadingParameter]
    public WorkspaceState State { get; set; } = null!;

    /// <summary>The variation against the original phrase: every accepted step and the one being tried. The page shows the panel only while there is one.</summary>
    private Variation Variation => State.Variation.Current!;

    /// <summary>Whether to list the rule flags; off where the page lists them already, just above.</summary>
    [Parameter]
    public bool ShowFlags { get; set; } = true;

    /// <summary>The properties checked without being asked to be kept.</summary>
    private IEnumerable<KeepCheck> Unasked => Variation.Properties.Where(property => Variation.Checks.All(check => check.Property != property.Property));

    /// <summary>The note-by-note diff, counted: how many of the original's notes changed pitch, start or length, and what was added or removed.</summary>
    private IEnumerable<string> Changed
    {
        get
        {
            int notes = Variation.Changes.Count + Variation.Removed.Count;
            string of = Text.Count("compare.ofNotes", notes);
            int pitch = Variation.Changes.Count(change => change.PitchChanged);
            int onset = Variation.Changes.Count(change => change.OnsetChanged);
            int length = Variation.Changes.Count(change => change.DurationChanged);
            if (pitch == 0 && onset == 0 && length == 0 && Variation.Added.Count == 0 && Variation.Removed.Count == 0)
            {
                yield return Text.Format("compare.nothing", Text.Count("compare.notes", notes));
                yield break;
            }

            yield return Text.Format("compare.pitch", pitch, of);
            yield return Text.Format("compare.start", onset, of);
            yield return Text.Format("compare.length", length, of);
            if (Variation.Added.Count > 0)
            {
                yield return Text.Format("compare.added", Text.Count("compare.notes", Variation.Added.Count));
            }

            if (Variation.Removed.Count > 0)
            {
                yield return Text.Format("compare.removed", Text.Count("compare.notes", Variation.Removed.Count));
            }
        }
    }

    /// <summary>"Contour, Rhythm and Register": the properties with this status, in the Keep table's order; null for none.</summary>
    private string? Names(IEnumerable<KeepCheck> checks, KeepStatus status)
    {
        string[] names = [.. checks.Where(check => check.Status == status).Select(check => Label(check.Property))];
        return names.Length == 0 ? null : MotiffLab.MusicCore.Words.For(Text.Language).Joined(names);
    }

    private static string StatusClass(KeepStatus status) => status switch
    {
        KeepStatus.Kept => "kept",
        KeepStatus.NoLongerKept => "broken",
        _ => "unchecked",
    };

    /// <summary>The property's name as the Keep chips show it.</summary>
    private string Label(KeepProperty property) => Text[$"term.keep.{property}"];
}
