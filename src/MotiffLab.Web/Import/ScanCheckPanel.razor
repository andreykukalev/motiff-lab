@using MotiffLab.MusicCore.Import.Scan
@using MotiffLab.MusicCore.Projects
@inject MotiffLab.Web.Localization.UiText Text

@* Check the scan (decision record 0011): the bars the rules flag in a piece read from a photo or PDF, first, then a way to confirm
   any other bars once the player has compared them with the page. Everything shown comes from ScanCheck; confirming only names bars. *@
<section class="scan-check" aria-label="@Text["import.scanCheck"]">
    <p>@Text.Format("scanCheck.intro", Scan.Engine, Text.Count("import.barCount", Scan.ConfirmedBars.Count(bar => Check.Find(bar) is not null)), Check.Bars.Count)</p>

    <h3>@Text["scanCheck.toCheck"]</h3>
    @if (Flagged.Count == 0)
    {
        <p class="meta">@Text["scanCheck.noneFlagged"]</p>
    }
    else
    {
        <p class="meta">@Text.Format("scanCheck.left", Text.Count("import.barCount", Flagged.Count(bar => !Scan.IsConfirmed(bar.Bar))))</p>
        <ul class="scan-bars">
            @foreach (ScanBar bar in Flagged)
            {
                bool confirmed = Scan.IsConfirmed(bar.Bar);
                <li class="@(confirmed ? "confirmed" : null)">
                    <strong>@Label(bar)</strong>
                    <span>@string.Join(" ", bar.ReasonsIn(MotiffLab.MusicCore.Words.For(Text.Language)))</span>
                    <span class="row">
                        <button @onclick="() => Show.InvokeAsync(bar)">@Text["scanCheck.show"]</button>
                        <button @onclick="() => Correct.InvokeAsync(bar)" title="@Text["scanCheck.correctHint"]">@Text["correct.label"]</button>
                        @if (confirmed)
                        {
                            <span class="kind">@Text["scanCheck.looksRight"] ✓</span>
                            <button @onclick="() => Unconfirm.InvokeAsync(bar.Bar)" title="@Text["scanCheck.againHint"]">@Text["scanCheck.again"]</button>
                        }
                        else
                        {
                            <button class="primary" @onclick="() => Confirm.InvokeAsync([bar.Bar])">@Text["scanCheck.looksRight"]</button>
                        }
                    </span>
                </li>
            }
        </ul>
    }

    <h3>@Text["scanCheck.other"]</h3>
    @if (SelectedBars.Count(bar => !Scan.IsConfirmed(bar)) is > 0 and int open)
    {
        <button @onclick="() => Confirm.InvokeAsync(SelectedBars)">@(SelectedBars.Count == 1 ? Text.Format("scanCheck.barRight", SelectedBars[0]) : Text.Format("scanCheck.barsRight", SelectedBars[0], SelectedBars[^1])) @Text.Format("scanCheck.notChecked", Text.Count("import.barCount", open))</button>
    }
    else
    {
        <p class="meta">@Text["scanCheck.selectHint"]</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required ScanCheck Check { get; set; }

    [Parameter, EditorRequired]
    public required ScanOrigin Scan { get; set; }

    /// <summary>The scanned bars the selection covers, in order.</summary>
    [Parameter]
    public IReadOnlyList<int> SelectedBars { get; set; } = [];

    [Parameter]
    public EventCallback<ScanBar> Show { get; set; }

    [Parameter]
    public EventCallback<ScanBar> Correct { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<int>> Confirm { get; set; }

    [Parameter]
    public EventCallback<int> Unconfirm { get; set; }

    private List<ScanBar> Flagged => [.. Check.Flagged];

    /// <summary>"Bar 16", with the measure's number in the scan when the two differ, so the player can find it on the page.</summary>
    private string Label(ScanBar bar) =>
        bar.Measure is { } measure && measure != bar.Bar.ToString(System.Globalization.CultureInfo.InvariantCulture)
            ? Text.Format("scanCheck.barMeasure", bar.Bar, measure)
            : Text.Format("import.bar", bar.Bar);
}
