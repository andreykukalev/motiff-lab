@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Events
@using MotiffLab.MusicCore.Motifs
@using MotiffLab.MusicCore.Notation
@using MotiffLab.MusicCore.Playback
@using MotiffLab.MusicCore.Settings
@using MotiffLab.MusicCore.Time
@using MotiffLab.MusicCore.Variations
@using MotiffLab.Web.Playback
@using MotiffLab.Web.Score
@using MotiffLab.Web.Understand
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Player Player
@inject MotiffLab.Web.Settings.DeviceSettings SettingsStore
@inject MotiffLab.Web.Localization.UiText Text

@* Drawn on canvas in Scripts/roll (S1-W2, S1-W3, S1-M1); the host's children belong to the script. *@
@if (Editor is { On: true } editor)
{
    @* The note editor (testing item 15): its tools, Undo and Reset, and nothing kept until ✓ Save; ✕ puts the notes back. *@
    <div class="roll-head editing" role="toolbar" aria-label="@Text["edit.toolbar"]">
        <p class="overline">@Text["edit.title"]</p>
        <div class="seg" role="radiogroup" aria-label="@Text["edit.tool"]">
            @foreach (string tool in s_editTools)
            {
                bool on = editor.Tool == tool;
                <button role="radio" aria-checked="@(on ? "true" : "false")" class="@(on ? "on" : null)" title="@Text[$"edit.{tool}Hint"]" @onclick="() => editor.ChooseTool(tool)">@Text[$"edit.{tool}"]</button>
            }
        </div>
        <button class="chip icon" aria-label="@Text["edit.undo"]" title="@Text["edit.undo"]" disabled="@(!editor.CanUndo)" @onclick="() => editor.Undo()"><Icon Name="undo" /></button>
        <button class="chip" title="@Text["edit.resetHint"]" disabled="@(!editor.CanReset)" @onclick="() => editor.Reset()">@Text["edit.reset"]</button>
        <span class="sp"></span>
        <button class="btn quiet compact" @onclick="() => editor.Cancel()">@Text["edit.cancel"]</button>
        <button class="btn primary compact" disabled="@(!editor.Changed)" @onclick="() => editor.Save()"><Icon Name="check" /> @Text[editor.SaveKey]</button>
    </div>
    <p class="caption roll-edit-hint">@Text[$"edit.{editor.Tool}Hint"] @Text["edit.keptOnSave"]</p>
}
else
{
<div class="roll-head">
    @if (Heading is not null)
    {
        <p class="overline">@Heading</p>
    }
    <span class="sp"></span>
    @if (Editor is { } closed)
    {
        @* Correct the notes on the roll (testing item 15): recognition artefacts out, missing notes in. *@
        <button class="chip" title="@Text["edit.beginHint"]" @onclick="() => closed.Begin()"><Icon Name="pen" /> @Text["edit.begin"]</button>
    }
    <button class="chip @(_noteNames ? "on" : null)" aria-pressed="@(_noteNames ? "true" : "false")" @onclick="ToggleNoteNamesAsync">
        <span class="dot" aria-hidden="true"></span> @Text["roll.noteNames"]
    </button>
    @* The colour scheme in one tap: the next grouping that tells notes apart; the overflow lists all three. *@
    <button class="chip" title="@Text["roll.colourHint"]" @onclick="NextColourAsync" disabled="@(AvailableModes.Count() < 2)">@Text[$"roll.colour.{_colourBy}"]</button>
    @if (Expanded.HasDelegate)
    {
        @* Into phrase focus with the phrase as a roll (testing item 12). *@
        <button class="chip" title="@Text["roll.expandHint"]" @onclick="() => Expanded.InvokeAsync()"><Icon Name="search" /> @Text["roll.expand"]</button>
    }
    <button class="chip icon @(_menuOpen ? "on" : null)" aria-expanded="@(_menuOpen ? "true" : "false")" aria-label="@Text["roll.more"]" title="@Text["roll.more"]"
            @onclick="() => _menuOpen = !_menuOpen"><Icon Name="more" /></button>
    @if (_menuOpen)
    {
        @* The roll's own small overflow (0018 section 4): colour by track, voice or hand. The zoom floats over the notes (testing item 13). *@
        <div class="roll-menu" role="group" aria-label="@Text["roll.more"]">
            <p class="overline">@Text["roll.colourBy"]</p>
            <div class="roll-tools">
                @foreach (string mode in s_colourModes)
                {
                    int lanes = LaneCount(mode);
                    <label class="@(lanes < 2 ? "unavailable" : null)" title="@(lanes < 2 ? OneLaneText(mode) : null)">
                        <input type="radio" name="roll-colour" checked="@(_colourBy == mode)" disabled="@(lanes < 2)" @onchange="() => SetColourByAsync(mode)" /> @Text[$"roll.mode.{mode}"]
                    </label>
                }
            </div>
            @if (s_colourModes.Any(mode => LaneCount(mode) < 2) && Notes is { Count: > 0 })
            {
                <p class="caption">@string.Join(" ", s_colourModes.Where(mode => LaneCount(mode) < 2).Select(OneLaneText))</p>
            }
        </div>
    }
</div>
}
<div class="roll" @ref="_host"></div>
<p class="meta" aria-live="polite">@SelectionText</p>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _view;
    private DotNetObjectReference<PianoRoll>? _self;
    private IReadOnlyList<Note>? _shown;
    private Dictionary<string, Note> _byId = [];
    private static readonly string[] s_colourModes = ["hand", "track", "voice"];

    private string _colourBy = "hand";
    private bool _noteNames = true;
    private bool _menuOpen;

    /// <summary>The device settings for the roll's note names and colour scheme (SettingsCatalogue, 0018 section 10).</summary>
    private const string NoteNamesSetting = "roll.noteNames";
    private const string ColourSetting = "roll.colour";

    /// <summary>The colour scheme the player chose last, kept on the device; the setting's default is hands.</summary>
    private string _preferredColour = SettingsCatalogue.Get(ColourSetting).Default;

    /// <summary>What heads the drawer: "Piano roll · bars 9–16".</summary>
    [Parameter]
    public string? Heading { get; set; }
    private Dictionary<string, int> _laneCounts = [];
    private IReadOnlyCollection<string>? _shownKept;
    private Variation? _shownVariation;
    private (bool Original, bool Variation) _shownAudible = (true, false);
    private TickSpan? _shownPlayRange;
    private PhraseMap? _shownPhrases;
    private IReadOnlyList<HighlightPlace>? _shownHighlight;
    private IReadOnlyList<string> _selected = [];
    private MotifSelection? _shownMotif;
    private bool _shownAlone;
    private IReadOnlyList<KeyChange>? _shownKeys;
    private (NoteNaming Naming, string Language)? _shownNaming;
    private IReadOnlyList<ScoreCheckFlag>? _shownChecks;
    private NotePoint? _shownPoint;

    /// <summary>Each note's name spelled for its key, by id, as the roll writes it.</summary>
    private IReadOnlyDictionary<string, string> _spelled = new Dictionary<string, string>();

    /// <summary>The notes to draw. The view loads them again only when a different list is given.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Note>? Notes { get; set; }

    /// <summary>The bars and beats of the piece.</summary>
    [Parameter, EditorRequired]
    public PlaybackScore? Score { get; set; }

    [Parameter, EditorRequired]
    public MeterMap? Meter { get; set; }

    /// <summary>The motif selection to show: its range shaded and the notes outside it faint. Null for none.</summary>
    [Parameter]
    public MotifSelection? Motif { get; set; }

    /// <summary>True while only the motif's notes play, so only they light up as they sound.</summary>
    [Parameter]
    public bool MotifPlaysAlone { get; set; }

    /// <summary>
    /// Raised when the player drags across the roll, with where the drag started and ended in ticks,
    /// not yet snapped; a click on a bar number comes with <see cref="RollRange.IsClick"/> set, and a
    /// Shift-click on one with <see cref="RollRange.Extend"/> set.
    /// </summary>
    [Parameter]
    public EventCallback<RollRange> RangePicked { get; set; }

    /// <summary>Raised when the player clears the selection: Escape, or a click on an empty place in or outside the roll.</summary>
    [Parameter]
    public EventCallback Cleared { get; set; }

    /// <summary>Raised when the player presses Space outside a control, to play or pause.</summary>
    [Parameter]
    public EventCallback PlayPausePressed { get; set; }

    /// <summary>Raised when the player moves the playhead on the roll: dragged or nudged by a beat, or tapped to play from there.</summary>
    [Parameter]
    public EventCallback<RollSeek> PlayheadMoved { get; set; }

    /// <summary>The ids of the notes the Notes filter keeps, drawn at full strength and lit as they sound; null keeps all.</summary>
    [Parameter]
    public IReadOnlyCollection<string>? Kept { get; set; }

    /// <summary>The variation of the motif, drawn as outlines over it with a line from each note it moved; null for none.</summary>
    [Parameter]
    public Variation? Variation { get; set; }

    /// <summary>The range that plays for the selection, which a variation can lengthen or shorten; null for none.</summary>
    [Parameter]
    public TickSpan? PlayRange { get; set; }

    /// <summary>Whether the piece's notes are being heard (the original or the selection source), so they light up.</summary>
    [Parameter]
    public bool OriginalAudible { get; set; } = true;

    /// <summary>Whether the variation is being heard, so its outlines light up as they sound.</summary>
    [Parameter]
    public bool VariationAudible { get; set; }

    /// <summary>The piece's phrases, whose starts are marked over the bar numbers (#18); null for none.</summary>
    [Parameter]
    public PhraseMap? Phrases { get; set; }

    /// <summary>The places of the fact chosen on the Understand tab (#25), highlighted; null or empty highlights none.</summary>
    [Parameter]
    public IReadOnlyList<HighlightPlace>? Highlight { get; set; }

    /// <summary>Raised with the ids of the selected notes, in time order.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> SelectionChanged { get; set; }

    /// <summary>The key signatures, from where each starts, that the roll spells its names for, as the score does; empty for C major.</summary>
    [Parameter]
    public IReadOnlyList<KeyChange>? Keys { get; set; }

    /// <summary>The bars Check flags (0018 section 9), drawn on the roll's bar numbers as on the score.</summary>
    [Parameter]
    public IReadOnlyList<ScoreCheckFlag>? Checks { get; set; }

    /// <summary>Raised with the bar number when the player taps a Check flag on the roll.</summary>
    [Parameter]
    public EventCallback<int> CheckPicked { get; set; }

    /// <summary>Shows Expand in the head, which opens the phrase in focus as a roll (testing item 12); none without it.</summary>
    [Parameter]
    public EventCallback Expanded { get; set; }

    /// <summary>Whether every selection is laid across the roll as Fit does: the roll in phrase focus (testing item 12).</summary>
    [Parameter]
    public bool FitsSelection { get; set; }

    private bool? _shownFits;

    /// <summary>Another version's notes as dashed plum outlines, for the bar the player writes in a merge (testing item 34).</summary>
    [Parameter]
    public IReadOnlyList<Note>? Ghosts { get; set; }

    private IReadOnlyList<Note>? _shownGhosts;

    /// <summary>The note editor on the roll (testing item 15); null where the notes cannot be edited.</summary>
    [Parameter]
    public NoteEditor? Editor { get; set; }

    private static readonly string[] s_editTools = ["move", "add", "delete"];

    private (bool On, string Tool)? _shownEditing;
    private string? _shownPicked;
    private string? _shownMode;

    /// <summary>The mode the bar chose (version 0.5, Scripts/roll/roll-modes.ts); null keeps the roll as it was.</summary>
    [Parameter]
    public string? Mode { get; set; }

    /// <summary>A click under the modes: the tick under it, and whether Shift was held.</summary>
    [Parameter]
    public EventCallback<(long Tick, bool Extend)> Placed { get; set; }

    /// <summary>A note pointed at elsewhere, such as on the score: the roll selects the note at that tick and key and shows it. A new value points again.</summary>
    [Parameter]
    public NotePoint? Point { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/roll/piano-roll.js");
            _view = await _module.InvokeAsync<IJSObjectReference>("createPianoRoll", _host, _self, Labels());
            _labelsLanguage = Text.Language;
            await SettingsStore.LoadAsync();
            SettingsStore.Changed += OnSettingsChanged;
            _noteNames = SettingsStore.IsOn(NoteNamesSetting);
            _preferredColour = SettingsStore[ColourSetting];

            await _view.InvokeVoidAsync("setNoteNames", _noteNames);
        }
        else if (_view is not null && _labelsLanguage != Text.Language)
        {
            _labelsLanguage = Text.Language;
            await _view.InvokeVoidAsync("setLabels", Labels());
        }

        if (_view is null || Notes is null || Score is null)
        {
            return;
        }

        if (!ReferenceEquals(Notes, _shown))
        {
            // Notes again on a roll that shows notes (an edit, a version taken in) keep its zoom and view (#495 BUG-04).
            bool keepView = _shown is not null;
            _shown = Notes;
            _byId = Notes.ToDictionary(note => note.Id);
            _selected = [];
            _shownMotif = null;
            _shownKept = null;
            _shownVariation = null;
            _shownPlayRange = null;
            _shownPhrases = null;
            _shownHighlight = null;
            _shownKeys = null;
            _shownNaming = null;
            _shownChecks = null;
            _laneCounts = new()
            {
                ["track"] = Notes.Select(note => note.Track).Distinct().Count(),
                // Without notated voices, Voice would only repeat Track.
                ["voice"] = Notes.Any(note => note.Voice is not null) ? Notes.Select(note => (note.Track, note.Voice)).Distinct().Count() : 1,
                ["hand"] = Notes.Select(note => note.Hand?.Value).Distinct().Count(),
            };
            // Start with the player's grouping (hands unless they chose another) when it tells notes apart, else hands, tracks, voices.
            _colourBy = AvailableModes.OrderBy(mode => mode == _preferredColour ? 0 : Array.IndexOf(s_colourModes, mode) + 1).FirstOrDefault() ?? _preferredColour;
            // The notes cross over once per piece: a second roll on them (Expand) takes what the first was sent (#419).
            string notesKey = RollShared.NotesKey(Notes, Score);
            if (!await _view.InvokeAsync<bool>("loadKept", notesKey, keepView))
            {
                await _view.InvokeVoidAsync("load", PianoRollData.Create(Notes, Score), notesKey, keepView);
            }

            _shownFits = null;
            await _view.InvokeVoidAsync("setColourBy", _colourBy);
            await _view.InvokeVoidAsync("follow", Player.Engine);
            await ShowMotifAsync(_view);
            await ShowOverlaysAsync(_view);
            StateHasChanged();
        }
        else
        {
            if (!ReferenceEquals(Motif, _shownMotif) || MotifPlaysAlone != _shownAlone || FitsSelection != _shownFits)
            {
                await ShowMotifAsync(_view);
            }

            await ShowOverlaysAsync(_view);
        }
    }

    /// <summary>Sends the Notes filter, the variation, the play range, the phrases, the highlight and which sources are heard, each only when it changed.</summary>
    private async Task ShowOverlaysAsync(IJSObjectReference view)
    {
        if (!ReferenceEquals(Kept, _shownKept))
        {
            _shownKept = Kept;
            // Cast, so the array goes across as one argument rather than as the argument list.
            await view.InvokeVoidAsync("setFilter", (object?)Kept?.ToArray());
        }

        if (!ReferenceEquals(Ghosts, _shownGhosts))
        {
            _shownGhosts = Ghosts;
            long[] ghosts = [.. (Ghosts ?? []).SelectMany(note => new[] { note.Span.Onset.Value, note.Span.End.Value, (long)note.Pitch.MidiNumber })];
            await view.InvokeVoidAsync("setGhosts", ghosts);
        }

        if (!ReferenceEquals(Variation, _shownVariation))
        {
            _shownVariation = Variation;
            if (Variation is { } variation)
            {
                long[] packed = [.. variation.Changes.SelectMany(change => new[]
                {
                    change.After.Span.Onset.Value, change.After.Span.End.Value, change.After.Pitch.MidiNumber,
                    change.Before.Span.Onset.Value, change.Before.Pitch.MidiNumber,
                })];
                await view.InvokeVoidAsync("setVariation", packed);
            }
            else
            {
                await view.InvokeVoidAsync("clearVariation");
            }
        }

        if (PlayRange != _shownPlayRange)
        {
            _shownPlayRange = PlayRange;
            if (PlayRange is { } range)
            {
                await view.InvokeVoidAsync("setPlayRange", range.Onset.Value, range.End.Value);
            }
            else
            {
                await view.InvokeVoidAsync("clearPlayRange");
            }
        }

        if (!ReferenceEquals(Phrases, _shownPhrases))
        {
            _shownPhrases = Phrases;
            // Per phrase start: the tick and how it was found, 0 from the file, 1 inferred, 2 the player's.
            long[] packed = [.. (Phrases?.Phrases ?? []).Where(phrase => phrase.Start is not null).SelectMany(phrase => new[]
            {
                phrase.Span.Onset.Value,
                phrase.Start!.Attribution.Provenance switch
                {
                    Provenance.Inferred or Provenance.Detected => 1L,
                    Provenance.UserEdited or Provenance.UserConfirmed => 2L,
                    _ => 0L,
                },
            })];
            await view.InvokeVoidAsync("setPhrases", packed);
        }

        if (!ReferenceEquals(Highlight, _shownHighlight))
        {
            _shownHighlight = Highlight;
            IReadOnlyList<HighlightPlace> places = Highlight ?? [];
            long[] spans = [.. places.SelectMany(place => new[] { place.Start, place.End })];
            string[] ids = [.. places.SelectMany(place => place.Notes).Select(note => note.Id).Distinct(StringComparer.Ordinal)];
            await view.InvokeVoidAsync("setHighlight", spans, ids);
        }

        NoteNaming naming = NoteNames.For(SettingsStore[NoteNames.Setting], MotiffLab.MusicCore.Words.For(Text.Language));
        if (!ReferenceEquals(Keys, _shownKeys) || _shownNaming != (naming, Text.Language))
        {
            _shownKeys = Keys;
            _shownNaming = (naming, Text.Language);
            string namesKey = RollShared.NamesKey(RollShared.NotesKey(Notes!, Score!), Keys, naming, Text.Language);
            (RollNames names, _spelled) = RollShared.Names(namesKey, Notes!, () => PianoRollData.Names(Notes!, Keys ?? [], naming, MotiffLab.MusicCore.Words.For(Text.Language)));
            if (!await view.InvokeAsync<bool>("setNamesKept", namesKey))
            {
                await view.InvokeVoidAsync("setNames", names.Notes, names.KeyTicks, names.Rows, names.Short, names.ShortRows, names.Octaves, namesKey);
            }
        }

        if (!ReferenceEquals(Checks, _shownChecks))
        {
            _shownChecks = Checks;
            await view.InvokeVoidAsync("setChecks", (object)(Checks ?? []).Select(check => new { tick = check.Tick, bar = check.Bar, label = check.Label }).ToArray());
        }

        if (Point is { } point && point != _shownPoint)
        {
            _shownPoint = point;
            await view.InvokeVoidAsync("pointAt", point.Tick, point.Pitch);
        }

        if (Mode != _shownMode)
        {
            _shownMode = Mode;
            await view.InvokeVoidAsync("setRules", Mode);
        }

        (bool, string) editing = (Editor?.On ?? false, Editor?.Tool ?? "move");
        if (editing != _shownEditing)
        {
            _shownEditing = editing;
            await view.InvokeVoidAsync("setEditing", editing.Item1, editing.Item2);
        }

        if (Editor?.Picked != _shownPicked)
        {
            _shownPicked = Editor?.Picked;
            await view.InvokeVoidAsync("pickForEdit", _shownPicked);
        }

        if ((OriginalAudible, VariationAudible) != _shownAudible)
        {
            _shownAudible = (OriginalAudible, VariationAudible);
            await view.InvokeVoidAsync("setAudible", OriginalAudible, VariationAudible);
        }
    }

    private int LaneCount(string mode) => _laneCounts.GetValueOrDefault(mode, 0);

    private string? _labelsLanguage;

    /// <summary>The words the script draws, in the player's language (RollLabels in Scripts/roll/roll-model.ts).</summary>
    private Dictionary<string, string> Labels() => new[]
    {
        "track", "trackVoice", "noVoice", "rightHand", "leftHand", "noHand", "rollAria", "scrollAria", "keysAria",
        "legendVariation", "legendHighlight", "legendInferred", "legendCheck", "zoomGroup", "zoomIn", "zoomOut", "zoomLevel", "fit", "fitHint",
        "playhead", "playheadAt",
    }.ToDictionary(name => name, name => Text[$"roll.js.{name}"]);

    /// <summary>Why a grouping is off for this piece, so the control never looks like it does nothing.</summary>
    private string OneLaneText(string mode) => Text[mode switch
    {
        "track" => "roll.oneTrack",
        "voice" => "roll.noVoices",
        _ => "roll.noHands",
    }];

    private async Task ShowMotifAsync(IJSObjectReference view)
    {
        if (FitsSelection != _shownFits)
        {
            _shownFits = FitsSelection;
            await view.InvokeVoidAsync("setFitsSelection", FitsSelection);
        }

        _shownMotif = Motif;
        _shownAlone = MotifPlaysAlone;
        if (Motif is { } motif)
        {
            await view.InvokeVoidAsync("setMotif", motif.Span.Onset.Value, motif.Span.End.Value, motif.NoteIds, MotifPlaysAlone);
        }
        else
        {
            await view.InvokeVoidAsync("clearMotif");
        }
    }

    /// <summary>Called by the script when a drag across the roll ends, or a bar number is clicked.</summary>
    [JSInvokable]
    public Task OnRollRange(long anchor, long current, bool click, bool extend) =>
        RangePicked.InvokeAsync(new RollRange(new Tick(Math.Max(0, anchor)), new Tick(Math.Max(0, current)), click, extend));

    /// <summary>Called by the script when the player clears the selection.</summary>
    [JSInvokable]
    public Task OnRollClear() => Cleared.InvokeAsync();

    /// <summary>Called by the script when Space is pressed outside a control.</summary>
    [JSInvokable]
    public Task OnRollSpace() => PlayPausePressed.InvokeAsync();

    /// <summary>Called by the script when the playhead is moved on the roll, and with play when a tap plays from there.</summary>
    [JSInvokable]
    public Task OnRollSeek(long tick, bool play) => PlayheadMoved.InvokeAsync(new RollSeek(new Tick(Math.Max(0, tick)), play));

    /// <summary>Called by the script when a Check flag on the bar numbers is tapped.</summary>
    [JSInvokable]
    public Task OnRollCheckPicked(int bar) => CheckPicked.InvokeAsync(bar);

    /// <summary>Called by the script when a note is dragged in the editor, or moved with the arrows: its new onset, pitch and length.</summary>
    [JSInvokable]
    public Task OnRollNoteChange(string id, long onset, int pitch, long length) =>
        Editor?.Change(new RollNoteEdit(id, onset, pitch, length)) ?? Task.CompletedTask;

    /// <summary>Called by the script when the editor adds a note where the player pressed.</summary>
    [JSInvokable]
    public Task OnRollNoteAdd(long onset, int pitch, long length) =>
        Editor?.Add(new RollNoteEdit(null, onset, pitch, length)) ?? Task.CompletedTask;

    /// <summary>Called by the script when a click under the modes places a playhead (version 0.5).</summary>
    [JSInvokable]
    public Task OnRollPlace(long tick, bool extend) => Placed.InvokeAsync((Math.Max(0, tick), extend));

    /// <summary>Called by the script when notes are picked in Edit notes, by a click or a box: the editor opens on them (version 0.5).</summary>
    [JSInvokable]
    public async Task OnRollNotesPicked(string[] ids)
    {
        if (ids.Length > 0 && Editor is { On: false } editor)
        {
            await editor.Begin();
        }
    }

    /// <summary>Called by the script when the editor takes a note out.</summary>
    [JSInvokable]
    public Task OnRollNoteRemove(string id) => Editor?.Remove(id) ?? Task.CompletedTask;

    /// <summary>Called by the script when the selection changes.</summary>
    [JSInvokable]
    public async Task OnRollSelection(string[] ids)
    {
        _selected = ids;
        StateHasChanged();
        await SelectionChanged.InvokeAsync(ids);
    }

    private async Task SetColourByAsync(string by)
    {
        _colourBy = by;
        _preferredColour = by;
        await SettingsStore.SetAsync(ColourSetting, by);
        if (_view is not null)
        {
            await _view.InvokeVoidAsync("setColourBy", by);
        }
    }

    /// <summary>The groupings that tell this piece's notes apart.</summary>
    private IEnumerable<string> AvailableModes => s_colourModes.Where(mode => LaneCount(mode) > 1);

    /// <summary>The colour chip: the next grouping that tells notes apart.</summary>
    private Task NextColourAsync()
    {
        string[] modes = [.. AvailableModes];
        return modes.Length < 2 ? Task.CompletedTask : SetColourByAsync(modes[(Array.IndexOf(modes, _colourBy) + 1) % modes.Length]);
    }

    private async Task ToggleNoteNamesAsync()
    {
        _noteNames = !_noteNames;
        await SettingsStore.SetAsync(NoteNamesSetting, _noteNames);
        if (_view is not null)
        {
            await _view.InvokeVoidAsync("setNoteNames", _noteNames);
        }
    }

    /// <summary>The selection in words, so it does not depend on seeing the outline, with anything inferred said so.</summary>
    private string SelectionText
    {
        get
        {
            if (_selected.Count == 0 || Meter is null)
            {
                return Text["roll.hint"];
            }

            if (_selected.Count > 1)
            {
                return Text.Count("roll.selected", _selected.Count);
            }

            if (!_byId.TryGetValue(_selected[0], out Note? note))
            {
                return Text.Count("roll.selected", 1);
            }

            MetricPosition position = Meter.ToPosition(note.Span.Onset);
            var parts = new List<string> { Text.Format("roll.at", _spelled.GetValueOrDefault(note.Id) ?? note.Pitch.ToString(), position.Bar, position.Beat), Text.Format("roll.track", note.Track + 1) };
            if (note.Voice is int voice)
            {
                parts.Add(Text.Format("roll.voice", voice));
            }

            if (note.Hand is { } hand)
            {
                string side = hand.Value == Hand.Left ? "left" : "right";
                parts.Add(Text[$"roll.{side}{(PianoRollData.IsCertain(hand.Attribution) ? "FromFile" : "Inferred")}"]);
            }

            if (!PianoRollData.IsCertain(note.Attribution))
            {
                parts.Add(Text.Format("roll.notStated", Text[$"roll.provenance.{note.Attribution.Provenance}"]));
            }

            return Text.Format("roll.selectedNote", string.Join(" · ", parts));
        }
    }

    /// <summary>The note names or the colour changed in the Settings sheet: the roll shows them at once.</summary>
    private void OnSettingsChanged() => _ = InvokeAsync(async () =>
    {
        bool names = SettingsStore.IsOn(NoteNamesSetting);
        string colour = SettingsStore[ColourSetting];
        if (_view is null)
        {
            return;
        }

        if (names != _noteNames)
        {
            _noteNames = names;
            await _view.InvokeVoidAsync("setNoteNames", names);
        }

        if (colour != _preferredColour)
        {
            _preferredColour = colour;
            if (AvailableModes.Contains(colour))
            {
                _colourBy = colour;
                await _view.InvokeVoidAsync("setColourBy", colour);
            }
        }

        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        SettingsStore.Changed -= OnSettingsChanged;
        try
        {
            if (_view is not null)
            {
                await _view.InvokeVoidAsync("dispose");
                await _view.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away with the view.
        }

        _self?.Dispose();
    }
}
