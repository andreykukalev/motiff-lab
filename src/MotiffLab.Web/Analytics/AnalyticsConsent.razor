@using MotiffLab.MusicCore.Analytics
@implements IDisposable
@inject UsageAnalytics Analytics
@inject MotiffLab.Web.Localization.UiText Text

@* Consent to anonymous usage analytics (#64), on the privacy notice next to what each event holds: off until the player turns
   it on, and turning it off forgets the device's ID and the events. *@
<section class="consent" aria-labelledby="analytics-heading">
    <h3 id="analytics-heading">@Text["consent.title"]</h3>
    <p>@Text["consent.text"]</p>
    <label>
        <input type="checkbox" checked="@Analytics.On" @onchange="ToggleAsync" />
        @Text["consent.toggle"]
    </label>
    <p class="meta">
        @if (Analytics.On)
        {
            @Text.Format("consent.id", Analytics.DeviceId ?? "")
        }
        else
        {
            @Text["consent.off"]
        }
    </p>
    <p class="meta">@Text["consent.notSent"]</p>

    @if (Analytics.On)
    {
        <h4>@Text.Format("consent.waiting", Analytics.Pending.Count)</h4>
        @if (Analytics.Pending.Count == 0)
        {
            <p class="meta">@Text["consent.nothingYet"]</p>
        }
        else
        {
            <ol class="events" reversed>
                @foreach (AnalyticsEvent recorded in Analytics.Pending.Reverse())
                {
                    <li><code>@recorded.Name</code> @string.Join(", ", recorded.Properties.Select(p => $"{p.Key}: {Format(p.Value)}"))</li>
                }
            </ol>
        }
    }
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        Analytics.Changed += OnChanged;
        await Analytics.LoadAsync();
    }

    public void Dispose() => Analytics.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task ToggleAsync(ChangeEventArgs args) => Analytics.SetOnAsync(args.Value is true);

    private string Format(object value) => value switch
    {
        bool flag => Text[flag ? "consent.yes" : "consent.no"],
        _ => value.ToString() ?? "",
    };
}
