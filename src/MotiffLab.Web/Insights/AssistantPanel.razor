@using MotiffLab.MusicCore.Accounts
@inject MotiffLab.Web.Account.CloudAccount Account
@inject MotiffLab.Web.Localization.UiText Text

@* The assistant (0018 section 7; design/kit/docs/01-ux-concept.md, "AI Assistant"; design/kit/screens/s9_assistant.png): the
   last voice in the Insights stream, in the same sheet. Its scope chips say what it looks at (the phrase or selection, or the
   whole piece), and the fold "What it knows" lists the context it would be given, each item removable before asking. It
   needs an AI model, so it is Pro in full: in the free tier the place where the conversation would be holds a one-line plum
   offer, and nothing is sent anywhere. The conversation itself is not built yet (part C), so in Pro a question joins the
   conversation and that place says the answers are coming, and nothing is sent either. It shows in two ways: in the sheet,
   and as a popover at the place Ask was pressed (testing item 23), each a window onto the same conversation. *@
<section class="assistant @(Popover ? "compact" : null)" aria-labelledby="@TitleId">
    @if (Popover)
    {
        @* The popover at the place Ask was pressed (testing item 23): the same assistant, a window onto the one
           conversation kept in the Insights stream; the place under it stays as it was. *@
        <div class="ask-head">
            <h2 id="@TitleId" class="overline">@Text["ask.title"]</h2>
            <span class="sp"></span>
            <button class="btn quiet icon" aria-label="@Text["drawer.close"]" title="@Text["drawer.close"]" @onclick="() => Closed.InvokeAsync()"><Icon Name="close" /></button>
        </div>
    }
    else
    {
        <div class="ask-head">
            @* ‹ names where it goes: the place it was opened from (More, Piece DNA), or the Insights stream (testing item 20). *@
            <button class="btn quiet back-to" aria-label="@(BackLabel is { } origin ? Text.Format("nav.backTo", origin) : Text["ask.back"])" @onclick="() => Back.InvokeAsync()">
                <Icon Name="back" Size="IconSize.Small" /> @(BackLabel ?? Text["bar.insights"])
            </button>
            <h2 id="@TitleId" class="overline">@Text["ask.title"]</h2>
            <span class="sp"></span>
            <button class="btn quiet icon" aria-label="@Text["drawer.close"]" title="@Text["drawer.close"]" @onclick="() => Closed.InvokeAsync()"><Icon Name="close" /></button>
        </div>
    }

    <div class="scope-chips" role="radiogroup" aria-label="@Text["ask.scope"]">
        @if (SelectionLabel is { } selection)
        {
            bool on = !WholePiece;
            <button role="radio" class="chip @(on ? "on" : null)" aria-checked="@(on ? "true" : "false")" @onclick="() => WholePieceChanged.InvokeAsync(false)">@selection</button>
        }
        <button role="radio" class="chip @(WholePiece ? "on" : null)" aria-checked="@(WholePiece ? "true" : "false")" @onclick="() => WholePieceChanged.InvokeAsync(true)">@Text["ask.wholePiece"]</button>
    </div>

    @if (Knows.Count > 0)
    {
        <details class="knows">
            <summary>@Text.Format("ask.knows", Text.Count("ask.items", Knows.Count - _removed.Count))</summary>
            <ul>
                @for (int index = 0; index < Knows.Count; index++)
                {
                    int item = index;
                    string id = $"ask-knows-{item}";
                    <li>
                        <input type="checkbox" id="@id" checked="@(!_removed.Contains(Knows[item]))" @onchange="() => Toggle(Knows[item])" />
                        <label for="@id">@Knows[item]</label>
                    </li>
                }
            </ul>
            <p class="caption">@Text["ask.knowsHint"]</p>
        </details>
    }

    <div class="conversation" role="status">
        @foreach (string question in Conversation)
        {
            <div class="turn">
                <p class="question">@question</p>
                <p class="caption">@Text[_allowed is true ? "ask.notYet" : "ask.notSent"]</p>
            </div>
        }
        @if (_allowed is true && Conversation.Count == 0)
        {
            <p class="caption">@Text["ask.notYet"]</p>
        }
        else if (_allowed is false)
        {
            <p class="pro-offer">
                <span class="tag pro">@Text["ask.pro"]</span> @Text["ask.offer"]
                @if (Account.IsAvailable)
                {
                    <a href="@(_signedIn ? "settings#plan" : "settings")">@Text[_signedIn ? "ask.offerPlan" : "ask.offerSignIn"]</a>
                }
            </p>
        }
    </div>

    @if (Suggestions.Count > 0)
    {
        <div class="suggestions" aria-label="@Text["ask.suggestions"]">
            @foreach (string suggestion in Suggestions)
            {
                <button class="chip" disabled="@(_allowed is not true)" @onclick="() => AskAsync(suggestion)">@suggestion</button>
            }
        </div>
    }

    <form class="ask-input" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <input type="text" disabled="@(_allowed is not true)" aria-label="@Text["ask.placeholder"]" placeholder="@Text["ask.placeholder"]" @bind="_draft" @ref="_input" />
        <button type="button" class="btn quiet icon" disabled aria-label="@Text["ask.speak"]" title="@Text["ask.speak"]"><Icon Name="mic" /></button>
    </form>

    @if (Popover)
    {
        <p class="ask-foot caption">
            <span>@Text["ask.keptInInsights"]</span>
            <span class="sp"></span>
            <button class="btn quiet compact open-in" @onclick="() => OpenInInsights.InvokeAsync()">@Text["ask.openInInsights"] ›</button>
        </p>
    }
</section>

@code {
    /// <summary>The context items the player took out before asking.</summary>
    private readonly HashSet<string> _removed = new(StringComparer.Ordinal);

    /// <summary>Whether the plan includes the assistant; null until the account has answered.</summary>
    private bool? _allowed;

    private bool _signedIn;

    private string _draft = "";

    private ElementReference _input;

    private bool _focused;

    private string TitleId => Popover ? "ask-pop-title" : "ask-title";

    /// <summary>The popover at the place Ask was pressed, rather than the assistant in the Insights sheet.</summary>
    [Parameter]
    public bool Popover { get; set; }

    /// <summary>The questions asked so far about this piece: one conversation, which the popover and the sheet both show.</summary>
    [Parameter]
    public IReadOnlyList<string> Conversation { get; set; } = [];

    /// <summary>Three questions the player might ask here; a tap asks one.</summary>
    [Parameter]
    public IReadOnlyList<string> Suggestions { get; set; } = [];

    /// <summary>A question asked: it joins the conversation. Nothing is sent anywhere until the assistant is built.</summary>
    [Parameter]
    public EventCallback<string> Asked { get; set; }

    /// <summary>Open in Insights: the conversation goes on in the stream.</summary>
    [Parameter]
    public EventCallback OpenInInsights { get; set; }

    /// <summary>"This phrase · 9–16" or "This selection · 9–16"; null with nothing selected, when only the whole piece is offered.</summary>
    [Parameter]
    public string? SelectionLabel { get; set; }

    /// <summary>Whether the assistant looks at the whole piece rather than the selection.</summary>
    [Parameter]
    public bool WholePiece { get; set; }

    [Parameter]
    public EventCallback<bool> WholePieceChanged { get; set; }

    /// <summary>What it would be given: the piece, the passage, what is being practised, what was kept, the level.</summary>
    [Parameter]
    public IReadOnlyList<string> Knows { get; set; } = [];

    /// <summary>Back to the Insights stream.</summary>
    [Parameter]
    public EventCallback Back { get; set; }

    /// <summary>Where ‹ goes when the assistant was opened from another place, such as "More"; null for the Insights stream.</summary>
    [Parameter]
    public string? BackLabel { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _signedIn = Account.IsAvailable && await Account.PlayerAsync() is not null;
        _allowed = _signedIn && await Account.AllowsAsync(ProFeature.Assistant);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Popover && !_focused && _allowed is not null)
        {
            _focused = true;
            try
            {
                if (_allowed is true)
                {
                    await _input.FocusAsync();
                }
            }
            catch (InvalidOperationException)
            {
            }
        }
    }

    private async Task SubmitAsync()
    {
        string question = _draft.Trim();
        _draft = "";
        await AskAsync(question);
    }

    private async Task AskAsync(string question)
    {
        if (_allowed is true && question.Length > 0)
        {
            await Asked.InvokeAsync(question);
        }
    }

    private void Toggle(string item)
    {
        if (!_removed.Remove(item))
        {
            _removed.Add(item);
        }
    }
}
