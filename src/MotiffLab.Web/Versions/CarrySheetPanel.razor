@using MotiffLab.MusicCore.Assembly
@inject MotiffLab.Web.Localization.UiText Text

@* The carry sheet (0024, section 5; mockups 05 and 07): what the carry will do, before it is done, in the same six lines every
   time, and from a recording a line first on how to get the notes: ? a choice, ! the music around changes, ✓ nothing changes.
   The choices sit in their lines as chips; the ghost is on the page. *@
<aside class="sheet inspector carry-sheet" aria-labelledby="carry-title" data-keeps-selection data-menu-clear="auto">
    <header class="check-head">
        <div>
            <p class="overline">@Text.Format("assembly.sheetOverline", Number)</p>
            <h2 id="carry-title"><span class="dot tone-@Tone" aria-hidden="true"></span> @Sheet.Title</h2>
            <p class="caption">@Sheet.Route · @Text["assembly.ghostShown"]</p>
        </div>
        <button class="btn icon" aria-label="@Text["assembly.cancel"]" title="@Text["assembly.cancel"]" @onclick="Cancel"><Icon Name="close" /></button>
    </header>
    <ul class="sheet-lines" aria-label="@Text["assembly.sheetLines"]">
        @foreach (SheetLine line in Sheet.Lines)
        {
            <li class="sheet-line @Mark(line.Mark)">
                <span class="mark" aria-label="@Text[$"assembly.mark.{Mark(line.Mark)}"]">@Glyph(line.Mark)</span>
                <div>
                    @if (line.Name == "how" && Sheet.KeepText is { } keep && Sheet.HeardText is { } heard)
                    {
                        <strong>@line.Label:</strong>
                        <span class="choices stacked" role="radiogroup" aria-label="@line.Label">
                            <button class="chip @(Keep ? "on" : null)" role="radio" aria-checked="@(Keep ? "true" : "false")" @onclick="() => ChooseKeep.InvokeAsync(true)">@keep</button>
                            <button class="chip @(Keep ? null : "on")" role="radio" aria-checked="@(Keep ? "false" : "true")" @onclick="() => ChooseKeep.InvokeAsync(false)">@heard</button>
                        </span>
                    }
                    else if (line.Name == "where")
                    {
                        <strong>@line.Label:</strong>
                        <span class="choices" role="radiogroup" aria-label="@line.Label">
                            @if (Sheet.ReplaceText is { } replace)
                            {
                                <button class="chip @(Insert ? null : "on")" role="radio" aria-checked="@(Insert ? "false" : "true")" @onclick="() => ChooseInsert.InvokeAsync(false)">@replace</button>
                            }
                            <button class="chip @(Insert || Sheet.ReplaceText is null ? "on" : null)" role="radio" aria-checked="@(Insert || Sheet.ReplaceText is null ? "true" : "false")"
                                    @onclick="() => ChooseInsert.InvokeAsync(true)">@Sheet.InsertText</button>
                        </span>
                    }
                    else
                    {
                        <strong>@($"{line.Label}: ")</strong>@line.Text
                        @if (line.Name == "key" && Sheet.KeyText is { } transposed)
                        {
                            <span class="choices" role="radiogroup" aria-label="@line.Label">
                                <button class="chip @(Transpose == 0 ? "on" : null)" role="radio" aria-checked="@(Transpose == 0 ? "true" : "false")" @onclick="() => ChooseTranspose.InvokeAsync(0)">@Text["assembly.asIs"]</button>
                                <button class="chip @(Transpose != 0 ? "on" : null)" role="radio" aria-checked="@(Transpose != 0 ? "true" : "false")"
                                        @onclick="() => ChooseTranspose.InvokeAsync(Sheet.SuggestedTranspose)">@transposed</button>
                            </span>
                        }
                    }
                </div>
            </li>
        }
    </ul>
    <footer class="carry-foot">
        <button class="btn quiet" @onclick="Hear"><Icon Name="@(Hearing ? "pause" : "play")" /> @Text["assembly.hearGhost"]</button>
        @if (HearRecording.HasDelegate)
        {
            <button class="btn quiet" @onclick="HearRecording"><Icon Name="@(HearingRecording ? "pause" : "mic")" /> @Text["recording.hearRecording"]</button>
        }
        <span class="sp"></span>
        <button class="btn quiet" @onclick="Cancel">@Text["assembly.cancel"]</button>
        <button class="btn primary" @onclick="Carry"><Icon Name="check" /> @Text["assembly.carry"]</button>
    </footer>
</aside>

@code {
    [Parameter, EditorRequired]
    public CarrySheet Sheet { get; set; } = default!;

    /// <summary>The number the carry will take in the journal.</summary>
    [Parameter]
    public int Number { get; set; }

    [Parameter]
    public string Tone { get; set; } = "plum";

    [Parameter]
    public bool Insert { get; set; }

    [Parameter]
    public int Transpose { get; set; }

    [Parameter]
    public bool Hearing { get; set; }

    /// <summary>From a recording: whether the notes stay and only what the performer plays otherwise is added.</summary>
    [Parameter]
    public bool Keep { get; set; }

    [Parameter]
    public EventCallback<bool> ChooseKeep { get; set; }

    [Parameter]
    public bool HearingRecording { get; set; }

    /// <summary>«Запись»: the fragment as the recording plays it; no delegate when its sound is not on this device.</summary>
    [Parameter]
    public EventCallback HearRecording { get; set; }

    [Parameter]
    public EventCallback<bool> ChooseInsert { get; set; }

    [Parameter]
    public EventCallback<int> ChooseTranspose { get; set; }

    [Parameter]
    public EventCallback Hear { get; set; }

    [Parameter]
    public EventCallback Cancel { get; set; }

    [Parameter]
    public EventCallback Carry { get; set; }

    /// <summary>The class and the screen reader's word for a line's mark.</summary>
    public static string Mark(SheetMark mark) => mark switch
    {
        SheetMark.Choice => "choice",
        SheetMark.Changes => "changes",
        _ => "same",
    };

    public static string Glyph(SheetMark mark) => mark switch
    {
        SheetMark.Choice => "?",
        SheetMark.Changes => "!",
        _ => "✓",
    };
}
