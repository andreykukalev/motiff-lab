@inject MotiffLab.Web.Localization.UiText Text
@using MotiffLab.Web.Playback

@* The pill while comparing (0024, section 6; mockups 00c and 13a): play, one chip per source (the name shows it, ▶ hears it),
   the loop and the tempo. Nothing over the notes: the chips are the tabs. *@
<div class="pill assembly-pill" role="toolbar" aria-label="@Text["assembly.pill"]" data-keeps-selection>
    <button class="play" @onclick="TogglePlay" aria-label="@(Playing ? Text["transport.pause"] : Text["transport.play"])">
        <Icon Name="@(Playing ? "pause" : "playf")" />
    </button>
    <div class="chips" role="radiogroup" aria-label="@Text["assembly.sources"]">
        @foreach (AssemblyChip chip in Chips)
        {
            <span class="source-chip tone-@chip.Tone @(chip.Shown ? "shown" : null) @(chip.Heard ? "heard" : null)">
                <button class="name" role="radio" aria-checked="@(chip.Shown ? "true" : "false")" title="@($"{chip.Name} ({chip.Key})")" @onclick="() => Show.InvokeAsync(chip.Id)">
                    <span class="dot" aria-hidden="true"></span>
                    <span class="label">@chip.Name</span>
                    @if (chip.Detail is { } detail)
                    {
                        <span class="detail">· @detail</span>
                    }
                </button>
                <button class="hear" aria-label="@Text.Format(chip.Heard ? "assembly.stopSource" : "assembly.hearSource", chip.Name)" title="@Text.Format(chip.Heard ? "assembly.stopSource" : "assembly.hearSource", chip.Name)"
                        @onclick="() => Hear.InvokeAsync(chip.Id)"><Icon Name="@(chip.Heard ? "pause" : "playf")" Size="IconSize.Small" /></button>
            </span>
        }
    </div>
    <span class="div" aria-hidden="true"></span>
    <button class="it @(Looping ? "on" : null)" aria-pressed="@(Looping ? "true" : "false")" @onclick="ToggleLoop"><Icon Name="loop" /> @Text["focus.loop"]</button>
    @* The tempo changes here too (version 0.5.4), except while the recording itself is heard: it plays at its own speed. *@
    @if (HearingRecording || !SetTempoPercent.HasDelegate)
    {
        <span class="it tempo-read mono" title="@Text["transport.tempo"]"><Icon Name="dial" /> @TempoPercent%</span>
    }
    else
    {
        <span class="anchor">
            <button class="it @(_tempoOpen ? "on" : null)" aria-expanded="@(_tempoOpen ? "true" : "false")" aria-label="@Text.Format("pill.tempoLabel", TempoPercent)"
                    @onclick="() => _tempoOpen = !_tempoOpen"><Icon Name="dial" /> <span class="mono tempo-label">@(Tempo is { } reading ? Text.Format("tempoControl.reading", TempoPercent, reading.HeardText(TempoPercent)) : $"{TempoPercent}%")</span></button>
            @if (_tempoOpen)
            {
                <div class="popover pill-popover" role="dialog" aria-label="@Text["transport.tempo"]">
                    <TempoControl Percent="TempoPercent" Reading="Tempo" SetPercent="SetTempoPercent" Close="() => _tempoOpen = false" />
                </div>
            }
        </span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<AssemblyChip> Chips { get; set; } = [];

    [Parameter]
    public bool Playing { get; set; }

    [Parameter]
    public bool Looping { get; set; }

    [Parameter]
    public int TempoPercent { get; set; } = 100;

    /// <summary>The piece's tempo for the control; null shows the percentage alone.</summary>
    [Parameter]
    public MotiffLab.Web.Playback.TempoReading? Tempo { get; set; }

    /// <summary>Whether the recording's own sound plays: its speed is its own, so the tempo is shown, not changed.</summary>
    [Parameter]
    public bool HearingRecording { get; set; }

    /// <summary>The playback tempo chosen, 25 % to 150 %.</summary>
    [Parameter]
    public EventCallback<int> SetTempoPercent { get; set; }

    private bool _tempoOpen;

    [Parameter]
    public EventCallback TogglePlay { get; set; }

    [Parameter]
    public EventCallback ToggleLoop { get; set; }

    [Parameter]
    public EventCallback<string> Show { get; set; }

    [Parameter]
    public EventCallback<string> Hear { get; set; }
}
