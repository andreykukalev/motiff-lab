@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Events
@using MotiffLab.MusicCore.Motifs
@using MotiffLab.MusicCore.Time
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject MotiffLab.Web.Localization.UiText Text

@* The piece as phrases (S1-I5, #18): the phrases music-core suggests, each marked with how its start was found, to pick
   as the working context, and the player's own boundaries; previous and next phrase by touch and with Page Up and Page Down (#126),
   and the selection run on into a neighbouring phrase. It only displays the workspace state (0013) and what PhraseMap returns; the page selects and saves. *@
<nav class="phrases" aria-label="@Text["workspace.phrases"]" data-keeps-selection>
    <div class="phrase-list" role="group" aria-label="@Text["phrases.ofPiece"]">
        <button class="step" aria-label="@Text["focus.previous"]" title="@Text["phrases.previousKey"]" disabled="@(Previous is null)" @onclick="() => StepAsync(-1)">‹</button>
        @foreach (Phrase phrase in Map.Phrases)
        {
            bool on = Current?.Number == phrase.Number;
            int kept = KeptCount?.Invoke(phrase) ?? 0;
            <button class="phrase @KindClass(phrase.Start) @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")"
                    aria-label="@(Label(phrase) + KeptText(kept))" title="@Title(phrase)" @onclick="() => Picked.InvokeAsync(phrase)">
                <span class="number">@phrase.Number</span>
                <span class="bars">@Bars(phrase)</span>
                <span class="how">@Tag(phrase.Start)</span>
                @if (kept > 0)
                {
                    <span class="kept-count" aria-hidden="true">@Text.Format("phrases.keptShort", kept)</span>
                }
            </button>
        }
        <button class="step" aria-label="@Text["focus.next"]" title="@Text["phrases.nextKey"]" disabled="@(Next is null)" @onclick="() => StepAsync(1)">›</button>
    </div>
    @* The boundary and transition tools fold away (0012), so the strip is one row of phrases to pick. *@
    <div class="row phrase-more">
        <button class="section-toggle" aria-expanded="@(_adjusting ? "true" : "false")" @onclick="() => _adjusting = !_adjusting">
            <span class="caret" aria-hidden="true">@(_adjusting ? "▾" : "▸")</span>
            @Text["phrases.adjust"]
        </button>
    </div>
    @if (_adjusting)
    {
        <div class="row phrase-actions">
            <button @onclick="() => Make.InvokeAsync()" disabled="@(!CanMake)"
                    title="@Text[CanMake ? "phrases.makeHint" : "phrases.makeDisabled"]">
                @Text["phrases.make"]
            </button>
            <button @onclick="() => Join.InvokeAsync(Current!)" disabled="@(Current is null || Current.Number == Map.Phrases.Count)"
                    title="@Text["phrases.joinHint"]">
                @Text["phrases.join"]
            </button>
            <button @onclick="() => Reset.InvokeAsync()" disabled="@Map.Edits.IsEmpty" title="@Text["phrases.resetHint"]">
                @Text["phrases.reset"]
            </button>
        </div>
        <div class="row phrase-extend" role="group" aria-label="@Text["phrases.transition"]">
            <span class="meta">@Text["phrases.transition"]:</span>
            <button @onclick="() => Extend.InvokeAsync(-1)" disabled="@(!CanExtendBack)"
                    title="@Text["phrases.addPreviousHint"]">
                @Text["phrases.addPrevious"]
            </button>
            <button @onclick="() => Extend.InvokeAsync(1)" disabled="@(!CanExtendOn)"
                    title="@Text["phrases.addNextHint"]">
                @Text["phrases.addNext"]
            </button>
        </div>
    }
    @if (EvidenceText is { } note)
    {
        <p class="meta">@note</p>
    }
</nav>

@code {
    /// <summary>The shared workspace state the page cascades; the strip reads its selection.</summary>
    [CascadingParameter]
    public WorkspaceState State { get; set; } = null!;

    /// <summary>The piece's phrases with the player's edits. The page shows the strip only once there is a map.</summary>
    private PhraseMap Map => State.Selection.Phrases!;

    /// <summary>The phrase the selection stands for, or null when the selection is another range or there is none.</summary>
    private Phrase? Current => State.Selection.Phrase;

    /// <summary>Whether there is a selection that could become a phrase.</summary>
    private bool CanMake => State.Selection.CanMakePhrase;

    /// <summary>How many observations the player kept about a phrase (#78), shown on its chip; null shows none.</summary>
    [Parameter]
    public Func<Phrase, int>? KeptCount { get; set; }

    [Parameter]
    public EventCallback<Phrase> Picked { get; set; }

    [Parameter]
    public EventCallback Make { get; set; }

    [Parameter]
    public EventCallback<Phrase> Join { get; set; }

    [Parameter]
    public EventCallback Reset { get; set; }

    /// <summary>The phrase before the selection's, which Previous phrase and Page Up select; null at the start.</summary>
    private Phrase? Previous => State.Selection.Previous;

    /// <summary>The phrase after the selection's, which Next phrase and Page Down select; null at the end.</summary>
    private Phrase? Next => State.Selection.Next;

    /// <summary>Whether the selection can run back into the phrase before it.</summary>
    [Parameter]
    public bool CanExtendBack { get; set; }

    /// <summary>Whether the selection can run on into the phrase after it.</summary>
    [Parameter]
    public bool CanExtendOn { get; set; }

    /// <summary>-1 to add the previous phrase to the selection, 1 to add the next.</summary>
    [Parameter]
    public EventCallback<int> Extend { get; set; }

    /// <summary>Whether the boundary and transition tools are shown.</summary>
    private bool _adjusting;

    private IJSObjectReference? _keys;
    private DotNetObjectReference<PhraseStrip>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/phrases/phrase-keys.js");
            _keys = await module.InvokeAsync<IJSObjectReference>("listen", _self);
            await module.DisposeAsync();
        }
    }

    /// <summary>Selects the previous (-1) or next (1) phrase, from the buttons or from Page Up and Page Down.</summary>
    [JSInvokable]
    public Task StepAsync(int direction) =>
        (direction < 0 ? Previous : Next) is { } phrase ? Picked.InvokeAsync(phrase) : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_keys is not null)
        {
            try
            {
                await _keys.InvokeVoidAsync("dispose");
                await _keys.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going away; its listener goes with it.
            }
        }

        _self?.Dispose();
    }

    /// <summary>What the file says about its phrases when it says little, so the player knows to choose bars instead.</summary>
    private string? EvidenceText => Map.Evidence switch
    {
        PhraseEvidenceLevel.None when Map.Edits.IsEmpty => Text["phrases.noEvidence"],
        PhraseEvidenceLevel.None => Text["phrases.yoursOnly"],
        PhraseEvidenceLevel.Partial when Map.Phrases.FirstOrDefault(phrase => !phrase.FitsSelection) is { } longest =>
            Text.Format("phrases.tooLong", longest.Number, longest.BarCount, MotifSelection.MaxBars),
        _ => null,
    };

    private string Bars(Phrase phrase) =>
        phrase.FirstBar == phrase.LastBar ? Text.Format("bars.one", phrase.FirstBar) : Text.Format("bars.range", phrase.FirstBar, phrase.LastBar);

    /// <summary>"Phrase 2, bars 3–4, starts after a rest of a beat or more, inferred".</summary>
    private string Label(Phrase phrase) => Text.Format("phrases.label", phrase.Number, Bars(phrase), Describe(phrase.Start));

    private string KeptText(int kept) => kept == 0 ? "" : ", " + Text.Format("phrases.keptShort", kept);

    private string Title(Phrase phrase) =>
        phrase.FitsSelection
            ? Text.Format("phrases.starts", Describe(phrase.Start))
            : Text.Format("phrases.startsLong", Describe(phrase.Start), phrase.BarCount, MotifSelection.MaxBars);

    /// <summary>How the start was found, with "inferred" and its confidence when it is a reading of the notes.</summary>
    private string Describe(PhraseBoundary? start) =>
        start?.Attribution is { Provenance: Provenance.Inferred or Provenance.Detected } attribution
            ? Text.Format("phrases.inferred", PhraseMap.Describe(start, Words), (int)Math.Round(attribution.Confidence * 100))
            : PhraseMap.Describe(start, Words);

    private MotiffLab.MusicCore.Words Words => MotiffLab.MusicCore.Words.For(Text.Language);

    /// <summary>The short tag on the chip: "slur", "rest", "repeat sign", "comes back", "yours", or "start" for the first phrase.</summary>
    private string Tag(PhraseBoundary? start) => start switch
    {
        null => Text["phrases.tag.start"],
        { Attribution.Provenance: Provenance.UserEdited } => Text["phrases.tag.yours"],
        { Evidence: var evidence } => string.Join(" + ", evidence.Select(mark => mark switch
        {
            PhraseEvidence.Slur => Text["phrases.tag.slur"],
            PhraseEvidence.Rest => Text["phrases.tag.rest"],
            PhraseEvidence.RepeatSign => Text["phrases.tag.repeat"],
            PhraseEvidence.Repetition => Text["phrases.tag.comesBack"],
            _ => mark.ToString().ToLowerInvariant(),
        })) + (start.Attribution.Provenance == Provenance.UserConfirmed ? " ✓" : ""),
    };

    /// <summary>Certainty by line as well as colour (docs/ui-conventions.md): solid for marks in the file and the player's own, dashed for inferred.</summary>
    internal static string KindClass(PhraseBoundary? start) => start?.Attribution.Provenance switch
    {
        null => "start",
        Provenance.UserEdited or Provenance.UserConfirmed => "yours",
        Provenance.Inferred or Provenance.Detected => "inferred",
        _ => "imported",
    };
}
