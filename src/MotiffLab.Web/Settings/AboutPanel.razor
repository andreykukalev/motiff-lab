@using System.Globalization
@inject MotiffLab.Web.Localization.UiText Text
@inject MotiffLab.Web.Account.OnlineProjects Online
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Settings · About (Andrei, 2026-11-13): which build this is, to tell that the latest version is here (BuildInfo, written at
   build time by MotiffLab.Web.csproj), and where it works. On the web test site only, «Очистить всё»: for a new testing
   cycle, the player's data in the test database and an empty library in this browser, and every other device of theirs
   clears its own test library at its next sync (Account/TestReset.cs, Scripts/storage/test-library.ts; infra/README.md,
   "A fresh testing cycle"). *@
<div class="set-row">
    <span class="label">@Text["about.version"]</span>
    <span class="about-value">@VersionText</span>
</div>
@if (BuildInfo.Commit.Length > 0)
{
    <div class="set-row">
        <span class="label">@Text["about.commit"]</span>
        <span class="about-value">@BuildInfo.Commit</span>
    </div>
}
@if (DateText is { } date)
{
    <div class="set-row">
        <span class="label">@Text["about.built"]</span>
        <span class="about-value">@date</span>
    </div>
}
@if (_environment is { } environment)
{
    <div class="set-row">
        <span class="label">@Text["about.environment"]</span>
        <span class="about-value">
            @Text[environment]
            @if (_testSite)
            {
                <span class="env-mark" aria-label="@Text["environment.markLabel"]">@Text["environment.mark"]</span>
            }
        </span>
    </div>
}
@if (_testSite)
{
    <div class="set-row column test-library">
        @if (_confirming)
        {
            <p class="label" id="test-library-title">@Text["testLibrary.confirmTitle"]</p>
            <p class="caption" id="test-library-message">@Text["testLibrary.webConfirmMessage"]</p>
            <div class="row danger" role="group" aria-labelledby="test-library-title" aria-describedby="test-library-message">
                <button class="destructive" disabled="@_clearing" @onclick="ClearAsync">@Text["testLibrary.confirm"]</button>
                <button disabled="@_clearing" @onclick="() => _confirming = false">@Text["common.cancel"]</button>
            </div>
        }
        else
        {
            <button class="destructive" @onclick="() => { _confirming = true; _message = null; }">@Text["testLibrary.clear"]</button>
            <p class="caption">@Text["testLibrary.webHint"]</p>
        }
        @if (_message is not null)
        {
            <p class="caption problem" role="status">@_message</p>
        }
    </div>
}

@code {
    private IJSObjectReference? _module;
    private bool _testSite;
    private string? _environment;
    private bool _confirming;
    private bool _clearing;
    private string? _message;

    /// <summary>The tag it was built from ("v0.5.2"), else VERSION with the branch ("0.5.1 · develop"); "dev" without either.</summary>
    private static string VersionText
    {
        get
        {
            if (BuildInfo.Tag.Length > 0)
            {
                return BuildInfo.Tag;
            }

            string branch = BuildInfo.Branch is "HEAD" ? "" : BuildInfo.Branch;
            string[] parts = [.. new[] { BuildInfo.Version, branch }.Where(part => part.Length > 0)];
            return parts.Length > 0 ? string.Join(" · ", parts) : "dev";
        }
    }

    /// <summary>The commit's date and time in the interface language; null when the build had no git.</summary>
    private string? DateText => DateTimeOffset.TryParse(BuildInfo.Date, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTimeOffset date)
        ? date.ToLocalTime().ToString("g", Text.Culture)
        : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/storage/test-library.js");
            string site = await _module.InvokeAsync<string>("siteKind");
            _testSite = site == "test";
            _environment = site switch
            {
                "test" => "environment.test",
                "local" => "about.environmentLocal",
                _ => "environment.main",
            };
        }
        catch (JSException)
        {
            _environment = null;
        }
    }

    /// <summary>The player's copies in the test database first, so the sync brings nothing back; then this browser's library, and a fresh page.</summary>
    private async Task ClearAsync()
    {
        if (_module is null || !_testSite)
        {
            return;
        }

        _clearing = true;
        _message = null;
        MotiffLab.Web.Account.TestCopies online = await Online.DeleteTestCopiesAsync();
        if (online is MotiffLab.Web.Account.TestCopies.Failed or MotiffLab.Web.Account.TestCopies.NotDevelop)
        {
            _message = Text[online == MotiffLab.Web.Account.TestCopies.Failed ? "testLibrary.onlineFailed" : "testLibrary.notDevelop"];
            _clearing = false;
            return;
        }

        try
        {
            await _module.InvokeAsync<int>("clearTestLibrary");
            await _module.InvokeVoidAsync("reloadPage");
        }
        catch (JSException)
        {
            _message = Text["testLibrary.webFailed"];
            _clearing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
