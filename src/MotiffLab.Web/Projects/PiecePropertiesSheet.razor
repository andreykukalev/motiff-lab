@using MotiffLab.MusicCore.Projects
@using MotiffLab.Web.Localization

@* A piece's properties (version 0.2, ux-prototype/v2/screens/lib-4-props.png): its title; its composer, with the composers
   already in the library offered while typing; its tags as chips, each taken off by its ✕ and a new one added with «+ tag»
   (or picked from the library's); and the playlists it is on, ticked, with «New playlist». What is typed is the player's; a
   field left empty shows what the file says again, named in its placeholder. Done keeps it in the project; Escape or a tap
   outside leaves it as it was. *@
<section class="lib-sheet props-sheet" role="dialog" aria-modal="true" aria-labelledby="props-title" tabindex="-1" @ref="_sheet" @onkeydown="OnKey">
    <header class="hd">
        <h2 class="ttl" id="props-title">@Text["library.properties"]</h2>
        <button class="btn primary" @onclick="SaveAsync" disabled="@_saving">@Text["library.done"]</button>
    </header>

    <label class="field">
        <span class="caption">@Text["library.fieldTitle"]</span>
        <input type="text" maxlength="200" @bind="_title" @bind:event="oninput" placeholder="@_fromFile.Title.Value" @ref="_first" />
    </label>
    <div class="field">
        <label class="field">
            <span class="caption">@Text["library.fieldComposer"]</span>
            <input type="text" maxlength="200" autocomplete="off" @bind="_composer" @bind:event="oninput" placeholder="@(_fromFile.Composer?.Value ?? Text["library.composerNone"])" />
        </label>
        @if (LibraryShelf.ComposerSuggestions(_composer, LibraryComposers) is { Count: > 0 } offered)
        {
            <ul class="suggest" aria-label="@Text["library.fieldComposer"]">
                @foreach (string composer in offered)
                {
                    <li @key="composer"><button @onclick="() => _composer = composer"><span class="name">@composer</span><span class="caption">@Text["library.inLibrary"]</span></button></li>
                }
            </ul>
        }
    </div>

    <fieldset class="field">
        <legend class="caption">@Text["library.fieldTags"]</legend>
        <ul class="chips">
            @foreach (string tag in _tags)
            {
                <li class="chip" @key="tag">
                    <span>@tag</span>
                    <button class="chip-x" aria-label="@Text.Format("library.removeTag", tag)" title="@Text.Format("library.removeTag", tag)" @onclick="() => _tags.Remove(tag)"><Icon Name="close" Size="IconSize.Small" /></button>
                </li>
            }
            <li>
                @if (_addingTag)
                {
                    <input class="chip-input" type="text" maxlength="60" @bind="_newTag" @bind:event="oninput" @onkeydown="OnTagKey" @onkeydown:stopPropagation="true"
                           aria-label="@Text["library.newTag"]" placeholder="@Text["library.newTag"]" @ref="_tagInput" />
                }
                else
                {
                    <button class="chip add" aria-label="@Text["library.newTag"]" @onclick="StartTag"><Icon Name="plus" Size="IconSize.Small" />@Text["library.tagChip"]</button>
                }
            </li>
        </ul>
        @if (_addingTag && TagSuggestions.Count > 0)
        {
            <ul class="chips" aria-label="@Text["library.libraryTags"]">
                @foreach (string tag in TagSuggestions)
                {
                    <li @key="tag"><button class="chip" @onclick="() => AddTag(tag)" aria-label="@Text.Format("library.addTagNamed", tag)"><Icon Name="plus" Size="IconSize.Small" /> @tag</button></li>
                }
            </ul>
        }
    </fieldset>

    <fieldset class="field playlists">
        <legend class="caption">@Text["library.fieldPlaylists"]</legend>
        @foreach (string playlist in _known)
        {
            bool on = _playlists.Contains(playlist, StringComparer.OrdinalIgnoreCase);
            <label class="check" @key="playlist">
                <input type="checkbox" checked="@on" @onchange="change => Tick(playlist, change.Value is true)" />
                <span>@playlist</span>
            </label>
        }
        @if (_addingPlaylist)
        {
            <input type="text" maxlength="80" @bind="_newPlaylist" @bind:event="oninput" @onkeydown="OnPlaylistKey" @onkeydown:stopPropagation="true"
                   aria-label="@Text["library.playlistName"]" placeholder="@Text["library.playlistName"]" @ref="_playlistInput" />
        }
        else
        {
            <button class="btn quiet new-playlist" @onclick="StartPlaylist"><Icon Name="plus" /> @Text["library.newPlaylist"]</button>
        }
    </fieldset>
</section>

@code {
    [Inject]
    private UiText Text { get; set; } = default!;

    /// <summary>The piece as saved: what the player set, and what its file says.</summary>
    [Parameter, EditorRequired]
    public Project Project { get; set; } = default!;

    /// <summary>Every composer on the shelf, to offer while typing.</summary>
    [Parameter]
    public IReadOnlyList<string> LibraryComposers { get; set; } = [];

    /// <summary>Every tag on the shelf, to pick from.</summary>
    [Parameter]
    public IReadOnlyList<string> LibraryTags { get; set; } = [];

    /// <summary>Every playlist on the shelf, to tick.</summary>
    [Parameter]
    public IReadOnlyList<string> LibraryPlaylists { get; set; } = [];

    [Parameter]
    public EventCallback<PieceMetadata> Saved { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    private ElementReference _sheet;
    private ElementReference _first;
    private ElementReference _tagInput;
    private ElementReference _playlistInput;
    private PieceDetails _fromFile = default!;
    private string? _title;
    private string? _composer;
    private string? _newTag;
    private string? _newPlaylist;
    private List<string> _tags = [];
    private List<string> _playlists = [];
    private List<string> _known = [];
    private bool _addingTag;
    private bool _addingPlaylist;
    private Field _focus;
    private bool _saving;
    private string? _for;

    /// <summary>The library's tags not on this piece yet, narrowed to what is typed in the new tag.</summary>
    private IReadOnlyList<string> TagSuggestions =>
        [.. LibraryTags.Where(tag => !_tags.Contains(tag, StringComparer.OrdinalIgnoreCase)
            && (PieceMetadata.Clean(_newTag) is not { } typed || LibraryShelf.Fold(tag).Contains(LibraryShelf.Fold(typed), StringComparison.Ordinal)))];

    protected override void OnParametersSet()
    {
        if (_for == Project.Id)
        {
            return;
        }

        _for = Project.Id;
        _fromFile = (Project with { Metadata = PieceMetadata.None }).Details;
        _title = Project.Metadata.Title;
        _composer = Project.Metadata.Composer;
        _tags = [.. Project.Metadata.Tags];
        _playlists = [.. Project.Metadata.Playlists];
        _known = [.. LibraryPlaylists];
        _known.AddRange(_playlists.Where(playlist => !_known.Contains(playlist, StringComparer.OrdinalIgnoreCase)));
        _newTag = null;
        _newPlaylist = null;
        _focus = Field.Title;
    }

    /// <summary>The field to focus once it is on the page: the title when the sheet opens, a new tag's or playlist's when its button gives way to it.</summary>
    private enum Field
    {
        None,
        Title,
        Tag,
        Playlist,
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        ElementReference? field = _focus switch
        {
            Field.Title => _first,
            Field.Tag => _tagInput,
            Field.Playlist => _playlistInput,
            _ => null,
        };
        _focus = Field.None;
        if (field is { } shown)
        {
            try
            {
                await shown.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // Not on the page yet.
            }
        }
    }

    private void StartTag()
    {
        _addingTag = true;
        _focus = Field.Tag;
    }

    private void StartPlaylist()
    {
        _addingPlaylist = true;
        _focus = Field.Playlist;
    }

    private void AddTag(string tag)
    {
        if (PieceMetadata.Clean(tag) is not { } clean)
        {
            return;
        }

        // A tag the library has in another letter case is taken as the library writes it.
        string named = LibraryTags.FirstOrDefault(each => string.Equals(each, clean, StringComparison.OrdinalIgnoreCase)) ?? clean;
        if (!_tags.Contains(named, StringComparer.OrdinalIgnoreCase))
        {
            _tags.Add(named);
        }

        _newTag = null;
    }

    private void AddPlaylist(string? typed)
    {
        if (PieceMetadata.Clean(typed) is { } clean)
        {
            string named = _known.FirstOrDefault(each => string.Equals(each, clean, StringComparison.OrdinalIgnoreCase)) ?? clean;
            if (!_known.Contains(named, StringComparer.OrdinalIgnoreCase))
            {
                _known.Add(named);
            }

            Tick(named, true);
        }

        _newPlaylist = null;
    }

    private void Tick(string playlist, bool on)
    {
        _playlists.RemoveAll(each => string.Equals(each, playlist, StringComparison.OrdinalIgnoreCase));
        if (on)
        {
            _playlists.Add(playlist);
        }
    }

    private void OnTagKey(KeyboardEventArgs key)
    {
        if (key.Key == "Enter")
        {
            AddTag(_newTag ?? "");
        }
        else if (key.Key == "Escape")
        {
            _addingTag = false;
            _newTag = null;
        }
    }

    private void OnPlaylistKey(KeyboardEventArgs key)
    {
        if (key.Key == "Enter")
        {
            AddPlaylist(_newPlaylist);
            _addingPlaylist = false;
        }
        else if (key.Key == "Escape")
        {
            _addingPlaylist = false;
            _newPlaylist = null;
        }
    }

    private async Task OnKey(KeyboardEventArgs key)
    {
        if (key.Key == "Escape")
        {
            await Closed.InvokeAsync();
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            AddTag(_newTag ?? "");
            AddPlaylist(_newPlaylist);
            await Saved.InvokeAsync(new PieceMetadata(_title, _composer, _tags, _playlists));
        }
        finally
        {
            _saving = false;
        }
    }
}
