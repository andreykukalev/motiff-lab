@using MotiffLab.Web.Localization

@* The library's search, order, view and filters (version 0.2), for a shelf of a couple of hundred pieces. Search finds
   words in the title, the composer and the tags, whatever their case and accents; a composer and a tag can be picked as
   chips, one of each; the count says how many pieces show, and when none does, the way back to all of them. *@
<div class="lib-tools">
    <label class="search">
        <Icon Name="search" />
        <span class="visually-hidden">@Text["library.search"]</span>
        <input type="search" value="@State.Query.Search" placeholder="@Text["library.searchHint"]" aria-label="@Text["library.search"]"
               @oninput="change => NarrowAsync(State.Query with { Search = change.Value as string })" />
    </label>
    <label class="sort">
        <span class="caption">@Text["library.sort"]</span>
        <select @onchange="change => NarrowAsync(State.Query with { Sort = Enum.TryParse(change.Value as string, out LibrarySort sort) ? sort : LibrarySort.Recent })">
            @foreach (LibrarySort sort in Enum.GetValues<LibrarySort>())
            {
                <option value="@sort" selected="@(State.Query.Sort == sort)">@SortLabel(sort)</option>
            }
        </select>
    </label>
    <div class="view-switch" role="group" aria-label="@Text["library.view"]">
        @foreach (LibraryView view in Enum.GetValues<LibraryView>())
        {
            <button class="seg @(State.View == view ? "on" : null)" aria-pressed="@(State.View == view ? "true" : "false")" @onclick="() => ChooseAsync(view)">@(view == LibraryView.List ? Text["library.viewList"] : Text["library.viewCards"])</button>
        }
    </div>
</div>

@if (State.Composers.Count > 0)
{
    <div class="chip-row" role="group" aria-label="@Text["library.byComposer"]">
        <span class="caption">@Text["library.byComposer"]</span>
        @foreach (string composer in State.Composers)
        {
            bool on = string.Equals(State.Query.Composer, composer, StringComparison.OrdinalIgnoreCase);
            <button class="chip @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @key="composer"
                    @onclick="() => NarrowAsync(State.Query with { Composer = on ? null : composer })">@composer</button>
        }
    </div>
}

@if (State.Tags.Count > 0)
{
    <div class="chip-row" role="group" aria-label="@Text["library.byTag"]">
        <span class="caption">@Text["library.byTag"]</span>
        @foreach (string tag in State.Tags)
        {
            bool on = string.Equals(State.Query.Tag, tag, StringComparison.OrdinalIgnoreCase);
            <button class="chip @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @key="tag"
                    @onclick="() => NarrowAsync(State.Query with { Tag = on ? null : tag })"><Icon Name="tag" /> @tag</button>
        }
    </div>
}

<p class="meta lib-count" role="status">@(State.Query.Narrows ? Text.Format("library.shownOf", State.Shown.Count, State.Entries.Count) : Text.Count("library.pieces", State.Entries.Count))</p>

@if (State.NoneMatch)
{
    <div class="lib-none">
        <p class="lead">@Text["library.noneMatch"]</p>
        <button class="btn secondary" @onclick="ClearAsync">@Text["library.clearFilters"]</button>
    </div>
}

@code {
    [Inject]
    private UiText Text { get; set; } = default!;

    /// <summary>The shelf this narrows and orders, changed in place.</summary>
    [Parameter, EditorRequired]
    public LibraryShelfState State { get; set; } = default!;

    /// <summary>Called after each change, so the page shows the shelf again.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private Task NarrowAsync(LibraryQuery query)
    {
        State.Narrow(query);
        return Changed.InvokeAsync();
    }

    private Task ClearAsync()
    {
        State.ClearFilters();
        return Changed.InvokeAsync();
    }

    private async Task ChooseAsync(LibraryView view)
    {
        await State.ChooseAsync(view);
        await Changed.InvokeAsync();
    }

    private string SortLabel(LibrarySort sort) => sort switch
    {
        LibrarySort.Title => Text["library.sortTitle"],
        LibrarySort.Composer => Text["library.sortComposer"],
        _ => Text["library.sortRecent"],
    };
}
