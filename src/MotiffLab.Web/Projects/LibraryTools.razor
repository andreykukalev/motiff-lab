@using MotiffLab.Web.Localization

@* The library's tabs (version 0.2, ux-prototype/v2/screens/lib-1-list.png) in Andrei's order, with the Composer, Tag and
   Playlist filters at their right on the tabs that list pieces; on Composers and Playlists, once one is opened, the way back
   to all of them. *@
<div class="lib-tabs">
    <div class="tabs" role="tablist" aria-label="@Text["library.title"]">
        @foreach (LibraryTab tab in Enum.GetValues<LibraryTab>())
        {
            bool on = State.Tab == tab;
            <button class="tab @(on ? "on" : null)" role="tab" aria-selected="@(on ? "true" : "false")" @key="tab" @onclick="() => ChooseAsync(tab)">@TabLabel(tab)</button>
        }
    </div>
    @if (State.Filters)
    {
        <div class="filters">
            @if (State.Composers.Count > 0)
            {
                <LibraryFilter Label="@Text["library.byComposer"]" All="@Text["library.anyComposer"]" Values="State.Composers" Picked="@State.Query.Composer"
                               Chosen="composer => NarrowAsync(State.Query with { Composer = composer })" />
            }
            @if (State.Tags.Count > 0)
            {
                <LibraryFilter Label="@Text["library.byTag"]" All="@Text["library.anyTag"]" Values="State.Tags" Picked="@State.Query.Tag"
                               Chosen="tag => NarrowAsync(State.Query with { Tag = tag })" />
            }
            @if (State.Playlists.Count > 0)
            {
                <LibraryFilter Label="@Text["library.byPlaylist"]" All="@Text["library.anyPlaylist"]" Values="State.Playlists" Picked="@State.Query.Playlist"
                               Chosen="playlist => NarrowAsync(State.Query with { Playlist = playlist })" />
            }
            @if (_withoutNotes && (State.Query.WithoutNotes || State.Entries.Any(static entry => entry.Summary.Origin == MotiffLab.MusicCore.Projects.PieceOrigin.Pdf)))
            {
                @* «Без нот» (version 0.5, import-web-5): the PDF pieces whose notes are not read yet. *@
                <button class="chip @(State.Query.WithoutNotes ? "on" : null)" aria-pressed="@(State.Query.WithoutNotes ? "true" : "false")"
                        @onclick="() => NarrowAsync(State.Query with { WithoutNotes = !State.Query.WithoutNotes })">@Text["library.withoutNotes"]</button>
            }
        </div>
    }
</div>

@if (State.Picked is { } picked)
{
    <div class="lib-picked">
        <button class="btn quiet back" @onclick="UnpickAsync"><Icon Name="back" /> @TabLabel(State.Tab)</button>
        <h2 class="ttl">@(picked.Name ?? Text["library.noComposer"])</h2>
    </div>
}

@if (State.Page.IsEmpty && State.Query.Narrows)
{
    <div class="lib-none">
        <p class="lead">@Text["library.noneMatch"]</p>
        <button class="btn secondary" @onclick="ClearAsync">@Text["library.clearFilters"]</button>
    </div>
}

@code {
    [Inject]
    private UiText Text { get; set; } = default!;

    [Inject]
    private MotiffLab.Web.Settings.DeviceSettings Settings { get; set; } = default!;

    private bool _withoutNotes;

    protected override async Task OnInitializedAsync()
    {
        await Settings.LoadAsync();
        _withoutNotes = Settings.IsOn(MotiffLab.Web.Library.ImportJob.Setting);
    }

    /// <summary>The shelf this narrows and orders, changed in place.</summary>
    [Parameter, EditorRequired]
    public LibraryShelfState State { get; set; } = default!;

    /// <summary>Called after each change, so the page shows the shelf again.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private Task NarrowAsync(LibraryQuery query)
    {
        State.Narrow(query);
        return Changed.InvokeAsync();
    }

    private Task ClearAsync()
    {
        State.ClearFilters();
        return Changed.InvokeAsync();
    }

    private Task UnpickAsync()
    {
        State.Pick(null);
        return Changed.InvokeAsync();
    }

    private async Task ChooseAsync(LibraryTab tab)
    {
        await State.ChooseAsync(tab);
        await Changed.InvokeAsync();
    }

    private string TabLabel(LibraryTab tab) => tab switch
    {
        LibraryTab.Composers => Text["library.tabComposers"],
        LibraryTab.Recent => Text["library.tabRecent"],
        LibraryTab.Playlists => Text["library.tabPlaylists"],
        LibraryTab.Sessions => Text["library.tabSessions"],
        _ => Text["library.tabAll"],
    };
}
