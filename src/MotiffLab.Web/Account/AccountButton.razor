@inject CloudAccount Account
@inject MotiffLab.Web.Localization.UiText Text
@implements IDisposable

@* The account and Settings at the top right, as in most apps (0014): Sign in while signed out, the player's initial once
   signed in, both leading to Settings. A build without sign-in shows Settings only. *@
<nav class="account-nav" aria-label="@Text["account.nav"]">
    @if (Account.IsAvailable && _loaded)
    {
        @if (_player is null)
        {
            <button class="primary" @onclick="() => Account.SignIn()">@Text["settings.signIn"]</button>
        }
        else
        {
            <a class="avatar" href="settings#account" title="@_player" aria-label="@Text.Format("account.open", _player)">@Initial(_player)</a>
        }
    }
    <a class="settings-link" href="settings" aria-label="@Text["settings.title"]" title="@Text["settings.title"]">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M19.4 13a7.5 7.5 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.6 7.6 0 0 0-1.7-1L15 3.3h-4l-.4 2.6a7.6 7.6 0 0 0-1.7 1l-2.5-1-2 3.5L4.6 11a7.5 7.5 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1a7.6 7.6 0 0 0 1.7 1l.4 2.6h4l.4-2.6a7.6 7.6 0 0 0 1.7-1l2.5 1 2-3.5L19.4 13zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" /></svg>
    </a>
</nav>

@code {
    private string? _player;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        Text.Changed += OnChanged;
        _player = await Account.PlayerAsync();
        _loaded = true;
    }

    /// <summary>The first letter or digit of the player's name or email, upper case; "?" when it has none.</summary>
    public static string Initial(string? player) =>
        player?.FirstOrDefault(char.IsLetterOrDigit) is char first and not '\0' ? char.ToUpperInvariant(first).ToString() : "?";

    public void Dispose() => Text.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
