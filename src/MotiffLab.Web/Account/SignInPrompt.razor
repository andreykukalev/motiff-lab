@inject CloudAccount Account
@inject MotiffLab.Web.Localization.UiText Labels

@* What needs an account says so in one line where it is, with Sign in next to it (0014). Creating an account is offered
   on the sign-in page and on Settings, so it is not repeated here. *@
<p class="sign-in-prompt">
    @Text
    <button class="link" @onclick="() => Account.SignIn()">@Labels["settings.signIn"]</button>
</p>
@code {
    /// <summary>What signing in gives here.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";
}
