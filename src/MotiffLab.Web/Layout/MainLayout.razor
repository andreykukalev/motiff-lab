@inherits LayoutComponentBase
@using MotiffLab.MusicCore.Analytics
@using MotiffLab.Web.Analytics
@inject UsageAnalytics Analytics

@Body

<footer class="site-footer">
    <nav aria-label="About Motiff Lab"><a href="settings">Settings</a> · <a href="privacy">Privacy</a> · <a href="terms">Terms of use</a></nav>
</footer>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The layout stays across pages, so this counts loads of the app, not pages (#64).
        if (firstRender)
        {
            await Analytics.TrackAsync(AnalyticsEvent.AppOpened());
        }
    }
}
