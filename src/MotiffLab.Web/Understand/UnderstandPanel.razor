@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Experiments

@* Understand (#25; S1-A1, S1-A2, S1-A4, S1-A5): the facts about the selection, one collapsible section per lens in FactLens order.
   A fact with places can be chosen to highlight them in the score and on the roll, one place at a time from its chips,
   and links to the experiments that rest on it. A new fact or a new lens from music-core shows up here without changes;
   the panel only displays, and the page highlights, plays and tries. *@
@if (Chosen is { } chosen)
{
    <div class="highlighted" role="group" aria-label="Highlighted in the score and on the roll">
        <p aria-live="polite">
            <strong>Highlighted:</strong> @chosen.Fact.Text
            <span class="meta">@(chosen.Place is { } place ? place.Label : Plural(chosen.Fact.Places.Count, "place")), in the score and on the roll.</span>
        </p>
        @if (!Facts.Contains(chosen.Fact))
        {
            <p class="meta">A fact about the passage the experiment was offered for.</p>
            @PlaceChips(chosen.Fact)
        }
        <button @onclick="() => Choose.InvokeAsync(null)">Clear highlight</button>
    </div>
}
@if (Facts.Count > 0)
{
    <div class="facts" role="group" aria-label="Facts about the selection">
        @foreach (FactLens lens in Enum.GetValues<FactLens>())
        {
            MotifFact[] facts = Facts.Where(fact => fact.Lens == lens).ToArray();
            if (facts.Length == 0)
            {
                continue;
            }

            bool open = !_collapsed.Contains(lens);
            <section class="lens-group">
                <button class="lens-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(lens)">
                    <span class="caret" aria-hidden="true">@(open ? "▾" : "▸")</span>
                    <span class="lens">@LensLabel(lens)</span>
                    <span class="count">@CountText(facts)</span>
                </button>
                @if (open)
                {
                    <ul>
                        @foreach (MotifFact fact in facts)
                        {
                            bool showBasis = _basisShown.Contains(fact.Id);
                            bool isChosen = Chosen?.Fact == fact;
                            <li title="@fact.Basis" class="@(isChosen ? "chosen" : null)">
                                <span class="certainty @fact.Certainty.ToString().ToLowerInvariant()">@CertaintyLabel(fact.Certainty)</span>
                                <div class="fact">
                                    @if (fact.Places.Count > 0)
                                    {
                                        <button class="fact-text" aria-pressed="@(isChosen ? "true" : "false")" @onclick="() => Choose.InvokeAsync(isChosen ? null : new FactChoice(fact))">
                                            @fact.Text <span class="where">@(isChosen ? "Shown" : "Show") @Plural(fact.Places.Count, "place")</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span>@fact.Text</span>
                                    }
                                    @if (showBasis)
                                    {
                                        <span class="basis">Basis: @fact.Basis</span>
                                    }
                                    @if (isChosen)
                                    {
                                        @PlaceChips(fact)
                                    }
                                    @foreach (Experiment experiment in ExperimentCatalogue.RestingOn(Offers, fact.Id))
                                    {
                                        <button class="try" @onclick="() => Try.InvokeAsync(experiment)" title="@experiment.Question">Try: @experiment.Title</button>
                                    }
                                </div>
                                <button class="basis-toggle" aria-expanded="@(showBasis ? "true" : "false")" @onclick="() => ToggleBasis(fact.Id)">@(showBasis ? "Hide basis" : "Basis")</button>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        <p class="meta">Detected: read from the notes or the file. Inferred: worked out by a rule. Uncertain: a guess on thin evidence. Basis shows why. Choose a fact that names places to see them in the score and on the roll.</p>
    </div>
}

@code {
    /// <summary>The lenses the player closed; they stay closed as the selection changes.</summary>
    private readonly HashSet<FactLens> _collapsed = [];

    /// <summary>The facts whose basis the player opened.</summary>
    private readonly HashSet<string> _basisShown = new(StringComparer.Ordinal);

    /// <summary>The facts to show, from any analysis, in the order music-core gives them within each lens.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MotifFact> Facts { get; set; } = [];

    /// <summary>The experiments offered for the same selection as <see cref="Facts"/>; each fact links to those resting on it.</summary>
    [Parameter]
    public IReadOnlyList<Experiment> Offers { get; set; } = [];

    /// <summary>The fact being highlighted, and its place when one was chosen; null for none.</summary>
    [Parameter]
    public FactChoice? Chosen { get; set; }

    /// <summary>Raised with the fact (and place) to highlight, or null to clear the highlight.</summary>
    [Parameter]
    public EventCallback<FactChoice?> Choose { get; set; }

    /// <summary>Raised with an experiment a fact links to, to try its first alternative.</summary>
    [Parameter]
    public EventCallback<Experiment> Try { get; set; }

    /// <summary>The places of a chosen fact as chips; a chip highlights only its place, and pressed again, all of them.</summary>
    private RenderFragment PlaceChips(MotifFact fact) =>
        @<div class="places" role="group" aria-label="Places">
            @foreach (FactPlace place in fact.Places)
            {
                bool on = Chosen?.Place == place;
                <button class="chip" aria-pressed="@(on ? "true" : "false")" title="Highlight only this place and move playback to its start."
                        @onclick="() => Choose.InvokeAsync(on ? new FactChoice(fact) : new FactChoice(fact, place))">@place.Label</button>
            }
        </div>;

    private void Toggle(FactLens lens)
    {
        if (!_collapsed.Remove(lens))
        {
            _collapsed.Add(lens);
        }
    }

    private void ToggleBasis(string id)
    {
        if (!_basisShown.Remove(id))
        {
            _basisShown.Add(id);
        }
    }

    private static string LensLabel(FactLens lens) => lens.ToString();

    private static string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    /// <summary>"4 facts: 3 detected, 1 inferred", so a closed section still says how sure it is.</summary>
    private static string CountText(MotifFact[] facts)
    {
        IEnumerable<string> parts = Enum.GetValues<FactCertainty>()
            .Select(certainty => (certainty, count: facts.Count(fact => fact.Certainty == certainty)))
            .Where(pair => pair.count > 0)
            .Select(pair => $"{pair.count} {CertaintyLabel(pair.certainty)}");
        return $"{facts.Length} {(facts.Length == 1 ? "fact" : "facts")}: {string.Join(", ", parts)}";
    }

    public static string CertaintyLabel(FactCertainty certainty) => certainty switch
    {
        FactCertainty.Detected => "detected",
        FactCertainty.Inferred => "inferred",
        _ => "uncertain",
    };
}
