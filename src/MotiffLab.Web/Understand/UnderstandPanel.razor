@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Experiments
@using MotiffLab.MusicCore.Time
@using MotiffLab.Web.Localization
@inject UiText Text

@* Understand (#25, #132; S1-A1, S1-A2, S1-A4, S1-A5; decision record 0013 section 9): two views of the facts about the selection.
   Now opens on the one observation music-core ranks first, with its claim kind, why that one, its places in the score, the readings
   that rest on the facts, and one recommended next step with Try it. Details lists every fact, one collapsible section per lens in
   FactLens order. A fact with places can be chosen to highlight them in the score and on the roll, one place at a time from its chips,
   and links to the experiments that rest on it. A new fact or a new lens from music-core shows up here without changes;
   the panel only displays the workspace state (0013), and the page ranks, highlights, plays and tries. *@
@if (Chosen is { } chosen)
{
    <div class="highlighted" role="group" aria-label="@Text["understand.highlightedLabel"]">
        <p aria-live="polite">
            <strong>@Text["understand.highlighted"]</strong> @chosen.Fact.Text
            <span class="meta">@Text.Format("understand.inScore", chosen.Place is { } place ? place.Label : Text.Count("understand.places", chosen.Fact.Places.Count))</span>
        </p>
        @if (!Facts.Contains(chosen.Fact))
        {
            <p class="meta">@Text["understand.offeredFor"]</p>
            @PlaceChips(chosen.Fact)
        }
        <button @onclick="() => Choose.InvokeAsync(null)">@Text["understand.clear"]</button>
    </div>
}
@if (Facts.Count > 0)
{
    <div class="view-switch" role="group" aria-label="@Text["understand.view"]">
        <button class="@(_details ? null : "on")" aria-pressed="@(_details ? "false" : "true")" @onclick="() => _details = false">@Text["understand.now"]</button>
        <button class="@(_details ? "on" : null)" aria-pressed="@(_details ? "true" : "false")" @onclick="() => _details = true">@Text["understand.details"]</button>
    </div>
}
@if (Facts.Count > 0 && !_details)
{
    <div class="facts now" role="group" aria-label="@Text["understand.now"]">
        @if (State.Facts.KeyObservation is { } key)
        {
            bool showWhy = _basisShown.Contains(key.Id);
            bool keyChosen = Chosen?.Fact == key;
            <section class="key-observation" aria-labelledby="key-observation-heading">
                <h4 id="key-observation-heading">@Text["understand.keyObservation"]</h4>
                <div class="fact-row" title="@key.Basis">
                    <span class="certainty @key.Certainty.ToString().ToLowerInvariant()">@CertaintyLabel(key.Certainty)</span>
                    <p class="text">@key.Text</p>
                </div>
                <div class="row">
                    @if (key.Places.Count > 0)
                    {
                        <button class="show" aria-pressed="@(keyChosen ? "true" : "false")" @onclick="() => Choose.InvokeAsync(keyChosen ? null : new FactChoice(key))">
                            @(keyChosen ? Text["understand.shownInScore"] : Text["understand.showInScore"])
                        </button>
                    }
                    <button class="basis-toggle" aria-expanded="@(showWhy ? "true" : "false")" @onclick="() => ToggleBasis(key.Id)">@(showWhy ? Text["understand.hideWhy"] : Text["understand.why"])</button>
                </div>
                @if (showWhy)
                {
                    <p class="basis">@key.Basis</p>
                    @if (State.Facts.KeyReason is { } reason)
                    {
                        <p class="basis"><strong>@Text["understand.whyThisOne"]</strong> @reason</p>
                    }
                }
                @if (keyChosen)
                {
                    @PlaceChips(key)
                }
            </section>
        }
        @if (Facts.Any(fact => fact.Certainty == FactCertainty.Interpretation))
        {
            <section class="reading" aria-labelledby="reading-heading">
                <h4 id="reading-heading">@Text["understand.reading"]</h4>
                <ul>
                    @foreach (MotifFact fact in Facts.Where(fact => fact.Certainty == FactCertainty.Interpretation))
                    {
                        bool showBasis = _basisShown.Contains(fact.Id);
                        <li title="@fact.Basis">
                            <span class="certainty interpretation">@CertaintyLabel(fact.Certainty)</span>
                            <div class="fact">
                                <span>@fact.Text</span>
                                @if (showBasis)
                                {
                                    <span class="basis">@fact.Basis</span>
                                }
                            </div>
                            <button class="basis-toggle" aria-expanded="@(showBasis ? "true" : "false")" @onclick="() => ToggleBasis(fact.Id)">@(showBasis ? Text["understand.hideWhy"] : Text["understand.why"])</button>
                        </li>
                    }
                </ul>
            </section>
        }
        <section class="recommended" aria-labelledby="recommended-heading">
            <h4 id="recommended-heading">@Text["understand.recommended"]</h4>
            @if (State.Facts.Recommended is { } next && _dismissedFor != State.Selection.Motif?.Span)
            {
                <p class="text"><strong>@next.Title</strong> <span class="meta">@next.Question</span></p>
                <div class="row">
                    <button class="primary" @onclick="() => Try.InvokeAsync(next)">@Text["understand.tryIt"]</button>
                    <button @onclick="() => _dismissedFor = State.Selection.Motif?.Span">@Text["understand.notNow"]</button>
                </div>
            }
            else
            {
                <p class="meta">@Text["understand.noRecommendation"]</p>
            }
        </section>
    </div>
}
@if (Facts.Count > 0 && _details)
{
    <div class="facts" role="group" aria-label="@Text["understand.factsLabel"]">
        @foreach (FactLens lens in Enum.GetValues<FactLens>())
        {
            MotifFact[] facts = Facts.Where(fact => fact.Lens == lens).ToArray();
            if (facts.Length == 0)
            {
                continue;
            }

            bool open = !_collapsed.Contains(lens);
            <section class="lens-group">
                <button class="lens-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(lens)">
                    <span class="caret" aria-hidden="true">@(open ? "▾" : "▸")</span>
                    <span class="lens">@LensLabel(lens)</span>
                    <span class="count">@CountText(facts)</span>
                </button>
                @if (open)
                {
                    <ul>
                        @foreach (MotifFact fact in facts)
                        {
                            bool showBasis = _basisShown.Contains(fact.Id);
                            bool isChosen = Chosen?.Fact == fact;
                            <li title="@fact.Basis" class="@(isChosen ? "chosen" : null)">
                                <span class="certainty @fact.Certainty.ToString().ToLowerInvariant()">@CertaintyLabel(fact.Certainty)</span>
                                <div class="fact">
                                    @if (fact.Places.Count > 0)
                                    {
                                        <button class="fact-text" aria-pressed="@(isChosen ? "true" : "false")" @onclick="() => Choose.InvokeAsync(isChosen ? null : new FactChoice(fact))">
                                            @fact.Text <span class="where">@Text.Format(isChosen ? "understand.shown" : "understand.show", Text.Count("understand.places", fact.Places.Count))</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span>@fact.Text</span>
                                    }
                                    @if (showBasis)
                                    {
                                        <span class="basis">@Text["understand.basisPrefix"] @fact.Basis</span>
                                    }
                                    @if (isChosen)
                                    {
                                        @PlaceChips(fact)
                                    }
                                    @foreach (Experiment experiment in ExperimentCatalogue.RestingOn(Offers, fact.Id))
                                    {
                                        <button class="try" @onclick="() => Try.InvokeAsync(experiment)" title="@experiment.Question">@Text.Format("understand.try", experiment.Title)</button>
                                    }
                                </div>
                                <button class="basis-toggle" aria-expanded="@(showBasis ? "true" : "false")" @onclick="() => ToggleBasis(fact.Id)">@Text[showBasis ? "understand.hideBasis" : "understand.basis"]</button>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        <p class="meta">@Text["understand.legend"]</p>
    </div>
}

@code {
    /// <summary>Whether the Details view shows (every fact by lens) instead of Now (the one observation to hear first).</summary>
    private bool _details;

    /// <summary>The selection whose recommended next step the player put aside with Not now; another selection brings one back.</summary>
    private TickSpan? _dismissedFor;

    /// <summary>The lenses the player closed; they stay closed as the selection changes.</summary>
    private readonly HashSet<FactLens> _collapsed = [];

    /// <summary>The facts whose basis the player opened.</summary>
    private readonly HashSet<string> _basisShown = new(StringComparer.Ordinal);

    /// <summary>The shared workspace state the page cascades; this panel reads its facts and the offers for them.</summary>
    [CascadingParameter]
    public WorkspaceState State { get; set; } = null!;

    /// <summary>The facts to show, from any analysis, in the order music-core gives them within each lens.</summary>
    private IReadOnlyList<MotifFact> Facts => State.Facts.All;

    /// <summary>The experiments offered for the same selection as <see cref="Facts"/>; each fact links to those resting on it.</summary>
    private IReadOnlyList<Experiment> Offers => State.Variation.UnderstandOffers;

    /// <summary>The fact being highlighted, and its place when one was chosen; null for none.</summary>
    private FactChoice? Chosen => State.Facts.Chosen;

    /// <summary>Raised with the fact (and place) to highlight, or null to clear the highlight.</summary>
    [Parameter]
    public EventCallback<FactChoice?> Choose { get; set; }

    /// <summary>Raised with an experiment a fact links to, to try its first alternative.</summary>
    [Parameter]
    public EventCallback<Experiment> Try { get; set; }

    /// <summary>The places of a chosen fact as chips; a chip highlights only its place, and pressed again, all of them.</summary>
    private RenderFragment PlaceChips(MotifFact fact) =>
        @<div class="places" role="group" aria-label="@Text["understand.placesLabel"]">
            @foreach (FactPlace place in fact.Places)
            {
                bool on = Chosen?.Place == place;
                <button class="chip" aria-pressed="@(on ? "true" : "false")" title="@Text["understand.placeHint"]"
                        @onclick="() => Choose.InvokeAsync(on ? new FactChoice(fact) : new FactChoice(fact, place))">@place.Label</button>
            }
        </div>;

    private void Toggle(FactLens lens)
    {
        if (!_collapsed.Remove(lens))
        {
            _collapsed.Add(lens);
        }
    }

    private void ToggleBasis(string id)
    {
        if (!_basisShown.Remove(id))
        {
            _basisShown.Add(id);
        }
    }

    private string LensLabel(FactLens lens) => Text[$"term.lens.{lens.ToString().ToLowerInvariant()}"];

    /// <summary>"4 facts: 3 detected, 1 inferred", so a closed section still says how sure it is.</summary>
    private string CountText(MotifFact[] facts)
    {
        IEnumerable<string> parts = Enum.GetValues<FactCertainty>()
            .Select(certainty => (certainty, count: facts.Count(fact => fact.Certainty == certainty)))
            .Where(pair => pair.count > 0)
            .Select(pair => Text.Format("understand.certaintyCount", CertaintyLabel(pair.certainty), pair.count));
        return $"{Text.Count("understand.facts", facts.Length)}: {string.Join(", ", parts)}";
    }

    private string CertaintyLabel(FactCertainty certainty) => Text[$"term.certainty.{certainty.ToString().ToLowerInvariant()}"];
}
