@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Experiments
@using MotiffLab.Web.Localization
@using MotiffLab.Web.Observations
@inject UiText Text

@* The card of the experiment being tried (decision record 0010; 0018 section 6), under the Try chip that started it in the
   Insights stream: the idea, its alternatives, what changed, the facts it rests on, Try another and
   Leave it; after Keep, a note in the player's own words. It only displays the workspace state (0013) and what
   ExperimentCatalogue returns; the page runs the steps, plays and saves. *@
@if (HasSelection && Trial is { } trial)
{
    Experiment experiment = trial.Experiment;
    <section class="explore" aria-label="@experiment.Title">
        <div class="experiment">
            <h3>@experiment.Title</h3>
            <p class="passage">@Text[trial.Elsewhere ? "explore.motifReturn" : State.Selection.Level == SelectionLevel.Sentence ? "explore.selectedSentence" : "explore.selectedPhrase"] · @Bars(experiment.Passage.FirstBar, experiment.Passage.LastBar)</p>
            @if (experiment.Alternatives.Count > 1)
            {
                <div class="choices" role="group" aria-label="@Text["explore.ways"]">
                    @for (int i = 0; i < experiment.Alternatives.Count; i++)
                    {
                        int index = i;
                        bool on = index == trial.Alternative;
                        <button class="chip @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @onclick='() => TryAsync(experiment, index, "offer")'>@experiment.Alternatives[index].Label</button>
                    }
                </div>
            }
            @if (Explanation is not null)
            {
                <p class="what-changed" aria-live="polite"><strong>@Text["explore.whatChanged"]</strong> @Explanation</p>
            }

            @if (trial.Elsewhere)
            {
                <button class="chip context @(AnswerLooping ? "on" : null)" aria-pressed="@(AnswerLooping ? "true" : "false")" @onclick="HearInContext"
                        title="@Text["explore.inContextHint"]">
                    @Text["explore.inContext"]
                </button>
            }
            @if (Layered)
            {
                <div class="listen" role="group" aria-label="@Text["explore.listenTo"]" title="@Text["explore.listenHint"]">
                    @foreach ((ListenTo choice, string key) in s_listen)
                    {
                        bool on = ListenTo == choice;
                        <button class="chip @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @onclick="() => ListenToChanged.InvokeAsync(choice)">@Text[key]</button>
                    }
                </div>
            }
            @* The sound comes first and the words on request (design/kit/docs/01-ux-concept.md; assessment items 16–20): the
               idea, its question, what it keeps, what to listen for and the facts it rests on open under About this idea. *@
            <details class="about-try">
                <summary>@Text["explore.about"]</summary>
                <p>@experiment.Change</p>
                <p class="question">@experiment.Question</p>
                <p class="caption">@Text.Format("explore.keeps", trial.Current.Keeps)</p>
                <p class="focus"><strong>@Text["explore.atThePiano"]</strong> @experiment.ListeningFocus</p>
                @if (RestsOn(trial) is { Length: > 0 } facts)
                {
                    @* The facts the experiment cites (#25), each ringing its places on the score. *@
                    <div class="rests-on" role="group" aria-label="@Text["explore.restsOnLabel"]">
                        <span class="caption">@Text["explore.restsOn"]</span>
                        @foreach (MotifFact fact in facts)
                        {
                            <button class="link fact-link" @onclick="() => FactChosen.InvokeAsync(fact)" title="@Text["explore.factHint"]">@fact.Claim</button>
                        }
                    </div>
                }
            </details>

            <div class="row actions">
                @if (trial.Kept)
                {
                    <span class="kept" role="status">@KeptText</span>
                }
                <button class="btn" @onclick="TryAnotherAsync" disabled="@(Next(trial) is null)" title="@NextText(trial)">@Text["explore.another"]</button>
                @if (!trial.Kept)
                {
                    <button class="btn quiet" @onclick="() => Leave.InvokeAsync()" title="@Text["explore.leaveHint"]">@Text["explore.leave"]</button>
                }
            </div>
            @if (trial.Kept && KeptId is not null)
            {
                @* After Keep, a note in the player's own words (#78), kept with the variation. *@
                <ObservationNote For="@KeptId" Note="@KeptNote" Label="@Text["explore.note"]" Saved="NoteSaved" />
            }
        </div>
    </section>
}

@code {
    private static readonly (ListenTo Choice, string Key)[] s_listen =
    [
        (ListenTo.Everything, "explore.everything"),
        (ListenTo.Melody, "explore.melodyAlone"),
        (ListenTo.Accompaniment, "explore.accompanimentAlone"),
    ];

    /// <summary>The shared workspace state the page cascades; the card reads its selection, playback, variation and ideas.</summary>
    [CascadingParameter]
    public WorkspaceState State { get; set; } = null!;

    private bool HasSelection => State.Selection.HasNotes;

    /// <summary>The experiment being tried, or null.</summary>
    private ExploreTrial? Trial => State.Variation.Trial;

    /// <summary>What the variation changed, read from its diff (S1-E4).</summary>
    private string? Explanation => State.Variation.Explanation;

    /// <summary>Whether the motif and its new answer loop together.</summary>
    private bool AnswerLooping => State.Playback.AnswerLooping;

    /// <summary>Whether the passage has a melody and an accompaniment to listen to apart.</summary>
    private bool Layered => State.Playback.Layered;

    private ListenTo ListenTo => State.Playback.ListenTo;

    [Parameter]
    public EventCallback<ExploreRequest> Try { get; set; }

    [Parameter]
    public EventCallback Leave { get; set; }

    /// <summary>Where a kept variation is saved, said plainly: with the project, or only while the page is open.</summary>
    private string KeptText => State.Ideas.KeptText;

    /// <summary>The observation the kept variation was saved as (#78), whose note the card offers to write; null for none.</summary>
    private string? KeptId => State.Ideas.OnCard?.Id;

    private string? KeptNote => State.Ideas.OnCard?.Note;

    /// <summary>Raised with the note as the player wrote it.</summary>
    [Parameter]
    public EventCallback<string> NoteSaved { get; set; }

    [Parameter]
    public EventCallback HearInContext { get; set; }

    [Parameter]
    public EventCallback<ListenTo> ListenToChanged { get; set; }

    /// <summary>Raised with a fact the experiment rests on, to show it on the Understand tab.</summary>
    [Parameter]
    public EventCallback<MotifFact> FactChosen { get; set; }

    private Task TryAsync(Experiment experiment, int alternative, string entry) =>
        Try.InvokeAsync(new ExploreRequest(experiment, alternative, entry));

    /// <summary>The next alternative, or after the last one the next experiment offered.</summary>
    private Task TryAnotherAsync() => Next(Trial!) is { } next ? TryAsync(next.Experiment, next.Alternative, "another") : Task.CompletedTask;

    private static (Experiment Experiment, int Alternative)? Next(ExploreTrial trial)
    {
        if (trial.Alternative + 1 < trial.Experiment.Alternatives.Count)
        {
            return (trial.Experiment, trial.Alternative + 1);
        }

        int at = trial.Offers.ToList().FindIndex(offer => offer.Id == trial.Experiment.Id);
        Experiment? next = trial.Offers.Count == 0 ? null : trial.Offers[(at + 1) % trial.Offers.Count];
        return next is null || (next.Id == trial.Experiment.Id && trial.Alternative == 0) ? null : (next, 0);
    }

    private string NextText(ExploreTrial trial) => Next(trial) switch
    {
        { } next when next.Experiment.Id == trial.Experiment.Id => Text.Format("explore.next", next.Experiment.Alternatives[next.Alternative].Label),
        { } next => Text.Format("explore.nextIdea", next.Experiment.Id.StartsWith(TryChips.ExperimentPrefix, StringComparison.Ordinal) ? next.Experiment.Alternatives[0].Label : next.Experiment.Title),
        _ => Text["explore.nothingElse"],
    };

    /// <summary>The facts the experiment cites, in its order, from the facts of the selection it was offered for.</summary>
    private static MotifFact[] RestsOn(ExploreTrial trial)
    {
        IReadOnlyList<MotifFact> facts = trial.Facts;
        return [.. trial.Experiment.FactIds.Select(id => facts.FirstOrDefault(fact => fact.Id == id)).OfType<MotifFact>()];
    }

    /// <summary>"bar 5", "bars 5–6", "the pickup", "the pickup and bar 1".</summary>
    private string Bars(int first, int last) => (first, last) switch
    {
        (0, 0) => Text["bars.pickup"],
        (0, 1) => Text["bars.pickupAndOne"],
        (0, _) => Text.Format("bars.pickupAndRange", last),
        _ when first == last => Text.Format("bars.one", first),
        _ => Text.Format("bars.range", first, last),
    };
}