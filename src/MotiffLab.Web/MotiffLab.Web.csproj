<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.13" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!--
    TypeScript in Scripts/ compiles to wwwroot/js/ (tsconfig.json). Static web assets are collected
    before CoreCompile, where the TypeScript package compiles, and the output does not exist when a
    clean checkout is evaluated. So compile first and add the output to Content; otherwise publish
    copies the files but the offline cache manifest leaves them out.
  -->
  <PropertyGroup>
    <TypeScriptSourceMap Condition="'$(Configuration)' == 'Release'">false</TypeScriptSourceMap>
  </PropertyGroup>

  <Target Name="IncludeCompiledTypeScript" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="SetTscExecutable;RunTscCompile">
    <ItemGroup>
      <Content Include="wwwroot/js/**/*.js;wwwroot/js/**/*.js.map" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MotiffLab.MusicCore\MotiffLab.MusicCore.csproj" />
  </ItemGroup>

</Project>
