@using MotiffLab.Web.Localization
@implements IDisposable

@* The batch's line over the library (version 0.5, ux-prototype/v0.5/screens/import-web-5-status.png): «Распознаю ноты: готово
   2 из 8», the piece and page being read and, once a page is timed, about how long is left (v0.5.6, #533 section 1), a
   segment a piece, Pause; when it waits, why, in plain words: the day's pages on Motiff Lab's server are used up (the rest
   tomorrow, or the player's own server, which has no limit), sign-in, Pro, the server, the folder. Nothing shows while the
   experiment is off or there is no batch. *@
@if (_on && Queue.Batch is { } batch)
{
    <div class="run-bar recognition-bar" role="status" aria-live="polite">
        <span class="what">@Headline(batch)</span>
        <span class="where">@Where(batch)</span>
        @if (batch.Stopped == "limit")
        {
            <a class="own" href="settings#scan-heading">@Text["recognition.ownServer"]</a>
        }
        <span class="sp"></span>
        @if (Queue.Running)
        {
            <button class="btn quiet" @onclick="Queue.PauseAsync"><Icon Name="pause" /> @Text["folder.pause"]</button>
        }
        else if (!batch.Finished)
        {
            <button class="btn quiet" @onclick="Queue.ResumeAsync"><Icon Name="play" /> @Text["folder.resume"]</button>
            <button class="btn quiet" @onclick="Queue.CloseAsync">@Text["folder.stop"]</button>
        }
        else
        {
            <button class="btn quiet" @onclick="Queue.CloseAsync">@Text["library.done"]</button>
        }
        @* A segment a piece (v0.5.6, #533 section 1): read, being read with its pages read filled in, or waiting. *@
        <span class="pages @(batch.Items.Count > MotiffLab.Web.Pdf.ScanProgressBar.DensePages ? "dense" : null)" aria-hidden="true">
            @foreach (RecognitionItem item in batch.Items)
            {
                <span class="page @Segment(item)" style="@(item.State == RecognitionState.Reading && item.Page > 0 ? $"--done: {(item.Page - 1) * 100 / Math.Max(1, item.Pages)}%" : null)"></span>
            }
        </span>
    </div>
}

@code {
    [Inject]
    private RecognitionQueue Queue { get; set; } = default!;

    [Inject]
    private UiText Text { get; set; } = default!;

    [Inject]
    private MotiffLab.Web.Settings.DeviceSettings Settings { get; set; } = default!;

    [Inject]
    private MotiffLab.Web.Import.ScanService Scans { get; set; } = default!;

    /// <summary>After a piece got its notes: the library reads its list again.</summary>
    [Parameter]
    public EventCallback Listed { get; set; }

    private bool _on;

    protected override async Task OnInitializedAsync()
    {
        Queue.Changed += OnChanged;
        Queue.Read += OnRead;
        await Settings.LoadAsync();
        _on = Settings.IsOn(ImportJob.Setting);
        if (_on)
        {
            await Queue.LoadAsync();
            await Scans.LoadAsync();
        }
    }

    public void Dispose()
    {
        Queue.Changed -= OnChanged;
        Queue.Read -= OnRead;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnRead() => _ = InvokeAsync(() => Listed.InvokeAsync());

    /// <summary>«Распознаю ноты: готово 2 из 8», «Распознавание остановлено на 2 из 8», «Ноты распознаны: 7 из 8».</summary>
    private string Headline(RecognitionBatch batch) =>
        Queue.Running ? Text.Format("recognition.running", batch.Done, batch.Items.Count)
        : batch.Finished ? Text.Format("recognition.finished", batch.Read, batch.Items.Count)
        : Text.Format("recognition.stopped", batch.Done, batch.Items.Count);

    /// <summary>
    /// While it reads (v0.5.6, #533 section 1): the piece and page being read, «Пьеса 3 из 8 · страница 2 из 5», and about
    /// how long is left once a page has been timed.
    /// </summary>
    private string? Reading(RecognitionBatch batch)
    {
        int index = batch.Items.ToList().FindIndex(static item => item.State == RecognitionState.Reading);
        List<string> parts = [];
        if (index >= 0 && batch.Items[index] is { Page: > 0 } item)
        {
            parts.Add(Text.Format("recognition.pieceOf", index + 1, batch.Items.Count));
            parts.Add(Text.Format("recognition.pageOf", item.Page, item.Pages));
        }

        if (Queue.MinutesLeft is { } minutes)
        {
            parts.Add(Text.Format("recognition.left", minutes));
        }

        return parts.Count > 0 ? string.Join(" · ", parts) : null;
    }

    /// <summary>A piece's segment: read (its notes or its reason back), being read, or waiting.</summary>
    private static string Segment(RecognitionItem item) => item.State switch
    {
        RecognitionState.Done or RecognitionState.Failed => "done",
        RecognitionState.Reading => "current",
        _ => "waiting",
    };

    /// <summary>About how long is left while it reads; why it waits when it waits; how many did not work at the end.</summary>
    private string? Where(RecognitionBatch batch) =>
        Queue.Running ? Reading(batch)
        : batch.Finished ? (batch.Failed > 0 ? Text.Count("recognition.failedCount", batch.Failed) : null)
        : batch.Stopped switch
        {
            "limit" => Text.Format("recognition.stop.limit", HostedPages.Limit),
            "server" => Text.Format("recognition.stop.server", Scans.Address?.Host ?? ""),
            { } why => Text[$"recognition.stop.{why}"],
            null => Text["recognition.stop.paused"],
        };
}