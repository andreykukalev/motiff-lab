@using System.Globalization
@using MotiffLab.Web.Localization
@inject UiText Text

@* The pen palette (0015, 0018 section 5) under the bar's Pen action, on the score and on a PDF's pages (0023), each handing it
   the state of its own pencil layer. Redrawn as a whole for version 0.5.6 (#533 section 9), as on the iPad: one card in two
   rows. The first holds what stays put whatever the tool: the three tools, each its own kit icon (pencil, marker, eraser), one
   chosen; then Undo, Redo and Clear, the layers where the host has them, and the cross that puts the tools away. The second
   holds the chosen tool's settings, grouped: its colour (the pencil's four inks as swatches, the chosen one ringed; the
   marker's one amber) and its thickness (lines as thick as the tool draws, in proportion, in its colour); for the eraser,
   one line on what it does. A setting belongs to its tool and never switches tools. *@
<div class="pen-palette" role="toolbar" aria-label="@Text["pencil.label"]" data-keeps-selection>
    <div class="pen-row">
        <div class="pen-tools" role="group" aria-label="@Text["pencil.tool"]">
            @foreach ((string tool, string icon, string key) in s_tools)
            {
                bool chosen = State.Tool == tool;
                <button class="pen-tool @(chosen ? "on" : null)" aria-pressed="@(chosen ? "true" : "false")" aria-label="@Text[key]" title="@Text[key]"
                        @onclick="() => Act(SetTool, [tool, null])"><Icon Name="@icon" /></button>
            }
        </div>
        <span class="pen-gap" aria-hidden="true"></span>
        <button class="it icon" aria-label="@Text["pencil.undo"]" title="@Text["pencil.undo"]" disabled="@(!State.CanUndo)"
                @onclick="() => Act(UndoLast, [])"><Icon Name="undo" /></button>
        <button class="it icon redo" aria-label="@Text["pencil.redo"]" title="@Text["pencil.redo"]" disabled="@(!State.CanRedo)"
                @onclick="() => Act(RedoLast, [])"><Icon Name="undo" /></button>
        @* Undo brings a cleared page back, so nothing asks first. *@
        <button class="it icon" aria-label="@Text["pencil.clear"]" title="@Text["pencil.clearHint"]" disabled="@(State.Marks == 0)"
                @onclick="() => Act(Clear, [])"><Icon Name="trash" /></button>
        @if (LayersRequested.HasDelegate)
        {
            <span class="div" aria-hidden="true"></span>
            <button class="it icon" aria-label="@Text["layers.title"]" title="@Text["layers.title"]" @onclick="() => LayersRequested.InvokeAsync()"><Icon Name="layers" /></button>
        }
        <button class="close" aria-label="@Text["pencil.close"]" title="@Text["pencil.close"]" @onclick="() => Act(SetOn, [false])"><Icon Name="close" /></button>
    </div>
    @if (State.Tool == EraserTool)
    {
        <p class="pen-row pen-settings pen-hint">@Text["pencil.eraserHint"]</p>
    }
    else
    {
        bool marker = State.Tool == HighlighterTool;
        string colour = marker ? "amber" : State.Colour;
        <div class="pen-row pen-settings">
            <div class="pen-colours" role="group" aria-label="@Text["pencil.ink"]">
                @if (marker)
                {
                    <span class="ink-swatch amber on" role="img" aria-label="@Text["pencil.markerColour"]" title="@Text["pencil.markerColour"]"><span aria-hidden="true"></span></span>
                }
                else
                {
                    @foreach ((string ink, string key) in s_penColours)
                    {
                        bool chosen = State.Colour == ink;
                        <button class="ink-swatch @ink @(chosen ? "on" : null)" aria-pressed="@(chosen ? "true" : "false")" aria-label="@Text[key]" title="@Text[key]"
                                @onclick="() => Act(SetTool, [PenTool, ink])"><span aria-hidden="true"></span></button>
                    }
                }
            </div>
            <span class="div" aria-hidden="true"></span>
            <div class="widths @colour @(marker ? "marker" : null)" role="radiogroup" aria-label="@Text["pencil.width"]">
                @for (int i = 0; i < s_widths.Length; i++)
                {
                    int width = i;
                    bool chosen = State.Width == width;
                    <button class="width @(chosen ? "on" : null)" role="radio" aria-checked="@(chosen ? "true" : "false")" aria-label="@Text[s_widths[width]]" title="@Text[s_widths[width]]"
                            @onclick="() => Act(SetWidth, [width])"><span class="sample" style="--share: @Share(marker ? s_highlighterSizes : s_penSizes, width)" aria-hidden="true"></span></button>
                }
            </div>
        </div>
    }
    @if (State.Hidden > 0)
    {
        <p class="caption">@Text.Format("pencil.hidden", State.Hidden)</p>
    }
</div>

@code {
    private const string PenTool = "pen";
    private const string HighlighterTool = "highlighter";
    private const string EraserTool = "eraser";
    private const string SetTool = "setTool";
    private const string SetWidth = "setWidth";
    private const string SetOn = "setOn";
    private const string UndoLast = "undoLast";
    private const string RedoLast = "redoLast";
    private const string Clear = "clear";

    /// <summary>The three tools, each with its own kit icon (#533 section 9), in the pencil layer's names.</summary>
    private static readonly (string Tool, string Icon, string Key)[] s_tools =
    [
        (PenTool, "pencil", "pencil.pen"),
        (HighlighterTool, "marker", "pencil.highlighter"),
        (EraserTool, "eraser", "pencil.eraser"),
    ];

    /// <summary>The three thicknesses, thin to thick.</summary>
    private static readonly string[] s_widths = ["pencil.widthThin", "pencil.widthMedium", "pencil.widthThick"];

    /// <summary>
    /// The thicknesses in staff spaces, as Scripts/score/pencil-marks.ts PEN_SIZES and HIGHLIGHTER_SIZES give them
    /// (tests/web/pencil-marks.test.mjs checks they agree): the samples are drawn in their proportions.
    /// </summary>
    private static readonly double[] s_penSizes = [0.1, 0.16, 0.3];

    private static readonly double[] s_highlighterSizes = [1.4, 2.2, 3.2];

    /// <summary>The four inks of the design kit (0018), in the project file's names (Projects/Marks.cs).</summary>
    private static readonly (string Colour, string Key)[] s_penColours =
    [
        ("graphite", "pencil.penGraphite"),
        ("carmine", "pencil.penCarmine"),
        ("forest", "pencil.penForest"),
        ("ochre", "pencil.penOchre"),
    ];

    /// <summary>The pencil layer's tools and marks, as its script last reported them.</summary>
    [Parameter, EditorRequired]
    public ScoreView.PencilState State { get; set; } = default!;

    /// <summary>Calls the pencil layer: a method of Scripts/score/pencil-layer.ts and its arguments.</summary>
    [Parameter, EditorRequired]
    public Func<string, object?[], Task> Act { get; set; } = default!;

    /// <summary>Opens the layers of marks, where the host has them.</summary>
    [Parameter]
    public EventCallback LayersRequested { get; set; }

    /// <summary>A thickness as a share of the tool's thickest, for the sample's height in CSS.</summary>
    private static string Share(double[] sizes, int width) => (sizes[width] / sizes.Max()).ToString("0.###", CultureInfo.InvariantCulture);
}
