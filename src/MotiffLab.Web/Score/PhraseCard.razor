@using MotiffLab.MusicCore.Time
@using MotiffLab.Web.Localization
@using MotiffLab.Web.Playback
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Player Player
@inject UiText Text

@* The focused phrase engraved on its own (0018 section 4), with any ossia above it; the script owns the host's children. *@
<div class="phrase-card-score" @ref="_host"></div>
@if (_error is not null)
{
    <p class="error">@_error</p>
}

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _card;
    private DotNetObjectReference<PhraseCard>? _self;
    private PhraseCardSource? _shown;
    private string? _shownSounding;
    private string? _error;

    /// <summary>What to engrave. The card engraves it again only when a different instance is given.</summary>
    [Parameter, EditorRequired]
    public PhraseCardSource? Source { get; set; }

    /// <summary>What sounds now, so only its staves light up: "original", "variation" or "both".</summary>
    [Parameter]
    public string Sounding { get; set; } = "original";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/score/phrase-card.js");
            _card = await _module.InvokeAsync<IJSObjectReference>("createPhraseCard", _host, _self);
            await _card.InvokeVoidAsync("follow", Player.Engine);
        }

        if (_card is null || Source is null)
        {
            return;
        }

        if (Sounding != _shownSounding)
        {
            _shownSounding = Sounding;
            await _card.InvokeVoidAsync("setSounding", Sounding);
        }

        if (ReferenceEquals(Source, _shown))
        {
            return;
        }

        PhraseCardSource source = Source;
        _shown = source;
        try
        {
            object[] ossias = [.. source.Ossias.Select(ossia => new { staves = ossia.Staves, prefix = ossia.Prefix, label = ossia.Label })];
            await _card.InvokeAsync<int>("load", source.Mei, source.Offset.Value, ossias);
            _error = null;
        }
        catch (JSException exception)
        {
            _error = Text.Format("score.error", exception.Message);
            StateHasChanged();
        }
    }

    /// <summary>Called by the script when a note on the card is clicked: playback moves to its onset.</summary>
    [JSInvokable]
    public Task OnCardNoteClicked(double tick) => Player.SeekAsync(new Tick(Math.Max(0, (long)Math.Round(tick))));

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_card is not null)
            {
                await _card.InvokeVoidAsync("dispose");
                await _card.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away with the card.
        }

        _self?.Dispose();
    }
}
