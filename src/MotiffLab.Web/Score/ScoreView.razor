@using MotiffLab.MusicCore.Time
@using MotiffLab.Web.Localization
@using MotiffLab.Web.Playback
@using MotiffLab.Web.Projects
@using MotiffLab.Web.Roll
@using MotiffLab.Web.Understand
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Player Player
@inject Preferences Preferences
@inject UiText Text

@if (PencilKey is not null && _pencilState.On)
{
    <PenPalette State="_pencilState" Act="PencilAsync" LayersRequested="LayersRequested" />
}
@if (_pdfError is not null)
{
    <p class="error" role="alert">@_pdfError</p>
}

@* Engraved by Verovio in Scripts/score (decision record 0008); the host's children belong to the script. *@
@* Focusable, so the score can be scrolled by keyboard within its panel. *@
<div class="score" @ref="_host" role="figure" aria-label="@Text["workspace.score"]" tabindex="0"></div>
@* The contextual menu over the selection (0018 section 3): drawn here, placed over the band by the script as the score scrolls. *@
<div class="ctx" @ref="_menu" role="toolbar" aria-label="@Text["menu.label"]" data-keeps-selection hidden>@Menu</div>
@if (_error is not null)
{
    <p class="error">@_error</p>
}
else if (_loading && !HoldHeight)
{
    <p class="meta">@Text["score.engraving"]</p>
}

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _view;
    private IJSObjectReference? _pencil;
    private string? _shownPencilKey;
    private string? _shownInk;
    private PencilState _pencilState = new(false, "pen", "graphite", 0, 0, false);
    private DotNetObjectReference<ScoreView>? _self;
    private ScoreSource? _shown;
    private bool _loading;
    private string? _error;
    private TickSpan? _shownRange;
    private ElementReference _menu;
    private TickSpan? _shownSelection;
    private bool _selectionShown;
    private IReadOnlyList<ScorePhrase>? _shownPhrases;
    private IReadOnlyList<ScoreBookmark>? _shownBookmarks;
    private IReadOnlyList<ScoreMarginNote>? _shownNotes;
    private IReadOnlyList<ScoreHighlightMark>? _shownMarkHighlights;
    private IReadOnlyList<ScoreCheckFlag>? _shownChecks;
    private IReadOnlyList<ScorePerformanceMarker>? _shownPerformance;
    private IReadOnlyList<HighlightPlace>? _shownUnheard;
    private IReadOnlyList<string>? _shownVersionAdded;
    private IReadOnlyList<string>? _shownVersionArtefacts;
    private IReadOnlyList<long>? _shownTakenBars;
    private IReadOnlyList<string>? _shownOwnNotes;
    private IReadOnlyList<ScoreOrigin>? _shownOrigins;
    private ScoreGhost? _shownGhost;
    private IReadOnlyList<string>? _shownHiddenLayers;
    private IReadOnlyList<HighlightPlace>? _shownHighlight;
    private IReadOnlyList<HighlightPlace>? _shownPointed;
    private bool _shownHold;
    private bool _shownFollow = true;
    private bool _shownEvenBars = true;
    private string? _shownMode;
    private IReadOnlyList<long>? _shownBeatLines;
    private ScorePlayheads? _shownPlayheads;
    private bool _paged = true;
    private bool _exporting;
    private string? _pdfError;

    /// <summary>The selection, drawn as a band with handles over its bars (0018 section 3); null draws none.</summary>
    [Parameter]
    public TickSpan? Selection { get; set; }

    /// <summary>The lines under the notes carries put in, in their sources' tones (0024, «Происхождение»); null draws none.</summary>
    [Parameter]
    public IReadOnlyList<ScoreOrigin>? Origins { get; set; }

    /// <summary>The ghost of a carry being made (0024): a dashed plum box over where its fragment will lie.</summary>
    [Parameter]
    public ScoreGhost? Ghost { get; set; }

    /// <summary>The contextual menu's items, shown above the selection; null shows no menu.</summary>
    [Parameter]
    public RenderFragment? Menu { get; set; }

    /// <summary>
    /// The mode under the rules of version 0.5 (Scripts/score/score-modes.ts): "navigate", "select", "edit" or "pen"; null keeps
    /// the rules before them. With <see cref="BeatLines"/> the selection goes by beats, a click places a playhead and never selects.
    /// </summary>
    [Parameter]
    public string? Mode { get; set; }

    /// <summary>music-core's beat lines in ticks, which the selection snaps to under the rules of version 0.5.</summary>
    [Parameter]
    public IReadOnlyList<long>? BeatLines { get; set; }

    /// <summary>The two playheads of version 0.5 (<see cref="ScorePlayheads"/>); null draws the one playhead as before.</summary>
    [Parameter]
    public ScorePlayheads? Playheads { get; set; }

    /// <summary>Raised under the rules of version 0.5 when beats are chosen: a drag in Select, or a handle moved.</summary>
    [Parameter]
    public EventCallback<(Tick Start, Tick End, bool ByHandle)> SpanChosen { get; set; }

    /// <summary>Raised under the rules of version 0.5 when a beat is clicked: where it starts and ends, and whether Shift was held.</summary>
    [Parameter]
    public EventCallback<(Tick Start, Tick End, bool Extend)> BeatClicked { get; set; }

    /// <summary>Raised in Edit notes when a note is clicked: when it starts and its key (-1 for a chord's stem).</summary>
    [Parameter]
    public EventCallback<NotePoint> NoteToEdit { get; set; }

    /// <summary>Raised when bars are chosen on the score: a drag across them, or a handle moved (where the first and the last bar start).</summary>
    [Parameter]
    public EventCallback<(Tick First, Tick Last, bool ByHandle)> BarsChosen { get; set; }

    /// <summary>The device preference for the layout: "pages" or "strip" (Settings · Notes).</summary>
    public const string LayoutPreference = "ml-score-layout";

    /// <summary>What to show. The view engraves it again only when a different instance is given.</summary>
    [Parameter, EditorRequired]
    public ScoreSource? Source { get; set; }

    /// <summary>The range that plays for the selection: notes outside it are marked as such, and the first note in it is scrolled into view. The band shows the selection itself.</summary>
    [Parameter]
    public TickSpan? Range { get; set; }

    /// <summary>Where phrases start, marked above the staves (#18); null or empty marks none.</summary>
    [Parameter]
    public IReadOnlyList<ScorePhrase>? Phrases { get; set; }

    /// <summary>The bookmarks, drawn above the phrase brackets (0018 section 5); null or empty draws none.</summary>
    [Parameter]
    public IReadOnlyList<ScoreBookmark>? Bookmarks { get; set; }

    /// <summary>The margin notes, as numbered markers beside their bars (0018 section 5); null or empty draws none.</summary>
    [Parameter]
    public IReadOnlyList<ScoreMarginNote>? Notes { get; set; }

    /// <summary>The player's highlights, as bands behind the staves; null or empty draws none.</summary>
    [Parameter]
    public IReadOnlyList<ScoreHighlightMark>? MarkHighlights { get; set; }

    /// <summary>The bars Check asks about (0018 section 9), each with a small amber flag; null or empty draws none.</summary>
    [Parameter]
    public IReadOnlyList<ScoreCheckFlag>? Checks { get; set; }

    /// <summary>A Check flag was tapped: its bar's number.</summary>
    [Parameter]
    public EventCallback<int> CheckPicked { get; set; }

    /// <summary>The bars a performance plays differently (decision record 0022, section 4), each with a plum label; null or empty draws none.</summary>
    [Parameter]
    public IReadOnlyList<ScorePerformanceMarker>? PerformanceMarkers { get; set; }

    /// <summary>The printed notes the performance did not play, tinted in place; null or empty tints none.</summary>
    [Parameter]
    public IReadOnlyList<HighlightPlace>? Unheard { get; set; }

    /// <summary>In the comparison layer above the systems, the ids of the notes another version adds, shown plum (0022, section 4).</summary>
    [Parameter]
    public IReadOnlyList<string>? VersionAdded { get; set; }

    /// <summary>In the comparison layer, the ids of the notes likely to be artefacts of a recording's hearing, shown grey when asked for.</summary>
    [Parameter]
    public IReadOnlyList<string>? VersionArtefacts { get; set; }

    /// <summary>Where each bar taken from another version starts, in ticks: a thin plum line under it (testing item 33); null or empty draws none.</summary>
    [Parameter]
    public IReadOnlyList<long>? TakenBars { get; set; }

    /// <summary>The ids of notes the player wrote themselves in a merge, shown amber in the merge's result.</summary>
    [Parameter]
    public IReadOnlyList<string>? OwnNotes { get; set; }

    /// <summary>A performance's marker was tapped: its bar's number.</summary>
    [Parameter]
    public EventCallback<ScoreMarkerPick> PerformancePicked { get; set; }

    /// <summary>The layers of marks hidden for a clean page: "ink", "notes", "bookmarks", "analysis".</summary>
    [Parameter]
    public IReadOnlyList<string>? HiddenLayers { get; set; }

    /// <summary>Raised with a margin note's id when its marker is tapped.</summary>
    [Parameter]
    public EventCallback<string> NoteMarkerPicked { get; set; }

    /// <summary>Raised when Layers is chosen in the pen palette.</summary>
    [Parameter]
    public EventCallback LayersRequested { get; set; }

    /// <summary>Raised with a bookmark's id when its bracket is tapped.</summary>
    [Parameter]
    public EventCallback<string> BookmarkPicked { get; set; }

    /// <summary>The places of the fact chosen on the Understand tab (#25), highlighted; null or empty highlights none.</summary>
    [Parameter]
    public IReadOnlyList<HighlightPlace>? Highlight { get; set; }

    /// <summary>The notes pointed at on the piano roll (0018 section 4), shown in cobalt on the score; null or empty for none.</summary>
    [Parameter]
    public IReadOnlyList<HighlightPlace>? Pointed { get; set; }

    /// <summary>Raised when a note on the score is tapped: when it starts and its key, so the piano roll can show it.</summary>
    [Parameter]
    public EventCallback<NotePoint> NotePicked { get; set; }

    /// <summary>
    /// While true the score never gets shorter, so what is below it stays put when two versions take turns
    /// (One after the other, #43): a tablet stacks the inspector under it.
    /// </summary>
    [Parameter]
    public bool HoldHeight { get; set; }

    /// <summary>
    /// Which piece's pencil marks to show and keep (0015, <see cref="PencilMarks"/>); null shows none and
    /// leaves the pen to scroll, as for a score with a variation in it.
    /// </summary>
    [Parameter]
    public string? PencilKey { get; set; }

    /// <summary>
    /// The strokes the project file keeps for the piece, as <see cref="MotiffLab.MusicCore.Projects.ProjectFile.WriteInk"/>
    /// writes them (empty for none); then every change comes back through <see cref="MarksChanged"/> for the project to
    /// save. Null when the piece has no project: its marks stay on the device.
    /// </summary>
    [Parameter]
    public string? Ink { get; set; }

    /// <summary>The project's strokes after the player wrote or erased, in the same shape as <see cref="Ink"/>; empty for none.</summary>
    [Parameter]
    public EventCallback<string> MarksChanged { get; set; }

    /// <summary>The piece's name: heads a MusicXML file without a title on its first page and names the PDF (0017).</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>The pages under the top of the view as the player scrolls, for the bar's "p. 2 of 4": first, last and how many; all 0 in the strip.</summary>
    [Parameter]
    public EventCallback<(int First, int Last, int Count)> PagesShown { get; set; }

    /// <summary>Whether the score scrolls to keep the playing system in view (Settings · Playback); the playhead shows either way.</summary>
    [Parameter]
    public bool Follow { get; set; } = true;

    /// <summary>
    /// Whether this score is the one heard: its playhead follows the player and a note clicked moves playback. A score
    /// shown beside the one heard (0024, «Рядом») is read only: in its own time, the player's position means nothing.
    /// </summary>
    [Parameter]
    public bool Heard { get; set; } = true;

    /// <summary>Whether the bars take room by their length, so the playhead keeps one pace (Settings · Notes, score.evenBars; testing item 35).</summary>
    [Parameter]
    public bool EvenBars { get; set; } = true;

    /// <summary>Raised when the playhead goes out of sight while playing, with where its bar starts, and with null when it is back in sight or playback stops.</summary>
    [Parameter]
    public EventCallback<Tick?> PlayheadAway { get; set; }

    /// <summary>Raised after each engraving with the title the first page is headed with; null when it has none or in the strip.</summary>
    [Parameter]
    public EventCallback<string?> TitleRead { get; set; }

    /// <summary>
    /// Raised after each engraving is on screen, or has failed: its first sheets are drawn and the rest follow (#419). The
    /// workspace reads a long piece's phrases after it, so the score shows first.
    /// </summary>
    [Parameter]
    public EventCallback Engraved { get; set; }

    /// <summary>Raised when the player taps a phrase's bracket, with the number <see cref="ScorePhrase"/> gave it.</summary>
    [Parameter]
    public EventCallback<int> BracketPicked { get; set; }

    /// <summary>Raised when the pen is turned on or off, or a mark is made, so the bar shows Pen as active (0018 section 5).</summary>
    [Parameter]
    public EventCallback<PencilState> PencilChanged { get; set; }

    /// <summary>Whether the score is laid out as A4 pages (the default) rather than one strip.</summary>
    public bool Paged => _paged;

    /// <summary>Whether a PDF is being made.</summary>
    public bool Exporting => _exporting;

    /// <summary>Whether the pen draws with a finger (the pencil always draws).</summary>
    public bool PenOn => _pencilState.On;

    /// <summary>Whether the score can be drawn on: a piece whose marks are kept.</summary>
    public bool CanDraw => PencilKey is not null;

    protected override void OnParametersSet()
    {
        _loading = !ReferenceEquals(Source, _shown) && Source is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/score/score-view.js");
            _view = await _module.InvokeAsync<IJSObjectReference>("createScoreView", _host, _self);
            _pencil = await _view.InvokeAsync<IJSObjectReference>("pencilLayer");
            await _view.InvokeVoidAsync("setMenu", _menu);
            if (await Preferences.GetAsync(LayoutPreference) == "strip")
            {
                _paged = false;
                await _view.InvokeVoidAsync("setPaged", false);
                StateHasChanged();
            }
        }

        if (_pencil is not null && (PencilKey != _shownPencilKey || (Ink is null) != (_shownInk is null)))
        {
            _shownPencilKey = PencilKey;
            _shownInk = Ink;
            await _pencil.InvokeVoidAsync("setKey", PencilKey, Ink);
        }
        else if (_pencil is not null && Ink is not null && Ink != _shownInk)
        {
            // The project's strokes changed other than by writing here (a file opened again, a project reloaded).
            _shownInk = Ink;
            await _pencil.InvokeVoidAsync("setInk", Ink);
        }

        if (_view is null || Source is null)
        {
            return;
        }

        if (Follow != _shownFollow)
        {
            _shownFollow = Follow;
            await _view.InvokeVoidAsync("setFollow", Follow);
        }

        if (EvenBars != _shownEvenBars)
        {
            _shownEvenBars = EvenBars;
            await _view.InvokeVoidAsync("setEvenBars", EvenBars);
        }

        if (Mode != _shownMode || !ReferenceEquals(BeatLines, _shownBeatLines))
        {
            (_shownMode, _shownBeatLines) = (Mode, BeatLines);
            await _view.InvokeVoidAsync("setRules", Mode, BeatLines?.ToArray());
        }

        if (Playheads != _shownPlayheads)
        {
            _shownPlayheads = Playheads;
            await _view.InvokeVoidAsync("setPlayheads", Playheads);
        }

        if (HoldHeight != _shownHold)
        {
            _shownHold = HoldHeight;
            await _view.InvokeVoidAsync("holdHeight", HoldHeight);
        }

        if (ReferenceEquals(Source, _shown))
        {
            if (Range != _shownRange)
            {
                await ShowRangeAsync(_view);
            }

            if (!ReferenceEquals(Phrases, _shownPhrases))
            {
                await ShowPhrasesAsync(_view);
            }

            if (!ReferenceEquals(Bookmarks, _shownBookmarks))
            {
                await ShowBookmarksAsync(_view);
            }

            if (!ReferenceEquals(Notes, _shownNotes) || !ReferenceEquals(MarkHighlights, _shownMarkHighlights) || !ReferenceEquals(Checks, _shownChecks))
            {
                await ShowMarksAsync(_view);
            }

            if (!ReferenceEquals(PerformanceMarkers, _shownPerformance) || !ReferenceEquals(Unheard, _shownUnheard) || !ReferenceEquals(VersionAdded, _shownVersionAdded)
                || !ReferenceEquals(VersionArtefacts, _shownVersionArtefacts) || !ReferenceEquals(TakenBars, _shownTakenBars) || !ReferenceEquals(OwnNotes, _shownOwnNotes))
            {
                await ShowPerformanceAsync(_view);
            }

            if (!ReferenceEquals(HiddenLayers, _shownHiddenLayers))
            {
                await ShowLayersAsync(_view);
            }

            if (!ReferenceEquals(Origins, _shownOrigins) || Ghost != _shownGhost)
            {
                await ShowAssemblyAsync(_view);
            }

            if (Selection != _shownSelection || !_selectionShown)
            {
                await ShowSelectionAsync(_view);
            }

            if (!ReferenceEquals(Highlight, _shownHighlight))
            {
                await ShowHighlightAsync(_view);
            }

            if (!ReferenceEquals(Pointed, _shownPointed))
            {
                await ShowPointedAsync(_view);
            }

            return;
        }

        ScoreSource source = Source;
        _shown = source;
        try
        {
            ScoreLoadResult loaded = await _view.InvokeAsync<ScoreLoadResult>("load", source.Data, Title);
            await TitleRead.InvokeAsync(loaded.Title);
            if (Heard)
            {
                await _view.InvokeVoidAsync("follow", Player.Engine);
            }

            await ShowRangeAsync(_view);
            await ShowPhrasesAsync(_view);
            await ShowBookmarksAsync(_view);
            await ShowMarksAsync(_view);
            await ShowLayersAsync(_view);
            await ShowSelectionAsync(_view);
            await ShowHighlightAsync(_view);
            await ShowPointedAsync(_view);
            await ShowPerformanceAsync(_view);
            await ShowAssemblyAsync(_view);
            _error = null;
        }
        catch (JSException exception)
        {
            _error = Text.Format("score.error", exception.Message);
        }

        _loading = false;
        StateHasChanged();
        await Engraved.InvokeAsync();
    }

    private async Task ShowPerformanceAsync(IJSObjectReference view)
    {
        _shownPerformance = PerformanceMarkers;
        _shownUnheard = Unheard;
        _shownVersionAdded = VersionAdded;
        _shownVersionArtefacts = VersionArtefacts;
        _shownTakenBars = TakenBars;
        _shownOwnNotes = OwnNotes;
        await view.InvokeVoidAsync(
            "setPerformance", (object)(PerformanceMarkers ?? []).ToArray(), (object)(Unheard ?? []).ToArray(), (object)(VersionAdded ?? []).ToArray(), (object)(VersionArtefacts ?? []).ToArray(),
            (object)(TakenBars ?? []).ToArray(), (object)(OwnNotes ?? []).ToArray());
    }

    private async Task ShowAssemblyAsync(IJSObjectReference view)
    {
        _shownOrigins = Origins;
        _shownGhost = Ghost;
        await view.InvokeVoidAsync("setAssembly", (object)(Origins ?? []).ToArray(), Ghost);
    }

    private async Task ShowRangeAsync(IJSObjectReference view)
    {
        _shownRange = Range;
        await view.InvokeVoidAsync("setRange", Range?.Onset.Value, Range?.End.Value);
    }

    private async Task ShowPhrasesAsync(IJSObjectReference view)
    {
        _shownPhrases = Phrases;
        // Cast, so the array goes across as one argument rather than as the argument list.
        await view.InvokeVoidAsync("setPhrases", (object)(Phrases ?? []).ToArray());
    }

    private async Task ShowBookmarksAsync(IJSObjectReference view)
    {
        _shownBookmarks = Bookmarks;
        await view.InvokeVoidAsync("setBookmarks", (object)(Bookmarks ?? []).ToArray());
    }

    private async Task ShowMarksAsync(IJSObjectReference view)
    {
        _shownNotes = Notes;
        _shownMarkHighlights = MarkHighlights;
        _shownChecks = Checks;
        await view.InvokeVoidAsync("setChecks", (object)(Checks ?? []).ToArray());
        await view.InvokeVoidAsync("setMarks", (object)(Notes ?? []).ToArray(), (object)(MarkHighlights ?? []).ToArray());
    }

    private async Task ShowLayersAsync(IJSObjectReference view)
    {
        _shownHiddenLayers = HiddenLayers;
        await view.InvokeVoidAsync("setHiddenLayers", (object)(HiddenLayers ?? []).ToArray());
    }

    private async Task ShowSelectionAsync(IJSObjectReference view)
    {
        _shownSelection = Selection;
        _selectionShown = true;
        object? selection = Selection is { } span
            ? new { start = span.Onset.Value, end = span.End.Value, startLabel = Text["selection.handleStart"], endLabel = Text["selection.handleEnd"] }
            : null;
        await view.InvokeVoidAsync("setSelection", selection);
    }

    private async Task ShowPointedAsync(IJSObjectReference view)
    {
        _shownPointed = Pointed;
        await view.InvokeVoidAsync("setPointed", (object)(Pointed ?? []).ToArray());
    }

    private async Task ShowHighlightAsync(IJSObjectReference view)
    {
        _shownHighlight = Highlight;
        await view.InvokeVoidAsync("setHighlight", (object)(Highlight ?? []).ToArray());
    }

    /// <summary>Raised when a bar is clicked away from its notes (0012): where it starts, and whether Shift extended the selection to it.</summary>
    [Parameter]
    public EventCallback<(Tick Start, bool Extend)> BarPicked { get; set; }

    /// <summary>Raised when the page is tapped where there is no music: the selection is put away (0018 section 3).</summary>
    [Parameter]
    public EventCallback PaperTapped { get; set; }

    /// <summary>Called by the script when a note is clicked: playback moves to its onset, and the piano roll shows the note.</summary>
    [JSInvokable]
    public async Task OnScoreNoteClicked(double tick, int pitch)
    {
        long at = Math.Max(0, (long)Math.Round(tick));
        if (!Heard)
        {
            return;
        }

        await Player.SeekAsync(new Tick(at));
        if (pitch >= 0)
        {
            await NotePicked.InvokeAsync(new NotePoint(at, pitch));
        }
    }

    /// <summary>Scrolls one page on (1) or back (-1), as the arrow keys do.</summary>
    public async Task StepPageAsync(int direction)
    {
        if (_view is not null)
        {
            await _view.InvokeVoidAsync("stepPage", direction);
        }
    }

    /// <summary>Lays the score out as A4 pages or as one strip, and keeps the choice on the device.</summary>
    public async Task SetPagedAsync(bool paged)
    {
        if (paged == _paged || _view is null)
        {
            return;
        }

        _paged = paged;
        await Preferences.SetAsync(LayoutPreference, paged ? "pages" : "strip");
        try
        {
            await _view.InvokeVoidAsync("setPaged", paged);
        }
        catch (JSException exception)
        {
            _error = Text.Format("score.error", exception.Message);
        }
    }

    /// <summary>Engraves the score on A4 pages and hands the player the PDF to save; on the iPad it goes through Files.</summary>
    public async Task ExportPdfAsync()
    {
        if (_view is null || _exporting)
        {
            return;
        }

        (_exporting, _pdfError) = (true, null);
        StateHasChanged();
        try
        {
            await _view.InvokeAsync<int>("exportPdf", Title);
        }
        catch (JSException exception)
        {
            _pdfError = Text.Format("score.pdfError", exception.Message);
        }
        finally
        {
            _exporting = false;
        }
    }

    /// <summary>Turns the pen on or off: on, one finger draws and two scroll (0018 section 5).</summary>
    public Task TogglePencilAsync() => PencilAsync("setOn", !_pencilState.On);

    private async Task PencilAsync(string method, params object?[] args)
    {
        if (_pencil is not null)
        {
            await _pencil.InvokeVoidAsync(method, args);
        }
    }

    /// <summary>Called by the script when the pencil tools or the marks change.</summary>
    [JSInvokable]
    public void OnPencilChanged(PencilState state)
    {
        if (state != _pencilState)
        {
            _pencilState = state;
            StateHasChanged();
            _ = PencilChanged.InvokeAsync(state);
        }
    }

    /// <summary>Called by the script after the player wrote or erased on a piece whose project keeps the marks.</summary>
    [JSInvokable]
    public Task OnPencilMarksChanged(string ink)
    {
        _shownInk = ink;
        return MarksChanged.InvokeAsync(ink);
    }

    /// <summary>Called by the script when the playhead goes out of sight, with where its bar starts, and with -1 when it is back in sight or stopped.</summary>
    [JSInvokable]
    public Task OnPlayheadAway(double barTick) => PlayheadAway.InvokeAsync(barTick < 0 ? null : new Tick((long)Math.Round(barTick)));

    /// <summary>Back to playback: the playing system is scrolled into view and the score follows it again.</summary>
    public async Task ReturnToPlayheadAsync()
    {
        if (_view is not null)
        {
            await _view.InvokeVoidAsync("returnToPlayhead");
        }
    }

    /// <summary>Called by the script when the pages under the top of the view change.</summary>
    [JSInvokable]
    public Task OnPagesShown(int first, int last, int count) => PagesShown.InvokeAsync((first, last, count));

    /// <summary>Called by the script when a margin note's marker is tapped.</summary>
    [JSInvokable]
    public Task OnNoteMarkerClicked(string id) => NoteMarkerPicked.InvokeAsync(id);

    /// <summary>Called by the script when a performance's marker is tapped.</summary>
    [JSInvokable]
    public Task OnPerformanceMarkerClicked(int bar, double left, double bottom) => PerformancePicked.InvokeAsync(new ScoreMarkerPick(bar, left, bottom));

    /// <summary>Called by the script when a Check flag is tapped.</summary>
    [JSInvokable]
    public Task OnCheckFlagClicked(int bar) => CheckPicked.InvokeAsync(bar);

    /// <summary>Called by the script when a bookmark's bracket is tapped.</summary>
    [JSInvokable]
    public Task OnBookmarkClicked(string id) => BookmarkPicked.InvokeAsync(id);

    /// <summary>The pages with their pictures and the stretch of the piece on each, for the Contents drawer; none in the strip.</summary>
    public async Task<IReadOnlyList<PageOutline>> PageOutlineAsync() =>
        _view is null ? [] : await _view.InvokeAsync<PageOutline[]>("pageOutline");

    /// <summary>Keeps the piece's cover for the library: the first page with where its pages, phrases and bars start. False in the strip.</summary>
    public async Task<bool> SaveCoverAsync(string projectId, IEnumerable<long> phraseStarts, IEnumerable<long> barStarts, int firstBar) =>
        _view is not null && await _view.InvokeAsync<bool>("saveCover", projectId, phraseStarts.ToArray(), barStarts.ToArray(), firstBar);

    /// <summary>Places the contextual menu again, as when a drawer opens or closes beside it.</summary>
    public async Task PlaceMenuAsync()
    {
        if (_view is not null)
        {
            await _view.InvokeVoidAsync("placeMenu");
        }
    }

    /// <summary>Scrolls to the top of a page, from 1.</summary>
    public async Task ShowPageAsync(int page)
    {
        if (_view is not null)
        {
            await _view.InvokeVoidAsync("showPage", page);
        }
    }

    /// <summary>Where the first bar on a page starts, from 1; null in the strip or before the score is engraved.</summary>
    public async Task<long?> FirstTickOnAsync(int page) =>
        _view is null ? null : await _view.InvokeAsync<long?>("firstTickOn", page);

    /// <summary>Scrolls to the top of the page a place in the piece is on.</summary>
    public async Task ShowTickAsync(long tick)
    {
        if (_view is not null)
        {
            await _view.InvokeVoidAsync("showTick", tick);
        }
    }

    /// <summary>Called by the script when a phrase's bracket is tapped.</summary>
    [JSInvokable]
    public Task OnBracketClicked(int number) => BracketPicked.InvokeAsync(number);

    /// <summary>Called by the script when bars are chosen by a drag or a handle.</summary>
    [JSInvokable]
    public Task OnScoreBarsChosen(double first, double last, bool byHandle) =>
        BarsChosen.InvokeAsync((new Tick(Math.Max(0, (long)Math.Round(first))), new Tick(Math.Max(0, (long)Math.Round(last))), byHandle));

    /// <summary>Called by the script under the rules of version 0.5 when beats are chosen by a drag or a handle.</summary>
    [JSInvokable]
    public Task OnScoreSpanChosen(double start, double end, bool byHandle) => SpanChosen.InvokeAsync((TickOf(start), TickOf(end), byHandle));

    /// <summary>Called by the script under the rules of version 0.5 when a beat is clicked.</summary>
    [JSInvokable]
    public Task OnScoreBeatClicked(double start, double end, bool extend) => BeatClicked.InvokeAsync((TickOf(start), TickOf(end), extend));

    /// <summary>Called by the script in Edit notes when a note is clicked.</summary>
    [JSInvokable]
    public Task OnScoreNoteToEdit(double tick, int pitch) => NoteToEdit.InvokeAsync(new NotePoint(TickOf(tick).Value, pitch));

    private static Tick TickOf(double tick) => new(Math.Max(0, (long)Math.Round(tick)));

    /// <summary>Called by the script when a bar is clicked away from its notes.</summary>
    [JSInvokable]
    public Task OnScoreBarClicked(double tick, bool extend) => BarPicked.InvokeAsync((new Tick(Math.Max(0, (long)Math.Round(tick))), extend));

    /// <summary>Called by the script when the page is tapped away from the bars and the marks.</summary>
    [JSInvokable]
    public Task OnScorePaperClicked() => PaperTapped.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_pencil is not null)
            {
                await _pencil.DisposeAsync();
            }

            if (_view is not null)
            {
                await _view.InvokeVoidAsync("dispose");
                await _view.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away with the view.
        }

        _self?.Dispose();
    }

    private sealed record ScoreLoadResult(int Pages, int Notes, string? Title);

    /// <summary>
    /// What the pencil tools show, as the script reports it (Scripts/score/pencil-layer.ts). <paramref name="Width"/> is the drawing
    /// tool's thickness: 0 thin, 1 medium, 2 thick.
    /// </summary>
    public sealed record PencilState(bool On, string Tool, string Colour, int Marks, int Hidden, bool CanUndo, int Width = 1);
}