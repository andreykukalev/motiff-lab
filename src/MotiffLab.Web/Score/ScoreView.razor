@using MotiffLab.MusicCore.Time
@using MotiffLab.Web.Localization
@using MotiffLab.Web.Playback
@using MotiffLab.Web.Understand
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Player Player
@inject UiText Text

@if (PencilKey is not null)
{
    @* Pencil marks (0015): the Apple Pencil writes on the score at any time; these tools choose the pen, the highlighter or the eraser. *@
    <div class="pencil-tools" role="toolbar" aria-label="@Text["pencil.label"]" data-keeps-selection>
        <button class="pencil-toggle @(_pencilState.On ? "on" : null)" aria-pressed="@(_pencilState.On ? "true" : "false")" title="@Text["pencil.hint"]"
                @onclick="TogglePencilAsync">✎ @Text["pencil.toggle"]</button>
        @if (_pencilState.On)
        {
            @foreach ((string colour, string key) in s_penColours)
            {
                bool chosen = _pencilState.Tool == PenTool && _pencilState.Colour == colour;
                <button class="pencil-pen @colour @(chosen ? "on" : null)" aria-pressed="@(chosen ? "true" : "false")" aria-label="@Text[key]" title="@Text[key]"
                        @onclick="() => ChooseAsync(PenTool, colour)"><span aria-hidden="true"></span></button>
            }
            <button class="@(_pencilState.Tool == HighlighterTool ? "on" : null)" aria-pressed="@(_pencilState.Tool == HighlighterTool ? "true" : "false")"
                    @onclick="() => ChooseAsync(HighlighterTool, null)">@Text["pencil.highlighter"]</button>
            <button class="@(_pencilState.Tool == EraserTool ? "on" : null)" aria-pressed="@(_pencilState.Tool == EraserTool ? "true" : "false")"
                    @onclick="() => ChooseAsync(EraserTool, null)">@Text["pencil.eraser"]</button>
            <button @onclick="UndoPencilAsync" disabled="@(!_pencilState.CanUndo)">@Text["pencil.undo"]</button>
            <button @onclick="ClearPencilAsync" disabled="@(_pencilState.Marks == 0)" title="@Text["pencil.clearHint"]">@Text["pencil.clear"]</button>
            <span class="meta">@Text["pencil.how"]</span>
        }
        @if (_pencilState.Hidden > 0)
        {
            <span class="meta">@Text.Format("pencil.hidden", _pencilState.Hidden)</span>
        }
    </div>
}

@* Engraved by Verovio in Scripts/score (decision record 0008); the host's children belong to the script. *@
@* Focusable, so the score can be scrolled by keyboard within its panel. *@
<div class="score" @ref="_host" role="figure" aria-label="@Text["workspace.score"]" tabindex="0"></div>
@if (_error is not null)
{
    <p class="error">@_error</p>
}
else if (_loading && !HoldHeight)
{
    <p class="meta">@Text["score.engraving"]</p>
}

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _view;
    private IJSObjectReference? _pencil;
    private string? _shownPencilKey;
    private PencilState _pencilState = new(false, "pen", "ink", 0, 0, false);
    private DotNetObjectReference<ScoreView>? _self;
    private ScoreSource? _shown;
    private bool _loading;
    private string? _error;
    private TickSpan? _shownRange;
    private IReadOnlyList<ScorePhrase>? _shownPhrases;
    private IReadOnlyList<HighlightPlace>? _shownHighlight;
    private bool _shownHold;

    /// <summary>What to show. The view engraves it again only when a different instance is given.</summary>
    [Parameter, EditorRequired]
    public ScoreSource? Source { get; set; }

    /// <summary>The range that plays for the selection; notes outside it are drawn faint. Null shows all at full strength.</summary>
    [Parameter]
    public TickSpan? Range { get; set; }

    /// <summary>Where phrases start, marked above the staves (#18); null or empty marks none.</summary>
    [Parameter]
    public IReadOnlyList<ScorePhrase>? Phrases { get; set; }

    /// <summary>The places of the fact chosen on the Understand tab (#25), highlighted; null or empty highlights none.</summary>
    [Parameter]
    public IReadOnlyList<HighlightPlace>? Highlight { get; set; }

    /// <summary>
    /// While true the score never gets shorter, so what is below it stays put when two versions take turns
    /// (One after the other, #43): a tablet stacks the inspector under it.
    /// </summary>
    [Parameter]
    public bool HoldHeight { get; set; }

    /// <summary>
    /// Which piece's pencil marks to show and keep on this device (0015, <see cref="PencilMarks"/>); null shows none and
    /// leaves the pen to scroll, as for a score with a variation in it.
    /// </summary>
    [Parameter]
    public string? PencilKey { get; set; }

    private static readonly (string Colour, string Key)[] s_penColours =
    [
        ("ink", "pencil.penInk"),
        ("red", "pencil.penRed"),
        ("blue", "pencil.penBlue"),
    ];

    protected override void OnParametersSet()
    {
        _loading = !ReferenceEquals(Source, _shown) && Source is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/score/score-view.js");
            _view = await _module.InvokeAsync<IJSObjectReference>("createScoreView", _host, _self);
            _pencil = await _view.InvokeAsync<IJSObjectReference>("pencilLayer");
        }

        if (_pencil is not null && PencilKey != _shownPencilKey)
        {
            _shownPencilKey = PencilKey;
            await _pencil.InvokeVoidAsync("setKey", PencilKey);
        }

        if (_view is null || Source is null)
        {
            return;
        }

        if (HoldHeight != _shownHold)
        {
            _shownHold = HoldHeight;
            await _view.InvokeVoidAsync("holdHeight", HoldHeight);
        }

        if (ReferenceEquals(Source, _shown))
        {
            if (Range != _shownRange)
            {
                await ShowRangeAsync(_view);
            }

            if (!ReferenceEquals(Phrases, _shownPhrases))
            {
                await ShowPhrasesAsync(_view);
            }

            if (!ReferenceEquals(Highlight, _shownHighlight))
            {
                await ShowHighlightAsync(_view);
            }

            return;
        }

        ScoreSource source = Source;
        _shown = source;
        try
        {
            await _view.InvokeAsync<ScoreLoadResult>("load", source.Data);
            await _view.InvokeVoidAsync("follow", Player.Engine);
            await ShowRangeAsync(_view);
            await ShowPhrasesAsync(_view);
            await ShowHighlightAsync(_view);
            _error = null;
        }
        catch (JSException exception)
        {
            _error = Text.Format("score.error", exception.Message);
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task ShowRangeAsync(IJSObjectReference view)
    {
        _shownRange = Range;
        await view.InvokeVoidAsync("setRange", Range?.Onset.Value, Range?.End.Value);
    }

    private async Task ShowPhrasesAsync(IJSObjectReference view)
    {
        _shownPhrases = Phrases;
        // Cast, so the array goes across as one argument rather than as the argument list.
        await view.InvokeVoidAsync("setPhrases", (object)(Phrases ?? []).ToArray());
    }

    private async Task ShowHighlightAsync(IJSObjectReference view)
    {
        _shownHighlight = Highlight;
        await view.InvokeVoidAsync("setHighlight", (object)(Highlight ?? []).ToArray());
    }

    /// <summary>Raised when a bar is clicked away from its notes (0012): where it starts, and whether Shift extended the selection to it.</summary>
    [Parameter]
    public EventCallback<(Tick Start, bool Extend)> BarPicked { get; set; }

    /// <summary>Called by the script when a note is clicked: playback moves to its onset.</summary>
    [JSInvokable]
    public Task OnScoreNoteClicked(double tick) => Player.SeekAsync(new Tick(Math.Max(0, (long)Math.Round(tick))));

    private const string PenTool = "pen";
    private const string HighlighterTool = "highlighter";
    private const string EraserTool = "eraser";

    private Task TogglePencilAsync() => PencilAsync("setOn", !_pencilState.On);

    /// <summary>The pen in a colour, the highlighter or the eraser; null keeps the colour the script picks.</summary>
    private Task ChooseAsync(string tool, string? colour) => PencilAsync("setTool", tool, colour);

    private Task UndoPencilAsync() => PencilAsync("undoLast");

    /// <summary>Takes away every mark on the piece; Undo brings them back, so nothing asks first.</summary>
    private Task ClearPencilAsync() => PencilAsync("clear");

    private async Task PencilAsync(string method, params object?[] args)
    {
        if (_pencil is not null)
        {
            await _pencil.InvokeVoidAsync(method, args);
        }
    }

    /// <summary>Called by the script when the pencil tools or the marks change.</summary>
    [JSInvokable]
    public void OnPencilChanged(PencilState state)
    {
        if (state != _pencilState)
        {
            _pencilState = state;
            StateHasChanged();
        }
    }

    /// <summary>Called by the script when a bar is clicked away from its notes.</summary>
    [JSInvokable]
    public Task OnScoreBarClicked(double tick, bool extend) => BarPicked.InvokeAsync((new Tick(Math.Max(0, (long)Math.Round(tick))), extend));

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_pencil is not null)
            {
                await _pencil.DisposeAsync();
            }

            if (_view is not null)
            {
                await _view.InvokeVoidAsync("dispose");
                await _view.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away with the view.
        }

        _self?.Dispose();
    }

    private sealed record ScoreLoadResult(int Pages, int Notes);

    /// <summary>What the pencil tools show, as the script reports it (Scripts/score/pencil-layer.ts).</summary>
    public sealed record PencilState(bool On, string Tool, string Colour, int Marks, int Hidden, bool CanUndo);
}
