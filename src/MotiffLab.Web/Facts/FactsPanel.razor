@using MotiffLab.MusicCore.Analysis

@* Facts about a selection (S1-A1, S1-A2, S1-A4, S1-A5), one collapsible section per lens in FactLens order.
   A new fact or a new lens from music-core shows up here without changes; the panel only displays. *@
@if (Facts.Count > 0)
{
    <div class="facts" role="group" aria-label="Facts about the selection">
        @foreach (FactLens lens in Enum.GetValues<FactLens>())
        {
            MotifFact[] facts = Facts.Where(fact => fact.Lens == lens).ToArray();
            if (facts.Length == 0)
            {
                continue;
            }

            bool open = !_collapsed.Contains(lens);
            <section class="lens-group">
                <button class="lens-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(lens)">
                    <span class="caret" aria-hidden="true">@(open ? "▾" : "▸")</span>
                    <span class="lens">@LensLabel(lens)</span>
                    <span class="count">@CountText(facts)</span>
                </button>
                @if (open)
                {
                    <ul>
                        @foreach (MotifFact fact in facts)
                        {
                            bool showBasis = _basisShown.Contains(fact.Id);
                            <li title="@fact.Basis">
                                <span class="certainty @fact.Certainty.ToString().ToLowerInvariant()">@CertaintyLabel(fact.Certainty)</span>
                                <div class="fact">
                                    <span>@fact.Text</span>
                                    @if (showBasis)
                                    {
                                        <span class="basis">Basis: @fact.Basis</span>
                                    }
                                </div>
                                <button class="basis-toggle" aria-expanded="@(showBasis ? "true" : "false")" @onclick="() => ToggleBasis(fact.Id)">@(showBasis ? "Hide basis" : "Basis")</button>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        <p class="meta">Detected: read from the notes or the file. Inferred: worked out by a rule. Uncertain: a guess on thin evidence. Basis shows why.</p>
    </div>
}

@code {
    /// <summary>The lenses the player closed; they stay closed as the selection changes.</summary>
    private readonly HashSet<FactLens> _collapsed = [];

    /// <summary>The facts whose basis the player opened.</summary>
    private readonly HashSet<string> _basisShown = new(StringComparer.Ordinal);

    /// <summary>The facts to show, from any analysis, in the order music-core gives them within each lens.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MotifFact> Facts { get; set; } = [];

    private void Toggle(FactLens lens)
    {
        if (!_collapsed.Remove(lens))
        {
            _collapsed.Add(lens);
        }
    }

    private void ToggleBasis(string id)
    {
        if (!_basisShown.Remove(id))
        {
            _basisShown.Add(id);
        }
    }

    private static string LensLabel(FactLens lens) => lens.ToString();

    /// <summary>"4 facts: 3 detected, 1 inferred", so a closed section still says how sure it is.</summary>
    private static string CountText(MotifFact[] facts)
    {
        IEnumerable<string> parts = Enum.GetValues<FactCertainty>()
            .Select(certainty => (certainty, count: facts.Count(fact => fact.Certainty == certainty)))
            .Where(pair => pair.count > 0)
            .Select(pair => $"{pair.count} {CertaintyLabel(pair.certainty)}");
        return $"{facts.Length} {(facts.Length == 1 ? "fact" : "facts")}: {string.Join(", ", parts)}";
    }

    public static string CertaintyLabel(FactCertainty certainty) => certainty switch
    {
        FactCertainty.Detected => "detected",
        FactCertainty.Inferred => "inferred",
        _ => "uncertain",
    };
}
