@using MotiffLab.MusicCore
@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Assembly
@using MotiffLab.Web.Localization
@inject UiText Text

@* «Тональности» (version 0.5): the circle of fifths with the signatures round it and each key a shade of one neutral tone by
   its accidentals, majors outside and their relative minors inside (Andrei, 2026-11-12: no new colours, the kit unchanged);
   the chosen key's card beside it (KeyCardView). In a piece its key is outlined, and the legend says which; under the card
   of another key of its mode, «Für Elise в ми миноре»: Слушать and Показать ноты (mockup C2, #351), and once the notes are
   shown in another key, the piece's own key takes them back. *@
<div class="ref-keys-tab">
    <div class="ref-circle-side">
        <ReferenceCircle Shaded="true" Chosen="Key" PieceKey="PieceKey?.Key" PieceKeyInferred="PieceKey is { Inferred: true }" Pick="Pick" />
        <p class="ref-legend">
            @if (PieceKey is { } piece)
            {
                <span class="ref-legend-item"><span class="ref-swatch piece @(piece.Inferred ? "inferred" : null)" aria-hidden="true"></span>@Text.Format(piece.Inferred ? "reference.pieceKeyInferred" : "reference.pieceKey", piece.Key.NameIn(Words))</span>
            }
            else if (InPiece)
            {
                <span class="ref-legend-item ref-key-unknown">@Text["reference.pieceKeyUnknown"]</span>
            }
            <span class="ref-legend-item"><span class="ref-swatch on" aria-hidden="true"></span>@Text["reference.chosen"]</span>
        </p>
    </div>
    <div class="ref-card-side">
        @if (Card is { } card)
        {
            <KeyCardView Card="card" Words="Words" Keyboard="false" Pick="Pick" Hear="Hear" OpenChord="OpenChord" OpenScale="OpenScale" />
            @if (PieceKey is { } own && Key is { } key && key.Mode == own.Key.Mode && (key != own.Key || Transposed is not null))
            {
                <section class="ref-piece-in" aria-labelledby="ref-piece-in-title">
                    <h3 id="ref-piece-in-title" class="overline">@Text.Format("reference.pieceIn", PieceTitle ?? Text["reference.thePiece"], AssemblyWords.KeyPrepositional(key, Words))</h3>
                    <div class="ref-piece-in-actions">
                        @if (key == own.Key)
                        {
                            <button type="button" class="btn primary" @onclick="() => Transpose.InvokeAsync(new PieceInKey(key, false))">@Text.Format("reference.backTo", key.NameIn(Words))</button>
                        }
                        else
                        {
                            <button type="button" class="btn primary" @onclick="() => Transpose.InvokeAsync(new PieceInKey(key, true))"><Icon Name="playf" />@Text["reference.hearPiece"]</button>
                            <button type="button" class="btn secondary" aria-pressed="@(Transposed == key ? "true" : "false")" @onclick="() => Transpose.InvokeAsync(new PieceInKey(key, false))">@Text["reference.showNotes"]</button>
                        }
                    </div>
                </section>
            }
        }
        else
        {
            <p class="caption ref-choose">@Text["reference.chooseOnCircle"]</p>
        }
    </div>
</div>

@code {
    /// <summary>The key whose card is open, kept by the sheet.</summary>
    [Parameter]
    public MusicalKey? Key { get; set; }

    [Parameter]
    public KeyCard? Card { get; set; }

    [Parameter]
    public DnaKey? PieceKey { get; set; }

    /// <summary>Opened over a piece: with no key known, the legend says so (#533 7), as the circle shows C major only to be filled.</summary>
    [Parameter]
    public bool InPiece { get; set; }

    [Parameter]
    public EventCallback<MusicalKey> Pick { get; set; }

    /// <summary>The open piece's title, for «Für Elise в ми миноре»; null outside a piece or without a title.</summary>
    [Parameter]
    public string? PieceTitle { get; set; }

    /// <summary>The key the piece's notes are shown in for now, when it is not its own (#351).</summary>
    [Parameter]
    public MusicalKey? Transposed { get; set; }

    /// <summary>The piece heard in the chosen key, its notes shown in it, or (its own key) shown as written again.</summary>
    [Parameter]
    public EventCallback<PieceInKey> Transpose { get; set; }

    [Parameter]
    public EventCallback<ReferenceSound> Hear { get; set; }

    /// <summary>A main chord of the card: it becomes the chord of «Аккорды и гаммы».</summary>
    [Parameter]
    public EventCallback<ReferenceChord> OpenChord { get; set; }

    /// <summary>A scale of the card: it becomes the scale of «Аккорды и гаммы».</summary>
    [Parameter]
    public EventCallback<ReferenceScale> OpenScale { get; set; }

    private Words Words => Words.For(Text.Language);
}
