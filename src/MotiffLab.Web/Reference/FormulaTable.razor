@using MotiffLab.Web.Localization
@inject UiText Text

@* A chord's or a scale's degrees over its notes (music-core's formula and spelled notes): "1 ♭3 5" above "A C E". *@
<table class="ref-formula">
    <tbody>
        <tr>
            <th scope="row" class="caption">@Text["reference.formula"]</th>
            @foreach (string degree in Formula)
            {
                <td class="ref-degree">@degree</td>
            }
        </tr>
        <tr>
            <th scope="row" class="caption">@Text["reference.notes"]</th>
            @foreach (string note in Notes)
            {
                <td>@note</td>
            }
        </tr>
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Formula { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Notes { get; set; } = [];
}
