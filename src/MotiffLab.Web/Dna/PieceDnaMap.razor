@using MotiffLab.MusicCore
@using MotiffLab.MusicCore.Analysis
@using MotiffLab.MusicCore.Time
@using MotiffLab.MusicCore.Events
@using MotiffLab.Web.Insights
@inject MotiffLab.Web.Localization.UiText Text
@inject MotiffLab.Web.Settings.DeviceSettings Settings
@implements IDisposable

@* Piece DNA (0018 section 11; design/kit/docs/01-ux-concept.md, "Piece DNA"; design/kit/screens/s11_piece_dna.png): the
   third place, a full-screen map of the whole piece read top to bottom: the form strip, a lane per idea with a mark at
   every place it is heard, the key lane and the bars that bring new material, then a card per idea. A lane the engine
   does not fill yet says so in place. A mark plays its passage; a second tap opens the score there. Leaving returns to
   the score exactly as it was. The map explains itself (testing item 30): a line on what it shows above the lanes, a line
   under each lane's name on how to read it, the form's sections coloured by their letter, the harmony in three rows that
   each turn on and off (chords, steps of the key, functions in their own colours T · S · D), the closes in words that say
   what they are when tapped, and the circle of fifths of a section from the key and harmony lanes. *@
<section class="dna" role="dialog" aria-modal="true" aria-labelledby="dna-title" tabindex="-1" @ref="_element" @onkeydown="OnKey">
    <header class="dna-bar">
        @if (BackLabel is { } origin)
        {
            @* Opened from More: ‹ More goes back there (testing item 20). *@
            <button class="act back-to" aria-label="@Text.Format("nav.backTo", origin)" @onclick="() => Closed.InvokeAsync()"><Icon Name="back" Size="IconSize.Large" /> @origin</button>
        }
        else
        {
            <button class="act" aria-label="@Text["dna.back"]" title="@Text["dna.back"]" @onclick="() => Closed.InvokeAsync()"><Icon Name="back" Size="IconSize.Large" /></button>
        }
        <h2 id="dna-title" class="ttl">@Title</h2>
        <span class="sub">@Text["dna.title"]</span>
        <span class="sp"></span>
        <span class="counts">@Counts</span>
    </header>

    @if (Dna.Status == DnaStatus.NotYet && Dna.NewMaterialBars.Count == 0 && Dna.Keys.Count == 0)
    {
        <p class="dna-empty">@Text["dna.empty"]</p>
    }
    else
    {
        @if (Dna.Summary.Length > 0)
        {
            <p class="dna-summary">@Dna.Summary</p>
        }
        <div class="dna-map">
            @if (PlayingAt is { } at && X(at) is { } playhead)
            {
                <span class="dna-playhead" style="@($"--x: {playhead}")" aria-hidden="true"></span>
            }

            @* Read top to bottom (testing item 22): the form, the key, the harmony, the density, new material, the folded
               lanes, then the ideas. *@
            <div class="dna-row form">
                <div class="lane-head">
                    <span class="lane-name overline">@Text["dna.form"]@if (Dna.Form.Count > 0) { <span class="tag assumed">@Text["dna.inferred"]</span> }</span>
                    <span class="why">@Text["dna.why.form"]</span>
                </div>
                <div class="lane-track">
                    @if (Dna.Form.Count == 0)
                    {
                        <p class="lane-empty">@Text["dna.formEmpty"]</p>
                    }
                    else
                    {
                        @foreach ((DnaSection from, DnaSection to) in Arcs)
                        {
                            <span class="dna-arc" style="@ArcPlace(from, to)" aria-hidden="true"></span>
                        }

                        @foreach (DnaSection section in Dna.Form)
                        {
                            <button class="dna-sec @SectionColour(section) @(section.Label.Length > 1 ? "rep" : null)" style="@Place(section.Span)"
                                    aria-label="@SectionName(section)" title="@SectionName(section)"
                                    @onclick="() => TapSectionAsync(section.Id, section.Span)">@(section.Label)</button>
                        }
                    }
                </div>
            </div>

            <div class="dna-row axis" aria-hidden="true">
                <span></span>
                <div class="lane-track">
                    @foreach (int bar in AxisBars)
                    {
                        <span class="bar-no" style="@($"--x: {X(Meter.GetBar(bar).Span.Onset) ?? "0"}")">@bar</span>
                    }
                </div>
            </div>

            <div class="dna-row key">
                <div class="lane-head">
                    <span class="lane-name overline">@Text["dna.key"]</span>
                    @if (Dna.Circles.Count > 0)
                    {
                        <button class="circle-open" aria-pressed="@(_circle is not null ? "true" : "false")" @onclick="() => ToggleCircle(null)">◎ @Text["dna.circle"]</button>
                    }
                    <span class="why">@Text["dna.why.key"]</span>
                </div>
                <div class="lane-track">
                    @if (Dna.Keys.Count == 0)
                    {
                        <p class="lane-empty">@Text["dna.keyEmpty"]</p>
                    }
                    @foreach (DnaKey key in Dna.Keys)
                    {
                        <button class="key-block @(key.Key.Mode == KeyMode.Minor ? "minor" : null)" style="@Place(key.Span)" title="@(key.Doubt is { } doubt ? $"{Text["dna.keyHint"]} {doubt}" : Text["dna.keyHint"])"
                                @onclick="() => OpenCircleAt(key.Span.Onset, null)">@KeyName(key)</button>
                    }
                </div>
            </div>

            <div class="dna-row harmony">
                <div class="lane-head">
                    <span class="lane-name overline">@Text["dna.harmony"]</span>
                    @if (Dna.Circles.Count > 0)
                    {
                        <button class="circle-open" aria-pressed="@(_circle is not null ? "true" : "false")" @onclick="() => ToggleCircle(null)">◎ @Text["dna.circle"]</button>
                    }
                    <span class="why">@Text["dna.why.harmony"]</span>
                    @if (Dna.Harmony.Count > 0)
                    {
                        <span class="rows" role="group" aria-label="@Text["dna.rows"]">
                            <button class="row-tog @(ShowChords ? "on" : null)" aria-pressed="@(ShowChords ? "true" : "false")" @onclick="() => ToggleRowAsync(ChordsSetting)">@Text["dna.rowChords"]</button>
                            <button class="row-tog @(ShowDegrees ? "on" : null)" aria-pressed="@(ShowDegrees ? "true" : "false")" @onclick="() => ToggleRowAsync(DegreesSetting)">@Text["dna.rowDegrees"]</button>
                            <button class="row-tog @(ShowFunctions ? "on" : null)" aria-pressed="@(ShowFunctions ? "true" : "false")" @onclick="() => ToggleRowAsync(FunctionsSetting)">@Text["dna.rowFunctions"]</button>
                        </span>
                    }
                </div>
                <div class="lane-track stack">
                    @if (Dna.Harmony.Count == 0)
                    {
                        <p class="lane-empty">@Text["dna.harmonyEmpty"]</p>
                    }
                    else
                    {
                        @if (ShowChords)
                        {
                            <div class="h-row chords">
                                @foreach ((Segment segment, string label) in Labels(ChordSegments, segment => segment.Symbol, MarkRoom))
                                {
                                    <button class="label chord @(segment.Clear ? null : "unsure") @(ChosenSymbol == segment.Symbol ? "on" : null)" style="@($"--x: {X(Middle(segment.Span))}")"
                                            aria-label="@ChordName(segment)" title="@ChordName(segment)" @onclick="() => OpenCircleAt(segment.Span.Onset, segment.Symbol)">@label</button>
                                }
                            </div>
                        }
                        @if (ShowDegrees)
                        {
                            <div class="h-row degrees" aria-hidden="true">
                                @foreach ((Segment segment, string label) in Labels(ChordSegments, segment => segment.Degree))
                                {
                                    <span class="label degree" style="@($"--x: {X(Middle(segment.Span))}")">@label</span>
                                }
                            </div>
                        }
                        @if (ShowFunctions)
                        {
                            <div class="h-row functions" aria-hidden="true">
                                @foreach (Segment segment in FunctionSegments)
                                {
                                    <span class="fn @FunctionClass(segment.Function)" style="@Place(segment.Span)">@(Fits(segment, "T") ? FunctionLetter(segment.Function) : "")</span>
                                }
                            </div>
                        }
                        <div class="h-row closes">
                            @foreach (DnaCadence cadence in ShownCadences)
                            {
                                bool on = _explained == cadence.Explanation;
                                <button class="cad @(cadence.Kind == CloseKind.Half ? "half" : null) @(on ? "on" : null)" style="@($"--x: {X(Middle(Meter.GetBar(cadence.Bar).Span)) ?? "0"}")"
                                        aria-pressed="@(on ? "true" : "false")" aria-label="@cadence.Explanation" @onclick="() => Explain(cadence)">@Text[cadence.Kind == CloseKind.Full ? "dna.cadFull" : "dna.cadHalf"]</button>
                            }
                        </div>
                        <span class="visually-hidden">@HarmonySummary</span>
                    }
                </div>
            </div>

            <div class="dna-row density">
                <div class="lane-head">
                    <span class="lane-name overline">@Text["dna.density"]</span>
                    <span class="why">@Text["dna.why.density"]</span>
                </div>
                <div class="lane-track levels">
                    @foreach (DnaBarLevel level in Dna.Density)
                    {
                        <span class="lvl" style="@($"{Place(Meter.GetBar(level.Bar).Span)}; --h: {Share(level.Value, MaxDensity)}")" aria-hidden="true"></span>
                    }
                    <span class="visually-hidden">@DensitySummary</span>
                </div>
            </div>

            <div class="dna-row new">
                <div class="lane-head">
                    <span class="lane-name overline">@Text["dna.newMaterial"]</span>
                    <span class="why">@Text["dna.why.newMaterial"]</span>
                </div>
                <div class="lane-track">
                    @for (int bar = Dna.FirstBar; bar <= Dna.LastBar; bar++)
                    {
                        <span class="new-bar @(NewBars.Contains(bar) ? "new" : "heard")" style="@Place(Meter.GetBar(bar).Span)" aria-hidden="true"></span>
                    }
                    <span class="visually-hidden">@Text.Format("dna.newMaterialSummary", string.Join(", ", Dna.NewMaterialBars))</span>
                </div>
            </div>

            <div class="dna-more">
                <button class="btn quiet compact" aria-expanded="@(_moreLanes ? "true" : "false")" @onclick="() => _moreLanes = !_moreLanes">
                    <span class="caret" aria-hidden="true">@(_moreLanes ? "▾" : "▸")</span> @Text["dna.moreLanes"]
                </button>
            </div>

            @if (_moreLanes)
            {
                <div class="dna-row register">
                    <div class="lane-head">
                        <span class="lane-name overline">@Text["dna.register"]</span>
                        <span class="why">@Text["dna.why.register"]</span>
                    </div>
                    <div class="lane-track levels">
                        @foreach (DnaRange range in Dna.Register)
                        {
                            <span class="rng" style="@($"{Place(Meter.GetBar(range.Bar).Span)}; --lo: {Share(range.Low - LowestNote, HighestNote - LowestNote)}; --hi: {Share(range.High - LowestNote, HighestNote - LowestNote)}")" aria-hidden="true"></span>
                        }
                        <span class="visually-hidden">@RegisterSummary</span>
                    </div>
                </div>

                <div class="dna-row dynamics">
                    <div class="lane-head">
                        <span class="lane-name overline">@Text["dna.dynamics"]</span>
                        <span class="why">@Text["dna.why.dynamics"]</span>
                    </div>
                    <div class="lane-track levels">
                        @if (Dna.Dynamics.Count == 0)
                        {
                            <p class="lane-empty">@Text["dna.dynamicsEmpty"]</p>
                        }
                        @foreach (DnaBarLevel level in Dna.Dynamics)
                        {
                            <span class="lvl dyn" style="@($"{Place(Meter.GetBar(level.Bar).Span)}; --h: {Share(level.Value, Note.MaxVelocity)}")" aria-hidden="true"></span>
                        }
                    </div>
                </div>
            }

            <p class="overline lanes-title">@Text["dna.ideasTitle"]</p>
            @if (Dna.Ideas.Count == 0)
            {
                <p class="lane-empty ideas-empty">@Text[Dna.IdeasStatus == DnaStatus.Ready ? "dna.ideasNone" : "dna.ideasEmpty"]</p>
            }
            @foreach (DnaIdea idea in Dna.Ideas)
            {
                <div class="dna-row idea" role="group" aria-label="@idea.Title">
                    <span class="lane-name">@idea.Title</span>
                    <div class="lane-track">
                        @foreach ((IdeaOccurrence occurrence, bool tappable) in Marks(idea))
                        {
                            bool on = _heard == occurrence.Span;
                            @if (tappable)
                            {
                                <button class="mk-hit @(on ? "on" : null)" style="@($"--x: {X(occurrence.Span.Onset) ?? "0"}")" aria-label="@MarkName(idea, occurrence)" title="@Text["dna.markHint"]"
                                        aria-pressed="@(on ? "true" : "false")" @onclick="() => TapAsync(occurrence.Span)">
                                    <span class="mk @MarkClass(occurrence.Kind)" aria-hidden="true"></span>
                                </button>
                            }
                            else
                            {
                                @* Too close to the mark before it for a finger: drawn, and heard with the card's Hear. *@
                                <span class="mk-hit" style="@($"--x: {X(occurrence.Span.Onset) ?? "0"}")" aria-hidden="true"><span class="mk @MarkClass(occurrence.Kind)"></span></span>
                            }
                        }
                    </div>
                </div>
            }

            @if (Dna.Ideas.Count > 0)
            {
                <p class="dna-legend caption" aria-hidden="true">
                    <span class="mk" ></span> @Text["dna.legendExact"] · <span class="mk o"></span> @Text["dna.legendTransposed"]
                </p>
            }
        </div>

        @if (_circle is { } circle)
        {
            <aside class="dna-pop circle" role="dialog" aria-modal="false" aria-labelledby="dna-circle-title">
                <div class="pop-head">
                    <h3 id="dna-circle-title" class="ttl">@Text.Format(circle.Id.StartsWith("key_", StringComparison.Ordinal) ? "dna.circleOfKey" : "dna.circleOfSection", circle.Label)</h3>
                    <button class="close" aria-label="@Text["dna.closeCircle"]" title="@Text["dna.closeCircle"]" @onclick="CloseCircle"><Icon Name="close" /></button>
                </div>
                @if (Dna.Circles.Count > 1)
                {
                    <div class="pop-sections" role="group" aria-label="@Text["dna.circleSections"]">
                        @foreach (DnaCircle other in Dna.Circles)
                        {
                            <button class="chip" aria-pressed="@(other == circle ? "true" : "false")" @onclick="() => ShowCircle(other, null)">@other.Label</button>
                        }
                    </div>
                }
                <KeyCircleCard Circle="circle.Circle" Functions="true" Chosen="@_chosenChord?.Place" Show="PickChord" Hear="() => HearScale.InvokeAsync(circle)" Playing="ScalePlaying" />
                <p class="dna-legend caption" aria-hidden="true">
                    <span class="sw tonic"></span> @Text["dna.zoneTonic"] <span class="sw subdominant"></span> @Text["dna.zoneSubdominant"] <span class="sw dominant"></span> @Text["dna.zoneDominant"] <span class="sw far"></span> @Text["dna.zoneFar"]
                </p>
                @if (_chosenChord is { } chosen)
                {
                    <p class="role" role="status">@chosen.Role</p>
                }
                @if (circle.From is { } from)
                {
                    <p class="caption">@Text.Format("dna.modulation", circle.Label, from.NameIn(Words), circle.Circle.Name)</p>
                }
                <div class="row">
                    <button class="btn quiet compact" @onclick="() => ShowInScore.InvokeAsync(_chosenChord?.Place.Span ?? circle.Span)">@Text["dna.inScore"]</button>
                </div>
            </aside>
        }
        else if (_explained is { } explained)
        {
            <aside class="dna-pop" role="dialog" aria-modal="false" aria-label="@Text["dna.explainTitle"]">
                <div class="pop-head">
                    <p class="explained">@explained</p>
                    <button class="close" aria-label="@Text["dna.closeCircle"]" @onclick="() => _explained = null"><Icon Name="close" /></button>
                </div>
                @if (_explainedSpan is { } span)
                {
                    <div class="row">
                        <button class="btn secondary compact" @onclick="() => HearIdeaAsync(span)"><Icon Name="play" /> @Text["dna.hear"]</button>
                        <button class="btn quiet compact" @onclick="() => ShowInScore.InvokeAsync(span)">@Text["dna.inScore"]</button>
                    </div>
                }
            </aside>
        }

        @if (Dna.Ideas.Count > 0)
        {
            <div class="dna-cards">
                @foreach (DnaIdea idea in Dna.Ideas)
                {
                    <article class="dna-card" aria-labelledby="@($"{idea.Id}-title")">
                        <h3 id="@($"{idea.Id}-title")" class="ttl">@idea.Title</h3>
                        <p class="caption">@idea.Summary</p>
                        <div class="row">
                            <button class="btn secondary compact" @onclick="() => HearIdeaAsync(idea.Span)"><Icon Name="play" /> @Text["dna.hear"]</button>
                            <button class="btn quiet compact" @onclick="() => ShowInScore.InvokeAsync(idea.Span)">@Text["dna.inScore"]</button>
                            <button class="btn quiet compact" @onclick="() => ShowInInsights.InvokeAsync(idea.Span)">@Text["dna.inInsights"]</button>
                        </div>
                    </article>
                }
            </div>
        }

        <div class="dna-actions">
            <button class="btn primary" @onclick="() => PlayMap.InvokeAsync()"><Icon Name="@(PlayingAt is null ? "play" : "pause")" /> @(PlayingAt is null ? Text["dna.playMap"] : Text["dna.stop"])</button>
            @if (Dna.Form.Count > 0)
            {
                <button class="btn secondary" @onclick="() => AddBookmarks.InvokeAsync()"><Icon Name="bookmark" /> @Text["dna.addBookmarks"]</button>
            }
            <button class="btn secondary ask-piece" @onclick="AskAsync"><Icon Name="insight" /> @Text["ask.aboutPiece"]</button>
            @if (Status is { } status)
            {
                <p class="caption" role="status">@status</p>
            }
        </div>
    }
</section>

@code {
    private ElementReference _element;
    private bool _focused;

    /// <summary>The passage of the mark tapped last, which a second tap opens in the score.</summary>
    private TickSpan? _heard;

    /// <summary>Whether the folded lanes, register and dynamics, show.</summary>
    private bool _moreLanes;

    [Parameter, EditorRequired]
    public PieceDna Dna { get; set; } = default!;

    [Parameter, EditorRequired]
    public MeterMap Meter { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public Words Words { get; set; }

    /// <summary>Where playback is while it runs, for the playhead across the lanes; null when stopped.</summary>
    [Parameter]
    public Tick? PlayingAt { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    /// <summary>The place the map was opened from, such as "More", which ‹ goes back to; null for the score.</summary>
    [Parameter]
    public string? BackLabel { get; set; }

    /// <summary>Plays a passage of the map.</summary>
    [Parameter]
    public EventCallback<TickSpan> Hear { get; set; }

    /// <summary>Leaves for the score, with the passage selected.</summary>
    [Parameter]
    public EventCallback<TickSpan> ShowInScore { get; set; }

    /// <summary>Plays the piece from the start with the map following, or stops it.</summary>
    [Parameter]
    public EventCallback PlayMap { get; set; }

    /// <summary>Ask about the piece: the assistant's popover at the button, the map staying open under it (testing item 23).</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> Ask { get; set; }

    /// <summary>Leaves for the score with the passage selected and the Insights stream open on it.</summary>
    [Parameter]
    public EventCallback<TickSpan> ShowInInsights { get; set; }

    /// <summary>Add Structure bookmarks: the form's sections into the Contents drawer.</summary>
    [Parameter]
    public EventCallback AddBookmarks { get; set; }

    /// <summary>A line on what the last action did, such as the bookmarks added.</summary>
    [Parameter]
    public string? Status { get; set; }

    /// <summary>Hear the scale of a section's key, from the section's start; pressed again, it stops.</summary>
    [Parameter]
    public EventCallback<DnaCircle> HearScale { get; set; }

    /// <summary>The scale of the open circle is sounding.</summary>
    [Parameter]
    public bool ScalePlaying { get; set; }

    // The harmony's three rows (testing item 30), each kept on the device: chords and functions on, the steps on request.
    private const string ChordsSetting = "dna.chords";
    private const string DegreesSetting = "dna.degrees";
    private const string FunctionsSetting = "dna.functions";

    private bool ShowChords => Settings.IsOn(ChordsSetting);

    private bool ShowDegrees => Settings.IsOn(DegreesSetting);

    private bool ShowFunctions => Settings.IsOn(FunctionsSetting);

    /// <summary>The circle of fifths open over the map, if any, and the chord picked on it.</summary>
    private DnaCircle? _circle;

    private CircleChord? _chosenChord;

    /// <summary>What a tapped close says, and the phrase it ends, shown over the map.</summary>
    private string? _explained;

    private TickSpan? _explainedSpan;

    protected override async Task OnInitializedAsync()
    {
        Settings.Changed += OnSettingsChanged;
        await Settings.LoadAsync();
    }

    public void Dispose() => Settings.Changed -= OnSettingsChanged;

    private void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    private Task ToggleRowAsync(string id) => Settings.SetAsync(id, !Settings.IsOn(id));

    /// <summary>A stretch of bars on the harmony lane: equal chords or equal functions joined.</summary>
    /// <param name="Doubt">Why some of its chords rest on recognised notes still to check (#352); null when none does.</param>
    private sealed record Segment(TickSpan Span, string Symbol, string Degree, HarmonicFunction Function, bool Clear, string? Doubt = null);

    private IEnumerable<Segment> ChordSegments => Join(Dna.Harmony, (a, b) => a.Symbol == b.Symbol);

    private IEnumerable<Segment> FunctionSegments => Join(Dna.Harmony, (a, b) => a.Function == b.Function).Where(segment => segment.Function != HarmonicFunction.None);

    /// <summary>The chords of consecutive bars joined while <paramref name="same"/> holds, each segment spanning its bars.</summary>
    private IEnumerable<Segment> Join(IReadOnlyList<DnaChord> chords, Func<DnaChord, DnaChord, bool> same)
    {
        int i = 0;
        while (i < chords.Count)
        {
            int j = i;
            while (j + 1 < chords.Count && chords[j + 1].Bar == chords[j].Bar + 1 && same(chords[i], chords[j + 1]))
            {
                j++;
            }

            TickSpan span = TickSpan.FromBounds(Meter.GetBar(chords[i].Bar).Span.Onset, Meter.GetBar(chords[j].Bar).Span.End);
            DnaChord[] joined = [.. chords.Skip(i).Take(j - i + 1)];
            yield return new Segment(span, chords[i].Symbol, chords[i].Degree, chords[i].Function, joined.All(chord => chord.Clear), joined.Select(chord => chord.Doubt).FirstOrDefault(doubt => doubt is not null));
            i = j + 1;
        }
    }

    /// <summary>Whether a label has room in its segment: about 8px a character on a lane about 1000px wide.</summary>
    private bool Fits(Segment segment, string label)
    {
        long length = Math.Max(1, End.Value - Start.Value);
        return (double)segment.Span.Duration / length >= (label.Length + 1) * SymbolRoom;
    }

    /// <summary>
    /// The labels centred on their segments where they have room: a label may reach past its own short segment, but one
    /// that would touch the label before it is left out on screen (the circle lists every chord; the summary reads them
    /// all). A chord's label is its button, so it keeps at least <paramref name="least"/>, the room a finger needs.
    /// </summary>
    private IEnumerable<(Segment Segment, string Label)> Labels(IEnumerable<Segment> segments, Func<Segment, string> label, double least = 0)
    {
        long length = Math.Max(1, End.Value - Start.Value);
        double free = double.NegativeInfinity;
        foreach (Segment segment in segments)
        {
            string text = label(segment);
            if (text.Length == 0)
            {
                continue;
            }

            double middle = (double)(Middle(segment.Span).Value - Start.Value) / length;
            double half = Math.Max((text.Length + 1) * SymbolRoom, least) / 2;
            if (middle - half < free)
            {
                continue;
            }

            free = middle + half;
            yield return (segment, text);
        }
    }

    private static string FunctionClass(HarmonicFunction function) => function switch
    {
        HarmonicFunction.Tonic => "t",
        HarmonicFunction.Subdominant => "s",
        _ => "d",
    };

    private string FunctionLetter(HarmonicFunction function) => Text[function switch
    {
        HarmonicFunction.Tonic => "dna.fnT",
        HarmonicFunction.Subdominant => "dna.fnS",
        _ => "dna.fnD",
    }];

    private string ChordName(Segment segment) => $"{segment.Symbol}, {segment.Degree}"
        + (segment.Function == HarmonicFunction.None ? "" : $", {Text[$"dna.fnName.{segment.Function.ToString().ToLowerInvariant()}"]}")
        + $" · {Bars(Meter.BarAt(segment.Span.Onset).Number, Meter.BarAt(new Tick(segment.Span.End.Value - 1)).Number)}"
        + (segment.Doubt is { } doubt ? $" · {doubt}" : "");

    /// <summary>The closes in words where there is room: one too close to the one before is left out on screen, still heard by a screen reader in the summary.</summary>
    private IEnumerable<DnaCadence> ShownCadences
    {
        get
        {
            double free = double.NegativeInfinity;
            long length = Math.Max(1, End.Value - Start.Value);
            foreach (DnaCadence cadence in Dna.Cadences)
            {
                double x = (double)(Middle(Meter.GetBar(cadence.Bar).Span).Value - Start.Value) / length;
                string label = Text[cadence.Kind == CloseKind.Full ? "dna.cadFull" : "dna.cadHalf"];
                // A pill: its words, its padding and a gap, on a lane that may be as narrow as an iPad held upright.
                double half = (label.Length + 4) * SymbolRoom * 1.25 / 2;
                if (x - half < free)
                {
                    continue;
                }

                free = x + half;
                yield return cadence;
            }
        }
    }

    private void Explain(DnaCadence cadence)
    {
        _circle = null;
        _chosenChord = null;
        _explained = cadence.Explanation;
        _explainedSpan = Meter.GetBar(cadence.Bar).Span;
    }

    private IReadOnlySet<int> NewBars => _newBars ??= Dna.NewMaterialBars.ToHashSet();

    private IReadOnlySet<int>? _newBars;

    protected override void OnParametersSet() => _newBars = null;

    /// <summary>The form's sections coloured by their letter: every section of one letter shares the first one's colour.</summary>
    private string SectionColour(DnaSection section)
    {
        string[] letters = [.. Dna.Form.Select(other => Letter(other.Label)).Distinct()];
        return $"g{Array.IndexOf(letters, Letter(section.Label)) % 4}";
    }

    private static string Letter(string label) => label.TrimEnd('′', '″', '‴');

    private string? ChosenSymbol => _chosenChord?.Symbol;

    private DnaCircle? CircleAt(Tick at) => Dna.Circles.LastOrDefault(circle => circle.Span.Onset <= at) ?? Dna.Circles.FirstOrDefault();

    /// <summary>◎ Circle: opens the circle of the section heard or picked last, or the first; pressed again, it closes.</summary>
    private void ToggleCircle(string? id)
    {
        if (_circle is not null && id is null)
        {
            CloseCircle();
            return;
        }

        DnaCircle? circle = (id is null ? null : Dna.Circles.FirstOrDefault(other => other.Id == id))
            ?? (_heard is { } heard ? CircleAt(heard.Onset) : Dna.Circles.FirstOrDefault());
        if (circle is not null)
        {
            ShowCircle(circle, null);
        }
    }

    /// <summary>A chord or a key tapped: the circle of its section, with the chord picked when there is one.</summary>
    private void OpenCircleAt(Tick at, string? symbol)
    {
        if (CircleAt(at) is { } circle)
        {
            ShowCircle(circle, symbol);
        }
    }

    private void ShowCircle(DnaCircle circle, string? symbol)
    {
        _explained = null;
        _circle = circle;
        _chosenChord = symbol is null ? null : circle.Circle.Chords.FirstOrDefault(chord => chord.Symbol == symbol);
    }

    private void PickChord(FactPlace place) => _chosenChord = _circle?.Circle.Chords.FirstOrDefault(chord => chord.Place == place);

    private void CloseCircle()
    {
        _circle = null;
        _chosenChord = null;
    }

    /// <summary>A section of the form: it plays, a second tap opens the score; with the circle open, the circle follows it.</summary>
    private async Task TapSectionAsync(string id, TickSpan span)
    {
        if (_circle is not null && Dna.Circles.FirstOrDefault(circle => circle.Id == id) is { } circle)
        {
            ShowCircle(circle, null);
        }

        await TapAsync(span);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focused)
        {
            _focused = true;
            try
            {
                await _element.FocusAsync();
            }
            catch (InvalidOperationException)
            {
            }
        }
    }

    private Task OnKey(KeyboardEventArgs args) => args.Key == "Escape" ? Closed.InvokeAsync() : Task.CompletedTask;

    private Tick Start => Meter.GetBar(Dna.FirstBar).Span.Onset;

    private Tick End => Meter.GetBar(Dna.LastBar).Span.End;

    /// <summary>A position on the map as a share of its width, written for CSS; null outside the piece.</summary>
    private string? X(Tick tick)
    {
        long length = End.Value - Start.Value;
        if (length <= 0 || tick < Start || tick > End)
        {
            return null;
        }

        return ((double)(tick.Value - Start.Value) / length).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    }

    private string Place(TickSpan span)
    {
        string left = X(span.Onset < Start ? Start : span.Onset) ?? "0";
        string right = X(span.End > End ? End : span.End) ?? "1";
        return $"--x: {left}; --x2: {right}";
    }

    /// <summary>The bar numbers under the form strip: the first bar, then about ten more.</summary>
    private IEnumerable<int> AxisBars
    {
        get
        {
            int count = Dna.LastBar - Dna.FirstBar + 1;
            int step = Math.Max(1, (int)Math.Ceiling(count / 10.0));
            for (int bar = Dna.FirstBar; bar <= Dna.LastBar; bar += step)
            {
                yield return bar;
            }
        }
    }

    /// <summary>"8 bars · 1 idea · A minor".</summary>
    private string Counts => string.Join(" · ", new[]
    {
        Text.Count("dna.bars", Dna.LastBar - Dna.FirstBar + 1),
        Dna.Ideas.Count > 0 ? Text.Count("dna.ideas", Dna.Ideas.Count) : null,
        Dna.Keys.Count > 0 ? KeyName(Dna.Keys[0]) : null,
    }.Where(part => part is not null));

    private string KeyName(DnaKey key) => key.Inferred ? Text.Format("dna.keyAssumed", key.Key.NameIn(Words)) : key.Key.NameIn(Words);

    private string Bars(int first, int last) => first == last ? Text.Format("dna.bar", first) : Text.Format("dna.barsRange", first, last);

    private static string? MarkClass(OccurrenceKind kind) => kind switch
    {
        OccurrenceKind.Transposed or OccurrenceKind.Varied => "o",
        OccurrenceKind.Inverted => "v",
        _ => null,
    };

    private Task AskAsync(MouseEventArgs args) => Ask.InvokeAsync(args);

    /// <summary>The share of the map's width a chord symbol takes per character (about 8px on a lane about 1000px wide).</summary>
    private const double SymbolRoom = 0.008;

    /// <summary>The share of the map's width a finger needs between two marks (24px on a lane about 700px wide).</summary>
    private const double MarkRoom = 0.035;

    /// <summary>The idea's marks, each saying whether it is far enough from the mark before it to be a button of its own.</summary>
    private IEnumerable<(IdeaOccurrence Occurrence, bool Tappable)> Marks(DnaIdea idea)
    {
        long length = Math.Max(1, End.Value - Start.Value);
        double last = double.NegativeInfinity;
        foreach (IdeaOccurrence occurrence in idea.Occurrences)
        {
            double x = (double)(occurrence.Span.Onset.Value - Start.Value) / length;
            bool tappable = x - last >= MarkRoom;
            if (tappable)
            {
                last = x;
            }

            yield return (occurrence, tappable);
        }
    }

    /// <summary>The arcs above the form: from each section that brings material back to the one before it with the same letter.</summary>
    private IEnumerable<(DnaSection From, DnaSection To)> Arcs =>
        Dna.Form.Select(section => (Earlier: Dna.Form.LastOrDefault(other => other.Span.Onset < section.Span.Onset && section.SharesWith.Contains(other.Id)), Section: section))
            .Where(pair => pair.Earlier is not null)
            .Select(pair => (pair.Earlier!, pair.Section));

    private DnaSection FirstOf(DnaSection section) =>
        Dna.Form.FirstOrDefault(other => section.SharesWith.Contains(other.Id) && other.Span.Onset < section.Span.Onset) is { } earlier ? FirstOf(earlier) : section;

    private string ArcPlace(DnaSection from, DnaSection to)
    {
        string left = X(Middle(from.Span)) ?? "0";
        string right = X(Middle(to.Span)) ?? "1";
        return $"--x: {left}; --x2: {right}";
    }

    private static Tick Middle(TickSpan span) => new(span.Onset.Value + (span.Duration / 2));

    private string SectionName(DnaSection section) => $"{section.Label}, {Bars(section.FirstBar, section.LastBar)}";

    /// <summary>The chords where they change, with room for each symbol: a symbol too close to the one before is left out on screen.</summary>
    private IEnumerable<DnaChord> ShownChords
    {
        get
        {
            string? previous = null;
            double last = double.NegativeInfinity;
            long length = Math.Max(1, End.Value - Start.Value);
            foreach (DnaChord chord in Dna.Harmony)
            {
                double x = (double)(Meter.GetBar(chord.Bar).Span.Onset.Value - Start.Value) / length;
                if (chord.Symbol == previous || x < last)
                {
                    previous = chord.Symbol;
                    continue;
                }

                previous = chord.Symbol;
                last = x + ((chord.Symbol.Length + 1) * SymbolRoom);
                yield return chord;
            }
        }
    }

    /// <summary>For a screen reader: "bar 2 Am, bar 3 E, …; full closes in bars 8, 23".</summary>
    private string HarmonySummary
    {
        get
        {
            string? previous = null;
            var changes = new List<string>();
            foreach (DnaChord chord in Dna.Harmony)
            {
                if (chord.Symbol != previous)
                {
                    changes.Add($"{Text.Format("dna.bar", chord.Bar)} {chord.Symbol}");
                }

                previous = chord.Symbol;
            }

            return string.Join(", ", changes);
        }
    }

    private double MaxDensity => Dna.Density.Count == 0 ? 1 : Math.Max(0.01, Dna.Density.Max(level => level.Value));

    private int LowestNote => Dna.Register.Count == 0 ? 0 : Dna.Register.Min(range => range.Low);

    private int HighestNote => Dna.Register.Count == 0 ? 1 : Math.Max(LowestNote + 1, Dna.Register.Max(range => range.High));

    /// <summary>A share from 0 to 1, written for CSS.</summary>
    private static string Share(double value, double of) =>
        (of <= 0 ? 0 : Math.Clamp(value / of, 0, 1)).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private string DensitySummary
    {
        get
        {
            if (Dna.Density.Count == 0)
            {
                return "";
            }

            DnaBarLevel busiest = Dna.Density.MaxBy(level => level.Value)!;
            return Text.Format("dna.densitySummary", Words.Decimal((decimal)busiest.Value), busiest.Bar);
        }
    }

    private string RegisterSummary => Dna.Register.Count == 0
        ? ""
        : Text.Format("dna.registerSummary", new MotiffLab.MusicCore.Events.Pitch(LowestNote), new MotiffLab.MusicCore.Events.Pitch(HighestNote));

    private string MarkName(DnaIdea idea, IdeaOccurrence occurrence) => Text.Format(occurrence.Kind switch
    {
        OccurrenceKind.Original when idea.FromSelection => "dna.mark.original",
        OccurrenceKind.Original => "dna.mark.first",
        OccurrenceKind.Exact => "dna.mark.exact",
        OccurrenceKind.Transposed => "dna.mark.transposed",
        OccurrenceKind.Varied => "dna.mark.varied",
        _ => "dna.mark.inverted",
    }, Bars(occurrence.FirstBar, occurrence.LastBar));

    /// <summary>The first tap plays the passage; a second tap on the same one opens the score there.</summary>
    private async Task TapAsync(TickSpan span)
    {
        if (_heard == span)
        {
            await ShowInScore.InvokeAsync(span);
            return;
        }

        _heard = span;
        await Hear.InvokeAsync(span);
    }

    private Task HearIdeaAsync(TickSpan span)
    {
        _heard = span;
        return Hear.InvokeAsync(span);
    }
}
